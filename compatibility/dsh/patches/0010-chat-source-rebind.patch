-      const target = ctx.uiConversation.binding(binding).target('chat')
+      // A projection rebuild retires the loaded Conversation assembly, so the
+      // target resolved now dies with it. Follow the replacement generation and
+      // hand the one listener set to its target instead of serving a stale one.
+      let target: ObservableSnapshot<ChatSnapshot | undefined> = ctx.uiConversation.binding(binding).target('chat')
+      let leaveTarget: (() => void) | undefined
+      let stopProjection: (() => void) | undefined
+      const listeners = new Set<() => void>()
+      const notify = (): void => { for (const listener of listeners) listener() }
+      const follow = (): void => {
+        let next: ObservableSnapshot<ChatSnapshot | undefined>
+        try {
+          next = ctx.uiConversation.binding(binding).target('chat')
+        } catch {
+          // The Session binding was withdrawn; its ctx effect drops this source.
+          stopProjection?.()
+          return
+        }
+        if (next === target) return
+        leaveTarget?.()
+        target = next
+        leaveTarget = listeners.size > 0 ? target.subscribe(notify) : undefined
+        notify()
+      }
+      stopProjection = binding.projection.subscribe(follow)
       source = {
         getSnapshot: () => target.getSnapshot() ?? EMPTY_CHAT_SNAPSHOT,
-        subscribe: listener => target.subscribe(listener),
+        subscribe: (listener) => {
+          listeners.add(listener)
+          if (leaveTarget === undefined) leaveTarget = target.subscribe(notify)
+          return () => {
+            listeners.delete(listener)
+            if (listeners.size > 0) return
+            leaveTarget?.()
+            leaveTarget = undefined
+          }
+        },
       }
       chatSources.set(binding, source)
     }
