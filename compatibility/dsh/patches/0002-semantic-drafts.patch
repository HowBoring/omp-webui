+  private record(state: SemanticDraftState): SemanticDraftRecord {
+    return { draft: state.draft, originals: state.originals,
+      ...(state.unresolved === undefined ? {} : { unresolved: state.unresolved }) }
+  }
+
+  /** Serialize provider writes so a delayed edit can never overwrite a later durable marker. */
+  private write(entry: Entry, provider: ConversationDraftProvider, scope: DraftScope,
+    record: SemanticDraftRecord, reason: Parameters<ConversationDraftProvider['write']>[2],
+    signal?: AbortSignal): Promise<void> {
