+// @vitest-environment jsdom
+/** Public Conversation/provider boundary. Synthetic Session and original-provider fixture only. */
+import { expect, it, onTestFinished, vi } from 'vitest'
+import { SlotTestRuntime, stubConfigForm } from '@deepseek-ai/dsh-client-test-runtime'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { apply, inject, type ConversationDraftProvider } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { DraftTabOwner, DraftHostContext, DraftSourceContext, DraftNativeSessionId, DraftProjectionGeneration, DraftStorageKey, DraftOriginalId, DraftSubmissionId } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+
+async function fixture(draftPersistence: 'stock' | 'provider' = 'provider', session: Record<string, unknown> = {}) {
+  const runtime = await SlotTestRuntime.create()
+  onTestFinished(async () => { await runtime.dispose() })
+  runtime.ctx.provide('uiWorkspace', { openWorkspace: async () => {}, openSession: async () => {} } as never)
+  runtime.ctx.provide('configForms', {
+    developerTools: { enabled: createSnapshotStore(false) }, get: () => stubConfigForm().scope,
+  } as never)
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
