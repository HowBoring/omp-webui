+/** Runtime decoder for the public provider record; ephemeral readiness/receipt fields are rejected. */
+import { z } from 'zod'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { SemanticDraftRecord } from './contract/semantic-draft.ts'
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftTabOwner = import('./contract/semantic-draft.ts').DraftTabOwner
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftHostContext = import('./contract/semantic-draft.ts').DraftHostContext
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftSourceContext = import('./contract/semantic-draft.ts').DraftSourceContext
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftNativeSessionId = import('./contract/semantic-draft.ts').DraftNativeSessionId
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftProjectionGeneration = import('./contract/semantic-draft.ts').DraftProjectionGeneration
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftStorageKey = import('./contract/semantic-draft.ts').DraftStorageKey
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftOriginalId = import('./contract/semantic-draft.ts').DraftOriginalId
+/** Opaque identity admitted by the matching public constructor. */
+export type DraftSubmissionId = import('./contract/semantic-draft.ts').DraftSubmissionId
+import { parseStoredDraft } from './draft.ts'
+
+const opaqueIdentity = z.string().min(1)
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftTabOwner.
+ */
+export const DraftTabOwner = (value: string): DraftTabOwner => brandString<DraftTabOwner>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftHostContext.
+ */
+export const DraftHostContext = (value: string): DraftHostContext => brandString<DraftHostContext>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftSourceContext.
+ */
+export const DraftSourceContext = (value: string): DraftSourceContext => brandString<DraftSourceContext>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftNativeSessionId.
+ */
+export const DraftNativeSessionId = (value: string): DraftNativeSessionId => brandString<DraftNativeSessionId>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftProjectionGeneration.
+ */
+export const DraftProjectionGeneration = (value: string): DraftProjectionGeneration =>
+  brandString<DraftProjectionGeneration>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftStorageKey.
+ */
+export const DraftStorageKey = (value: string): DraftStorageKey => brandString<DraftStorageKey>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftOriginalId.
+ */
+export const DraftOriginalId = (value: string): DraftOriginalId => brandString<DraftOriginalId>(opaqueIdentity.parse(value))
+
+/**
+ * Admit a nonempty opaque provider identity; native-specific grammar belongs to that provider.
+ * @param value - decoded identity string.
+ * @returns validated DraftSubmissionId.
+ */
+export const DraftSubmissionId = (value: string): DraftSubmissionId => brandString<DraftSubmissionId>(opaqueIdentity.parse(value))
+
+const originalsSchema = z.array(z.object({
+  id: opaqueIdentity.transform(DraftOriginalId), name: z.string(), mediaType: z.string().min(1),
+}).strict())
+const recordSchema = z.object({
+  draft: z.unknown(), originals: originalsSchema,
+  unresolved: z.object({ ownsDraft: z.boolean(), id: opaqueIdentity.transform(DraftSubmissionId),
+    draft: z.unknown(), originals: originalsSchema }).strict().optional(),
+}).strict()
+
+/**
+ * Decode persisted or caller-supplied records before preparation/publication, rejecting runtime receipt fields.
+ * @param value - untrusted saved semantic record.
+ * @returns decoded record with validated identities, or undefined for an invalid record.
+ */
+export function parseSemanticDraftRecord(value: unknown): SemanticDraftRecord | undefined {
+  const record = recordSchema.safeParse(value)
+  if (!record.success) return undefined
+  const draft = parseStoredDraft(record.data.draft)
+  if (draft === undefined) return undefined
+  const saved = record.data.unresolved
+  const frozen = saved === undefined ? undefined : parseStoredDraft(saved.draft)
+  if (saved !== undefined && frozen === undefined) return undefined
+  return { draft, originals: record.data.originals,
+    ...(saved === undefined || frozen === undefined ? {} : {
+      unresolved: { id: saved.id, ownsDraft: saved.ownsDraft, draft: frozen, originals: saved.originals },
+    }),
+  }
+}
