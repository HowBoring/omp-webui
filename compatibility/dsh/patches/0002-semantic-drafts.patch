+          if (this.provider === provider && !lifetime.aborted) {
+            entry.suppressPersistence = true
+            try { entry.shell.protectSubmission({ ...parsed.unresolved, ownsDraft: false }) } finally { entry.suppressPersistence = false }
+          }
+          await abortable(Promise.resolve(provider.write(scope,
+            { ...record, unresolved: { ...parsed.unresolved, ownsDraft: false } }, reason, lifetime)), lifetime)
+          this.assertAuthority(entry, provider, scope, lifetime)
+          return
+        }
+      }
+      this.assertAuthority(entry, provider, scope, lifetime)
+      await abortable(Promise.resolve(provider.write(scope, structuredClone(record), reason, lifetime)), lifetime)
+      this.assertAuthority(entry, provider, scope, lifetime)
+    })
+    entry.writes = pending.catch(() => { /* A later explicit write may retry after a failed publication. */ })
+    return pending
+  }
+
+  /**
+   * Freeze before durable publication; transport loss never unlocks the attempted snapshot.
+   * @param binding - exact retained scope owning execution.
+   * @param signal - attempt lifetime; cancellation never authorizes execution.
+   */
+  async checkpoint(binding: SessionBinding, signal: AbortSignal): Promise<void> {
+    const shell = this.shellFor(binding)
+    const entry = this.entry(binding)
+    const marker = { id: DraftSubmissionId(randomUUID()), ownsDraft: true,
+      draft: structuredClone(shell.draftSnapshot), originals: structuredClone(shell.originals) }
+    entry.suppressPersistence = true
+    try { shell.protectSubmission(marker) } finally { entry.suppressPersistence = false }
+    const provider = this.provider
+    if (provider === undefined) throw new Error('draft persistence provider unavailable')
+    const scope = { ...provider.scope(binding) }
+    const revision = shell.restorationRevision
+    entry.submissionScope = scope
+    const op = this.begin(binding, signal)
+    const current = (): void => {
+      if (op.signal.aborted || this.provider !== provider || this.sessions().binding(binding.sessionId) !== binding
+        || !sameScope(scope, provider.scope(binding)) || shell.restorationRevision !== revision) {
+        throw new Error('draft submission checkpoint superseded')
+      }
+    }
+    try {
+      await abortable(entry.writes, op.signal)
+      current()
+      const saved = await abortable(provider.read(scope, op.signal), op.signal)
+      current()
+      const parsed = saved === undefined ? undefined : parseSemanticDraftRecord(saved)
+      if (saved !== undefined && parsed === undefined) throw new Error('invalid persisted draft')
+      if (parsed?.unresolved !== undefined) {
+        entry.suppressPersistence = true
+        try { shell.protectSubmission(parsed.unresolved) } finally { entry.suppressPersistence = false }
+        throw new Error('resolve the prior submission before sending')
+      }
+      await abortable(this.write(entry, provider, scope,
+        this.record(this.snapshot(binding, shell, provider)), 'submission', op.signal), op.signal)
+      current()
+    } finally { this.finish(binding, op) }
+  }
+
+  /**
+   * Associate the actual prompt identity before dispatch, without interpreting acceptance as commitment.
+   * @param binding - current retained scope.
+   * @param requestId - public DSH prompt identity minted for this invocation.
+   * @param signal - attempt lifetime.
+   */
+  async dispatch(binding: SessionBinding, requestId: SessionRequestId, signal: AbortSignal): Promise<void> {
+    const provider = this.provider
+    const entry = this.entry(binding)
+    const marker = entry.shell.unresolved
+    const scope = entry.submissionScope
+    if (provider === undefined || marker === undefined || scope === undefined) throw new Error('submission checkpoint unavailable')
+    const current = (): void => {
+      if (this.provider !== provider || this.sessions().binding(binding.sessionId) !== binding
+        || !sameScope(scope, provider.scope(binding)) || entry.shell.unresolved !== marker) {
+        throw new Error('submission dispatch superseded')
+      }
+    }
+    const op = this.begin(binding, signal)
+    try {
+      op.signal.throwIfAborted()
+      current()
+      await abortable(Promise.resolve(provider.beforeDispatch?.(scope,
+        Object.freeze({ submissionId: marker.id, requestId }), op.signal)), op.signal)
+      current()
+    } finally { this.finish(binding, op) }
+  }
+
+  /**
+   * An explicit native outcome authorizes durable resolution, never automatic replay.
+   * @param request - captured scope, revision, attempt identity and authoritative decision.
+   * @returns applied after durable publication; failure retains the protected snapshot.
+   */
+  async resolveSubmission(request: DraftSubmissionRecoveryRequest): Promise<DraftHydrationResult> {
+    request = { ...request, scope: { ...request.scope } }
+    const provider = this.provider
+    if (provider === undefined) return blocked('provider')
+    if (this.sessions().binding(request.binding.sessionId) !== request.binding) return blocked('binding')
+    const shell = this.shellFor(request.binding)
+    const marker = shell.unresolved
+    const stale = this.recoveryGuard(request, provider, shell, marker)
+    if (stale !== undefined) return stale
+    if (marker === undefined) return blocked('revision')
+    const current = { draft: structuredClone(shell.draftSnapshot), originals: structuredClone(shell.originals) }
+    if (request.outcome === 'not-submitted' && !marker.ownsDraft) return blocked('revision')
+    const record: SemanticDraftRecord = request.outcome === 'not-submitted'
+      ? { draft: marker.draft, originals: marker.originals }
+      : marker.ownsDraft ? { draft: { text: '', references: [] }, originals: [] } : current
+    const entry = this.entry(request.binding)
+    const op = this.begin(request.binding, request.signal)
+    try {
+      await abortable(this.write(entry, provider, request.scope, record, 'recovery', op.signal), op.signal)
+      const late = this.recoveryGuard(request, provider, shell, marker)
+      if (late !== undefined) return late
+      const oldIds = shell.snapshot.attachmentIds
+      entry.suppressPersistence = true
+      try {
+        if (!shell.resolveSemanticSubmission(record)) return blocked('frozen')
+      } finally { entry.suppressPersistence = false }
+      for (const id of oldIds) this.conversation()?.releaseDraftAttachment(id)
+      return { status: 'applied' }
+    } catch { return blocked(op.signal.aborted ? 'cancelled' : 'persistence') }
+    finally { this.finish(request.binding, op) }
+  }
+
+  private recoveryGuard(request: DraftSubmissionRecoveryRequest, provider: ConversationDraftProvider,
+    shell: SessionInputShell, marker: UnresolvedDraftSubmission | undefined): DraftHydrationResult | undefined {
+    if (this.provider !== provider) return blocked('provider')
+    if (this.sessions().binding(request.binding.sessionId) !== request.binding) return blocked('binding')
+    if (!sameScope(request.scope, provider.scope(request.binding))) return blocked('scope')
+    if (shell.restorationRevision !== request.expectedRevision || marker?.id !== request.submissionId
+        || shell.unresolved !== marker) return blocked('revision')
+    if (shell.executing) return blocked('frozen')
+    return undefined
+  }
+
+  /**
+   * Read the provider-owned input observation.
+   * @param binding - retained scope.
+   * @returns stable observable semantic state for the registered provider.
+   */
+  draft(binding: SessionBinding): SnapshotStore<SemanticDraftState> {
+    if (this.sessions().binding(binding.sessionId) !== binding) throw new Error('semantic draft requires a retained binding')
+    this.shellFor(binding)
+    const store = this.entries.get(binding)?.store
+    if (store === undefined || this.sessions().binding(binding.sessionId) !== binding) {
+      throw new Error('semantic draft requires a retained binding and registered provider')
+    }
+    return store
+  }
+
+  private begin(binding: SessionBinding, signal?: AbortSignal): AbortController {
+    this.operations.get(binding)?.abort()
+    const operation = new AbortController()
+    this.operations.set(binding, operation)
+    const abort = (): void => { operation.abort() }
+    signal?.addEventListener('abort', abort, { once: true })
+    operation.signal.addEventListener('abort', () => { signal?.removeEventListener('abort', abort) }, { once: true })
+    if (signal?.aborted) operation.abort()
+    return operation
+  }
+
+  private guard(request: DraftHydrationRequest, provider: ConversationDraftProvider): DraftHydrationResult | undefined {
+    if (this.provider !== provider) return blocked('provider')
+    if (this.sessions().binding(request.binding.sessionId) !== request.binding) return blocked('binding')
+    if (!sameScope(request.scope, provider.scope(request.binding))) return blocked('scope')
+    const shell = this.shellFor(request.binding)
+    if (frozen(shell)) return blocked('frozen')
+    if (shell.restorationRevision !== request.expectedRevision) return blocked('revision')
+    return undefined
+  }
+
+  /**
+   * Read and atomically restore the provider record.
+   * @param binding - retained scope.
+   * @param signal - operation lifetime.
+   * @returns guarded provider restore result.
+   */
+  async restore(binding: SessionBinding, signal?: AbortSignal): Promise<DraftHydrationResult> {
+    const provider = this.provider
+    if (provider === undefined) return blocked('provider')
+    if (this.sessions().binding(binding.sessionId) !== binding) return blocked('binding')
+    const state = this.draft(binding).getSnapshot()
+    const request = { binding, scope: { ...provider.scope(binding) }, expectedRevision: state.revision }
+    const initial = this.guard({ ...request, record: state }, provider)
+    if (initial !== undefined) return initial
+    const op = this.begin(binding, signal)
+    try {
+      if (op.signal.aborted) return blocked('cancelled')
+      const record = await abortable(provider.read(request.scope, op.signal), op.signal)
+      const stale = this.guard({ ...request, record: state }, provider)
+      if (stale !== undefined) return stale
+      if (record === undefined) return { status: 'empty' }
+      return await this.apply({ ...request, record: structuredClone(record) }, provider, op)
+    } catch { return blocked(op.signal.aborted ? 'cancelled' : 'preparation') }
+    finally { this.finish(binding, op) }
+  }
+
+  /**
+   * Atomically restore supplied semantic input.
+   * @param request - scoped revision-CAS restore.
+   * @returns atomic publication or a reason for refusal.
+   */
+  async hydrate(request: DraftHydrationRequest): Promise<DraftHydrationResult> {
+    const provider = this.provider
+    if (provider === undefined) return blocked('provider')
+    const initial = this.guard(request, provider)
+    if (initial !== undefined) return initial
+    // Capture caller-owned input before any asynchronous provider work.
+    const owned = { ...request, scope: { ...request.scope }, record: structuredClone(request.record) }
+    const op = this.begin(request.binding, request.signal)
+    try { return await this.apply(owned, provider, op) }
+    catch { return blocked(op.signal.aborted ? 'cancelled' : 'preparation') }
+    finally { this.finish(request.binding, op) }
+  }
+
+  private finish(binding: SessionBinding, op: AbortController): void {
+    if (this.operations.get(binding) === op) this.operations.delete(binding)
+    op.abort()
+  }
+
+  private async apply(
+    request: DraftHydrationRequest, provider: ConversationDraftProvider, op: AbortController,
+  ): Promise<DraftHydrationResult> {
+    if (op.signal.aborted) return blocked('cancelled')
+    const record = parseSemanticDraftRecord(request.record)
+    if (record === undefined) return blocked('invalid')
+    const { originals } = record
+    if (record.unresolved !== undefined) return this.quarantine(request, provider, record, record.unresolved)
+    const prepared = await abortable(provider.prepare(request.scope, originals, op.signal), op.signal)
+    if (prepared.length !== originals.length || prepared.some((item, index) => {
+      const original = originals.at(index)
+      return original === undefined || (item.status === 'ready'
+        && (item.file.name !== original.name || item.file.type !== original.mediaType))
+    })) {
+      return blocked('preparation')
+    }
+    const stale = this.guard(request, provider)
+    if (stale !== undefined) return stale
+    return this.publishPrepared(request, provider, op, record, prepared)
+  }
+
+  private quarantine(request: DraftHydrationRequest, provider: ConversationDraftProvider,
+    record: SemanticDraftRecord, marker: UnresolvedDraftSubmission): DraftHydrationResult {
+    const stale = this.guard(request, provider)
+    if (stale !== undefined) return stale
+    const entry = this.entry(request.binding)
+    entry.suppressPersistence = true
+    try {
+      if (!entry.shell.hydrateSemanticDraft(request.expectedRevision, record.draft, record.originals,
+        record.originals.map(() => ({ status: 'invalid', reason: 'Submission outcome unresolved.' })))) return blocked('revision')
+      entry.shell.protectSubmission(marker)
+    } finally { entry.suppressPersistence = false }
+    return { status: 'applied' }
+  }
+
+  private async publishPrepared(request: DraftHydrationRequest, provider: ConversationDraftProvider,
+    op: AbortController, { draft, originals }: SemanticDraftRecord,
+    prepared: readonly PreparedDraftOriginal[]): Promise<DraftHydrationResult> {
+    const controller = this.controller()
+    const created = controller.createDrafts(request.binding.sessionId,
+      prepared.flatMap(item => item.status === 'ready' ? [item.file] : []), true)
+    let committed = false
+    try {
+      await abortable(this.waitForUploads(controller, created.map(item => item.id), op.signal), op.signal)
+      op.signal.throwIfAborted()
+      const late = this.guard(request, provider)
+      if (late !== undefined) return late
+      let index = 0
+      const readiness: DraftOriginalReadiness[] = prepared.map(item => item.status === 'invalid'
+        ? { status: 'invalid', reason: item.reason }
+        : { status: 'ready', attachmentId: this.createdId(created, index++) })
+      const entry = this.entry(request.binding)
+      const oldIds = entry.shell.snapshot.attachmentIds
+      entry.hydrating = true
+      try { committed = entry.shell.hydrateSemanticDraft(request.expectedRevision, draft, originals, readiness) }
+      finally { entry.hydrating = false }
+      if (!committed) return blocked('revision')
+      for (const id of oldIds) controller.releaseDraftAttachment(id)
+      return { status: 'applied' }
+    } finally { if (!committed) controller.releaseDraftAttachments(created) }
+  }
+
+  private createdId(created: readonly { id: import('../contract/input.ts').DraftAttachmentId }[], index: number) {
+    const attachment = created[index]
+    if (attachment === undefined) throw new Error('original upload count mismatch')
+    return attachment.id
+  }
+
+  private waitForUploads(
+    controller: ConversationController, ids: readonly import('../contract/input.ts').DraftAttachmentId[], signal: AbortSignal,
+  ): Promise<void> {
+    return new Promise((resolve, reject) => {
+      let stop = (): void => {}
+      const finish = (error?: Error): void => {
+        stop()
+        signal.removeEventListener('abort', abort)
+        if (error === undefined) resolve(); else reject(error)
+      }
+      const abort = (): void => { finish(new Error('draft upload cancelled')) }
+      const check = (): void => {
+        const uploads = controller.fileUploads.getSnapshot()
+        if (ids.some(id => uploads[id]?.status === 'error')) finish(new Error('draft upload failed'))
+        else if (ids.every(id => uploads[id]?.status === 'ready')) finish()
+      }
+      stop = controller.fileUploads.subscribe(check)
+      signal.addEventListener('abort', abort, { once: true })
+      if (signal.aborted) abort(); else check()
+    })
+  }
+}
