+it('aborts a delayed old provider publication so replacement writes retain their own current scope', async () => {
+  const b = await fixture()
+  const started = deferred<undefined>()
+  const late = deferred<undefined>()
+  let saved: Awaited<ReturnType<ConversationDraftProvider['read']>>
+  let cancelled = false
+  const dispose = b.input.registerDraftProvider(b.runtime.ctx, providerFor(b.id, {
+    read: async () => saved,
+    write: async (_scope, record, _reason, signal) => {
+      started.resolve(undefined)
+      await late.promise
+      if (signal?.aborted) { cancelled = true; throw new Error('old provider publication cancelled') }
+      saved = record
+    },
+  }))
+  b.input.for(b.binding.ctx).setDraft('old delayed publication')
+  await started.promise
+  dispose()
+  const replacement = providerFor(b.id, { read: async () => saved,
+    write: (_scope, record) => { saved = structuredClone(record) } })
+  b.input.registerDraftProvider(b.runtime.ctx, replacement)
+  b.input.for(b.binding.ctx).setDraft('newer replacement draft')
+  await vi.waitFor(() => { expect(saved?.draft.text).toBe('newer replacement draft') })
+  late.resolve(undefined)
+  await vi.waitFor(() => { expect(cancelled).toBe(true) })
+  expect(saved?.draft.text).toBe('newer replacement draft')
+})
