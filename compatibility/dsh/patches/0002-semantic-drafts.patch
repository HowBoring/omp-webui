@@ -0,0 +1,20 @@
+/** Runtime decoder for the public provider record; ephemeral readiness/receipt fields are rejected. */
+import { z } from 'zod'
+import type { SemanticDraftRecord } from './contract/semantic-draft.ts'
+import { parseStoredDraft } from './draft.ts'
+
+const recordSchema = z.object({
+  draft: z.unknown(),
+  originals: z.array(z.object({
+    id: z.string().min(1), name: z.string(), mediaType: z.string().min(1),
+  }).strict()),
+}).strict()
+
+/** Decode persisted or caller-supplied records before any preparation/publication. */
+export function parseSemanticDraftRecord(value: unknown): SemanticDraftRecord | undefined {
+  const record = recordSchema.safeParse(value)
+  if (!record.success) return undefined
+  const draft = parseStoredDraft(record.data.draft)
+  if (draft === undefined) return undefined
+  return { draft, originals: record.data.originals }
+}
