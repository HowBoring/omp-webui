diff --git a/packages/client/ui-conversation/src/client/input/semantic-drafts.ts b/packages/client/ui-conversation/src/client/input/semantic-drafts.ts
new file mode 100644
index 00000000..0f4d803c
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/input/semantic-drafts.ts
@@ -0,0 +1,249 @@
+/** Provider persistence and atomic hydration coordinated at the retained Session input boundary. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { ISessions, SessionBinding } from '@deepseek-ai/dsh-api-session-controller/client'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { ConversationController } from '../service.ts'
+import type { SessionInputShell } from './facade.ts'
+import type {
+  ConversationDraftProvider, DraftHydrationRequest, DraftHydrationResult, DraftScope,
+  DraftOriginalReadiness, SemanticDraftState,
+} from '../contract/semantic-draft.ts'
+import { parseSemanticDraftRecord } from '../semantic-draft.ts'
+
+const blocked = (reason: Extract<DraftHydrationResult, { status: 'blocked' }>['reason']): DraftHydrationResult =>
+  ({ status: 'blocked', reason })
+const frozen = (shell: SessionInputShell): boolean =>
+  !['plain', 'claimed'].includes(shell.snapshot.phase)
+const sameScope = (a: DraftScope, b: DraftScope): boolean =>
+  a.tabOwner === b.tabOwner && a.hostContext === b.hostContext && a.sourceContext === b.sourceContext
+  && a.nativeSessionId === b.nativeSessionId && a.projectionGeneration === b.projectionGeneration
+  && a.storageKey === b.storageKey
+
+/** Bound any provider that ignores abort; its late result has no publication authority. */
+function abortable<T>(work: Promise<T>, signal: AbortSignal): Promise<T> {
+  return new Promise((resolve, reject) => {
+    const abort = (): void => { reject(new Error('draft operation cancelled')) }
+    if (signal.aborted) { abort(); return }
+    signal.addEventListener('abort', abort, { once: true })
+    work.then(resolve, reject).finally(() => { signal.removeEventListener('abort', abort) })
+  })
+}
+
+interface Entry {
+  readonly shell: SessionInputShell
+  store?: SnapshotStore<SemanticDraftState>
+  stop?: (() => void) | undefined
+  hydrating: boolean
+}
+
+export class SemanticDrafts {
+  private provider: ConversationDraftProvider | undefined
+  private readonly entries = new Map<SessionBinding, Entry>()
+  private readonly operations = new Map<SessionBinding, AbortController>()
+
+  constructor(
+    private readonly mode: 'stock' | 'provider',
+    private readonly sessions: () => ISessions,
+    private readonly shellFor: (binding: SessionBinding) => SessionInputShell,
+    private readonly conversation: () => ConversationController,
+  ) {}
+
+  register(ctx: Context, provider: ConversationDraftProvider): () => void {
+    if (this.mode !== 'provider' || this.provider !== undefined) throw new Error('draft provider requires exclusive provider mode')
+    this.provider = provider
+    for (const [binding, entry] of this.entries) this.connect(binding, entry)
+    return ctx.effect(() => () => {
+      if (this.provider !== provider) return
+      this.provider = undefined
+      for (const op of this.operations.values()) op.abort()
+      for (const entry of this.entries.values()) this.withdraw(entry)
+    }, 'conversation: draft provider')
+  }
+
+  watch(binding: SessionBinding, shell: SessionInputShell): void {
+    const entry: Entry = { shell, hydrating: false }
+    this.entries.set(binding, entry)
+    this.connect(binding, entry)
+    binding.ctx.effect(() => () => {
+      this.operations.get(binding)?.abort()
+      this.operations.delete(binding)
+      entry.stop?.()
+      this.entries.delete(binding)
+    }, 'conversation: semantic draft')
+  }
+
+  private connect(binding: SessionBinding, entry: Entry): void {
+    if (this.provider === undefined || entry.stop !== undefined) return
+    const provider = this.provider
+    const initial = this.snapshot(binding, entry.shell, provider)
+    if (entry.store === undefined) entry.store = createSnapshotStore(initial)
+    else entry.store.set(initial)
+    let previous = JSON.stringify({ draft: initial.draft, originals: initial.originals })
+    entry.stop = entry.shell.state.subscribe(() => {
+      if (this.sessions().binding(binding.sessionId) !== binding || this.provider !== provider) return
+      const state = this.snapshot(binding, entry.shell, provider)
+      entry.store?.set(state)
+      const record = { draft: state.draft, originals: state.originals }
+      const next = JSON.stringify(record)
+      if (previous === next) return
+      previous = next
+      try { provider.write(state.scope, record, entry.hydrating ? 'hydrate' : 'edit') }
+      catch { entry.shell.notify('error', 'Draft persistence failed; keep this page open and retry.') }
+    })
+  }
+
+  /** Withdraw only provider-owned runtime handles; durable originals and the semantic document remain. */
+  private withdraw(entry: Entry): void {
+    entry.stop?.()
+    entry.stop = undefined
+    const owned = new Set(entry.shell.originalReadiness.flatMap(item =>
+      item.status === 'ready' ? [item.attachmentId] : []))
+    for (const id of owned) this.conversation()?.releaseDraftAttachment(id)
+    entry.shell.pruneAttachments(entry.shell.snapshot.attachmentIds.filter(id => !owned.has(id)))
+    const previous = entry.store?.getSnapshot()
+    if (previous !== undefined) entry.store?.set({
+      ...previous, revision: entry.shell.restorationRevision, phase: entry.shell.snapshot.phase,
+      draft: structuredClone(entry.shell.draftSnapshot), originals: structuredClone(entry.shell.originals),
+      readiness: structuredClone(entry.shell.originalReadiness),
+    })
+  }
+
+  private snapshot(binding: SessionBinding, shell: SessionInputShell, provider: ConversationDraftProvider): SemanticDraftState {
+    return {
+      scope: { ...provider.scope(binding) }, revision: shell.restorationRevision, phase: shell.snapshot.phase,
+      draft: structuredClone(shell.draftSnapshot), originals: structuredClone(shell.originals),
+      readiness: structuredClone(shell.originalReadiness),
+    }
+  }
+
+  draft(binding: SessionBinding): SnapshotStore<SemanticDraftState> {
+    if (this.sessions().binding(binding.sessionId) !== binding) throw new Error('semantic draft requires a retained binding')
+    this.shellFor(binding)
+    const store = this.entries.get(binding)?.store
+    if (store === undefined || this.sessions().binding(binding.sessionId) !== binding) {
+      throw new Error('semantic draft requires a retained binding and registered provider')
+    }
+    return store
+  }
+
+  private begin(binding: SessionBinding, signal?: AbortSignal): AbortController {
+    this.operations.get(binding)?.abort()
+    const operation = new AbortController()
+    this.operations.set(binding, operation)
+    const abort = (): void => { operation.abort() }
+    signal?.addEventListener('abort', abort, { once: true })
+    operation.signal.addEventListener('abort', () => { signal?.removeEventListener('abort', abort) }, { once: true })
+    if (signal?.aborted) operation.abort()
+    return operation
+  }
+
+  private guard(request: DraftHydrationRequest, provider: ConversationDraftProvider): DraftHydrationResult | undefined {
+    if (this.provider !== provider) return blocked('provider')
+    if (this.sessions().binding(request.binding.sessionId) !== request.binding) return blocked('binding')
+    if (!sameScope(request.scope, provider.scope(request.binding))) return blocked('scope')
+    const shell = this.shellFor(request.binding)
+    if (frozen(shell)) return blocked('frozen')
+    if (shell.restorationRevision !== request.expectedRevision) return blocked('revision')
+    return undefined
+  }
+
+  async restore(binding: SessionBinding, signal?: AbortSignal): Promise<DraftHydrationResult> {
+    const provider = this.provider
+    if (provider === undefined) return blocked('provider')
+    if (this.sessions().binding(binding.sessionId) !== binding) return blocked('binding')
+    const state = this.draft(binding).getSnapshot()
+    const request = { binding, scope: { ...provider.scope(binding) }, expectedRevision: state.revision }
+    const initial = this.guard({ ...request, record: state }, provider)
+    if (initial !== undefined) return initial
+    const op = this.begin(binding, signal)
+    try {
+      if (op.signal.aborted) return blocked('cancelled')
+      const record = await abortable(provider.read(request.scope, op.signal), op.signal)
+      const stale = this.guard({ ...request, record: state }, provider)
+      if (stale !== undefined) return stale
+      if (record === undefined) return { status: 'empty' }
+      return await this.apply({ ...request, record: structuredClone(record) }, provider, op)
+    } catch { return blocked(op.signal.aborted ? 'cancelled' : 'preparation') }
+    finally { this.finish(binding, op) }
+  }
+
+  async hydrate(request: DraftHydrationRequest): Promise<DraftHydrationResult> {
+    const provider = this.provider
+    if (provider === undefined) return blocked('provider')
+    const initial = this.guard(request, provider)
+    if (initial !== undefined) return initial
+    // Capture caller-owned input before any asynchronous provider work.
+    const owned = { ...request, scope: { ...request.scope }, record: structuredClone(request.record) }
+    const op = this.begin(request.binding, request.signal)
+    try { return await this.apply(owned, provider, op) }
+    catch { return blocked(op.signal.aborted ? 'cancelled' : 'preparation') }
+    finally { this.finish(request.binding, op) }
+  }
+
+  private finish(binding: SessionBinding, op: AbortController): void {
+    if (this.operations.get(binding) === op) this.operations.delete(binding)
+    op.abort()
+  }
+
+  private async apply(
+    request: DraftHydrationRequest, provider: ConversationDraftProvider, op: AbortController,
+  ): Promise<DraftHydrationResult> {
+    if (op.signal.aborted) return blocked('cancelled')
+    const record = parseSemanticDraftRecord(request.record)
+    if (record === undefined) return blocked('invalid')
+    const { draft, originals } = record
+    const prepared = await abortable(provider.prepare(request.scope, originals, op.signal), op.signal)
+    if (prepared.length !== originals.length || prepared.some((item, index) =>
+      item.status === 'invalid' ? typeof item.reason !== 'string'
+        : item.status !== 'ready' || !(item.file instanceof File)
+          || item.file.name !== originals[index]?.name || item.file.type !== originals[index]?.mediaType)) {
+      return blocked('preparation')
+    }
+    const stale = this.guard(request, provider)
+    if (stale !== undefined) return stale
+    const controller = this.conversation()
+    const created = controller.createDrafts(request.binding.sessionId,
+      prepared.flatMap(item => item.status === 'ready' ? [item.file] : []), true)
+    let committed = false
+    try {
+      await abortable(this.waitForUploads(controller, created.map(item => item.id), op.signal), op.signal)
+      if (op.signal.aborted) return blocked('cancelled')
+      const late = this.guard(request, provider)
+      if (late !== undefined) return late
+      let index = 0
+      const readiness: DraftOriginalReadiness[] = prepared.map(item => item.status === 'invalid'
+        ? { status: 'invalid', reason: item.reason }
+        : { status: 'ready', attachmentId: created[index++]!.id })
+      const entry = this.entries.get(request.binding)!
+      const oldIds = entry.shell.snapshot.attachmentIds
+      entry.hydrating = true
+      try { committed = entry.shell.hydrateSemanticDraft(request.expectedRevision, draft, originals, readiness) }
+      finally { entry.hydrating = false }
+      if (!committed) return blocked('revision')
+      for (const id of oldIds) controller.releaseDraftAttachment(id)
+      return { status: 'applied' }
+    } finally { if (!committed) controller.releaseDraftAttachments(created) }
+  }
+
+  private waitForUploads(
+    controller: ConversationController, ids: readonly import('../contract/input.ts').DraftAttachmentId[], signal: AbortSignal,
+  ): Promise<void> {
+    return new Promise((resolve, reject) => {
+      let stop = (): void => {}
+      const finish = (error?: Error): void => {
+        stop()
+        signal.removeEventListener('abort', abort)
+        if (error === undefined) resolve(); else reject(error)
+      }
+      const abort = (): void => { finish(new Error('draft upload cancelled')) }
+      const check = (): void => {
+        const uploads = controller.fileUploads.getSnapshot()
+        if (ids.some(id => uploads[id]?.status === 'error')) finish(new Error('draft upload failed'))
+        else if (ids.every(id => uploads[id]?.status === 'ready')) finish()
+      }
+      stop = controller.fileUploads.subscribe(check)
+      signal.addEventListener('abort', abort, { once: true })
+      if (signal.aborted) abort(); else check()
+    })
+  }
+}
