+it.each(['reject', 'cancel', 'withdraw', 'rebind'] as const)(
+  'keeps recovery frozen after %s and fences late recovery publication', async (fault) => {
+    const b = await fixture()
+    const marker = { ownsDraft: true, id: DraftSubmissionId('protected-attempt'), draft: { text: 'protected', references: [] }, originals: [] }
+    const publication = deferred<undefined>()
+    const writing = deferred<undefined>()
+    const dispose = b.input.registerDraftProvider(b.runtime.ctx, providerFor(b.id, {
+      read: async () => ({ draft: marker.draft, originals: [], unresolved: marker }),
+      write: async (_scope, _record, reason) => {
+        if (reason !== 'recovery') return
+        writing.resolve(undefined)
+        await publication.promise
+        if (fault === 'reject') throw new Error('recovery storage failure')
+      },
+    }))
+    await b.input.restoreDraft(b.binding)
+    const source = b.input.draft(b.binding)
+    const state = source.getSnapshot()
+    const cancel = new AbortController()
+    const result = b.input.resolveDraftSubmission({ binding: b.binding, scope: state.scope,
+      expectedRevision: state.revision, submissionId: marker.id, outcome: 'accepted', signal: cancel.signal })
+    await writing.promise
+    if (fault === 'cancel') cancel.abort()
+    if (fault === 'withdraw') dispose()
+    if (fault === 'rebind') { b.ref.release(); await b.runtime.sessions.disposeScopes() }
+    publication.resolve(undefined)
+    expect((await result).status).toBe('blocked')
+    expect(source.getSnapshot().unresolved?.id).toBe(marker.id)
+    expect(source.getSnapshot().draft.text).toBe('protected')
+  },
+)
