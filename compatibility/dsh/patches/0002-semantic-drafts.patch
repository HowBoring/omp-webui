index 00000000..5bb9bcff
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/contract/semantic-draft.ts
@@ -0,0 +1,160 @@
+/** Public provider-owned semantic drafts; receipts and browser URLs are never persisted. */
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionRequestId } from '@deepseek-ai/dsh-api-session-controller/types'
+import type { SessionBinding } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { DraftSnapshot } from './draft-editor.ts'
+import type { DraftAttachmentId, InputState } from './input.ts'
+
+/** Opaque TabOwner identity owned by the provider; no native format is implied. */
+export type DraftTabOwner = Branded<'DraftTabOwner'>
+
+/** Opaque HostContext identity owned by the provider; no native format is implied. */
+export type DraftHostContext = Branded<'DraftHostContext'>
+
+/** Opaque SourceContext identity owned by the provider; no native format is implied. */
+export type DraftSourceContext = Branded<'DraftSourceContext'>
+
+/** Opaque NativeSessionId identity owned by the provider; no native format is implied. */
+export type DraftNativeSessionId = Branded<'DraftNativeSessionId'>
+
+/** Opaque ProjectionGeneration identity owned by the provider; no native format is implied. */
+export type DraftProjectionGeneration = Branded<'DraftProjectionGeneration'>
+
+/** Opaque StorageKey identity owned by the provider; no native format is implied. */
+export type DraftStorageKey = Branded<'DraftStorageKey'>
+
+/** Opaque OriginalId identity owned by the provider; no native format is implied. */
+export type DraftOriginalId = Branded<'DraftOriginalId'>
+
+/** Opaque SubmissionId identity owned by the provider; no native format is implied. */
+export type DraftSubmissionId = Branded<'DraftSubmissionId'>
+
+/** Stable identity of the saved draft. Generation fences hydration, but must not enter the storage key. */
+export interface DraftScope {
+  readonly tabOwner: DraftTabOwner
+  /** Persisted Host identity/origin/data-directory context, not a process/run id. */
+  readonly hostContext: DraftHostContext
+  readonly sourceContext: DraftSourceContext
+  readonly nativeSessionId: DraftNativeSessionId
+  readonly projectionGeneration: DraftProjectionGeneration
+  /** Provider-owned key: stable across refresh/Host restart and isolated by tab/source/native Session. */
+  readonly storageKey: DraftStorageKey
+}
+
+/** An ordered logical original, never an upload receipt, path, object URL or content-hash authority. */
+export interface DraftOriginalRef {
+  readonly id: DraftOriginalId
+  readonly name: string
+  readonly mediaType: string
+}
+
+/** One attempted input retained until an explicit authoritative recovery decision; never a receipt. */
+export interface UnresolvedDraftSubmission {
+  /** True when the displayed document belongs to this attempt; false protects a separate newer draft. */
+  readonly ownsDraft: boolean
+  readonly id: DraftSubmissionId
+  readonly draft: DraftSnapshot
+  readonly originals: readonly DraftOriginalRef[]
+}
+
+/** Provider-owned record. Absence of unresolved denotes editable input, never an inferred outcome. */
+export interface SemanticDraftRecord {
+  readonly unresolved?: UnresolvedDraftSubmission
+  readonly draft: DraftSnapshot
+  readonly originals: readonly DraftOriginalRef[]
+}
+
+/** Current runtime readiness, excluded from durable provider records. */
+export type DraftOriginalReadiness =
+  | { readonly status: 'ready'; readonly attachmentId: DraftAttachmentId }
+  | { readonly status: 'invalid'; readonly reason: string }
+
+/** Observable input state; unresolved attempts remain frozen until explicit authoritative recovery. */
+export interface SemanticDraftState extends SemanticDraftRecord {
+  readonly scope: DraftScope
+  /** Advances on edits, attachment changes and submission entry; failed submissions still fence older restores. */
+  readonly revision: number
+  readonly phase: InputState['phase']
+  readonly readiness: readonly DraftOriginalReadiness[]
+}
+
+/** Providers reauthorize/revalidate each original and return current bytes, never replay old receipts. */
+export type PreparedDraftOriginal =
+  | { readonly status: 'ready'; readonly file: File }
+  | { readonly status: 'invalid'; readonly reason: string }
+
+/** Correlates a protected local input with the exact DSH prompt request, never a native commit receipt. */
+export interface DraftDispatchContext {
+  readonly submissionId: DraftSubmissionId
+  readonly requestId: SessionRequestId
+}
+
+/** Exclusive provider of scoped semantic persistence and current authorized original bytes. */
+export interface ConversationDraftProvider {
+  /** @param binding - retained native Session projection. @returns persistent identity and current generation. */
+  scope(binding: SessionBinding): DraftScope
+  /** @param scope - exact storage authority. @param signal - operation lifetime. @returns decoded record or absence. */
+  read(scope: DraftScope, signal: AbortSignal): Promise<SemanticDraftRecord | undefined>
+  /**
+   * Persist the complete record in call order. Resolve only after durable publication; reject on failure.
+   * Submission and recovery writes must honor cancellation before publication. Hydration does not renew retention.
+   * @param scope - exact tab/source/native Session storage authority.
+   * @param record - semantic document, stable originals and any protected unresolved attempt.
+   * @param reason - explicit edit, hydration, pre-execution checkpoint or authoritative recovery.
+   * @param signal - lifetime of checkpoint/recovery; an aborted call must never authorize execution.
+   * @returns durable publication, synchronously or asynchronously.
+   */
+  write(scope: DraftScope, record: SemanticDraftRecord,
+    reason: 'edit' | 'hydrate' | 'submission' | 'recovery', signal?: AbortSignal): void | Promise<void>
+  /**
+   * Optionally durably associate the checkpoint with the actual upcoming prompt RPC before dispatch.
+   * @param scope - unchanged checkpoint authority.
+   * @param context - local attempt ID and exact public DSH request identity; neither implies native commitment.
+   * @param signal - dispatch lifetime; abort or failed association must reject and never authorize dispatch.
+   * @returns completion only after the integration can reconcile this request by identity.
+   */
+  beforeDispatch?(scope: DraftScope, context: DraftDispatchContext, signal: AbortSignal): void | Promise<void>
+  prepare(scope: DraftScope, originals: readonly DraftOriginalRef[], signal: AbortSignal): Promise<readonly PreparedDraftOriginal[]>
+}
+
+/** Atomic restore request guarded by the complete scope, retained binding and hydration revision. */
+export interface DraftHydrationRequest {
+  readonly binding: SessionBinding
+  readonly scope: DraftScope
+  readonly expectedRevision: number
+  readonly record: SemanticDraftRecord
+  readonly signal?: AbortSignal
+}
+
+/** Restore/recovery outcome; a blocked operation never authorizes automatic submission. */
+export type DraftHydrationResult =
+  | { readonly status: 'applied' }
+  | { readonly status: 'empty' }
+  | { readonly status: 'blocked'; readonly reason: 'provider' | 'binding' | 'scope' | 'revision' | 'frozen' | 'invalid' | 'preparation' | 'cancelled' | 'persistence' }
+
+/** Explicit authoritative decision supplied by the native submission integration, never inferred from transport loss. */
+export interface DraftSubmissionRecoveryRequest {
+  readonly binding: SessionBinding
+  readonly scope: DraftScope
+  readonly expectedRevision: number
+  readonly submissionId: DraftSubmissionId
+  /** Accepted discards only the frozen attempted input; not-submitted returns it for a later explicit send. */
+  readonly outcome: 'accepted' | 'not-submitted'
+  readonly signal?: AbortSignal
+}
+
+/** Additive input face. Registration is effect-owned and available only in provider persistence mode. */
+export interface ConversationDrafts {
+  registerDraftProvider(ctx: Context, provider: ConversationDraftProvider): () => void
+  draft(binding: SessionBinding): ObservableSnapshot<SemanticDraftState>
+  restoreDraft(binding: SessionBinding, signal?: AbortSignal): Promise<DraftHydrationResult>
+  hydrateDraft(request: DraftHydrationRequest): Promise<DraftHydrationResult>
+  /**
+   * Resolve a matching unresolved attempt after authoritative outcome lookup. Durable write precedes unlock.
+   * @param request - current binding, scope/revision CAS, attempt identity and explicit outcome.
+   * @returns applied only after durable resolution; failure retains the protected snapshot and never sends.
+   */
+  resolveDraftSubmission(request: DraftSubmissionRecoveryRequest): Promise<DraftHydrationResult>
+}
