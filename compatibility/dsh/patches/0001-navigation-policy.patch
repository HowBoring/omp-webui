+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Session operations whose Client presentation and execution may be unavailable in a deployment. */
+export type ClientSessionAction = 'create' | 'prompt' | 'rename' | 'fork' | 'queue'
+
+/** Deployment-selected Client behavior; Host authorization is always independent. */
+export interface ClientSessionPolicy {
+  /** Operations this Client must not present or send. Omission leaves the standard action set available. */
+  readonly disabledActions?: readonly ClientSessionAction[]
+  /** False refuses prompt admission while the Host reports this Session running. Omission preserves queueing. */
+  readonly allowPromptWhileRunning?: boolean
+}
+
+// These failures are produced locally before transport; they are not Host endpoints.
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface RemoteErrorDetailsMap {
+    'client/session-action-unavailable': { readonly action: ClientSessionAction }
+    'client/session-busy': { readonly sessionId: SessionId; readonly mode: 'queue' | 'steer' }
+  }
+}
