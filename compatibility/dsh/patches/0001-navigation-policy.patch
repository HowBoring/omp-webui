@@ -0,0 +1,70 @@
+/** Client admission is observed at the public Session verbs and Connection calls. */
+import { Context } from '@deepseek-ai/cordis'
+import { ClientSessions } from '../src/client/sessions/service.ts'
+import { sessionWorld } from './remote/session.client.ts'
+import { describe, expect, onTestFinished } from 'vitest'
+import type { MessageId } from '@deepseek-ai/dsh-llm/brand'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { sessionBench } from './remote/bench.client.ts'
+
+const it = createClientTest({ roster: webApp.closure(['@deepseek-ai/dsh-api-gateway']) })
+const SID = 'policy-session' as SessionId
+
+describe('Session deployment policy', () => {
+  it('leaves a busy prompt unsent when queue admission is disabled', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID, { policy: { allowPromptWhileRunning: false } })
+    session.handleRunning(true)
+    const result = await session.prompt([{ type: 'text', text: 'keep this draft' }], 'queue')
+    expect(result).toMatchObject({ ok: false, error: { code: 'client/session-busy' } })
+    expect(mock.log.calls('session/prompt')).toHaveLength(0)
+    expect(session.getSnapshot().promptError?.op).toBe('send')
+  }, 60_000)
+
+  it('keeps defaults available and carries deployment policy through public Controller acquisitions', async ({ mock, start }) => {
+    mock.load(sessionWorld)
+    const client = await start()
+    const root = new Context()
+    onTestFinished(() => root.fiber.dispose())
+    const svc = new ClientSessions(root, client.ctx.remote, {
+      disabledActions: ['create', 'fork', 'rename', 'queue'], allowPromptWhileRunning: false,
+    })
+    svc.handleSessionAdded({ sessionId: SID, updatedAt: 0, running: true, blank: false, agentAvailable: true })
+    await expect(svc.create()).rejects.toMatchObject({ rpcError: { code: 'client/session-action-unavailable' } })
+    await expect(svc.fork({ sessionId: SID })).rejects.toMatchObject({ rpcError: { code: 'client/session-action-unavailable' } })
+    const ref = svc.retain(SID, { source: 'controllerOperation' })
+    await ref.ready
+    // Feed a Host running control observation after opening's baseline.
+    svc.handleSessionStatus(SID, true)
+    expect(await ref.binding.session.prompt([{ type: 'text', text: 'unsent' }], 'steer')).toMatchObject({ ok: false })
+    expect(await ref.binding.session.rename('unsent')).toMatchObject({ ok: false })
+    expect(Object.isFrozen(svc.policy.disabledActions)).toBe(true)
+    ref.release()
+    for (const endpoint of ['session/create', 'session/fork', 'session/prompt', 'session/rename']) {
+      expect(mock.log.calls(endpoint)).toHaveLength(0)
+    }
+    const standard = await sessionBench(mock, start, SID)
+    standard.handleRunning(true)
+    expect(await standard.prompt([{ type: 'text', text: 'standard queue' }], 'queue')).toMatchObject({ ok: true })
+    expect(mock.log.calls('session/prompt')).toHaveLength(1)
+  })
+
+  it('refuses busy queued steering without disabling queue withdrawal', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID, { policy: { allowPromptWhileRunning: false } })
+    session.handleRunning(true)
+    expect(await session.updateQueue('queued' as MessageId, { kind: 'steer' })).toMatchObject({
+      ok: false, error: { code: 'client/session-busy' },
+    })
+    expect(mock.log.calls('session/updateQueue')).toHaveLength(0)
+    expect(await session.updateQueue('queued' as MessageId, { kind: 'remove' })).toMatchObject({ ok: true })
+    expect(mock.log.calls('session/updateQueue')).toHaveLength(1)
+  })
+
+  it('refuses an unavailable rename before sending a Remote request', async ({ mock, start }) => {
+    const session = await sessionBench(mock, start, SID, { policy: { disabledActions: ['rename'] } })
+    expect(await session.rename('changed')).toMatchObject({
+      ok: false, error: { code: 'client/session-action-unavailable' },
+    })
+    expect(mock.log.calls('session/rename')).toHaveLength(0)
+  })
+})
