+/** Local deployment refusal, independent of Remote resource authorization. */
+import { RemoteError, type RemoteFailure } from '@deepseek-ai/dsh-typert-protocol'
+import type { ClientSessionAction, ClientSessionPolicy } from '../contract/policy.ts'
+
+/**
+ * Check an action against the immutable deployment selection.
+ * @param policy - Client-selected availability; omission preserves the standard behavior.
+ * @param action - operation about to execute.
+ * @returns a local failure when unavailable, otherwise undefined.
+ */
+export function sessionActionFailure(policy: ClientSessionPolicy | undefined, action: ClientSessionAction): RemoteFailure | undefined {
+  return policy?.disabledActions?.includes(action)
+    ? new RemoteError('client/session-action-unavailable', 'client/session-action-unavailable', { action })
+    : undefined
+}
