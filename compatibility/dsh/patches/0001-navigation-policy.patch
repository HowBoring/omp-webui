+/** Deployment availability is independent of Remote resource permissions. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { ClientSessionAction } from '@deepseek-ai/dsh-api-session-controller/client'
+
+/**
+ * @param controllers - Controllers carrying immutable deployment selections.
+ * @param action - operation to present or execute.
+ * @returns false only for explicitly disabled operations; absent policy preserves standard behavior.
+ */
+export function sessionActionAvailable(controllers: Pick<Context, 'sessions' | 'workspaces'>, action: ClientSessionAction | 'archive' | 'pin'): boolean {
+  return action === 'archive' || action === 'pin'
+    ? !controllers.workspaces.policy?.disabledSessionActions?.includes(action)
+    : !controllers.sessions.policy?.disabledActions?.includes(action)
+}
