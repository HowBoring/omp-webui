diff --git a/packages/api/session-controller/tests/submission-no-input.client.spec.ts b/packages/api/session-controller/tests/submission-no-input.client.spec.ts
new file mode 100644
index 00000000..99dca4cc
--- /dev/null
+++ b/packages/api/session-controller/tests/submission-no-input.client.spec.ts
@@ -0,0 +1,157 @@
+/** Accepted operations with no inbox or durable input retire only their scoped local echo. */
+import { Context } from '@deepseek-ai/cordis'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { ok, type RemoteMock } from '@deepseek-ai/dsh-remote-mock'
+import { createClientTest, webApp, type TestClient } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { describe, expect, onTestFinished, vi } from 'vitest'
+import { ClientSessions } from '../src/client/sessions/service.ts'
+import { parseProjectionBinding } from '../src/projection-binding.ts'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionProjectionBinding, SessionPromptValue } from '../src/types.ts'
+import type { RemoteResult } from '@deepseek-ai/dsh-typert-protocol'
+import type { PendingSubmissionRetirement } from '../src/client/contract/session.ts'
+import { FOLLOW } from './remote/session.client.ts'
+
+const ID = SessionId('no-input-session')
+const PROJECTION = parseProjectionBinding({ source: 'synthetic-native-source', generation: 'generation-one' })
+const it = createClientTest({ roster: webApp.closure(['@deepseek-ai/dsh-api-gateway']) })
+
+describe('no-input submission settlement', () => {
+  it('accepts a synchronous no-input operation without retaining a transcript echo or creating a turn', async ({ mock, start }) => {
+    const client = await start(), ctx = new Context()
+    const sessions = new ClientSessions(ctx, client.ctx.remote, { projectionRebuild: true })
+    onTestFinished(() => ctx.fiber.dispose())
+    mock.remote.session.list.mockResolvedValue(ok({ items: [{ sessionId: ID, updatedAt: 1,
+      running: false, blank: true, agentAvailable: true, projection: PROJECTION }] }))
+    mock.stream(FOLLOW, (_args, stream) => { stream.push({ type: 'snapshot', projection: PROJECTION,
+      header: { version: 4, id: ID, createdAt: 0, isSeeded: false }, cursor: -1, records: [], hasMore: false,
+      projections: { projection: PROJECTION, asOfSeq: -1, values: {} }, assistantStream: { revision: 0 } }) })
+    await sessions.refresh()
+    using reference = sessions.retain(ID, { source: 'controllerOperation' })
+    const binding = await reference.ready, retired: PendingSubmissionRetirement[] = []
+    const handle = binding.session.beginSubmission({ mode: 'queue', text: '/help', attachments: [],
+      onRetire: result => { retired.push(result) } })
+    mock.remote.session.prompt.mockResolvedValue(ok({ accepted: true, noInput: { requestId: handle.requestId, projection: PROJECTION } }))
+    expect((await binding.session.prompt([{ type: 'text', text: '/help' }], 'queue', undefined, handle.requestId)).ok).toBe(true)
+    expect(binding.session.getSnapshot()).toMatchObject({ pendingSubmissions: [], blank: true, awaitingFirstTurn: false })
+    expect(binding.eventSource.getSnapshot().entries).toEqual([])
+    expect(retired).toEqual([{ reason: 'no-input' }])
+  })
+})
+
+/** Open an empty, projection-scoped Session through its public retain interface. */
+async function openEmpty(mock: RemoteMock, start: () => Promise<TestClient>) {
+  let projection = PROJECTION
+  const client = await start(), ctx = new Context()
+  const sessions = new ClientSessions(ctx, client.ctx.remote, { projectionRebuild: true })
+  onTestFinished(() => ctx.fiber.dispose())
+  mock.remote.session.list.mockResolvedValue(ok({ items: [{ sessionId: ID, updatedAt: 1,
+    running: false, blank: true, agentAvailable: true, projection: PROJECTION }] }))
+  mock.stream(FOLLOW, (_args, stream) => { stream.push({ type: 'snapshot', projection,
+    header: { version: 4, id: ID, createdAt: 0, isSeeded: false }, cursor: -1, records: [], hasMore: false,
+    projections: { projection, asOfSeq: -1, values: {} }, assistantStream: { revision: 0 } }) })
+  await sessions.refresh()
+  const reference = sessions.retain(ID, { source: 'controllerOperation' })
+  onTestFinished(() => reference.release())
+  const binding = await reference.ready
+  return { session: binding.session, sessions, binding,
+    replaceProjection(next: SessionProjectionBinding) {
+      projection = next
+      sessions.handleControlFrame({ type: 'projection-invalidated', sessionId: ID, projection: next })
+    } }
+}
+
+it('recognizes a late original no-input receipt without clearing a successor send', async ({ mock, start }) => {
+  const { session } = await openEmpty(mock, start)
+  const retired: PendingSubmissionRetirement[] = []
+  const old = session.beginSubmission({ mode: 'queue', text: '/help', attachments: [],
+    onRetire: result => { retired.push(result) } })
+  const late = Promise.withResolvers<RemoteResult<SessionPromptValue>>()
+  onTestFinished(() => late.resolve(ok({ accepted: true })))
+  mock.remote.session.prompt.mockImplementationOnce(() => late.promise)
+  const original = session.prompt([{ type: 'text', text: '/help' }], 'queue', undefined, old.requestId)
+  const proof = { requestId: old.requestId, projection: PROJECTION }
+  expect(session.settleSubmissionNoInput(proof)).toBe(true)
+  expect(session.settleSubmissionNoInput(proof)).toBe(false)
+  const successor = session.beginSubmission({ mode: 'queue', text: 'new question', attachments: [] })
+  mock.remote.session.prompt.mockResolvedValueOnce(ok({ accepted: true }))
+  await session.prompt([{ type: 'text', text: 'new question' }], 'queue', undefined, successor.requestId)
+  expect(session.getSnapshot()).toMatchObject({ awaitingFirstTurn: true, blank: false })
+  late.resolve(ok({ accepted: true, noInput: proof }))
+  expect((await original).ok).toBe(true)
+  const unrelated = session.beginSubmission({ mode: 'queue', text: 'cancelled edit', attachments: [] })
+  unrelated.abandon()
+  expect(session.getSnapshot()).toMatchObject({ awaitingFirstTurn: true, blank: false,
+    pendingSubmissions: [{ requestId: successor.requestId, text: 'new question' }] })
+  expect(retired).toEqual([{ reason: 'no-input' }])
+})
+
+
+it('rejects mismatched proof and preserves ordinary accepted echoes until exact terminal settlement', async ({ mock, start }) => {
+  const { session } = await openEmpty(mock, start)
+  const retired: PendingSubmissionRetirement[] = []
+  const handle = session.beginSubmission({ mode: 'queue', text: '/help', attachments: [],
+    onRetire: result => { retired.push(result) } })
+  mock.remote.session.prompt.mockResolvedValueOnce(ok({ accepted: true }))
+  expect((await session.prompt([{ type: 'text', text: '/help' }], 'queue', undefined, handle.requestId)).ok).toBe(true)
+  expect(session.getSnapshot().pendingSubmissions).toMatchObject([{ requestId: handle.requestId }])
+  const wrong = parseProjectionBinding({ source: 'different-source', generation: 'generation-one' })
+  expect(session.settleSubmissionNoInput({ requestId: handle.requestId, projection: wrong })).toBe(false)
+  expect(retired).toEqual([])
+  expect(session.settleSubmissionNoInput({ requestId: handle.requestId, projection: PROJECTION })).toBe(true)
+  expect(session.getSnapshot()).toMatchObject({ pendingSubmissions: [], blank: true, awaitingFirstTurn: false })
+  expect(retired).toEqual([{ reason: 'no-input' }])
+})
+
+it('retires an old-generation echo without changing the successor projection or echo', async ({ mock, start }) => {
+  const { session, binding, replaceProjection } = await openEmpty(mock, start)
+  const retired: PendingSubmissionRetirement[] = []
+  const old = session.beginSubmission({ mode: 'queue', text: '/help', attachments: [],
+    onRetire: result => { retired.push(result) } })
+  mock.remote.session.prompt.mockResolvedValue(ok({ accepted: true }))
+  await session.prompt([{ type: 'text', text: '/help' }], 'queue', undefined, old.requestId)
+  const next = parseProjectionBinding({ source: 'synthetic-native-source', generation: 'generation-two' })
+  replaceProjection(next)
+  await vi.waitFor(() => { expect(binding.projection.getSnapshot().phase).toBe('ready') })
+  const successor = session.beginSubmission({ mode: 'queue', text: 'new branch draft', attachments: [] })
+  await session.prompt([{ type: 'text', text: 'new branch draft' }], 'queue', undefined, successor.requestId)
+  const before = session.getSnapshot()
+  expect(session.settleSubmissionNoInput({ requestId: old.requestId, projection: PROJECTION })).toBe(true)
+  expect(binding.projection.getSnapshot()).toMatchObject({ phase: 'ready', binding: next })
