+  mock.remote.session.prompt.mockResolvedValueOnce(ok({ accepted: true }))
+  await session.prompt([{ type: 'text', text: 'actual input' }], 'queue', undefined, handle.requestId)
+  const message = createUserMessage({ source: { kind: 'user', rpcId: handle.requestId },
+    content: [{ type: 'text', text: 'actual input' }] })
+  sessions.handleControlFrame({ type: 'projection', sessionId: ID, projection: PROJECTION, seq: 0,
+    changes: [{ key: 'inbox', val: { 'next-turn': [message], 'next-step': [] } }] })
+  await Promise.resolve()
+  expect(session.settleSubmissionNoInput({ requestId: handle.requestId, projection: PROJECTION })).toBe(false)
+  expect(retired).toEqual([])
+  expect(session.getSnapshot().pendingSubmissions).toMatchObject([{ requestId: handle.requestId }])
+})
+
+
+it('rejects a receipt for the wrong request without retiring its registered echo', async ({ mock, start }) => {
+  const { session } = await openEmpty(mock, start)
+  const retired: PendingSubmissionRetirement[] = []
+  const original = session.beginSubmission({ mode: 'queue', text: '/help', attachments: [],
+    onRetire: result => { retired.push(result) } })
+  const other = session.beginSubmission({ mode: 'queue', text: 'separate draft', attachments: [] })
+  mock.remote.session.prompt.mockResolvedValueOnce(ok({ accepted: true,
+    noInput: { requestId: other.requestId, projection: PROJECTION } }))
+  expect((await session.prompt([{ type: 'text', text: '/help' }], 'queue', undefined, original.requestId)).ok).toBe(false)
+  expect(retired).toEqual([])
+  expect(session.settleSubmissionNoInput({ requestId: original.requestId, projection: PROJECTION })).toBe(true)
+  expect(retired).toEqual([{ reason: 'no-input' }])
+  other.abandon()
+})
