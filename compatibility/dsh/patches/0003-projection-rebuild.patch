+    expect(binding.projection.getSnapshot().phase).toBe('ready')
+    expect(JSON.stringify(binding.eventSource.getSnapshot())).toContain('off-branch original')
+    sessions.handleConnected()
+    expect(binding.projection.getSnapshot().phase).toBe('rebuilding')
+    expect(JSON.stringify(binding.eventSource.getSnapshot())).toContain('off-branch original')
+    sessions.handleControlFrame({ type: 'baseline', value: { projections: {
+      [ID]: { projection: OLD, asOfSeq: 6, values: {} },
+    } } })
+    expect(binding.projection.getSnapshot().phase).toBe('ready')
+    const oldProjection = binding.projection.getSnapshot()
+    const abortObservation: unknown[] = []
+    if (oldProjection.phase !== 'stock') oldProjection.signal.addEventListener('abort', () => {
+      abortObservation.push({ phase: binding.projection.getSnapshot().phase,
+        entries: binding.eventSource.getSnapshot().entries })
+    })
+    sessions.handleControlFrame({ type: 'projection-invalidated', sessionId: ID, projection: NEXT })
+    expect(abortObservation).toEqual([{ phase: 'rebuilding', entries: [] }])
+    expect(binding.projection.getSnapshot().phase).toBe('rebuilding')
+    expect(binding.eventSource.getSnapshot().entries).toEqual([])
+    expect(second.binding).toBe(binding)
+    expect(sessions.scope(ID)).toBe(binding.ctx)
+    expect(binding.session.getSnapshot().running).toBe(true)
+    expect(sessions.retainInfo(ID).getSnapshot().referenceCount).toBe(2)
+    opening.resolve(undefined)
+    await vi.waitFor(() => { expect(binding.projection.getSnapshot().phase).toBe('failed') })
+    expect(binding.eventSource.getSnapshot().entries).toEqual([])
