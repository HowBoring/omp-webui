+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { ClientSessions } from '../src/client/sessions/service.ts'
+import { parseProjectionBinding } from '../src/projection-binding.ts'
+import type { SessionFollowRequest, SessionProjectionBinding } from '../src/types.ts'
+import { FOLLOW } from './remote/session.client.ts'
+import { followSnapshot } from './remote/history.client.ts'
+import { ev, historyValue } from './event-script.client.ts'
+
+const ID = SessionId('projection-session')
+const OLD = parseProjectionBinding({ source: 'synthetic-source', generation: 'old-generation' })
+const NEXT = parseProjectionBinding({ source: 'synthetic-source', generation: 'new-generation' })
+const it = createClientTest({ roster: webApp.closure(['@deepseek-ai/dsh-api-gateway']) })
+
+function snapshot(projection: SessionProjectionBinding, text: string, first: number) {
+  const frame = followSnapshot(historyValue([
+    ev.turnStart(SessionSeq(first), 0), ev.user(SessionSeq(first + 1), text),
+  ]), { address: { kind: 'session', sessionId: ID }, assistantStream: true })
+  return { ...frame, projection, projections: { ...frame.projections, projection, values: { title: text } } }
+}
