+    mock.remote.session.list.mockResolvedValue(ok({ items: [
+      { sessionId: ID, updatedAt: 1, running: true, blank: false, agentAvailable: true },
+    ] }))
+    await sessions.refresh()
+    mock.stream(FOLLOW, async ([raw], stream) => {
+      const request = raw as SessionFollowRequest
+      if (request.projection?.generation === NEXT.generation) {
+        await opening.promise
+        stream.fail(new RemoteError('gateway/internal', 'baseline unavailable', {}))
+      } else stream.push(snapshot(OLD, 'off-branch original', 5))
+    })
+    using first = sessions.retain(ID, { source: 'controllerOperation' })
+    using second = sessions.retain(ID, { source: 'controllerOperation' })
