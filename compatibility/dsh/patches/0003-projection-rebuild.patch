@@ -0,0 +1,43 @@
+/** Runtime admission of opaque projection identities at provider and wire boundaries. */
+import { z } from 'zod'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type {
+  SessionProjectionBinding, SessionProjectionSource, SessionProjectionGeneration,
+} from './types.ts'
+
+const identity = z.string().min(1).max(512)
+const bindingSchema = z.object({ source: identity, generation: identity }).strict()
+
+/**
+ * Validate an opaque verified source identity without asserting its authenticity.
+ * @param value - opaque verified source identity.
+ * @returns validated source brand.
+ */
+export const projectionSource = (value: string): SessionProjectionSource =>
+  brandString<SessionProjectionSource>(identity.parse(value))
+/**
+ * Validate an opaque authoritative presentation generation.
+ * @param value - opaque authoritative generation.
+ * @returns validated generation brand.
+ */
+export const projectionGeneration = (value: string): SessionProjectionGeneration =>
+  brandString<SessionProjectionGeneration>(identity.parse(value))
+/**
+ * Decode a detached presentation identity at a provider or wire boundary.
+ * @param value - decoded provider or wire value.
+ * @returns detached validated identity.
+ */
+export function parseProjectionBinding(value: unknown): SessionProjectionBinding {
+  const parsed = bindingSchema.parse(value)
+  return Object.freeze({ source: projectionSource(parsed.source), generation: projectionGeneration(parsed.generation) })
+}
+/**
+ * Compare complete presentation identities, including the stock unscoped case.
+ * @param left - expected identity.
+ * @param right - received identity.
+ * @returns exact generation equality.
+ */
+export function sameProjection(left: SessionProjectionBinding | undefined,
+  right: SessionProjectionBinding | undefined): boolean {
+  return left?.source === right?.source && left?.generation === right?.generation
+}
