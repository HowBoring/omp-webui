--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-history.ts
@@ -0,0 +1,300 @@
+/** Coherent native history v1. In-memory observations are not persistence receipts. */
+import { randomUUID, createHash } from "node:crypto";
+import type { SessionManager } from "../../session/session-manager";
+
+export const HISTORY_LIMITS = Object.freeze({
+  entries: 20_000, bytes: 320 * 1024 * 1024, nativeItemBytes: 64 * 1024 * 1024, itemBytes: 512 * 1024, ms: 5_000,
+  snapshotBytes: 256 * 1024 * 1024, cacheBytes: 512 * 1024 * 1024, snapshots: 2,
+  pageItems: 128, pageBytes: 768 * 1024, responseBytes: 1024 * 1024, ttlMs: 600_000,
+  contentItems: 20_000, contentPageBytes: 256 * 1024, liveEvents: 4096, liveBytes: 8 * 1024 * 1024, pollItems: 128,
+});
+export type HistoryScope = "tree" | "active" | "running";
+export interface HistoryContent {
+  cursor: string; mimeType: string; bytes: number; sha256: string; origin: "retained_native"; originalAssociation: "unproven";
+}
+export interface HistoryItem {
+  id: string; parentId: string | null; kind: string; active: boolean; text: string;
+  contents?: HistoryContent[]; entryId?: string; partIndex?: number; partCount?: number; toolCallId?: string; toolName?: string; isError?: boolean; stopReason?: string; role?: string; timestamp?: string; boundary?: "compaction" | "reset" | "branch";
+}
+export interface HistoryCut {
+  sourceBindingStatus: "worker" | "catalog"; catalogBinding?: { sourceId: string; instanceId: string; nativeSessionId: string; reference: string };
+  sourceId: string; sessionId: string; workerId: string; contextId: string;
+  contentRevision: string; leafId: string | null; observationSeq: number;
+}
+export interface HistoryOpen {
+  version: "coherent-history-v1"; snapshot: string; cursor: string; scope: HistoryScope; cut: HistoryCut;
+  cursors: Record<HistoryScope, string>; expiresAt: number; count: number; streaming: boolean; compacting: boolean;
+  prefix: HistoryItem | null; scannedBytes: number; scanMs: number;
+  limits: Readonly<Record<keyof typeof HISTORY_LIMITS, number>>;
+}
+export interface HistoryPage {
+  snapshot: string; scope: HistoryScope; cut: HistoryCut; expiresAt: number; items: HistoryItem[];
+  complete: true; nextCursor?: string;
+}
+export interface HistoryContentPage {
+  snapshot: string; cut: HistoryCut; expiresAt: number; content: HistoryContent; encoding: "base64";
+  partIndex: number; data: string; nextCursor?: string;
+}
+export interface HistoryChange { seq: number; kind: string }
+export interface HistoryPoll { cut: HistoryCut; after: number; through: number; events: HistoryChange[]; hasMore: boolean }
+interface Runtime { messages: unknown[]; prefix?: unknown; streaming: boolean; compacting: boolean }
+interface ContentPosition { content: HistoryContent; data: string; offset: number }
+interface Snapshot { timer: ReturnType<typeof setTimeout>; contents: Map<string, ContentPosition>; open: HistoryOpen; rows: Record<HistoryScope, string[]>; bytes: number; cursors: Map<string, { scope: HistoryScope; offset: number }> }
+function record(value: unknown): Record<string, unknown> {
+  return typeof value === "object" && value !== null ? value as Record<string, unknown> : {};
+}
+function textContent(value: unknown): string {
+  if (typeof value === "string") return value;
+  if (!Array.isArray(value)) return "";
+  return value.map(part => {
+    const block = record(part);
+    if (block.type === "text" && typeof block.text === "string") return block.text;
+    if (block.type === "thinking" && typeof block.thinking === "string") return `[Thinking] ${block.thinking}`;
+    if (block.type === "toolCall") return `[Tool call: ${typeof block.name === "string" ? block.name : "unknown"}]`;
+    if (block.type === "image") return "[Retained native image available; original association unproven]";
+    return "[Unsupported content block]";
+  }).join("\n");
+}
+function readableMessage(value: unknown, content?: (value: unknown) => HistoryContent[]): Pick<HistoryItem, "text" | "role" | "contents" | "toolCallId" | "toolName" | "isError" | "stopReason"> {
+  const message = record(value);
+  const role = typeof message.role === "string" ? message.role : "unknown";
+  if (role === "fileMention") {
+    const files = Array.isArray(message.files) ? message.files.map(record) : [];
+    return { role, text: files.map(file => `[File mention: ${typeof file.path === "string" ? file.path : "unknown"}]\n` +
+      (typeof file.content === "string" ? file.content : "") +
+      (typeof file.skippedReason === "string" ? `\n[Native unavailable: ${file.skippedReason}]` : "") +
+      (file.image ? "\n[Retained native image; original association unproven]" : "")).join("\n"),
+      ...(content ? { contents: content(files.flatMap(file => file.image ? [file.image] : [])) } : {}) };
+  }
+  if (role === "branchSummary" || role === "compactionSummary") return { role, text: typeof message.summary === "string" ? message.summary : "[Native summary]" };
+  if (["user", "assistant", "toolResult", "custom", "hookMessage"].includes(role)) {
+    if ((role === "custom" || role === "hookMessage") && message.display !== true) return { text: "[Internal custom message]" };
+    return { role, text: (textContent(message.content) || `[${role}]`) +
+      (typeof message.errorMessage === "string" ? `\n[Native error: ${message.errorMessage}]` : ""),
+      ...(typeof message.toolCallId === "string" ? {toolCallId:message.toolCallId} : {}),
+      ...(typeof message.toolName === "string" ? {toolName:message.toolName} : {}),
+      ...(typeof message.isError === "boolean" ? {isError:message.isError} : {}),
+      ...(typeof message.stopReason === "string" ? {stopReason:message.stopReason} : {}),
+      ...(content ? { contents: content(message.content) } : {}) };
+  }
+  if (role === "bashExecution" || role === "pythonExecution") return { role,
+    text: typeof message.output === "string" ? message.output : "[Native execution]",
+    ...(content && Array.isArray(message.images) ? {contents:content(message.images)} : {}) };
+  return { text: "[Native message: unsupported display type]" };
+}
+/** The whitelist deliberately never spreads native entries, custom state, provider metadata or config. */
+function readableEntry(value: unknown, active: Set<string>, content: (value: unknown) => HistoryContent[]): HistoryItem {
+  const entry = record(value);
+  const id = String(entry.id);
+  const item: HistoryItem = { id, parentId: typeof entry.parentId === "string" ? entry.parentId : null,
+    kind: String(entry.type), active: active.has(id), text: "[Native structural record]" };
+  if (typeof entry.timestamp === "string") item.timestamp = entry.timestamp;
+  if (entry.type === "message") Object.assign(item, readableMessage(entry.message, content));
+  if (entry.type === "custom_message") {
+    item.text = entry.display === true ? textContent(entry.content) : "[Internal custom message]";
+    if (entry.display === true) item.contents = content(entry.content);
+  }
+  if (entry.type === "compaction" || entry.type === "branch_summary") {
+    item.boundary = entry.type === "compaction" ? "compaction" : "branch";
+    item.text = typeof entry.summary === "string" ? entry.summary : "[Native summary]";
+  }
+  if (entry.type === "reset_boundary") { item.boundary = "reset"; item.text = "[Native context reset]"; }
+  return item;
+}
+
+/** One registry per worker, installed before live forwarding; later settlement can extend observe(). */
+export class RpcHistoryObservation {
+  readonly #workerId = randomUUID();
+  readonly #manager: SessionManager;
+  readonly #runtime: () => Runtime;
+  readonly #snapshots = new Map<string, Snapshot>();
+  readonly #events: HistoryChange[] = [];
+  #seq = 0;
+  #liveBytes = 0;
+  #lastRevision: string | undefined;
+  constructor(manager: SessionManager, runtime: () => Runtime) {
+    this.#manager = manager; this.#runtime = runtime;
+    manager.subscribeHistoryChanges(change => this.observe({ type: `native_${change.kind}` }));
+  }
+
+  /** Observe before any output filter. Bounded journal gaps are observable, never synthesized as empty success. */
+  observe(event: { type: string }): void {
+    const change = { seq: ++this.#seq, kind: event.type };
+    this.#events.push(change);
+    this.#liveBytes += Buffer.byteLength(JSON.stringify(change));
+    while (this.#events.length > HISTORY_LIMITS.liveEvents || this.#liveBytes > HISTORY_LIMITS.liveBytes) {
+      this.#liveBytes -= Buffer.byteLength(JSON.stringify(this.#events.shift()));
+    }
+  }
+  #capture(materialize = true) {
+    const value = this.#manager.captureHistoryObservation(this.#runtime(), HISTORY_LIMITS, materialize);
+    if (value.contentRevision !== this.#lastRevision) {
+      this.observe({ type: "native_content_changed" });
+      this.#lastRevision = value.contentRevision;
+    }
+    const contextId = createHash("sha256").update(JSON.stringify({ source: value.sourceId,
+      contextRevision: value.contextRevision })).digest("hex");
+    const cut: HistoryCut = { sourceBindingStatus: value.sourceBinding ? "catalog" : "worker",
+      ...(value.sourceBinding ? { catalogBinding: { ...value.sourceBinding } } : {}), sourceId: value.sourceId, sessionId: value.sessionId,
+      workerId: this.#workerId, contextId, contentRevision: value.contentRevision,
+      leafId: value.leafId, observationSeq: this.#seq };
+    return { ...value, cut };
+  }
+  open(scope: HistoryScope): HistoryOpen {
+    const started = performance.now();
+    if (!["tree", "active", "running"].includes(scope)) throw new Error("history_invalid_scope");
+    const value = this.#capture();
+    const known = new Set(["message", "model_usage", "thinking_level_change", "model_change", "service_tier_change",
+      "compaction", "branch_summary", "custom", "custom_message", "label", "title_change", "ttsr_injection",
+      "session_init", "mode_change", "credential_pin", "reset_boundary"]);
+    for (const entry of value.entries) {
+      if (!known.has(entry.type)) throw new Error("history_unknown_entry");
+      if (typeof entry.id !== "string" || entry.id.length > 256 || entry.id.length === 0 ||
+        (entry.parentId !== null && typeof entry.parentId !== "string")) throw new Error("history_invalid_entry");
+    }
+    const indexed = new Map(value.entries.map(entry => [entry.id, entry]));
+    if (indexed.size !== value.entries.length) throw new Error("history_duplicate_entry");
+    for (const entry of value.entries) {
+      if (entry.parentId !== null && !indexed.has(entry.parentId)) throw new Error("history_missing_parent");
+    }
+    const completed = new Set<string>();
+    for (const entry of value.entries) {
+      const path = new Set<string>(); let cursor: string | null = entry.id;
+      while (cursor !== null && !completed.has(cursor)) {
+        if (path.has(cursor)) throw new Error("history_parent_cycle");
+        path.add(cursor); cursor = indexed.get(cursor)!.parentId;
+      }
+      for (const id of path) completed.add(id);
+    }
+    const active = new Set<string>();
+    let next = value.leafId;
+    while (next !== null) {
+      if (active.has(next)) throw new Error("history_parent_cycle");
+      const entry = indexed.get(next);
+      if (!entry) throw new Error("history_missing_leaf");
+      active.add(next); next = entry.parentId;
+    }
+    const contents = new Map<string, ContentPosition>();
+    const contentByDigest = new Map<string, HistoryContent>();
+    let contentBytes = 0;
+    const registerContent = (value: unknown): HistoryContent[] => {
+      if (!Array.isArray(value)) return [];
+      return value.flatMap(block => {
+        const image = record(block);
+        if (image.type !== "image") return [];
+        if (typeof image.data !== "string" || typeof image.mimeType !== "string") throw new Error("history_content_invalid");
+        if (!["image/png", "image/jpeg", "image/webp", "image/gif"].includes(image.mimeType)) throw new Error("history_content_mime");
+        const decoded = Buffer.from(image.data, "base64");
+        if (decoded.toString("base64") !== image.data) throw new Error("history_content_invalid");
+        const sha256 = createHash("sha256").update(decoded).digest("hex");
+        const key = `${image.mimeType}:${sha256}`;
+        const existing = contentByDigest.get(key);
+        if (existing) return [existing];
+        if (contents.size >= HISTORY_LIMITS.contentItems) throw new Error("history_content_items");
+        const content: HistoryContent = { cursor: randomUUID(), mimeType: image.mimeType, bytes: decoded.byteLength,
+          sha256, origin: "retained_native", originalAssociation: "unproven" };
+        contents.set(content.cursor, { content, data: image.data, offset: 0 });
+        contentByDigest.set(key, content); contentBytes += Buffer.byteLength(image.data);
+        return [content];
+      });
+    };
+    const split = (item: HistoryItem): string[] => {
+      // Fixed UTF-16 slices preserve every code unit, including escaped text. No dropped tail.
+      const width = 32 * 1024;
+      const count = Math.max(1, Math.ceil(item.text.length / width));
+      return Array.from({ length: count }, (_, partIndex) => JSON.stringify({ ...item,
+        id: partIndex === 0 ? item.id : `${item.id}:part:${partIndex}`, entryId: item.id,
+        partIndex, partCount: count, text: item.text.slice(partIndex * width, (partIndex + 1) * width) }));
+    };
+    const encodedById = new Map(value.entries.map(entry => [entry.id, split(readableEntry(entry, active, registerContent))]));
+    const tree = value.entries.flatMap(entry => encodedById.get(entry.id)!);
+    const activeRows = [...active].reverse().flatMap(id => encodedById.get(id)!);
+    const running = value.runtime.messages.flatMap((message, index) => split({
+      id: `running-${index}`, parentId: null, active: false, kind: "running", ...readableMessage(message, registerContent),
+    }));
+    const prefixItem: HistoryItem | null = value.runtime.prefix === null ? null : { id: "running-prefix", parentId: null,
+      kind: "running_prefix", active: false, ...readableMessage(value.runtime.prefix, registerContent) };
+    if (prefixItem) running.push(...split(prefixItem));
+    // Active rows share exactly the tree's encoded strings. Count retained storage once.
+    const bytes = contentBytes + [...tree, ...running].reduce((sum, row) => sum + Buffer.byteLength(row), 0);
+    if (bytes > HISTORY_LIMITS.snapshotBytes) throw new Error("history_snapshot_bytes");
+    if ([...tree, ...running].some(row => Buffer.byteLength(row) > HISTORY_LIMITS.itemBytes)) throw new Error("history_item_bytes");
+    const snapshot = randomUUID();
+    const cursors = { tree: randomUUID(), active: randomUUID(), running: randomUUID() };
+    const cursor = cursors[scope];
+    const prefix = prefixItem && { id: prefixItem.id, parentId: null, kind: "running_prefix", active: false,
+      text: "[Running prefix content is available through this snapshot's running cursor]" };
+    const rows = { tree, active: activeRows, running };
+    const open: HistoryOpen = { version: "coherent-history-v1", snapshot, cursor, cursors, scope, cut: value.cut,
+      expiresAt: Date.now() + HISTORY_LIMITS.ttlMs, count: rows[scope].length, streaming: value.runtime.streaming,
+      compacting: value.runtime.compacting, prefix, scannedBytes: value.scannedBytes, scanMs: value.scanMs, limits: HISTORY_LIMITS };
+    if (performance.now() - started > HISTORY_LIMITS.ms) throw new Error("history_snapshot_deadline");
+    this.#expire();
+    let total = bytes;
+    for (const prior of this.#snapshots.values()) total += prior.bytes;
+    if (this.#snapshots.size >= HISTORY_LIMITS.snapshots || total > HISTORY_LIMITS.cacheBytes) throw new Error("history_cache_full");
+    const timer = setTimeout(() => { this.#snapshots.delete(snapshot); }, HISTORY_LIMITS.ttlMs);
+    timer.unref();
+    this.#snapshots.set(snapshot, { timer, contents, open: structuredClone(open), rows, bytes, cursors: new Map(Object.entries(cursors).map(([scope, cursor]) => [cursor, { scope: scope as HistoryScope, offset: 0 }])) });
+    return structuredClone(open);
+  }
+  #expire(): void {
+    for (const [id, snapshot] of this.#snapshots) if (Date.now() >= snapshot.open.expiresAt) { clearTimeout(snapshot.timer); this.#snapshots.delete(id); }
+  }
+  page(cursor: string): HistoryPage {
+    this.#expire();
+    const snapshot = [...this.#snapshots.values()].find(value => value.cursors.has(cursor));
+    if (!snapshot) throw new Error("history_stale_cursor");
+    if (this.#capture(false).cut.contentRevision !== snapshot.open.cut.contentRevision) throw new Error("history_changed");
+    const position = snapshot.cursors.get(cursor)!;
+    const start = position.offset;
+    const rows = snapshot.rows[position.scope];
+    const result: HistoryPage = { snapshot: snapshot.open.snapshot, scope: position.scope,
+      cut: structuredClone(snapshot.open.cut), expiresAt: snapshot.open.expiresAt, items: [], complete: true };
+    let index = start;
+    let used = Buffer.byteLength(JSON.stringify(result)) + 1024;
+    while (index < rows.length && result.items.length < HISTORY_LIMITS.pageItems) {
+      const encoded = rows[index];
+      const size = Buffer.byteLength(encoded) + (result.items.length === 0 ? 0 : 1);
+      if (used + size > HISTORY_LIMITS.pageBytes) break;
+      result.items.push(JSON.parse(encoded)); used += size; index++;
+    }
+    if (index === start && index < rows.length) throw new Error("history_unpageable_item");
+    if (index < rows.length) {
+      const existing = [...snapshot.cursors].find(([, value]) => value.scope === position.scope && value.offset === index);
+      const next = existing?.[0] ?? randomUUID();
+      snapshot.cursors.set(next, { scope: position.scope, offset: index }); result.nextCursor = next;
+    }
+    if (Buffer.byteLength(JSON.stringify(result)) + 1024 > HISTORY_LIMITS.responseBytes) throw new Error("history_response_bytes");
+    return result;
+  }
+  contentPage(cursor: string): HistoryContentPage {
+    this.#expire();
+    const snapshot = [...this.#snapshots.values()].find(value => value.contents.has(cursor));
+    if (!snapshot) throw new Error("history_stale_content_cursor");
+    if (this.#capture(false).cut.contentRevision !== snapshot.open.cut.contentRevision) throw new Error("history_changed");
+    const position = snapshot.contents.get(cursor)!;
+    const end = Math.min(position.data.length, position.offset + HISTORY_LIMITS.contentPageBytes);
+    const page: HistoryContentPage = { snapshot: snapshot.open.snapshot, cut: structuredClone(snapshot.open.cut),
+      expiresAt: snapshot.open.expiresAt, content: structuredClone(position.content), encoding: "base64",
+      partIndex: position.offset / HISTORY_LIMITS.contentPageBytes, data: position.data.slice(position.offset, end) };
+    if (end < position.data.length) {
+      const existing = [...snapshot.contents].find(([, value]) => value.content.cursor === position.content.cursor && value.offset === end);
+      const next = existing?.[0] ?? randomUUID();
+      snapshot.contents.set(next, { ...position, offset: end }); page.nextCursor = next;
+    }
+    return page;
+  }
+  close(snapshot: string): { closed: boolean } {
+    const value = this.#snapshots.get(snapshot); if (value) clearTimeout(value.timer);
+    return { closed: this.#snapshots.delete(snapshot) };
+  }
+  poll(workerId: string, after: number): HistoryPoll {
+    const { cut } = this.#capture(false);
+    if (workerId !== this.#workerId || !Number.isSafeInteger(after) || after < 0 || after > this.#seq) throw new Error("history_stale_observation");
+    if (after < (this.#events[0]?.seq ?? this.#seq + 1) - 1) throw new Error("history_observation_gap");
+    const events = this.#events.filter(event => event.seq > after).slice(0, HISTORY_LIMITS.pollItems);
+    const through = events.at(-1)?.seq ?? after;
+    return { cut, after, through, events: structuredClone(events), hasMore: through < this.#seq };
+  }
+}
