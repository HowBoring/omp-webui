+/** Coherent native observation v1: safe readable history, never a provider-input or durability audit. */
+export const historyDefs = {
+  HistoryScope: "'tree' | 'active' | 'running'",
+  HistoryItem: { id: "string", parentId: "string | null", kind: "string", active: "boolean", text: "string",
+    "entryId?": "string", "partIndex?": "number.integer", "partCount?": "number.integer", "role?": "string", "timestamp?": "string", "boundary?": "'compaction' | 'reset' | 'branch'" },
+  HistoryCut: { sourceId: "string", sessionId: "string", workerId: "string", contextId: "string",
+    contentRevision: "string", leafId: "string | null", observationSeq: "number.integer" },
+  HistoryLimits: { entries: "number.integer", bytes: "number.integer", nativeItemBytes: "number.integer", itemBytes: "number.integer", ms: "number.integer",
+    snapshotBytes: "number.integer", cacheBytes: "number.integer", snapshots: "number.integer", pageItems: "number.integer",
+    pageBytes: "number.integer", responseBytes: "number.integer", ttlMs: "number.integer", liveEvents: "number.integer",
+    liveBytes: "number.integer", pollItems: "number.integer" },
+  HistoryOpen: { version: "'coherent-history-v1'", snapshot: "string", cursor: "string", scope: "HistoryScope", cut: "HistoryCut",
+    cursors: { tree: "string", active: "string", running: "string" }, expiresAt: "number.integer", count: "number.integer", streaming: "boolean", compacting: "boolean", prefix: "HistoryItem | null",
+    scannedBytes: "number.integer", scanMs: "number", limits: "HistoryLimits" },
+  HistoryPage: { snapshot: "string", scope: "HistoryScope", cut: "HistoryCut", expiresAt: "number.integer", items: "HistoryItem[]",
+    complete: "true", "nextCursor?": "string" },
+  HistoryChange: { seq: "number.integer", kind: "string" },
+  HistoryPoll: { cut: "HistoryCut", after: "number.integer", through: "number.integer", events: "HistoryChange[]", hasMore: "boolean" },
+};
+export const historyCommands = [
+  { name: "history_snapshot_open", doc: "Atomic native retained-tree/active-chain/running-message observation, with bounded live watermark.",
+    params: { scope: "HistoryScope" }, result: "HistoryOpen" },
+  { name: "history_snapshot_page", doc: "Immutable, source/version/scope/expiry-bound native history page; any source change rejects old cursor.",
+    params: { cursor: "string" }, result: "HistoryPage" },
+  { name: "history_snapshot_close", doc: "Release one native snapshot without changing history.",
+    params: { snapshot: "string" }, result: { closed: "boolean" } },
+  { name: "history_observation_poll", doc: "Bounded observation journal after a worker cut; explicit gaps require new snapshot.",
+    params: { workerId: "string", after: "number.integer" }, result: "HistoryPoll" },
+] as const;
