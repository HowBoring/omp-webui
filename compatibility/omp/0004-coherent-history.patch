+    pageBytes: "number.integer", responseBytes: "number.integer", ttlMs: "number.integer", contentItems: "number.integer", contentPageBytes: "number.integer", liveEvents: "number.integer",
+    liveBytes: "number.integer", pollItems: "number.integer" },
+  HistoryCursors: { tree: "string", active: "string", running: "string" },
+  HistoryOpen: { version: "'coherent-history-v1'", snapshot: "string", cursor: "string", scope: "HistoryScope", cut: "HistoryCut",
+    cursors: "HistoryCursors", expiresAt: "number.integer", count: "number.integer", streaming: "boolean", compacting: "boolean", prefix: "HistoryItem | null",
+    scannedBytes: "number.integer", scanMs: "number", limits: "HistoryLimits" },
