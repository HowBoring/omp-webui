@@ -0,0 +1,117 @@
+export * from "./rpc-interaction-policy";
+export type RpcUIReplyStatus = "answered" | "cancelled" | "expired" | "invalid" | "stale";
+export type RpcUIAnswer =
+	| { type: "value"; value: string }
+	| { type: "confirm"; confirmed: boolean }
+	| { type: "cancel"; timedOut?: boolean }
+	| { type: "ask"; answers: Array<{ id: string; selectedOptions: string[]; customInput?: string }> };
+export function rpcUIAnswerFrame(targetId: string, answer: RpcUIAnswer): RpcExtensionUIResponse {
+	const base = { type: "extension_ui_response" as const, id: targetId };
+	switch (answer.type) {
+		case "value": return { ...base, value: answer.value };
+		case "confirm": return { ...base, confirmed: answer.confirmed };
+		case "ask": return { ...base, answers: answer.answers };
+		case "cancel": return { ...base, cancelled: true,
+			...(answer.timedOut === undefined ? {} : { timedOut: answer.timedOut }) };
+	}
+}
+export interface RpcUIReplyResult { status: RpcUIReplyStatus }
+
+import { toError } from "@oh-my-pi/pi-utils/type-guards";
+import { Snowflake } from "@oh-my-pi/pi-utils/snowflake";
+import { EXPLICIT_INTERACTION_EXPIRY_REASON, type ExtensionUIDialogOptions } from "../../extensibility/extensions/types";
+import type { RpcExtensionUIResponse } from "./rpc-types";
+
+export interface RpcPendingUIRequest {
+	resolve(response: RpcExtensionUIResponse): RpcUIReplyResult | void;
+	reject(error: Error): void;
+	cancel?(reason: "cancelled" | "expired" | "aborted"): void;
+}
+
+/** Validate the discriminated response before parsing or releasing a pending request. */
+function validResponse(response: RpcExtensionUIResponse, request: Record<string, unknown>): boolean {
+	const payload: Record<string, unknown> = { ...response };
+	const keys = Object.keys(payload).filter(key => key !== "type" && key !== "id");
+	if (payload.cancelled === true) {
+		return keys.every(key => ["cancelled", "timedOut"].includes(key)) &&
+			(payload.timedOut === undefined || typeof payload.timedOut === "boolean");
+	}
+	if (request.method === "ask") return keys.length === 1 && keys[0] === "answers";
+	if (request.method === "confirm") {
+		return keys.length === 1 && keys[0] === "confirmed" && typeof payload.confirmed === "boolean";
+	}
+	if (keys.length !== 1 || keys[0] !== "value" || typeof payload.value !== "string") return false;
+	return request.method !== "select" || (Array.isArray(request.options) && request.options.includes(payload.value));
+}
+
+/**
+ * All rpc-ui dialog kinds share one first-valid settlement. Invalid replies keep
+ * the original deadline; deadline checks win even if the timer callback is late.
+ */
+export function requestExplicitRpcDialog<T>(
+	pending: Map<string, RpcPendingUIRequest>, output: (frame: object) => void,
+	opts: ExtensionUIDialogOptions | undefined, cancelledValue: T,
+	request: Record<string, unknown>, parse: (response: RpcExtensionUIResponse) => T,
+): Promise<T> {
+	const signal = opts?.signal;
+	if (signal?.aborted) return Promise.resolve(cancelledValue);
+	const id = Snowflake.next() as string;
+	const { promise, resolve, reject } = Promise.withResolvers<T>();
+	const relative = opts?.timeout === undefined ? undefined : performance.now() + Math.max(0, opts.timeout);
+	const absolute = opts?.deadlineMonotonicMs;
+	if (absolute !== undefined && !Number.isFinite(absolute)) return Promise.reject(new Error("Invalid dialog deadline"));
+	const deadline = absolute === undefined ? relative : relative === undefined ? absolute : Math.min(absolute, relative);
+	let timer: NodeJS.Timeout | undefined;
+	let settled = false;
+	const cleanup = () => {
+		settled = true;
+		clearTimeout(timer);
+		signal?.removeEventListener("abort", onAbort);
+		pending.delete(id);
+	};
+	const fail = (error: Error) => {
+		if (settled) return;
+		cleanup(); reject(error);
+	};
+	const cancel = (reason: "cancelled" | "expired" | "aborted") => {
+		if (settled) return;
+		cleanup();
+		resolve(cancelledValue);
+		output({ type: "extension_ui_request", id: Snowflake.next() as string, method: "cancel", targetId: id, reason });
+		if (reason === "expired") opts?.onTimeout?.();
+	};
+	const onAbort = () => cancel(signal?.reason === EXPLICIT_INTERACTION_EXPIRY_REASON ? "expired" : "aborted");
+	signal?.addEventListener("abort", onAbort, { once: true });
+	pending.set(id, {
+		cancel,
+		resolve: response => {
+			if (settled) return { status: "stale" };
+			if (deadline !== undefined && performance.now() >= deadline) {
+				cancel("expired"); return { status: "expired" };
+			}
+			if (!validResponse(response, request)) return { status: "invalid" };
+			if ("cancelled" in response && response.cancelled) {
+				const status = response.timedOut ? "expired" : "cancelled";
+				cancel(status); return { status };
+			}
+			let value: T;
+			try { value = parse(response); } catch { return { status: "invalid" }; }
+			cleanup();
+			resolve(value);
+			return { status: "answered" };
+		},
+		reject: fail,
+	});
+	if (settled) return promise;
+	if (deadline !== undefined) timer = setTimeout(() => cancel("expired"), Math.max(0, deadline - performance.now()));
+	try {
+		output({ type: "extension_ui_request", id, ...request,
+		...(deadline === undefined ? {} : { timeout: Math.max(0, Math.floor(deadline - performance.now())) }) });
+	} catch (error) { fail(toError(error)); }
+	return promise;
+}
+
+/** Only extension UI requests are eligible; host tool/URI ID spaces stay separate. */
+export function replyRpcInteraction(pending: Map<string, RpcPendingUIRequest>, response: RpcExtensionUIResponse): RpcUIReplyResult {
+	return pending.get(response.id)?.resolve(response) ?? { status: "stale" };
+}
