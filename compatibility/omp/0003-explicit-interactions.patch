+/** Effective for every rpc-ui request, before extension initialization or native timers. */
+export const rpcInteractionPolicy = Object.freeze({
+	version: "1" as const,
+	explicitAnswersOnly: true as const,
+	nativeExpiry: "cancel" as const,
+	toolExpiry: "cancel" as const,
+	invalidAnswer: "pending" as const,
+});
+export type RpcInteractionPolicy = typeof rpcInteractionPolicy;
