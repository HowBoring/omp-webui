+	UIConfirmAnswer: { type: "'confirm'", confirmed: "boolean" },
+	UICancelAnswer: { type: "'cancel'", "timedOut?": "boolean" },
+	UIAskAnswer: { type: "'ask'", answers: "AskAnswer[]" },
+	UIAnswer: "UIValueAnswer | UIConfirmAnswer | UICancelAnswer | UIAskAnswer",
+	UIReplyResult: { status: "'answered' | 'cancelled' | 'expired' | 'invalid' | 'stale'" },
+} satisfies WireDefs;
+
+export const interactionCommands: readonly RpcCommandSpec[] = [
+	{
+		name: "get_interaction_policy",
