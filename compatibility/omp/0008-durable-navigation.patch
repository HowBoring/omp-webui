diff --git a/packages/coding-agent/src/modes/rpc/rpc-navigation.ts b/packages/coding-agent/src/modes/rpc/rpc-navigation.ts
new file mode 100644
index 0000000000..38496e6545
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-navigation.ts
@@ -0,0 +1,141 @@
+/** Narrow recoverable navigation coordinator; OMP owns all conversation and tree state. */
+import type { AgentSession, NavigateTreeResult } from "../../session/agent-session";
+import type { NativeNavigation } from "../../session/navigation-records";
+import { validNavigationCommand } from "./navigation.generated";
+import type { NavigationResult, NavigationPreview, RpcWireCommands, SubmissionTarget } from "./wire/rpc-wire.generated";
+export type NavigationCommand = { [K in "navigate_tree_committed" | "navigation_query" | "navigation_inspect"]:
+  { id?: string; type: K } & RpcWireCommands[K]["params"] }["navigate_tree_committed" | "navigation_query" | "navigation_inspect"];
+export type NavigationSubmit = Extract<NavigationCommand, { type: "navigate_tree_committed" }>;
+interface NavigationFailure { persistence: "failed" | "unknown"; code: string }
+export class RpcNavigation {
+  #target: SubmissionTarget | undefined;
+  readonly #failures = new Map<string, NavigationFailure>();
+  constructor(readonly session: AgentSession) {
+    try { this.#target = session.sessionManager.getSubmissionTarget(); } catch { /* Protected capability unavailable. */ }
+  }
+  validate(value: unknown): void {
+    if (!validNavigationCommand(value)) throw new Error("NAVIGATION_COMMAND_SCHEMA");
+    if (value.type === "navigation_inspect") {
+      if (value.entryId.length < 1 || value.entryId.length > 128) throw new Error("NAVIGATION_COMMAND_SCHEMA");
+      return;
+    }
+    if (!/^[A-Za-z0-9_-]{1,96}$/.test(value.navigationId) || (value.id !== undefined && value.id.length > 96))
+      throw new Error("NAVIGATION_COMMAND_SCHEMA");
+    if (value.type === "navigation_query") return;
+    if (!/^[a-f0-9]{64}$/.test(value.sourceId) || !/^[a-f0-9]{64}$/.test(value.instanceId)
+      || value.entryId.length < 1 || value.entryId.length > 128 || value.nativeSessionId.length < 1
+      || value.nativeSessionId.length > 128 || Buffer.byteLength(value.customInstructions ?? "") > 16384)
+      throw new Error("NAVIGATION_COMMAND_SCHEMA");
+  }
+  /** Rechecked under the native transition before hooks and again after every awaited hook/summary. */
+  validateCurrent(value: NativeNavigation): void {
+    const manager = this.session.sessionManager, target = manager.getSubmissionTarget();
+    // The read verifies the held current header/cwd and namespace without executing or repairing.
+    manager.assertNavigationSource();
+    if (target.sourceId !== value.origin.sourceId || target.instanceId !== value.origin.instanceId
+      || target.nativeSessionId !== value.origin.nativeSessionId) throw new Error("NAVIGATION_TARGET_CHANGED");
+    const entry = manager.navigationTarget(value.result.requestedTargetId!);
+    if (entry.targetRevision !== value.result.targetRevision)
+      throw new Error("NAVIGATION_STALE_TARGET");
+  }
+  inspect(entryId: string): NavigationPreview {
+    this.validate({ type: "navigation_inspect", entryId });
+    const manager = this.session.sessionManager, target = manager.getSubmissionTarget();
+    const entry = manager.navigationTarget(entryId);
+    return { version: "durable-navigation-v1", target, entryId, targetParentId: entry.parentId,
+      targetRevision: entry.targetRevision, contextRevision: manager.navigationContextRevision() };
+  }
+  async reserve(command: NavigationSubmit): Promise<{ admitted: boolean; value: NativeNavigation; executionContextRevision?: string }> {
+    this.validate(command);
+    const manager = this.session.sessionManager, target = manager.getSubmissionTarget();
+    this.#target = target;
+    manager.assertNavigationSource();
+    if (target.sourceId !== command.sourceId || target.instanceId !== command.instanceId
+      || target.nativeSessionId !== command.nativeSessionId) throw new Error("NAVIGATION_TARGET_MISMATCH");
+    const origin = { ...target, navigationId: command.navigationId }, prior = manager.readNavigation(command.navigationId);
+    // A lost reply or an inherited fact is resolved before looking at today's target/context. Never replay it.
+    const preview = prior ? undefined : this.inspect(command.entryId);
+    const targetRevision = prior?.result.targetRevision ?? preview!.targetRevision;
+    const fingerprint = Bun.SHA256.hash(JSON.stringify({ origin, entryId: command.entryId, targetRevision,
+      expectedTargetRevision: command.expectedTargetRevision ?? null,
+      expectedContextRevision: command.expectedContextRevision ?? null, summarize: command.summarize === true,
+      customInstructions: command.customInstructions ?? null }), "hex");
+    if (prior) {
+      if (JSON.stringify(prior.origin) !== JSON.stringify(origin) || prior.fingerprint !== fingerprint)
+        throw new Error("NAVIGATION_CONFLICT");
+      return { admitted: false, value: prior };
+    }
+    if (!preview) throw new Error("NAVIGATION_PREVIEW_UNAVAILABLE");
+    if (command.expectedTargetRevision !== undefined && command.expectedTargetRevision !== preview.targetRevision)
+      throw new Error("NAVIGATION_STALE_TARGET");
+    if (command.expectedContextRevision !== undefined && command.expectedContextRevision !== preview.contextRevision)
+      throw new Error("NAVIGATION_STALE_CONTEXT");
+    const value: NativeNavigation = { origin, fingerprint, result: { version: "durable-navigation-v1",
+      navigationId: command.navigationId, target, found: true, duplicate: false, admission: "local", origin,
+      outcome: "reserved", reservation: "committed", persistence: "unresolved", terminal: false,
+      requestedTargetId: preview.entryId, targetParentId: preview.targetParentId,
+      targetRevision: preview.targetRevision, contextRevision: preview.contextRevision } };
+    const admitted = await manager.reserveNavigation(value);
+    return { admitted, value, executionContextRevision: manager.navigationContextRevision() };
+  }
+  validateReservedContext(value: NativeNavigation, revision: string | undefined): void {
+    this.validateCurrent(value);
+    if (!revision || this.session.sessionManager.navigationContextRevision() !== revision)
+      throw new Error("NAVIGATION_STALE_CONTEXT");
+  }
+  async complete(value: NativeNavigation, result: NavigateTreeResult): Promise<NavigationResult> {
+    this.validateCurrent(value);
+    return this.#publish(value, {
+      outcome: result.reopenAsk ? "unsupported" : result.aborted ? "aborted" : result.cancelled ? "cancelled" : "committed",
+      ...(result.reopenAsk ? { code: "ask_reanswer_unsupported" } : {}),
+      ...(result.summaryEntry ? { summaryEntryId: result.summaryEntry.id,
+        summaryOrigin: result.summaryEntry.fromExtension ? "extension" : "native" } : {}),
+      ...(result.editorText === undefined ? {} : { draftOriginEntryId: value.result.requestedTargetId,
+        draftContentRevision: value.result.targetRevision,
+        ...(Buffer.byteLength(result.editorText) <= 65536 ? { editorText: result.editorText, draftStatus: "inline" as const }
+          : { draftStatus: "reference_only" as const, draftUnavailableReason: "draft_exceeds_inline_limit" }) }),
+      hookCompleted: result.navigationHooks?.treeHookCompleted ?? false,
+      beforeHookInvoked: result.navigationHooks?.beforeHookInvoked ?? false,
+      beforeHookCompleted: result.navigationHooks?.beforeHookCompleted ?? false,
+      treeHookInvoked: result.navigationHooks?.treeHookInvoked ?? false,
+      hookChangedLeaf: result.navigationHooks?.changedLeaf ?? false,
+    });
+  }
+  async #publish(value: NativeNavigation, facts: Partial<NavigationResult>): Promise<NavigationResult> {
+    await this.session.sessionManager.completeNavigation({ ...value, result: { ...value.result, ...facts,
+      persistence: "committed", terminal: true } });
+    return this.query(value.origin.navigationId);
+  }
+  /** Execution failure can coexist with durable hook effects; publication failures never trigger repair/retry. */
+  async failed(value: NativeNavigation, failure: unknown, publicationStarted: boolean): Promise<NavigationResult> {
+    const message = failure instanceof Error ? failure.message : "NAVIGATION_FAILURE";
+    const code = /^[A-Z][A-Z0-9_]+$/.test(message) ? message : "NAVIGATION_EXECUTION_FAILED";
+    if (!publicationStarted) {
+      try { return await this.#publish(value, { outcome: "failed", code, hookCompleted: false }); }
+      catch (publicationFailure) { failure = publicationFailure; }
+    }
+    const publicationCode = failure instanceof Error ? failure.message : "NAVIGATION_FAILURE";
+    this.#failures.set(value.origin.navigationId, { persistence: /UNKNOWN|INDETERMINATE|BINDING|SOURCE|IDENTITY|HEADER|CWD/.test(publicationCode)
+      ? "unknown" : "failed", code: publicationCode });
+    return this.query(value.origin.navigationId);
+  }
+  query(navigationId: string, duplicate = false): NavigationResult {
+    this.validate({ type: "navigation_query", navigationId });
+    const manager = this.session.sessionManager;
+    let target = this.#target, value: NativeNavigation | undefined;
