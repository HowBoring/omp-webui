index 0000000000..81f5bd853d
--- /dev/null
+++ b/packages/coding-agent/src/session/navigation-records.ts
@@ -0,0 +1,99 @@
+import { nativeNavigationPolicy } from "./navigation-policy";
+import { validNavigationResult } from "../modes/rpc/navigation.generated";
+/** Navigation metadata is native control state, never a conversation entry or model message. */
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import * as util from "node:util";
+import { sessionEntryLeafId } from "./session-entries";
+import { isSubmissionControl } from "./submission-records";
+import type { CustomEntry, SessionEntry } from "./session-entries";
+import type { NavigationResult } from "../modes/rpc/wire/rpc-wire.generated";
+
+export const NAVIGATION_CONTROL = "omp.native-control/navigation-v1";
+export interface NativeNavigation {
+  origin: { sourceId: string; instanceId: string; nativeSessionId: string; navigationId: string };
+  fingerprint: string;
+  result: NavigationResult;
+}
+export function isNavigationControl(entry: SessionEntry): entry is CustomEntry {
+  return entry.type === "custom" && entry.customType === NAVIGATION_CONTROL;
+}
+function control(data: object): CustomEntry {
+  const checksum = Bun.SHA256.hash(JSON.stringify(data), "hex");
+  return { type: "custom", customType: NAVIGATION_CONTROL, id: `navigation-${checksum.slice(0, 32)}`,
+    parentId: null, activeLeafId: null, timestamp: "1970-01-01T00:00:00.000Z", data: { version: 1, payload: data, checksum } };
+}
+export function navigationRecord(value: NativeNavigation, applyPosition = false): CustomEntry {
+  return control({ kind: "receipt", value: structuredClone(value), applyPosition });
+}
+export function navigationPosition(leafId: string | null): CustomEntry {
+  return { ...control({ kind: "position", leafId }), parentId: leafId, activeLeafId: leafId };
+}
+function payload(entry: CustomEntry): Record<string, unknown> {
+  if (!isRecord(entry.data) || entry.data.version !== 1 || !isRecord(entry.data.payload)
+    || typeof entry.data.checksum !== "string"
+    || Bun.SHA256.hash(JSON.stringify(entry.data.payload), "hex") !== entry.data.checksum)
+    throw new Error("NAVIGATION_METADATA_CORRUPT");
+  return entry.data.payload;
+}
+/** Source, requested point and confirmation identities cannot change after reservation. */
+function sameBinding(left: NavigationResult, right: NavigationResult): boolean {
+  return util.isDeepStrictEqual(
+    [left.target, left.requestedTargetId, left.targetParentId, left.targetRevision, left.contextRevision],
+    [right.target, right.requestedTargetId, right.targetParentId, right.targetRevision, right.contextRevision],
+  );
+}
+/** Decode permanent facts; neither completion nor a later rewrite may replace their reserved target or final result. */
+export function readNavigationRecords(entries: SessionEntry[]): NativeNavigation[] {
+  const records = new Map<string, NativeNavigation>();
+  let bytes = 0;
+  for (const entry of entries) {
+    if (!isNavigationControl(entry)) continue;
+    const data = payload(entry);
+    bytes += Buffer.byteLength(JSON.stringify(entry));
+    if (bytes > 32 * 1024 * 1024) throw new Error("NAVIGATION_METADATA_LIMIT");
+    if (data.kind === "position") {
+      if (data.leafId !== null && typeof data.leafId !== "string") throw new Error("NAVIGATION_METADATA_CORRUPT");
+      continue;
+    }
+    const value = data.value;
+    if (data.kind !== "receipt" || typeof data.applyPosition !== "boolean" || !isRecord(value)
+      || !isRecord(value.origin) || typeof value.origin.navigationId !== "string"
+      || !/^[A-Za-z0-9_-]{1,96}$/.test(value.origin.navigationId)
+      || typeof value.origin.sourceId !== "string" || !/^[a-f0-9]{64}$/.test(value.origin.sourceId)
+      || typeof value.origin.instanceId !== "string" || !/^[a-f0-9]{64}$/.test(value.origin.instanceId)
+      || typeof value.origin.nativeSessionId !== "string" || typeof value.fingerprint !== "string"
+      || !/^[a-f0-9]{64}$/.test(value.fingerprint) || !validNavigationResult(value.result))
+      throw new Error("NAVIGATION_METADATA_CORRUPT");
+    const record = value as unknown as NativeNavigation;
+    if (record.result.navigationId !== record.origin.navigationId || !record.result.origin
+      || !util.isDeepStrictEqual(record.result.origin, record.origin)
+      || (data.applyPosition && (!record.result.terminal || record.result.actualLeafId === undefined)))
+      throw new Error("NAVIGATION_METADATA_CORRUPT");
+    const prior = records.get(record.origin.navigationId);
+    if (prior && (!util.isDeepStrictEqual(prior.origin, record.origin) || prior.fingerprint !== record.fingerprint
+      || !sameBinding(prior.result, record.result)
+      || (prior.result.terminal && !util.isDeepStrictEqual(prior.result, record.result))))
