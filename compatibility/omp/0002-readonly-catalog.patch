+/** Read-only catalog v1. No history, authorization, open or lease reservation. */
+export const catalogDefs = {
+  CatalogCwd: { status: "'known' | 'unknown' | 'missing' | 'inaccessible' | 'invalid'", "recorded?": "string", "canonical?": "string" },
+  CatalogOwnership: { state: "'held' | 'free' | 'unknown'", observedAt: "string" },
+  CatalogDescriptor: {
+    sourceId: "string", instanceId: "string", reference: "string", nativeSessionId: "string",
+    aliases: "string[]", cwd: "CatalogCwd", "title?": "string", createdAt: "string",
+    modifiedAt: "string", observedAt: "string", ownership: "CatalogOwnership",
+    "parentSession?": "string", "continuationOf?": "string",
+  },
+  CatalogFailure: { sourceId: "string", code: "string", "locator?": "string" },
+  CatalogSource: { sourceId: "string", kind: "'default' | 'custom'", aliases: "string[]", status: "'ready' | 'invalid'" },
+  CatalogBudgets: { scanEntriesPerRequest: "number.integer", scanEntriesPerSnapshot: "number.integer",
+    directoriesPerSnapshot: "number.integer", sessionsPerSnapshot: "number.integer", headerBytes: "number.integer",
+    pageItems: "number.integer", responseBytes: "number.integer", snapshotBytes: "number.integer",
+    snapshots: "number.integer", scanWindowMs: "number.integer", scanTotalMs: "number.integer", tokenTtlMs: "number.integer" },
+  CatalogSources: { version: "'readonly-catalog-v1'", profile: "string", sources: "CatalogSource[]", budgets: "CatalogBudgets" },
+  CatalogPage: { status: "'scanning' | 'complete' | 'partial'", snapshot: "string", observedAt: "string",
+    expiresAt: "string", items: "CatalogDescriptor[]", failures: "CatalogFailure[]", examined: "number.integer",
+    "nextCursor?": "string" },
+  CatalogDescription: { status: "'verified' | 'missing' | 'replaced' | 'invalid_reference' | 'source_unavailable' | 'inaccessible'",
+    observedAt: "string", "item?": "CatalogDescriptor" },
+};
+
+export const catalogCommands = [
+  { name: "catalog_sources", doc: "Readonly catalog v1 startup-selected profile and explicitly configured sources.", result: "CatalogSources" },
+  { name: "catalog_page", doc: "Bounded scan window or stable snapshot page. Expired/stale cursors must restart.",
+    params: { "cursor?": "string", "pageSize?": "number.integer" }, result: "CatalogPage" },
+  { name: "describe_session", doc: "Revalidate an existing native reference without opening, repair or ownership acquisition.",
+    params: { reference: "string" }, result: "CatalogDescription" },
+] as const;
