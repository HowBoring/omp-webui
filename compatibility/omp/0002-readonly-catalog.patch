index 00000000..db2b8454
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/catalog-path.ts
@@ -0,0 +1,24 @@
+/** Linux directory-descriptor walk: ancestor/leaf symlink swaps cannot redirect native reads. */
+import * as fs from "node:fs";
+import type { FileHandle } from "node:fs/promises";
+import * as nodePath from "node:path";
+import { relativePathWithinNormalizedRoot } from "@oh-my-pi/pi-utils/dirs";
+const hash = (text:string):string => Bun.SHA256.hash(text,"hex");
+
+export async function openWithin(root:string,rootIdentity:string,target:string,directory=false):Promise<FileHandle> {
+  if (process.platform !== "linux" || relativePathWithinNormalizedRoot(root,target) === null) throw new Error("UNSUPPORTED_SOURCE_PATH");
+  const parts = nodePath.relative(root,target).split("/").filter(Boolean);
+  let current:FileHandle|undefined = await fs.promises.open(root,fs.constants.O_RDONLY|fs.constants.O_DIRECTORY|fs.constants.O_NOFOLLOW);
+  try {
+    const info = await current.stat({bigint:true});
+    if (hash(`${info.dev}:${info.ino}:${info.birthtimeNs}`) !== rootIdentity) throw new Error("SOURCE_REPLACED");
+    for (const [index,part] of parts.entries()) {
+      if (part === ".." || part.includes("\0")) throw new Error("INVALID_SOURCE_PATH");
+      const flags = fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW|fs.constants.O_NONBLOCK
+        | (index < parts.length-1 || directory ? fs.constants.O_DIRECTORY:0);
+      const child = await fs.promises.open(`/proc/self/fd/${current.fd}/${part}`,flags);
+      await current.close(); current = child;
+    }
+    const result = current; current = undefined; return result;
+  } finally { if (current) await current.close(); }
+}
