+        if (snapshot.directories.some(item => item.source.sourceId === source.sourceId && item.path === target)) return;
+        const child = {source,path:target,depth:1}; snapshot.directories.push(child); snapshot.pending.push(child);
+      } else if (info.isFile() && name.endsWith(".jsonl")) {
