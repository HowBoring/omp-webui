+/** Public isolated read-only mode. Normal AgentSession/config/extensions are not imported. */
+import { RpcFrameEncoder, MAX_RPC_FRAME_BYTES, MAX_RPC_REASSEMBLED_BYTES } from "./rpc-frame";
+import { validateCatalogCommand } from "./catalog.generated";
+import { NativeCatalog } from "./catalog-native";
+
+export async function runCatalog():Promise<void> {
+  const encoder = new RpcFrameEncoder();
+  const write = async (frame:object):Promise<void> => {
+    const lines = encoder.encodeFrames(frame);
+    for (const line of lines) await Bun.stdout.write(line);
+  };
+  const catalog = await NativeCatalog.create();
+  await write({type:"ready",protocolVersion:1,supportedProtocolVersions:[1,2],
+    maxFrameBytes:MAX_RPC_FRAME_BYTES,maxReassembledFrameBytes:MAX_RPC_REASSEMBLED_BYTES});
+  let negotiated = false;
+  const buffer = new Uint8Array(16_384);
+  let used = 0;
+  try {
+    for await (const bytes of Bun.stdin.stream()) for (const byte of bytes) {
+      if (used === buffer.length) throw new Error("CATALOG_INPUT_LIMIT");
+      buffer[used++] = byte;
+      if (byte !== 10) continue;
+      const command:unknown = JSON.parse(new TextDecoder("utf-8",{fatal:true}).decode(buffer.subarray(0,used-1)));
+      used = 0;
+      if (!validateCatalogCommand(command) || command.id.length > 128) throw new Error("CATALOG_COMMAND_SCHEMA");
+      if (command.type === "negotiate_protocol") {
+        if (negotiated || command.protocolVersion !== 2) throw new Error("CATALOG_NEGOTIATION");
+        negotiated = true; encoder.setProtocolVersion(2);
+        await write({type:"response",id:command.id,command:command.type,success:true,data:{protocolVersion:2}}); continue;
+      }
+      if (!negotiated) throw new Error("CATALOG_NEGOTIATION_REQUIRED");
+      const deadline = setTimeout(() => process.exit(3),3000);
+      try {
+        const data = command.type === "catalog_sources" ? catalog.sourcesReport()
+          : command.type === "catalog_page" ? await catalog.page(command.cursor,command.pageSize)
+          : await catalog.describe(command.reference);
+        await write({type:"response",id:command.id,command:command.type,success:true,data});
+      } catch (error) {
+        const code = error instanceof Error && /^CATALOG_[A-Z_]+$/.test(error.message) ? error.message:"CATALOG_FAILED";
+        await write({type:"response",id:command.id,command:command.type,success:false,error:code});
+      } finally { clearTimeout(deadline); }
+    }
+    if (used) throw new Error("CATALOG_PARTIAL_EOF");
+  } finally { await catalog.close(); }
+}
