+      snapshot:snapshot.id,observedAt:new Date(snapshot.created).toISOString(),expiresAt:new Date(snapshot.expires).toISOString(),
+      items,failures:snapshot.failures,examined:snapshot.examined,...(nextCursor ? {nextCursor}: {})};
