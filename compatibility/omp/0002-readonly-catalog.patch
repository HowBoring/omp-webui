--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/catalog-path.ts
@@ -0,0 +1,28 @@
+/** Linux directory-descriptor walk: ancestor/leaf symlink swaps cannot redirect native reads. */
+import { constants } from "node:fs";
+import { open, type FileHandle } from "node:fs/promises";
+import { relative } from "node:path";
+import { isAbsolute } from "node:path";
+const hash = (text:string):string => Bun.SHA256.hash(text,"hex");
+const inside = (root:string,target:string):boolean => {
+  const part = relative(root,target);
+  return part === "" || (!part.startsWith("..") && !isAbsolute(part));
+};
+
+export async function openWithin(root:string,rootIdentity:string,target:string,directory=false):Promise<FileHandle> {
+  if (process.platform !== "linux" || !inside(root,target)) throw new Error("UNSUPPORTED_SOURCE_PATH");
+  const parts = relative(root,target).split("/").filter(Boolean);
+  let current:FileHandle|undefined = await open(root,constants.O_RDONLY|constants.O_DIRECTORY|constants.O_NOFOLLOW);
+  try {
+    const info = await current.stat({bigint:true});
+    if (hash(`${info.dev}:${info.ino}:${info.birthtimeNs}`) !== rootIdentity) throw new Error("SOURCE_REPLACED");
+    for (const [index,part] of parts.entries()) {
+      if (part === ".." || part.includes("\0")) throw new Error("INVALID_SOURCE_PATH");
+      const flags = constants.O_RDONLY|constants.O_NOFOLLOW|constants.O_NONBLOCK
+        | (index < parts.length-1 || directory ? constants.O_DIRECTORY:0);
+      const child = await open(`/proc/self/fd/${current.fd}/${part}`,flags);
+      await current.close(); current = child;
+    }
+    const result = current; current = undefined; return result;
+  } finally { if (current) await current.close(); }
+}
