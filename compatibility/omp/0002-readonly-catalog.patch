+      snapshot.failures[127] = {sourceId:source.sourceId,code:"FAILURE_LIMIT"};
+  }
+  async #entry(snapshot:Snapshot,directory:Directory,name:string):Promise<void> {
+    const path = nodePath.join(directory.path,name), source = directory.source;
+    try {
+      const target = await fs.realpath(path);
