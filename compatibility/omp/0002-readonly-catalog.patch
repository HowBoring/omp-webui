@@ -0,0 +1,87 @@
+/** Native readonly descriptor implementation. Never calls SessionManager/load/migrate/repair. */
+import * as fs from "node:fs/promises";
+import { openWithin } from "./catalog-path";
+import * as nodePath from "node:path";
+import { getSessionOwnersDir, relativePathWithinNormalizedRoot } from "@oh-my-pi/pi-utils/dirs";
+import { parseTitleSlotLine } from "../../session/session-title-slot";
+import { isFileLockHeld } from "@oh-my-pi/pi-utils/file-lock";
+import type { CatalogDescriptor, CatalogCwd } from "./wire/rpc-wire.generated";
+
+export const HEADER_BYTES = 16_384;
+export const hash = (text: string): string => Bun.SHA256.hash(text, "hex");
+export async function physicalId(path: string): Promise<string> {
+  const info = await fs.stat(path, { bigint: true });
+  return hash(`${info.dev}:${info.ino}:${info.birthtimeNs}`);
+}
+export function errorCode(error: unknown): string {
+  return error instanceof Error && "code" in error && typeof error.code === "string" ? error.code : "INVALID_METADATA";
+}
+async function cwdInfo(recorded: unknown): Promise<CatalogCwd> {
+  if (typeof recorded !== "string" || recorded.length === 0) return { status: "unknown" };
+  if (recorded.length > 4096 || !nodePath.isAbsolute(recorded) || recorded.includes("\0")) return { status: "invalid" };
+  try {
+    const canonical = await fs.realpath(recorded);
+    return (await fs.stat(canonical)).isDirectory() ? { recorded, canonical, status: "known" } : { recorded, status: "invalid" };
+  } catch (error) { return { recorded, status: errorCode(error) === "ENOENT" ? "missing" : "inaccessible" }; }
+}
+function ownership(id: string): CatalogDescriptor["ownership"] {
+  const observedAt = new Date().toISOString();
+  // This v1 candidate supports Linux. Other native backends are deliberately unknown until validated.
+  if (process.platform !== "linux") return { state: "unknown", observedAt };
+  const name = /^[A-Za-z0-9_-]{1,128}$/.test(id) ? id : `h-${Bun.hash.wyhash(id).toString(16).padStart(16, "0")}`;
+  try { return { state: isFileLockHeld(nodePath.join(getSessionOwnersDir(), name)) ? "held" : "free", observedAt }; }
+  catch { return { state: "unknown", observedAt }; }
+}
+function isRecord(value:unknown):value is Record<string,unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+function text(value: unknown, max: number): string | undefined {
+  return typeof value === "string" && value.length <= max ? value : undefined;
+}
+export interface NativeSource { sourceId: string; root: string; rootIdentity:string }
+export interface NativeReference { sourceId: string; locator: string; instanceId: string; nativeSessionId: string }
+export async function readDescriptor(source: NativeSource, path: string): Promise<CatalogDescriptor> {
+  const target = await fs.realpath(path);
+  if (relativePathWithinNormalizedRoot(source.root, target) === null) throw new Error("OUTSIDE_SOURCE");
+  if (nodePath.relative(source.root, path).length > 1024 || nodePath.relative(source.root, target).length > 1024) throw new Error("LOCATOR_LIMIT");
+  const file = await openWithin(source.root,source.rootIdentity,target);
+  try {
+    const before = await file.stat({bigint:true});
+    if (!before.isFile()) throw new Error("NOT_REGULAR_FILE");
+    const bytes = Buffer.alloc(HEADER_BYTES);
+    const { bytesRead } = await file.read(bytes, 0, bytes.length, 0);
+    const prefix = bytes.subarray(0, bytesRead);
+    const firstEnd = prefix.indexOf(10);
+    if (firstEnd < 0) throw new Error("HEADER_LIMIT");
+    const decoder = new TextDecoder("utf-8", {fatal:true});
+    const firstLine = decoder.decode(prefix.subarray(0, firstEnd));
+    const slot = parseTitleSlotLine(firstLine);
+    const start = slot ? firstEnd+1 : 0;
+    const end = slot ? prefix.indexOf(10, start) : firstEnd;
+    if (end < 0) throw new Error("HEADER_LIMIT");
+    const value: unknown = JSON.parse(slot ? decoder.decode(prefix.subarray(start, end)) : firstLine);
+    if (!isRecord(value) || value.type !== "session"
+      || !("id" in value) || typeof value.id !== "string" || value.id.length === 0 || value.id.length > 128
+      || !("timestamp" in value) || typeof value.timestamp !== "string" || !Number.isFinite(Date.parse(value.timestamp))) {
+      throw new Error("INVALID_HEADER");
+    }
+    const header = value;
+    const title=slot ? text(slot.title,512) || undefined : text(header.title,512);
+    const parentSession=text(header.parentSession,128),continuationOf=text(header.continuationOf,128);
+    const nativeSessionId = value.id;
+    const instanceId = hash(`${before.dev}:${before.ino}:${before.birthtimeNs}:${nativeSessionId}`);
+    const locator = nodePath.relative(source.root, target);
+    const ref: NativeReference = {sourceId:source.sourceId, locator, instanceId, nativeSessionId};
+    const cwd = await cwdInfo(header.cwd);
+    const after = await file.stat({bigint:true});
+    if (before.ctimeNs !== after.ctimeNs || before.size !== after.size || await physicalId(target) !==
+      hash(`${before.dev}:${before.ino}:${before.birthtimeNs}`)) throw new Error("CHANGED_DURING_READ");
+    return {sourceId:source.sourceId, instanceId, nativeSessionId,
+      reference:Buffer.from(JSON.stringify(ref)).toString("base64url"), aliases:[nodePath.relative(source.root,path)], cwd,
+      ...(title === undefined ? {} : {title}),
+      ...(parentSession === undefined ? {} : {parentSession}),
+      ...(continuationOf === undefined ? {} : {continuationOf}),
+      createdAt:value.timestamp, modifiedAt:new Date(Number(before.mtimeMs)).toISOString(), observedAt:new Date().toISOString(),
+      ownership:ownership(nativeSessionId)};
+  } finally { await file.close(); }
+}
