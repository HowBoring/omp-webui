+      }
+      const directory = snapshot.pending[0]!;
+      try {
+        if (!directory.handle) {
+          if (await physicalId(directory.source.root) !== directory.source.rootIdentity) throw new Error("SOURCE_REPLACED");
+          directory.identity = await physicalId(directory.path); directory.mtime = (await fs.stat(directory.path)).mtimeMs;
+          directory.anchor = await openWithin(directory.source.root,directory.source.rootIdentity,directory.path,true);
+          directory.handle = await fs.opendir(`/proc/self/fd/${directory.anchor.fd}`,{bufferSize:1});
+        }
+        const next = await directory.handle.read();
+        if (next === null) { await directory.handle.close(); delete directory.handle; await directory.anchor?.close(); delete directory.anchor; snapshot.pending.shift(); continue; }
+        snapshot.examined++; examined++;
+        await this.#entry(snapshot,directory,next.name);
+      } catch (error) {
+        this.#addFailure(snapshot,directory.source,failure(error),nodePath.relative(directory.source.root,directory.path));
+        if (directory.handle) { await directory.handle.close().catch(() => {}); delete directory.handle; }
