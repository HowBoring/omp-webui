+    while (snapshot.pending.length && examined < catalogBudgets.scanEntriesPerRequest
+      && performance.now()-started < catalogBudgets.scanWindowMs) {
+      if (snapshot.examined >= catalogBudgets.scanEntriesPerSnapshot || snapshot.scanMs+performance.now()-started >= catalogBudgets.scanTotalMs) {
