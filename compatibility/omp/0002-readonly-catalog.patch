+/** Bounded native discovery. Snapshot memory is finite; opendir never materializes a whole root. */
+import { openWithin } from "./catalog-path";
+import * as fs from "node:fs/promises";
+import type { FileHandle } from "node:fs/promises";
+import type { Dir } from "node:fs";
+import * as nodePath from "node:path";
+import { getActiveProfile, getSessionsDir, setProfile, relativePathWithinNormalizedRoot } from "@oh-my-pi/pi-utils/dirs";
+import { readDescriptor, physicalId, hash, errorCode, type NativeSource } from "./catalog-metadata";
+import type { CatalogBudgets, CatalogDescriptor, CatalogFailure, CatalogPage, CatalogSources,
+  CatalogSource, CatalogDescription } from "./wire/rpc-wire.generated";
+
+export const catalogBudgets: CatalogBudgets = { scanEntriesPerRequest:256, scanEntriesPerSnapshot:8192,
+  directoriesPerSnapshot:2048, sessionsPerSnapshot:4096, headerBytes:16384, pageItems:32, responseBytes:262144,
+  snapshotBytes:16777216, snapshots:4, scanWindowMs:250, scanTotalMs:10000, tokenTtlMs:60000 };
+interface Source extends NativeSource { kind:"default"|"custom"; aliases:string[]; rootIdentity:string; status:"ready"|"invalid" }
+interface Directory { source:Source; path:string; depth:number; identity?:string; mtime?:number; handle?:Dir; anchor?:FileHandle }
+interface Snapshot {
+  id:string; created:number; expires:number; examined:number; scanMs:number; bytes:number;
+  directories:Directory[]; pending:Directory[]; items:Map<string,CatalogDescriptor>; sorted?:CatalogDescriptor[];
+  failures:CatalogFailure[]; pageSize:number; expiryTimer?:Timer;
+}
+const failure = (error:unknown):string => error instanceof Error && !('code' in error)
+  ? /^[A-Z][A-Z_]+$/.test(error.message) ? error.message:"INVALID_METADATA" : errorCode(error);
+const order = (a:string,b:string):number => a < b ? -1 : a > b ? 1 : 0;
+
+export class NativeCatalog {
+  readonly #snapshots = new Map<string,Snapshot>();
+  private constructor(private readonly sources:Source[]) {}
+  static async create():Promise<NativeCatalog> {
+    setProfile(process.env.OMP_PROFILE ?? process.env.PI_PROFILE);
+    const custom:unknown = JSON.parse(process.env.OMP_CATALOG_SOURCES ?? "[]");
+    if (!Array.isArray(custom) || custom.length > 15 || custom.some(path => typeof path !== "string"
+      || !nodePath.isAbsolute(path) || path.length > 4096)) throw new Error("CATALOG_SOURCE_CONFIG_INVALID");
+    const roots = [getSessionsDir(), ...custom];
+    const sources:Source[] = [];
