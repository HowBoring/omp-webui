+        || (mode === "scan" && snapshot.sorted !== undefined) || (mode === "page" && snapshot.sorted === undefined))
+        throw new Error("CATALOG_CURSOR_SCOPE");
+    } else snapshot = await this.#start(pageSize);
+    await this.#validate(snapshot);
+    if (!snapshot.sorted) await this.#scan(snapshot);
+    const items:CatalogDescriptor[] = [];
+    for (const item of snapshot.sorted?.slice(offset,offset+pageSize) ?? []) {
+      if (Buffer.byteLength(JSON.stringify({items:[...items,item],failures:snapshot.failures}))+2048 > catalogBudgets.responseBytes) break;
+      items.push(item);
+    }
