diff --git a/packages/coding-agent/src/session/live-message-observation.ts b/packages/coding-agent/src/session/live-message-observation.ts
new file mode 100644
index 0000000000..9229c9f947
--- /dev/null
+++ b/packages/coding-agent/src/session/live-message-observation.ts
@@ -0,0 +1,81 @@
+import * as logger from "@oh-my-pi/pi-utils/logger";
+/** Exact in-process lifecycle/entry associations. Symbols never become persisted or wire identities. */
+import type { AgentEvent, AgentMessage } from "@oh-my-pi/pi-agent-core";
+
+export interface NativeMessageIdentity {
+  messageId: string; sourceId: string; sessionId: string; contextId: string; branchLeafId: string | null; toolOwnerMessageId?: string;
+}
+export interface NativeMessageSettlement {
+  status: "observed" | "no_entry" | "failed";
+  durability: "not_attested";
+  entryId?: string;
+  reason?: string;
+}
+export interface NativeMessageObservation {
+  kind: "message_start" | "message_update" | "message_final" | "message_settlement";
+  live: NativeMessageIdentity;
+  message: AgentMessage;
+  settlement?: NativeMessageSettlement;
+}
+const kLive = Symbol("nativeLiveMessage");
+const entries = new WeakMap<object, { owner: object; entryId: string }>();
+type ObservedMessage = AgentMessage & { [kLive]?: NativeMessageIdentity };
+/** Only a native append call with the original object may establish this association. */
+export function associateMessageEntry(message: object, owner: object, entryId: string): void { entries.set(message, { owner, entryId }); }
+export function nativeMessageEntry(message: object, owner: object): string | undefined {
+  const value = entries.get(message); return value?.owner === owner ? value.entryId : undefined;
+}
+export function nativeMessageIdentity(message: unknown): NativeMessageIdentity | undefined {
+  return typeof message === "object" && message !== null ? (message as ObservedMessage)[kLive] : undefined;
+}
+
+/** Stamps the native lifecycle before asynchronous display listeners can delay or reorder it. */
+export class NativeMessageObservations {
+  #count = 0;
+  readonly #open: NativeMessageIdentity[] = [];
+  readonly #toolOwners = new Map<string, string>();
+  readonly #listeners = new Set<(observation: NativeMessageObservation) => void>();
+  constructor(readonly context: () => Omit<NativeMessageIdentity, "messageId">) {}
+  subscribe(listener: (observation: NativeMessageObservation) => void): () => void {
+    this.#listeners.add(listener); return () => { this.#listeners.delete(listener); };
+  }
+  observe(event: AgentEvent): void {
+    try { this.#observe(event); } catch { logger.warn("Native message observation unavailable"); }
+  }
+  #observe(event: AgentEvent): void {
+    if (event.type === "agent_end") { this.#open.length = 0; return; }
+    if (event.type !== "message_start" && event.type !== "message_update" && event.type !== "message_end") return;
+    let live = event.type === "message_start" ? undefined : this.#open.at(-1);
+    if (!live) {
+      live = { ...this.context(), messageId: `msg-${++this.#count}` };
+      if (event.message.role === "toolResult") live.toolOwnerMessageId = this.#toolOwners.get(
+        JSON.stringify([live.sourceId, live.sessionId, live.contextId, event.message.toolCallId]));
+      this.#open.push(live);
+    }
+    if (event.type === "message_end") {
+      this.#open.pop();
+      if (event.message.role === "assistant") for (const block of event.message.content) {
+        if (block.type !== "toolCall") continue;
+        const key = JSON.stringify([live.sourceId, live.sessionId, live.contextId, block.id]);
+        // Reused unresolved IDs are ambiguous; absence is safer than assigning a late result to a new call.
+        this.#toolOwners.set(key, this.#toolOwners.has(key) ? "" : live.messageId);
+        if (this.#toolOwners.size > 4096) this.#toolOwners.delete(this.#toolOwners.keys().next().value!);
+      }
+    }
+    if (event.type === "message_end" && event.message.role === "toolResult") {
+      this.#toolOwners.delete(JSON.stringify([live.sourceId, live.sessionId, live.contextId, event.message.toolCallId]));
+    }
+    if (live.toolOwnerMessageId === "") delete live.toolOwnerMessageId;
+    (event.message as ObservedMessage)[kLive] = live;
+    this.#emit({ kind: event.type === "message_end" ? "message_final" : event.type, live, message: event.message });
+  }
+  settle(message: AgentMessage, settlement: NativeMessageSettlement): void {
+    const live = nativeMessageIdentity(message);
+    if (live) this.#emit({ kind: "message_settlement", live, message, settlement });
+  }
+  #emit(observation: NativeMessageObservation): void {
+    for (const listener of this.#listeners) {
+      try { listener(observation); } catch { logger.warn("Native message observer failed"); }
+    }
+  }
+}
