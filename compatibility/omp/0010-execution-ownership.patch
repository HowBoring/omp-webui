+import { loadOwnershipApproval, ownershipApprovalPin } from "../../src/launch/ownership/approval";
+import { LinuxOwnershipServer } from "../../src/launch/ownership/server";
+import { OwnershipError } from "../../src/launch/ownership/protocol";
+
+/** Synthetic explicit server process only. Public stdin EOF closes it; no signal, Native or helper launch exists. */
+async function run(): Promise<void> {
+	const selected = process.env.OMP_OWNERSHIP_SERVER_FIXTURE_MANIFEST;
+	if (!selected?.startsWith("/tmp/ownership-server-tracer-") || !selected.endsWith("/fixture.json")) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	const value: unknown = await Bun.file(selected).json();
+	if (typeof value !== "object" || value === null || !("approval" in value) || !("key" in value)) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	const approval = await loadOwnershipApproval(ownershipApprovalPin(value.approval));
+	const server = await LinuxOwnershipServer.open(approval, ownershipApprovalPin(value.key));
+	try {
+		process.stdout.write("OWNERSHIP_SERVER_READY\n");
+		for await (const bytes of Bun.stdin.stream()) {
+			if (bytes.length) throw new OwnershipError("ownership_protocol");
+		}
+	} finally { await server.close(); }
+}
+void run().catch(error => {
+	process.stderr.write(JSON.stringify({ code: error instanceof OwnershipError ? error.code : "ownership_unresolved" }) + "\n");
+	process.exitCode = 2;
+});
