+++ b/packages/coding-agent/test/execution-ownership-contract.test.ts
@@ -0,0 +1,46 @@
+import { expect, test } from "bun:test";
+import { decodeOwnershipRequest, decodeOwnershipResponse, OwnershipError, type OwnershipResponse } from "../src/launch/ownership/protocol";
+import { OwnershipFrames } from "../src/launch/ownership/framing";
+
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+const request = (operation: unknown): string => JSON.stringify({
+	version: "omp-execution-ownership/1", id: "request-00000001", identity, operation,
+});
+
+test("Native client rejects a valid-looking reply for a different request, release or operation", () => {
+	const expected = decodeOwnershipRequest(request({ op: "classify" }));
+	const response = { version: expected.version, id: expected.id, identity, ok: true,
+		result: { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+			policy: "private", generation: "generation-000001" } } } satisfies OwnershipResponse;
+	for (const invalid of [
+		{ ...response, id: "different-request-001" },
+		{ ...response, identity: { ...identity, schema: "c".repeat(64) } },
+		{ ...response, result: { op: "publish", generation: "generation-000001" } },
+		{ ...response, result: { ...response.result, executable: "/bin/sh" } },
+	]) expect(() => decodeOwnershipResponse(JSON.stringify(invalid), expected)).toThrow(OwnershipError);
+	expect(decodeOwnershipResponse(JSON.stringify(response), expected)).toEqual(response);
+});
+
+test("dispatcher framing rejects invalid UTF-8, oversized partial frames and incomplete EOF", () => {
+	const frames = new OwnershipFrames();
+	const frame = new TextEncoder().encode(`${request({ op: "classify" })}\n`);
+	expect(frames.push(frame.slice(0, 17))).toEqual([]);
+	expect(frames.push(frame.slice(17))).toEqual([request({ op: "classify" })]);
+	frames.end();
+	expect(() => new OwnershipFrames().push(new Uint8Array([0xff, 10]))).toThrow("ownership_protocol");
+	expect(() => new OwnershipFrames().push(new Uint8Array(16_385).fill(65))).toThrow("ownership_limit");
+	const partial = new OwnershipFrames();
+	partial.push(new TextEncoder().encode("{}"));
+	expect(() => partial.end()).toThrow("ownership_protocol");
+});
+
+test("dispatcher rejects claimed process identity and executable choices before admission", () => {
+	for (const operation of [
+		{ op: "classify", pid: 123 },
+		{ op: "broker", scope: { kind: "project", directory: "/work" }, argv: ["sh"] },
+		{ op: "broker", scope: { kind: "global", service: "arbitrary-command" } },
+	]) {
+		expect(() => decodeOwnershipRequest(request(operation))).toThrow(OwnershipError);
+	}
+	expect(decodeOwnershipRequest(request({ op: "classify" })).operation).toEqual({ op: "classify" });
+});
diff --git a/packages/coding-agent/test/execution-ownership-dispatcher.test.ts b/packages/coding-agent/test/execution-ownership-dispatcher.test.ts
new file mode 100644
index 0000000000..3ad8369208
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-dispatcher.test.ts
@@ -0,0 +1,170 @@
+import { expect, test } from "bun:test";
+import { OwnershipClient } from "../src/launch/ownership/client";
+import { HelperWireSession, verifyHelperAcknowledgement, type HelperOwnershipRequest } from "../src/launch/ownership/helper-protocol";
+import { OwnershipDispatcher, type OwnershipSystem, type PublicationPermit, type StablePeer } from "../src/launch/ownership/dispatcher";
+import { OWNERSHIP_VERSION, type OwnershipIdentity, type OwnershipScope } from "../src/launch/ownership/protocol";
+
+const identity: OwnershipIdentity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+const generation = "e".repeat(64);
+
+/** Synthetic OS facts at the public native lifecycle seam; no kernel/process proof is claimed. */
+class SyntheticSystem implements OwnershipSystem {
+	readonly dispatcher = "dispatcher-generation-0001";
+	readonly policies = new Map<StablePeer, "external" | "private" | "unresolved">();
+	readonly durable = new Set<string>();
+	readonly publications: OwnershipScope[] = [];
+	failDurability = false;
+	async ready(): Promise<void> {}
+	async classify(peer: StablePeer) {
+		const kind = this.policies.get(peer) ?? "unresolved";
+		return kind === "private" ? { kind, generation } as const : { kind };
+	}
+	async protectHelper(_control: StablePeer, _helper: StablePeer, value: string): Promise<void> {
+		if (this.failDurability) throw new Error("disk failure");
+		this.durable.add(value);
+		this.policies.set(_helper, "private");
+	}
+	async markUnresolved(value: string): Promise<void> { this.durable.add(value); }
+	async completeHelper(_helper: StablePeer, _value: string): Promise<void> { throw new Error("no extinction proof"); }
+	async canonicalScope(scope: OwnershipScope): Promise<OwnershipScope> { return scope; }
+	async broker(scope: OwnershipScope, permit: PublicationPermit) {
+		permit.assertCurrent();
+		this.publications.push(scope);
+		return { generation: "broker-generation-0001", runtimeDirectory: "/run/native/project", token: "d".repeat(64) };
+	}
+	async publish(): Promise<void> { throw new Error("not an authenticated owned broker"); }
+}
+
+function frame(op: unknown): string {
+	return JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000001", identity, operation: op });
+}
+async function register(dispatcher: OwnershipDispatcher, system: SyntheticSystem, helper: StablePeer): Promise<void> {
+	const control = {};
+	system.policies.set(control, "external");
+	const prepared = await dispatcher.handle(control, frame({ op: "prepare_helper", generation }));
+	if (!prepared.ok) throw new Error(prepared.error);
+	await dispatcher.registerHelper(control, helper, generation);
+}
+
+test("Host prepares before helper registration and another authenticated Host cannot claim its generation", async () => {
+	const system = new SyntheticSystem(), host = {}, foreign = {}, helper = {};
+	system.policies.set(host, "external"); system.policies.set(foreign, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) { return JSON.stringify(await dispatcher.handle(host, frame)); }, close() {},
+	});
+	await client.prepareHelper(generation);
+	expect(await client.helperStatus(generation)).toBe("pending");
+	await expect(dispatcher.registerHelper(foreign, helper, generation)).rejects.toThrow("ownership_unresolved");
+	await dispatcher.registerHelperPeer(helper, generation);
+	expect(await client.helperStatus(generation)).toBe("registered");
+	expect(await dispatcher.handle(foreign, frame({ op: "helper_status", generation })))
+		.toMatchObject({ ok: false, error: "ownership_unresolved" });
+});
+
+test("helper REGISTER is acknowledged after durable registration and COMPLETE stays fenced without extinction proof", async () => {
+	const system = new SyntheticSystem(), host = {}, helper = {}, installation = "f".repeat(64);
+	system.policies.set(host, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	await dispatcher.handle(host, frame({ op: "prepare_helper", generation }));
+	const session = new HelperWireSession(installation);
+	const request: HelperOwnershipRequest = { version: "omp-execution-helper/1", id: "a".repeat(64), installation,
+		operation: { op: "register_helper", generation } };
+	const ack = await dispatcher.handleHelper(helper, session, JSON.stringify(request));
+	verifyHelperAcknowledgement(ack, request);
+	expect(system.durable.has(generation)).toBe(true);
+	const completion: HelperOwnershipRequest = { ...request, id: "b".repeat(64), operation: { op: "complete_helper", generation } };
+	await expect(dispatcher.handleHelper(helper, session, JSON.stringify(completion))).rejects.toThrow("no extinction proof");
+	expect(system.durable.has(generation)).toBe(true);
+	expect(await dispatcher.handle(host, frame({ op: "helper_status", generation })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+});
+
+test("peers classified private or unresolved by the OS adapter cannot publish shared execution", async () => {
+	const system = new SyntheticSystem();
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	const helper = {}, nested = {}, unresolved = {};
+	await register(dispatcher, system, helper);
+	system.policies.set(nested, "private");
+	const scope = { kind: "project", directory: "/work" };
+	expect(await dispatcher.handle(nested, frame({ op: "broker", scope }))).toMatchObject({
+		ok: false, error: "shared_service_unsupported",
+	});
+	expect(await dispatcher.handle(unresolved, frame({ op: "broker", scope }))).toMatchObject({
+		ok: false, error: "ownership_unresolved",
+	});
+	expect(system.publications).toEqual([]);
+});
+
+test("matched external client and server negotiate a fixed canonical broker scope through the public wire", async () => {
+	const system = new SyntheticSystem(), peer = {};
+	system.policies.set(peer, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) { return JSON.stringify(await dispatcher.handle(peer, frame)); }, close() {},
+	});
+	const result = await client.broker({ kind: "project", directory: "/work" });
+	expect(result).toEqual({ op: "broker", scope: { kind: "project", directory: "/work" },
+		generation: "broker-generation-0001", runtimeDirectory: "/run/native/project", token: "d".repeat(64) });
+	expect(system.publications).toEqual([{ kind: "project", directory: "/work" }]);
+});
+
+test("helper uncertainty during an awaited broker prepare invalidates its publication barrier", async () => {
+	class HeldSystem extends SyntheticSystem {
+		readonly arrived = Promise.withResolvers<void>();
+		readonly release = Promise.withResolvers<void>();
+		override async broker(scope: OwnershipScope, permit: PublicationPermit) {
+			this.arrived.resolve();
+			await this.release.promise;
+			return super.broker(scope, permit);
+		}
+	}
+	const system = new HeldSystem(), peer = {}, helper = {};
+	system.policies.set(peer, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	await register(dispatcher, system, helper);
+	const response = dispatcher.handle(peer, frame({ op: "broker", scope: { kind: "project", directory: "/work" } }));
+	await system.arrived.promise;
+	await dispatcher.helperUncertain(helper);
+	system.release.resolve();
+	expect(await response).toMatchObject({ ok: false, error: "maintenance_fenced" });
+	expect(system.publications).toEqual([]);
+});
+
+test("uncertain helper death globally blocks a new unrelated external registration and maintenance remains fenced", async () => {
+	const system = new SyntheticSystem(), helper = {}, external = {};
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	await register(dispatcher, system, helper);
+	system.policies.set(external, "external");
+	await dispatcher.helperUncertain(helper);
+	expect(await dispatcher.handle(external, frame({ op: "broker", scope: { kind: "project", directory: "/work" } })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+	expect(system.durable.has(generation)).toBe(true);
+	expect(system.publications).toEqual([]);
+});
+
+test("durability failure never releases worker admission and failed extinction cannot retire its fence", async () => {
+	const system = new SyntheticSystem(), helper = {}, external = {};
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	system.failDurability = true;
+	await expect(register(dispatcher, system, helper)).rejects.toThrow("disk failure");
+	system.policies.set(external, "external");
+	expect(await dispatcher.handle(external, frame({ op: "classify" })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+	const other = new SyntheticSystem();
+	const second = await OwnershipDispatcher.open(identity, other);
+	await register(second, other, helper);
+	await expect(second.completeHelper(helper)).rejects.toThrow("no extinction proof");
+	expect(other.durable.has(generation)).toBe(true);
+	expect(await second.handle(external, frame({ op: "classify" })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+});
+
+test("no client can bypass actual backend readiness by constructing an uninitialized dispatcher", async () => {
+	const system = new SyntheticSystem(), peer = {};
+	system.policies.set(peer, "external");
+	const dispatcher = new OwnershipDispatcher(identity, system);
+	expect(await dispatcher.handle(peer, frame({ op: "broker", scope: { kind: "project", directory: "/work" } })))
+		.toMatchObject({ ok: false, error: "ownership_backend_unavailable" });
+	expect(system.publications).toEqual([]);
+});
diff --git a/packages/coding-agent/test/execution-ownership-fences.test.ts b/packages/coding-agent/test/execution-ownership-fences.test.ts
new file mode 100644
index 0000000000..cc5c3333d0
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-fences.test.ts
@@ -0,0 +1,64 @@
+import { expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { OwnershipDispatcher, type OwnershipSystem, type StablePeer } from "../src/launch/ownership/dispatcher";
+import { OwnershipFences } from "../src/launch/ownership/fences";
+import { OWNERSHIP_VERSION } from "../src/launch/ownership/protocol";
+
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) }, installation = "c".repeat(64);
+const generation = "d".repeat(64);
+
+/** Public dispatcher seam with synthetic OS facts and the real owned durable filesystem adapter. */
+function system(fences: OwnershipFences): OwnershipSystem {
+	const helpers = new Set<StablePeer>();
+	return {
+		dispatcher: "dispatcher-generation-0001", async ready() {},
+		async classify(peer) { return helpers.has(peer) ? { kind: "private", generation } : { kind: "external" }; },
+		async protectHelper(_control, helper) { await fences.create(generation, "private-helper"); helpers.add(helper); },
+		async markUnresolved() { await fences.verify(); },
+		async completeHelper() { throw new Error("no kernel extinction proof"); },
+		async canonicalScope(scope) { return scope; },
+		async broker() { throw new Error("external protector unavailable"); },
+		async publish() { throw new Error("external protector unavailable"); },
+	};
+}
+
+test("dispatcher state loss preserves a durable helper fence and reopening cannot silently admit another generation", async () => {
+	const root = await fs.mkdtemp("/tmp/ownership-fence-fixture-");
+	const directory = path.join(root, "dispatcher-fences");
+	await fs.mkdir(directory, { mode: 0o700 });
+	const stat = await fs.stat(directory, { bigint: true });
+	const approval = { directory: { path: directory, device: String(stat.dev), inode: String(stat.ino) },
+		releaseRoot: path.join(root, "release"), installation, identity };
+	let fences: OwnershipFences | undefined;
+	try {
+		fences = await OwnershipFences.open(approval);
+		const dispatcher = await OwnershipDispatcher.open(identity, system(fences)), host = {}, helper = {};
+		const prepared = await dispatcher.handle(host, JSON.stringify({ version: OWNERSHIP_VERSION, id: "prepare-request-0001",
+			identity, operation: { op: "prepare_helper", generation } }));
+		expect(prepared).toMatchObject({ ok: true, result: { op: "prepare_helper", generation } });
+		await dispatcher.registerHelperPeer(helper, generation);
+		await fences.close(); fences = undefined;
+		await expect(OwnershipFences.open(approval)).rejects.toThrow("maintenance_fenced");
+	} finally { await fences?.close(); await fs.rm(root, { recursive: true, force: true }); }
+});
+
+test("only an owned completed generation can retire its durable record and leave the directory reusable", async () => {
+	const root = await fs.mkdtemp("/tmp/ownership-fence-complete-");
+	const directory = path.join(root, "dispatcher-fences");
+	await fs.mkdir(directory, { mode: 0o700 });
+	const stat = await fs.stat(directory, { bigint: true });
+	const approval = { directory: { path: directory, device: String(stat.dev), inode: String(stat.ino) },
+		releaseRoot: path.join(root, "release"), installation, identity };
+	let fences: OwnershipFences | undefined;
+	try {
+		fences = await OwnershipFences.open(approval);
+		await fences.create(generation, "private-helper");
+		await fences.retireCompleted(generation);
+		await fences.close(); fences = undefined;
+		fences = await OwnershipFences.open(approval);
+		await fences.create("e".repeat(64), "external-lifetime");
+		await fences.verify();
+		expect(await fs.readdir(directory)).toEqual([`dispatcher-${"e".repeat(64)}.json`]);
+	} finally { await fences?.close(); await fs.rm(root, { recursive: true, force: true }); }
+});
diff --git a/packages/coding-agent/test/execution-ownership-helper-wire.test.ts b/packages/coding-agent/test/execution-ownership-helper-wire.test.ts
new file mode 100644
index 0000000000..6eca6ae513
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-helper-wire.test.ts
@@ -0,0 +1,33 @@
+import { expect, test } from "bun:test";
+import { decodeHelperRequest, encodeHelperSuccess, verifyHelperAcknowledgement, HelperWireSession,
+	type HelperOwnershipRequest } from "../src/launch/ownership/helper-protocol";
+
+const generation = "a".repeat(64), installation = "b".repeat(64);
+const request = { version: "omp-execution-helper/1", id: "c".repeat(64), installation,
+	operation: { op: "register_helper", generation } } satisfies HelperOwnershipRequest;
+
+test("helper registration accepts only the pinned installation and generation-bound fixed operations", () => {
+	expect(decodeHelperRequest(JSON.stringify(request), installation)).toEqual(request);
+	for (const invalid of [
+		{ ...request, pid: 123 },
+		{ ...request, installation: "c".repeat(64) },
+		{ ...request, operation: { op: "register_helper", generation: "g".repeat(64) } },
+		{ ...request, operation: { op: "exec", generation, argv: ["sh"] } },
+	]) expect(() => decodeHelperRequest(JSON.stringify(invalid), installation)).toThrow();
+	// Exact bytes are consumed by the tiny C helper; property order and absence of whitespace are public wire semantics.
+	expect(encodeHelperSuccess(request)).toBe(`{"version":"omp-execution-helper/1","id":"${request.id}","ok":true,"operation":"register_helper","generation":"${generation}"}\n`);
+});
+
+test("late REGISTER acknowledgements cannot complete cleanup and duplicate helper requests cannot reopen a phase", () => {
+	const session = new HelperWireSession(installation);
+	const registration = session.decode(JSON.stringify(request));
+	const registered = session.acknowledge(registration);
+	expect(() => session.decode(JSON.stringify(request))).toThrow("ownership_protocol");
+	const complete: HelperOwnershipRequest = { ...request, id: "d".repeat(64), operation: { op: "complete_helper", generation } };
+	expect(() => verifyHelperAcknowledgement(registered, complete)).toThrow("dispatcher_mismatch");
+	expect(() => session.decode(JSON.stringify({ ...complete, id: request.id }))).toThrow("ownership_protocol");
+	const completing = session.decode(JSON.stringify(complete));
+	const completed = session.acknowledge(completing);
+	expect(verifyHelperAcknowledgement(completed, complete)).toBeUndefined();
+	expect(() => session.decode(JSON.stringify(complete))).toThrow("ownership_protocol");
+});
diff --git a/packages/coding-agent/test/execution-ownership-linux.test.ts b/packages/coding-agent/test/execution-ownership-linux.test.ts
