--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/release-inventory.ts
@@ -0,0 +1,160 @@
+import { strictOwnershipRecord as record } from "./strict-record";
+import * as fs from "node:fs/promises";
+import { constants, type BigIntStats } from "node:fs";
+import * as path from "node:path";
+import { createHash } from "node:crypto";
+import type { ControlReleaseManifest, ControlReleaseMember } from "@omp-webui/control-io";
+import type { OwnershipFileApproval } from "./approval";
+import { OwnershipError } from "./protocol";
+import { verifyOwnershipPlatformClosure } from "./platform-closure";
+
+const maxMembers = 200_000, maxManifest = 33_554_432;
+function fail(): never { throw new OwnershipError("dispatcher_mismatch"); }
+const hash = (bytes: string | Uint8Array) => createHash("sha256").update(bytes).digest("hex");
+function canonical(value: string): void {
+  if (!path.isAbsolute(value) || path.resolve(value) !== value || value.includes("\0") || value.length > 4096) fail();
+}
+function relative(value: string): void {
+  if (value !== "." && (value.length > 4096 || value.includes("\0") || value.startsWith("/")
+    || value.split("/").some(part => part === "" || part === "." || part === ".."))) fail();
+}
+function member(value: unknown, outside: boolean, root: string): ControlReleaseMember {
+  const source = record(value, ["path", "kind", "identity", "mode"]);
+  if (typeof source.path !== "string" || typeof source.identity !== "string"
+    || typeof source.mode !== "number" || !Number.isInteger(source.mode) || source.mode < 0 || source.mode > 0o777
+    || !["file", "directory", "link"].includes(String(source.kind))) fail();
+  if (outside) {
+    canonical(source.path);
+    if ((source.kind !== "file" && source.kind !== "link") || source.path === root || source.path.startsWith(`${root}/`)) fail();
+  } else relative(source.path);
+  if (source.kind === "link") {
+    if (source.identity.length < 1 || source.identity.length > 4096 || source.identity.includes("\0")
+      || path.isAbsolute(source.identity)) fail();
+  } else if (!/^[a-f0-9]{64}$/.test(source.identity)) fail();
+  if (source.kind !== "file" && source.kind !== "directory" && source.kind !== "link") fail();
+  return Object.freeze({ path: source.path, kind: source.kind, identity: source.identity, mode: source.mode });
+}
+function decode(bytes: Buffer, root: string): ControlReleaseManifest {
+  const text = new TextDecoder("utf-8", { fatal: true }).decode(bytes), parsed: unknown = JSON.parse(text);
+  if (JSON.stringify(parsed, null, 2) + "\n" !== text) fail();
+  const source = record(parsed, ["format", "stage", "platform", "arch", "assets", "platformDependencies"]);
+  if (source.format !== "omp-webui-release-inventory-v1" || source.stage !== "unaccepted-artifact"
+    || source.platform !== process.platform || source.arch !== process.arch || process.platform !== "linux"
+    || !["x64", "arm64"].includes(process.arch) || !Array.isArray(source.assets)
+    || source.assets.length < 1 || source.assets.length > maxMembers || !Array.isArray(source.platformDependencies)
+    || source.platformDependencies.length > 256) fail();
+  const assets = source.assets.map(value => member(value, false, root));
+  const dependencies = source.platformDependencies.map(value => member(value, true, root));
+  if (new Set(assets.map(value => value.path)).size !== assets.length
+    || new Set(dependencies.map(value => value.path)).size !== dependencies.length
+    || assets.some(value => value.path === "release.json")) fail();
+  return Object.freeze({ format: source.format, stage: source.stage, platform: process.platform, arch: process.arch,
+    assets: Object.freeze(assets), platformDependencies: Object.freeze(dependencies) });
+}
+function stamp(stat: BigIntStats): string {
+  return [stat.dev, stat.ino, stat.uid, stat.gid, stat.mode, stat.nlink, stat.size, stat.mtimeNs, stat.ctimeNs].join(":");
+}
+async function same(location: string, before: BigIntStats): Promise<void> {
+  if (stamp(await fs.lstat(location, { bigint: true })) !== stamp(before)) fail();
+}
+async function fileDigest(location: string, maximum = 1_073_741_824): Promise<string> {
+  if (await fs.realpath(location) !== location) fail();
+  const file = await fs.open(location, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const before = await file.stat({ bigint: true });
+    if (!before.isFile() || before.nlink !== 1n || before.size < 0n || before.size > BigInt(maximum)) fail();
+    await same(location, before);
+    const digest = createHash("sha256"), buffer = Buffer.alloc(65_536); let offset = 0;
+    while (BigInt(offset) < before.size) {
+      const length = Math.min(buffer.length, Number(before.size) - offset);
+      const result = await file.read(buffer, 0, length, offset);
+      if (!result.bytesRead) fail(); digest.update(buffer.subarray(0, result.bytesRead)); offset += result.bytesRead;
+    }
+    if (stamp(await file.stat({ bigint: true })) !== stamp(before)) fail();
+    await same(location, before);
+    if (await fs.realpath(location) !== location) fail();
+    return digest.digest("hex");
+  } finally { await file.close(); }
+}
+async function manifestBytes(selected: OwnershipFileApproval): Promise<Buffer> {
+  const file = await fs.open(selected.file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const before = await file.stat({ bigint: true });
+    if (await fs.realpath(selected.file) !== selected.file || !before.isFile() || before.nlink !== 1n
+      || before.size <= 0n || before.size > BigInt(maxManifest)) fail();
+    const bytes = Buffer.alloc(Number(before.size)); let offset = 0;
+    while (offset < bytes.length) {
+      const result = await file.read(bytes, offset, bytes.length - offset, offset);
+      if (!result.bytesRead) fail(); offset += result.bytesRead;
+    }
+    if (hash(bytes) !== selected.sha256 || stamp(await file.stat({ bigint: true })) !== stamp(before)) fail();
+    await same(selected.file, before); return bytes;
+  } finally { await file.close(); }
+}
+async function inventory(root: string): Promise<ControlReleaseMember[]> {
+  const assets: ControlReleaseMember[] = []; let total = 0n;
+  const visit = async (relativePath: string, depth: number): Promise<void> => {
+    if (assets.length >= maxMembers || depth > 64) fail();
+    const location = path.resolve(root, relativePath);
+    if (await fs.realpath(path.dirname(location)) !== path.dirname(location)) fail();
+    const before = await fs.lstat(location, { bigint: true }), mode = Number(before.mode & 0o7777n);
+    if (mode > 0o777) fail();
+    if (before.isSymbolicLink()) {
+      if (before.nlink !== 1n) fail();
+      const identity = await fs.readlink(location), target = path.resolve(path.dirname(location), identity);
+      if (path.isAbsolute(identity) || !target.startsWith(`${root}/`) || await fs.realpath(location) !== target) fail();
+      assets.push({ path: relativePath, kind: "link", identity, mode });
+    } else if (before.isDirectory()) {
+      const names = (await fs.readdir(location)).filter(name => relativePath !== "." || name !== "release.json").sort();
+      assets.push({ path: relativePath, kind: "directory", identity: hash(JSON.stringify(names)), mode });
+      for (const name of names) await visit(relativePath === "." ? name : `${relativePath}/${name}`, depth + 1);
+      const after = (await fs.readdir(location)).filter(name => relativePath !== "." || name !== "release.json").sort();
+      if (JSON.stringify(after) !== JSON.stringify(names)) fail();
+    } else if (before.isFile()) {
+      total += before.size;
+      if (total > 8_589_934_592n) fail();
+      assets.push({ path: relativePath, kind: "file", identity: await fileDigest(location), mode });
+    } else fail();
+    await same(location, before);
+  };
+  await visit(".", 0); return assets;
+}
+async function dependencyMember(member: ControlReleaseMember): Promise<void> {
+  if (await fs.realpath(path.dirname(member.path)) !== path.dirname(member.path)) fail();
+  const before = await fs.lstat(member.path, { bigint: true });
+  if (Number(before.mode & 0o7777n) !== member.mode) fail();
+  if (member.kind === "link") {
+    if (!before.isSymbolicLink() || before.nlink !== 1n || await fs.readlink(member.path) !== member.identity) fail();
+  } else if (await fs.realpath(member.path) !== member.path || await fileDigest(member.path) !== member.identity) fail();
+  await same(member.path, before);
+}
+/**
+ * Exact release.json bytes use JSON.stringify(manifest,null,2)+newline. Its SHA256 is independently signed.
+ * File identities hash bytes; directories hash JSON of sorted direct names; direct relative link identities are their exact target text.
+ * Only release.json itself is excluded to keep finalization acyclic. Every other byte/name/mode is inventoried.
+ */
+export async function inspectOwnershipInventory(root: string, selected: OwnershipFileApproval): Promise<{
+  readonly manifest: ControlReleaseManifest; verify(): Promise<void>;
+}> {
+  try {
+    canonical(root);
+    if (root === "/" || selected.file !== `${root}/release.json` || !/^[a-f0-9]{64}$/.test(selected.sha256)) fail();
+    const bytes = await manifestBytes(selected), manifest = decode(bytes, root);
+    let failed = false;
+    const verify = async (): Promise<void> => {
+      try {
+        if (failed || await fs.realpath(root) !== root || !(await manifestBytes(selected)).equals(bytes)) fail();
+        const actual = await inventory(root);
+        if (JSON.stringify(actual) !== JSON.stringify(manifest.assets)) fail();
+        for (const dependency of manifest.platformDependencies) await dependencyMember(dependency);
+        await verifyOwnershipPlatformClosure(actual.filter(value => value.kind === "file").map(value => path.join(root, value.path)),
+          manifest.platformDependencies);
+        if (JSON.stringify(await inventory(root)) !== JSON.stringify(manifest.assets)
+          || !(await manifestBytes(selected)).equals(bytes)) fail();
+        for (const dependency of manifest.platformDependencies) await dependencyMember(dependency);
+        if (failed) fail();
+      } catch { failed = true; fail(); }
+    };
+    await verify(); return Object.freeze({ manifest, verify });
+  } catch { return fail(); }
+}
diff --git a/packages/coding-agent/src/launch/ownership/reply-queue.ts b/packages/coding-agent/src/launch/ownership/reply-queue.ts
