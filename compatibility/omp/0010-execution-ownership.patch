+++ b/packages/coding-agent/src/launch/ownership/linux-bridge.ts
@@ -0,0 +1,209 @@
+/** Loaded only by the explicit Linux execution-ownership backend, never catalog/preflight. */
+import { dlopen, FFIType, ptr, type FFIFunction, type Library } from "bun:ffi";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+import type { StablePeer } from "./dispatcher";
+
+const nativeFunctions = {
+	omp_ownership_abi: { args: [], returns: FFIType.i32 },
+	omp_ownership_fd_count: { args: [], returns: FFIType.u32 },
+	omp_ownership_probe: { args: [], returns: FFIType.i32 },
+	omp_ownership_listen: { args: [FFIType.ptr], returns: FFIType.i32 },
+	omp_ownership_accept: { args: [FFIType.i32, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_connect_begin: { args: [FFIType.ptr], returns: FFIType.i32 },
+	omp_ownership_connect_ready: { args: [FFIType.i32, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_peer: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_peer_pid: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_peer_start: { args: [FFIType.i32], returns: FFIType.u64 },
+	omp_ownership_peer_alive: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_same_peer: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_direct_child: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_classify: { args: [FFIType.i32, FFIType.ptr, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_read: { args: [FFIType.i32, FFIType.ptr, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_write: { args: [FFIType.i32, FFIType.ptr, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_close: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_close_all: { args: [], returns: FFIType.void },
+} as const satisfies Record<string, FFIFunction>;
+
+export interface OwnershipBridgeSelection {
+	/** Approved canonical direct library within the selected maintained Native release, never a browser choice. */
+	file: string;
+	/** Independent operator/build trust input, not obtained by hashing the selected file itself. */
+	sha256: string;
+	/** Revalidate independently held installation maintenance protection before/after loading. */
+	verify(): Promise<void>;
+}
+
+/** Opaque connection/listener identities. The bridge validates object membership before its generational C handle. */
+export type OwnershipSocket = object;
+const libraryAuthority = Symbol("ownership-library-authority");
+let activeBridge: LinuxOwnershipBridge | undefined;
+let loadingBridge = false;
+
+/**
+ * Linux syscall adapter, ABI 1. Only bounded socket/pidfd primitives have fixture evidence; no lifecycle capability.
+ * It owns accept/read/write/connect and stable peer handles; no Bun socket private fields/casts are used.
+ * Call from the main Native thread only. It provides classification, never signal or wait authority.
+ */
+export class LinuxOwnershipBridge {
+	readonly #library: Library<typeof nativeFunctions>;
+	readonly #sockets = new Map<OwnershipSocket, number>();
+	readonly #listeners = new Map<OwnershipSocket, number>();
+	readonly #peers = new Map<StablePeer, number>();
+	#closed = false;
+
+	constructor(library: Library<typeof nativeFunctions>, authority: symbol) {
+		if (authority !== libraryAuthority) throw new OwnershipError("ownership_backend_unavailable");
+		this.#library = library;
+	}
+
+	static async open(selection: OwnershipBridgeSelection): Promise<LinuxOwnershipBridge> {
+		if (activeBridge || loadingBridge) throw new OwnershipError("ownership_limit");
+		loadingBridge = true;
+		try {
+			const bridge = await LinuxOwnershipBridge.#load(selection);
+			activeBridge = bridge;
+			return bridge;
+		} finally { loadingBridge = false; }
+	}
+
+	static async #load(selection: OwnershipBridgeSelection): Promise<LinuxOwnershipBridge> {
+		if (process.platform !== "linux" || !Bun.isMainThread || !process.getuid || !process.geteuid
+			|| process.getuid() !== process.geteuid()) throw new OwnershipError("ownership_backend_unavailable");
+		if (!/^[a-f0-9]{64}$/.test(selection.sha256) || !path.isAbsolute(selection.file)
+			|| path.resolve(selection.file) !== selection.file || await fs.realpath(selection.file) !== selection.file) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		await selection.verify();
+		const before = await fs.lstat(selection.file, { bigint: true });
+		if (!before.isFile() || before.nlink !== 1n || before.size > 1_048_576n) throw new OwnershipError("dispatcher_mismatch");
+		const bytes = await Bun.file(selection.file).arrayBuffer();
+		const digest = Buffer.from(await crypto.subtle.digest("SHA-256", bytes)).toString("hex");
+		const after = await fs.lstat(selection.file, { bigint: true });
+		if (digest !== selection.sha256 || before.dev !== after.dev || before.ino !== after.ino
+			|| before.size !== after.size || before.mtimeNs !== after.mtimeNs || before.ctimeNs !== after.ctimeNs) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		const library = dlopen(selection.file, nativeFunctions);
+		const bridge = new LinuxOwnershipBridge(library, libraryAuthority);
+		try {
+			await selection.verify();
+			if (library.symbols.omp_ownership_abi() !== 1) throw new OwnershipError("ownership_backend_unavailable");
+			const probe = library.symbols.omp_ownership_probe();
+			if (probe !== 0) throw new OwnershipError("ownership_backend_unavailable", -probe);
+			return bridge;
+		} catch (error) { bridge.close(); throw error; }
+	}
+
+	listen(endpoint: string): OwnershipSocket {
+		const bytes = this.#endpoint(endpoint);
+		return this.#store(this.#listeners, this.#library.symbols.omp_ownership_listen(ptr(bytes)));
+	}
+	accept(listener: OwnershipSocket, uid: number): OwnershipSocket | undefined {
+		const value = this.#library.symbols.omp_ownership_accept(this.#handle(this.#listeners, listener), uid);
+		return value === 0 ? undefined : this.#store(this.#sockets, value);
+	}
+	connect(endpoint: string): OwnershipSocket {
+		const bytes = this.#endpoint(endpoint);
+		return this.#store(this.#sockets, this.#library.symbols.omp_ownership_connect_begin(ptr(bytes)));
+	}
+	connected(socket: OwnershipSocket, uid: number): boolean {
+		const result = this.#library.symbols.omp_ownership_connect_ready(this.#handle(this.#sockets, socket), uid);
+		if (result < 0) throw new OwnershipError("dispatcher_unavailable", -result);
+		return result === 1;
+	}
+
+	capturePeer(socket: OwnershipSocket): StablePeer {
+		if (this.#peers.size >= OWNERSHIP_LIMITS.registrations) throw new OwnershipError("ownership_limit");
+		return this.#store(this.#peers, this.#library.symbols.omp_ownership_peer(this.#handle(this.#sockets, socket)));
+	}
+	samePeer(left: StablePeer, right: StablePeer): boolean {
+		const result = this.#library.symbols.omp_ownership_same_peer(this.#handle(this.#peers, left), this.#handle(this.#peers, right));
+		if (result < 0) throw new OwnershipError("ownership_unresolved", -result);
+		return result === 1;
+	}
+	/** False means the held kernel pidfd reports exit; fd/protocol failures remain unresolved. */
+	peerAlive(peer: StablePeer): boolean {
+		const result = this.#library.symbols.omp_ownership_peer_alive(this.#handle(this.#peers, peer));
+		if (result < 0) throw new OwnershipError("ownership_unresolved", -result);
+		return result === 1;
+	}
+	/** Verify parentage using retained actual peers and rechecked kernel edges, never control-frame PID hints. */
+	isDirectChild(child: StablePeer, parent: StablePeer): boolean {
+		const result = this.#library.symbols.omp_ownership_direct_child(this.#handle(this.#peers, child), this.#handle(this.#peers, parent));
+		if (result < 0) throw new OwnershipError("ownership_unresolved", -result);
+		return result === 1;
+	}
+	/** Hints for audit/control correlation only; this result never grants classification or signal authority. */
+	peerHints(peer: StablePeer): { pid: number; startTime: string } {
+		const handle = this.#handle(this.#peers, peer);
+		const pid = this.#library.symbols.omp_ownership_peer_pid(handle);
+		const start = this.#library.symbols.omp_ownership_peer_start(handle);
+		if (pid <= 0 || start === 0n) throw new OwnershipError("ownership_unresolved");
+		return { pid, startTime: String(start) };
+	}
+	/** Returns a verified registered helper, or undefined only for a complete stable external chain. */
+	classify(peer: StablePeer, helpers: readonly StablePeer[]): StablePeer | undefined {
+		if (helpers.length > OWNERSHIP_LIMITS.helpers) throw new OwnershipError("ownership_limit");
+		const keys = new Int32Array(Math.max(1, helpers.length));
+		helpers.forEach((helper, index) => { keys[index] = this.#handle(this.#peers, helper); });
+		const result = this.#library.symbols.omp_ownership_classify(this.#handle(this.#peers, peer), ptr(keys), helpers.length);
+		if (result < 0 || result > helpers.length) throw new OwnershipError("ownership_unresolved", result < 0 ? -result : undefined);
+		return result === 0 ? undefined : helpers[result - 1];
+	}
+
+	/** Undefined is Linux EAGAIN; an empty array is EOF. Caller owns total queue/idle/deadline enforcement. */
+	read(socket: OwnershipSocket): Uint8Array | undefined {
+		const bytes = Buffer.alloc(OWNERSHIP_LIMITS.frameBytes);
+		const count = this.#library.symbols.omp_ownership_read(this.#handle(this.#sockets, socket), ptr(bytes), bytes.length);
+		if (count === -11) return undefined;
+		if (count < 0 || count > bytes.length) throw new OwnershipError("dispatcher_unavailable", count < 0 ? -count : undefined);
+		return bytes.subarray(0, count);
+	}
+	/** May write partially; the caller must retain at most the fixed queue budget and honor the request deadline. */
+	write(socket: OwnershipSocket, bytes: Uint8Array): number {
+		if (!bytes.byteLength || bytes.byteLength > OWNERSHIP_LIMITS.frameBytes + 1) throw new OwnershipError("ownership_limit");
+		const count = this.#library.symbols.omp_ownership_write(this.#handle(this.#sockets, socket), ptr(bytes), bytes.byteLength);
+		if (count === -11) return 0;
+		if (count < 0 || count > bytes.byteLength) throw new OwnershipError("dispatcher_unavailable", count < 0 ? -count : undefined);
+		return count;
+	}
+
+	releaseSocket(socket: OwnershipSocket): void { this.#release(this.#sockets.has(socket) ? this.#sockets : this.#listeners, socket); }
+	releasePeer(peer: StablePeer): void { this.#release(this.#peers, peer); }
+	ownedDescriptorCount(): number { this.#assertOpen(); return this.#library.symbols.omp_ownership_fd_count(); }
+	/** Close is an error/shutdown primitive, never an extinction receipt. Durable generation fences must remain. */
+	close(): void {
+		if (this.#closed) return;
+		this.#closed = true;
+		this.#library.symbols.omp_ownership_close_all();
+		this.#library.close(); this.#sockets.clear(); this.#listeners.clear(); this.#peers.clear();
+		if (activeBridge === this) activeBridge = undefined;
+	}
+
+	#endpoint(endpoint: string): Buffer {
+		this.#assertOpen();
+		if (!endpoint.startsWith("/") || endpoint.includes("\0") || Buffer.byteLength(endpoint) >= 108) {
+			throw new OwnershipError("ownership_protocol");
+		}
+		return Buffer.from(`${endpoint}\0`);
+	}
+	#assertOpen(): void { if (this.#closed) throw new OwnershipError("dispatcher_unavailable"); }
+	#handle(map: Map<object, number>, value: object): number {
+		this.#assertOpen();
+		const handle = map.get(value);
+		if (handle === undefined) throw new OwnershipError("ownership_unresolved");
+		return handle;
+	}
+	#store(map: Map<object, number>, handle: number): object {
+		this.#assertOpen();
+		if (handle <= 0) throw new OwnershipError("ownership_unresolved", handle < 0 ? -handle : undefined);
+		const object = Object.freeze({}); map.set(object, handle); return object;
+	}
+	#release(map: Map<object, number>, value: object): void {
+		const handle = this.#handle(map, value);
+		map.delete(value);
+		if (this.#library.symbols.omp_ownership_close(handle) !== 0) throw new OwnershipError("ownership_unresolved");
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/protocol.ts b/packages/coding-agent/src/launch/ownership/protocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a4b0d0687b24eb00b9d0419f928ceb3c9f83c77
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/protocol.ts
@@ -0,0 +1,170 @@
+/** Public Native lifecycle IPC. No request can name a PID, executable, argv, token path or environment. */
+export const OWNERSHIP_VERSION = "omp-execution-ownership/1";
+
+/** Fixed resource limits; exceeding one fails closed and never falls back to a local broker. */
+export const OWNERSHIP_LIMITS = Object.freeze({
+	frameBytes: 16_384, connections: 64, pendingPerConnection: 1, queuedBytesPerConnection: 32_768,
+	registrations: 512, helpers: 64, helperGenerations: 512, ancestryDepth: 256,
+	bridgeHandles: 1024, bridgeDescriptors: 2048, brokerScopes: 64, externalLifetimes: 256,
+	connectMs: 1_000, requestMs: 10_000, idleMs: 30_000,
+});
+
+const errorCodes = ["ownership_protocol", "ownership_limit", "dispatcher_unavailable", "dispatcher_mismatch",
+	"ownership_unresolved", "maintenance_fenced", "shared_service_unsupported", "ownership_backend_unavailable"] as const;
+export type OwnershipErrorCode = (typeof errorCodes)[number];
+
+/** Stable native error code; consumers must not translate a refusal into successful tool execution. */
+export class OwnershipError extends Error {
+	constructor(readonly code: OwnershipErrorCode, readonly nativeErrno?: number) {
+		super(code); this.name = "OwnershipError";
+	}
+}
+
+/** Independently selected immutable release closure and effective RPC schema digests. */
+export interface OwnershipIdentity { closure: string; schema: string }
+export type OwnershipScope =
+	| { kind: "project"; directory: string }
+	| { kind: "global"; service: "browser-relay" | "text-predict" };
+export type OwnershipOperation =
+	| { op: "classify" }
+	| { op: "prepare_helper"; generation: string }
+	| { op: "helper_status"; generation: string }
+	| { op: "broker"; scope: OwnershipScope }
+	| { op: "publish"; scope: OwnershipScope; generation: string };
+export interface OwnershipRequest {
+	version: typeof OWNERSHIP_VERSION;
+	id: string;
+	identity: OwnershipIdentity;
+	operation: OwnershipOperation;
+}
+
+export interface OwnershipRegistration {
+	/** A connection is always authenticated again; this identifier grants no bearer authority. */
+	registration: string;
+	dispatcher: string;
+	policy: "private" | "external";
+	generation: string;
+}
+export type OwnershipResult =
+	| { op: "classify"; registration: OwnershipRegistration }
+	| { op: "prepare_helper"; generation: string }
+	| { op: "helper_status"; generation: string; status: "pending" | "registered" }
+	| { op: "broker"; scope: OwnershipScope; generation: string; runtimeDirectory: string; token: string }
+	| { op: "publish"; generation: string };
+export type OwnershipResponse =
+	| { version: typeof OWNERSHIP_VERSION; id: string; ok: true; identity: OwnershipIdentity; result: OwnershipResult }
+	| { version: typeof OWNERSHIP_VERSION; id: string; ok: false; error: OwnershipErrorCode };
+
+function record(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (value === null || typeof value !== "object" || Array.isArray(value)) throw new OwnershipError("ownership_protocol");
+	const result = value as Record<string, unknown>;
+	if (Object.keys(result).some(key => !keys.includes(key))) throw new OwnershipError("ownership_protocol");
+	return result;
+}
+function text(value: unknown, pattern: RegExp): string {
+	if (typeof value !== "string" || !pattern.test(value)) throw new OwnershipError("ownership_protocol");
+	return value;
+}
+export function ownershipToken(value: unknown): string { return text(value, /^[A-Za-z0-9_-]{16,128}$/); }
+export function ownershipGeneration(value: unknown): string { return text(value, /^[a-f0-9]{64}$/); }
+export function ownershipIdentity(value: unknown): OwnershipIdentity {
+	const source = record(value, ["closure", "schema"]);
+	return { closure: text(source.closure, /^[a-f0-9]{64}$/), schema: text(source.schema, /^[a-f0-9]{64}$/) };
+}
+
+/** Lexical validation only. The authenticated server must realpath and pin the directory before use. */
+export function ownershipScope(value: unknown): OwnershipScope {
+	const source = record(value, ["kind", "directory", "service"]);
+	if (source.kind === "global" && source.directory === undefined
+		&& (source.service === "browser-relay" || source.service === "text-predict")) {
+		return { kind: "global", service: source.service };
+	}
+	if (source.kind !== "project" || source.service !== undefined || typeof source.directory !== "string") {
+		throw new OwnershipError("ownership_protocol");
+	}
+	const directory = source.directory;
+	if (directory.length > 4096 || !directory.startsWith("/") || directory.includes("\0")
+		|| (directory !== "/" && directory.split("/").slice(1).some(part => !part || part === "." || part === ".."))) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	return { kind: "project", directory };
+}
+
+/** A single UTF-8 JSON frame, without its LF delimiter. Strict decoder rejects extra authority fields. */
+export function decodeOwnershipRequest(frame: string): OwnershipRequest {
+	if (new TextEncoder().encode(frame).length > OWNERSHIP_LIMITS.frameBytes) throw new OwnershipError("ownership_limit");
+	let decoded: unknown;
+	try { decoded = JSON.parse(frame); } catch { throw new OwnershipError("ownership_protocol"); }
+	const source = record(decoded, ["version", "id", "identity", "operation"]);
+	if (source.version !== OWNERSHIP_VERSION) throw new OwnershipError("dispatcher_mismatch");
+	const operation = record(source.operation, ["op", "scope", "generation"]);
+	let parsed: OwnershipOperation;
+	if (operation.op === "classify" && Object.keys(operation).length === 1) parsed = { op: "classify" };
+	else if ((operation.op === "prepare_helper" || operation.op === "helper_status") && Object.keys(operation).length === 2) {
+		parsed = { op: operation.op, generation: ownershipGeneration(operation.generation) };
+	}
+	else if (operation.op === "broker" && operation.generation === undefined) {
+		parsed = { op: "broker", scope: ownershipScope(operation.scope) };
+	} else if (operation.op === "publish") {
+		parsed = { op: "publish", scope: ownershipScope(operation.scope), generation: ownershipToken(operation.generation) };
+	} else throw new OwnershipError("ownership_protocol");
+	return { version: OWNERSHIP_VERSION, id: ownershipToken(source.id), identity: ownershipIdentity(source.identity), operation: parsed };
+}
+
+export function sameOwnershipScope(left: OwnershipScope, right: OwnershipScope): boolean {
+	return left.kind === "project" ? right.kind === "project" && left.directory === right.directory
+		: right.kind === "global" && left.service === right.service;
+}
+
+function registration(value: unknown): OwnershipRegistration {
+	const source = record(value, ["registration", "dispatcher", "policy", "generation"]);
+	if (source.policy !== "private" && source.policy !== "external") throw new OwnershipError("ownership_protocol");
+	return { registration: ownershipToken(source.registration), dispatcher: ownershipToken(source.dispatcher),
+		policy: source.policy, generation: ownershipToken(source.generation) };
+}
+
+function result(value: unknown, expected: OwnershipOperation): OwnershipResult {
+	const source = record(value, ["op", "registration", "scope", "generation", "runtimeDirectory", "token", "status"]);
+	if (source.op !== expected.op) throw new OwnershipError("ownership_protocol");
+	if (expected.op === "prepare_helper" && Object.keys(source).length === 2 && source.generation === expected.generation) {
+		return { op: "prepare_helper", generation: ownershipGeneration(source.generation) };
+	}
+	if (expected.op === "helper_status" && Object.keys(source).length === 3 && source.generation === expected.generation
+		&& (source.status === "pending" || source.status === "registered")) {
+		return { op: "helper_status", generation: ownershipGeneration(source.generation), status: source.status };
+	}
+	if (source.op === "classify" && Object.keys(source).length === 2) {
+		return { op: "classify", registration: registration(source.registration) };
+	}
+	if (source.op === "publish" && expected.op === "publish" && Object.keys(source).length === 2
+		&& source.generation === expected.generation) return { op: "publish", generation: expected.generation };
+	if (source.op !== "broker" || expected.op !== "broker" || Object.keys(source).length !== 5) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	const scope = ownershipScope(source.scope);
+	if (!sameOwnershipScope(scope, expected.scope)) throw new OwnershipError("ownership_protocol");
+	const directory = ownershipScope({ kind: "project", directory: source.runtimeDirectory });
+	if (directory.kind !== "project") throw new OwnershipError("ownership_protocol");
+	return { op: "broker", scope, generation: ownershipToken(source.generation), runtimeDirectory: directory.directory,
+		token: text(source.token, /^[a-f0-9]{64}$/) };
+}
+
+/** Validate correlation, matched release/schema and operation before any endpoint/token reaches a Native client. */
+export function decodeOwnershipResponse(frame: string, expected: OwnershipRequest): OwnershipResponse {
+	if (new TextEncoder().encode(frame).length > OWNERSHIP_LIMITS.frameBytes) throw new OwnershipError("ownership_limit");
+	let decoded: unknown;
+	try { decoded = JSON.parse(frame); } catch { throw new OwnershipError("ownership_protocol"); }
+	const source = record(decoded, ["version", "id", "ok", "identity", "result", "error"]);
+	if (source.version !== OWNERSHIP_VERSION || source.id !== expected.id) throw new OwnershipError("dispatcher_mismatch");
+	if (source.ok === false && Object.keys(source).length === 4) {
+		const code = errorCodes.find(code => code === source.error);
+		if (!code) throw new OwnershipError("ownership_protocol");
+		return { version: OWNERSHIP_VERSION, id: expected.id, ok: false, error: code };
+	}
+	if (source.ok !== true || Object.keys(source).length !== 5) throw new OwnershipError("ownership_protocol");
+	const identity = ownershipIdentity(source.identity);
+	if (identity.closure !== expected.identity.closure || identity.schema !== expected.identity.schema) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	return { version: OWNERSHIP_VERSION, id: expected.id, ok: true, identity, result: result(source.result, expected.operation) };
+}
