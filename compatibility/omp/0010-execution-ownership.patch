diff --git a/packages/coding-agent/src/launch/ownership/worker-bootstrap.ts b/packages/coding-agent/src/launch/ownership/worker-bootstrap.ts
new file mode 100644
index 0000000000..db94e7cd31
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/worker-bootstrap.ts
@@ -0,0 +1,150 @@
+import * as workerThreads from "node:worker_threads";
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+
+export interface OwnershipWorkerPort {
+	on(event: "message", listener: (value: unknown) => void): unknown;
+	off(event: "message", listener: (value: unknown) => void): unknown;
+}
+export interface OwnershipWorkerScope { onmessage: ((event: MessageEvent) => void) | null }
+interface BufferLimits { messages: number; bytes: number }
+
+/** Conservative logical payload accounting, including backing buffers, cycles and transferred public MessagePorts. */
+function payloadBytes(root: unknown, limit: number): number {
+	const pending = [{ value: root, depth: 0 }], seen = new Set<object>();
+	let bytes = 0, values = 0;
+	const add = (value: unknown, depth: number): void => {
+		if (pending.length >= OWNERSHIP_LIMITS.workerBootstrapValues) throw new OwnershipError("ownership_limit");
+		pending.push({ value, depth });
+	};
+	while (pending.length) {
+		const next = pending.pop();
+		if (!next) break;
+		const { value, depth } = next;
+		if (++values > OWNERSHIP_LIMITS.workerBootstrapValues || depth > 64 || bytes > limit) throw new OwnershipError("ownership_limit");
+		if (typeof value === "string" || typeof value === "bigint") {
+			const text = String(value);
+			if (text.length > limit - bytes) throw new OwnershipError("ownership_limit");
+			bytes += new TextEncoder().encode(text).byteLength; continue;
+		}
+		if (value === null || value === undefined || typeof value === "boolean" || typeof value === "number") { bytes += 8; continue; }
+		if (typeof value !== "object") throw new OwnershipError("ownership_protocol");
+		if (seen.has(value)) continue;
+		seen.add(value); bytes += 64;
+		if (value instanceof ArrayBuffer || value instanceof SharedArrayBuffer) bytes += value.byteLength;
+		else if (ArrayBuffer.isView(value)) add(value.buffer, depth + 1);
+		else if (value instanceof Blob) bytes += value.size;
+		else if (value instanceof workerThreads.MessagePort || value instanceof Date) continue;
+		else if (value instanceof Map) for (const [key, item] of value) { add(key, depth + 1); add(item, depth + 1); }
+		else if (value instanceof Set) for (const item of value) add(item, depth + 1);
+		else if (value instanceof Error) { add(value.message, depth + 1); add(value.stack, depth + 1); }
+		else for (const key in value) {
+			if (!Object.hasOwn(value, key)) continue;
+			const descriptor = Object.getOwnPropertyDescriptor(value, key);
+			if (!descriptor || !("value" in descriptor)) throw new OwnershipError("ownership_protocol");
+			add(key, depth + 1); add(descriptor.value, depth + 1);
+		}
+	}
+	if (bytes > limit) throw new OwnershipError("ownership_limit");
+	return bytes;
+}
+
+class BufferedMessages<T> {
+	readonly #limits: BufferLimits;
+	readonly #messages: T[] = [];
+	#bytes = 0;
+	#handler: ((value: T) => void) | undefined;
+	constructor(limits: BufferLimits) { this.#limits = limits; }
+	push(value: T, payload: unknown): void {
+		if (this.#handler) { this.#handler(value); return; }
+		if (this.#messages.length >= this.#limits.messages) throw new OwnershipError("ownership_limit");
+		this.#bytes += payloadBytes(payload, this.#limits.bytes - this.#bytes);
+		this.#messages.push(value);
+	}
+	bind(handler: (value: T) => void): void {
+		if (this.#handler) throw new OwnershipError("ownership_protocol");
+		this.#handler = handler;
+		for (const message of this.#messages) handler(message);
+		this.clear();
+	}
+	clear(): void { this.#messages.length = 0; this.#bytes = 0; }
+}
+
+/**
+ * Synchronous worker registration prefix. This buffers public event delivery only; it grants no policy itself.
+ * The existing central WorkerInbox receives its port adapter after async ownership initialization, exactly once.
+ */
+export class OwnershipWorkerBootstrap {
+	readonly #port: OwnershipWorkerPort | null;
+	readonly #scope: OwnershipWorkerScope;
+	readonly #previous: OwnershipWorkerScope["onmessage"];
+	readonly #portMessages: BufferedMessages<unknown>;
+	readonly #globalMessages: BufferedMessages<MessageEvent>;
+	readonly #portListener: (value: unknown) => void;
+	readonly #globalListener: (event: MessageEvent) => void;
+	#portAdopted = false;
+	#closed = false;
+	constructor(port: OwnershipWorkerPort | null, scope: OwnershipWorkerScope, limits: BufferLimits = {
+		messages: OWNERSHIP_LIMITS.workerBootstrapMessages, bytes: OWNERSHIP_LIMITS.workerBootstrapBytes,
+	}) {
+		if (!Number.isSafeInteger(limits.messages) || limits.messages < 1 || limits.messages > OWNERSHIP_LIMITS.workerBootstrapMessages
+			|| !Number.isSafeInteger(limits.bytes) || limits.bytes < 1 || limits.bytes > OWNERSHIP_LIMITS.workerBootstrapBytes) {
+			throw new OwnershipError("ownership_limit");
+		}
+		this.#port = port; this.#scope = scope; this.#previous = scope.onmessage;
+		const fixed = Object.freeze({ ...limits });
+		this.#portMessages = new BufferedMessages(fixed); this.#globalMessages = new BufferedMessages(fixed);
+		this.#portListener = value => this.#receive(() => this.#portMessages.push(value, value));
+		this.#globalListener = event => this.#receive(() => this.#globalMessages.push(event, event.data));
+		port?.on("message", this.#portListener); scope.onmessage = this.#globalListener;
+	}
+
+	adoptPort(port: OwnershipWorkerPort): Pick<OwnershipWorkerPort, "on"> | undefined {
+		this.assertCurrent();
+		if (port !== this.#port) return undefined;
+		return { on: (_event, listener) => {
+			if (this.#portAdopted) throw new OwnershipError("ownership_protocol");
+			this.#portAdopted = true; this.#portMessages.bind(listener);
+		} };
+	}
+
+	finish(): void {
+		this.assertCurrent();
+		if (this.#portAdopted) {
+			this.#globalMessages.clear();
+			if (this.#scope.onmessage === this.#globalListener) this.#scope.onmessage = this.#previous;
+		} else {
+			const handler = this.#scope.onmessage;
+			if (handler && handler !== this.#globalListener) this.#globalMessages.bind(handler);
+			else this.#globalMessages.clear();
+			this.#port?.off("message", this.#portListener); this.#portMessages.clear();
+			if (this.#scope.onmessage === this.#globalListener) this.#scope.onmessage = this.#previous;
+		}
+	}
+
+	close(): void {
+		if (this.#closed) return;
+		this.#closed = true; this.#port?.off("message", this.#portListener);
+		if (this.#scope.onmessage === this.#globalListener) this.#scope.onmessage = this.#previous;
+		this.#portMessages.clear(); this.#globalMessages.clear();
+	}
+	assertCurrent(): void { if (this.#closed) throw new OwnershipError("dispatcher_unavailable"); }
+	#receive(action: () => void): void {
+		if (this.#closed) return;
+		try { action(); } catch (error) { this.close(); throw error; }
+	}
+}
+
+let bootstrap: OwnershipWorkerBootstrap | undefined;
+/** Call synchronously in the pure CLI entry, before its first await. Main-thread/catalog/preflight reads do nothing. */
+export function prepareOwnershipWorkerBootstrap(): void {
+	if (Bun.isMainThread || bootstrap) return;
+	bootstrap = new OwnershipWorkerBootstrap(workerThreads.parentPort, globalThis as unknown as OwnershipWorkerScope);
+}
+/** Adapter for the upstream central installWorkerInbox; never replaces/duplicates its pending inbox. */
+export function ownershipWorkerPort(port: OwnershipWorkerPort): Pick<OwnershipWorkerPort, "on"> | undefined {
+	return bootstrap?.adoptPort(port);
+}
+export function assertOwnershipWorkerBootstrap(): void { bootstrap?.assertCurrent(); }
+/** Invoke only after cli-runtime's synchronous worker prefix has installed its actual buffering handlers. */
+export function finishOwnershipWorkerBootstrap(): void { bootstrap?.finish(); bootstrap = undefined; }
+export function cancelOwnershipWorkerBootstrap(): void { bootstrap?.close(); bootstrap = undefined; }
