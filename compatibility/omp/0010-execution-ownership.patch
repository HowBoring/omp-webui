+		const timer: Timer = setTimeout(() => controller.abort(), OWNERSHIP_LIMITS.requestMs);
+		try {
+			const exchange = Promise.resolve().then(() => {
+				if (this.#failed || controller.signal.aborted) throw new OwnershipError("dispatcher_unavailable");
+				return this.#transport.exchange(JSON.stringify(request), controller.signal);
+			});
+			const frame = await Promise.race([exchange, cancellation.promise]);
+			if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+			const response = decodeOwnershipResponse(frame, request);
+			if (!response.ok) throw new OwnershipError(response.error);
+			return response.result;
+		} catch (error) {
+			this.close();
+			if (error instanceof OwnershipError) throw error;
+			throw new OwnershipError("dispatcher_unavailable");
+		} finally {
+			clearTimeout(timer); controller.signal.removeEventListener("abort", abort);
+			this.#activeAbort = undefined; this.#busy = false;
+		}
+	}
+
+	#fail(code: "ownership_protocol" | "dispatcher_mismatch"): OwnershipError {
+		this.close(); return new OwnershipError(code);
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/context.ts b/packages/coding-agent/src/launch/ownership/context.ts
new file mode 100644
index 0000000000..2683a029e8
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/context.ts
@@ -0,0 +1,128 @@
+import { connectProcessOwnershipClient } from "./bootstrap";
+import type { OwnershipClient } from "./client";
+import { OWNERSHIP_LIMITS, OwnershipError, ownershipScope, type OwnershipErrorCode, type OwnershipIdentity,
+	type OwnershipRegistration, type OwnershipScope } from "./protocol";
+
+export type RegisteredExecutionOwnership = Readonly<OwnershipRegistration & {
+	status: "registered"; identity: Readonly<OwnershipIdentity>;
+}>;
+export type ProcessExecutionOwnership = RegisteredExecutionOwnership
+	| Readonly<{ status: "unavailable"; code: OwnershipErrorCode }>;
+export interface ExecutionBrokerSelection {
+	readonly scope: OwnershipScope;
+	readonly generation: string;
+	readonly runtimeDirectory: string;
+	readonly token: string;
+	readonly dispatcher: string;
+	readonly identity: Readonly<OwnershipIdentity>;
+}
+
+function unavailable(code: OwnershipErrorCode): ProcessExecutionOwnership {
+	return Object.freeze({ status: "unavailable", code });
+}
+
+/** Immutable process-policy module. Callers normalize before factories; pure getters never connect or create files. */
+export class ExecutionOwnershipContext {
+	readonly #client: OwnershipClient;
+	#state = unavailable("ownership_backend_unavailable");
+	#initialization: Promise<RegisteredExecutionOwnership> | undefined;
+	#brokerTail = Promise.resolve();
+	#brokerOutstanding = 0;
+	constructor(client: OwnershipClient) { this.#client = client; }
+
+	getExecutionOwnership(): ProcessExecutionOwnership { return this.#state; }
+	initializeExecutionOwnership(): Promise<RegisteredExecutionOwnership> {
+		this.#initialization ??= this.#initialize();
+		return this.#initialization;
+	}
+	async #initialize(): Promise<RegisteredExecutionOwnership> {
+		try {
+			const registration = await this.#client.classify();
+			const state = Object.freeze({ ...registration, status: "registered" as const, identity: this.#client.identity });
+			this.#state = state;
+			return state;
+		} catch (error) { throw this.#failure(error); }
+	}
+
+	requireExecutionOwnership(): RegisteredExecutionOwnership {
+		if (this.#state.status !== "registered") throw new OwnershipError(this.#state.code);
+		return this.#state;
+	}
+	requireSharedExecution(): RegisteredExecutionOwnership & { policy: "external" } {
+		const state = this.requireExecutionOwnership();
+		if (state.policy !== "external") throw new OwnershipError("shared_service_unsupported");
+		return Object.freeze({ ...state, policy: "external" as const });
+	}
+	async acquireExecutionBroker(scope: OwnershipScope): Promise<ExecutionBrokerSelection> {
+		this.requireSharedExecution();
+		const requested = ownershipScope(scope);
+		if (this.#brokerOutstanding >= OWNERSHIP_LIMITS.contextRequests) throw new OwnershipError("ownership_limit");
+		this.#brokerOutstanding++;
+		const result = Promise.withResolvers<ExecutionBrokerSelection>();
+		let expired = false, dispatched = false;
+		const timer: Timer = setTimeout(() => {
+			expired = true;
+			const error = new OwnershipError("dispatcher_unavailable");
+			result.reject(dispatched ? this.#failure(error) : error);
+		}, OWNERSHIP_LIMITS.requestMs);
+		this.#brokerTail = this.#brokerTail.then(async () => {
+			try {
+				if (expired) return;
+				const state = this.requireSharedExecution();
+				dispatched = true;
+				const grant = await this.#client.broker(requested);
+				if (!expired) result.resolve(Object.freeze({ scope: Object.freeze(grant.scope), generation: grant.generation,
+					runtimeDirectory: grant.runtimeDirectory, token: grant.token, dispatcher: state.dispatcher, identity: state.identity }));
+			} catch (error) { if (!expired) result.reject(this.#failure(error)); }
+			finally { clearTimeout(timer); this.#brokerOutstanding--; }
+		});
+		return result.promise;
+	}
+	#failure(error: unknown): OwnershipError {
+		const failure = error instanceof OwnershipError ? error : new OwnershipError("dispatcher_unavailable");
+		this.#state = unavailable(failure.code); this.#client.close();
+		return failure;
+	}
+}
+
+let processContext: ExecutionOwnershipContext | undefined;
+let initialization: Promise<RegisteredExecutionOwnership> | undefined;
+let initialState = unavailable("ownership_backend_unavailable");
+
+/** Pure read, including before initialization; unavailable is never silently interpreted as external/private fallback. */
+export function getExecutionOwnership(): ProcessExecutionOwnership {
+	return processContext?.getExecutionOwnership() ?? initialState;
+}
+
+/** Before normal CLI/strict graph imports and as the first SDK factory action, including every worker realm. */
+export function initializeExecutionOwnership(): Promise<RegisteredExecutionOwnership> {
+	initialization ??= connectProcessOwnershipClient().then(client => {
+		processContext = new ExecutionOwnershipContext(client);
+		return processContext.initializeExecutionOwnership();
+	}).catch((error: unknown) => {
+		const code = error instanceof OwnershipError ? error.code : "dispatcher_unavailable";
+		initialState = unavailable(code);
+		throw error;
+	});
+	return initialization;
+}
+
+export function requireExecutionOwnership(): RegisteredExecutionOwnership {
+	const state = getExecutionOwnership();
+	if (state.status !== "registered") throw new OwnershipError(state.code);
+	return state;
+}
+
+/** Guard before every shared factory/token/directory/connect/request/completion effect, including ping/reconnect. */
+export function requireSharedExecution(): RegisteredExecutionOwnership & { policy: "external" } {
+	const state = requireExecutionOwnership();
+	if (state.policy !== "external") throw new OwnershipError("shared_service_unsupported");
+	return Object.freeze({ ...state, policy: "external" as const });
+}
+
+/** Fixed Native dispatcher operation; never accepts executable/argv or a browser-supplied endpoint. */
+export async function acquireExecutionBroker(scope: OwnershipScope): Promise<ExecutionBrokerSelection> {
+	requireSharedExecution();
+	if (!processContext) throw new OwnershipError("ownership_backend_unavailable");
+	return processContext.acquireExecutionBroker(scope);
+}
diff --git a/packages/coding-agent/src/launch/ownership/dispatcher.ts b/packages/coding-agent/src/launch/ownership/dispatcher.ts
new file mode 100644
index 0000000000..d9c6607f9b
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/dispatcher.ts
@@ -0,0 +1,225 @@
+import {
+	decodeOwnershipRequest, OWNERSHIP_LIMITS, OWNERSHIP_VERSION, OwnershipError,
+	ownershipGeneration, ownershipIdentity, ownershipToken, sameOwnershipScope,
+	type OwnershipIdentity, type OwnershipRegistration, type OwnershipRequest, type OwnershipResponse,
+	type OwnershipResult, type OwnershipScope,
+} from "./protocol";
+import { HelperWireSession } from "./helper-protocol";
+
+/** Opaque retained OS peer identity, supplied only by the authenticated local transport, never decoded from wire. */
+export type StablePeer = object;
+export type PeerClassification =
+	| { kind: "external" } | { kind: "private"; generation: string } | { kind: "unresolved" };
+/** Backend must check synchronously at every spawn/publication barrier, after all awaited work. */
+export interface PublicationPermit { assertCurrent(): void }
+
+/**
+ * OS/durable-storage seam. The Linux adapter MUST obtain SO_PEERPIDFD, retain peer/ancestor pidfds,
+ * and recheck ancestry without trusting environment, numeric PID claims or command names.
+ * No implementation is admitted by this interface alone; a missing backend fails before serving.
+ */
+export interface OwnershipSystem {
+	readonly dispatcher: string;
+	/** Probe actual kernel operations and load durable fences. Any unresolved generation rejects startup. */
+	ready(): Promise<void>;
+	classify(peer: StablePeer): Promise<PeerClassification>;
+	/** Verify trusted supervisor/helper identities, retain pidfds and durably fsync an incomplete fence before return. */
+	protectHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void>;
+	/** Persist uncertainty. Failure must retain the existing incomplete fence; never erase it as recovery. */
+	markUnresolved(generation: string): Promise<void>;
+	/** Only authenticated helper root-reaped + closed-admission + P_ALL/ECHILD proof may clear/fsync the fence. */
+	completeHelper(helper: StablePeer, generation: string): Promise<void>;
+	/** Canonicalize and pin a real directory; no create-on-read or missing-path lexical fallback. */
+	canonicalScope(scope: OwnershipScope): Promise<OwnershipScope>;
+	/**
+	 * Fixed Native broker operation only. Before any spawn, protect the broker AND every permitted surviving
+	 * service lifetime with independent maintenance leases/durable fences outside all private helper domains.
+	 * Unknown start outcome retains its fence. Never accept arbitrary argv from this interface.
+	 */
+	broker(scope: OwnershipScope, permit: PublicationPermit): Promise<{ generation: string; runtimeDirectory: string; token: string }>;
+	/** Verify exact owned broker pidfd, scope, release/schema and independent protector before publication. */
+	publish(peer: StablePeer, scope: OwnershipScope, generation: string, permit: PublicationPermit): Promise<void>;
+}
+
+/** Public Native dispatcher decision module. No process launch or signaling authority is granted to Host/browser. */
+export class OwnershipDispatcher {
+	readonly #identity: OwnershipIdentity;
+	readonly #system: OwnershipSystem;
+	readonly #helpers = new Map<StablePeer, string>();
+	readonly #helperControllers = new Map<string, StablePeer>();
+	readonly #pendingHelpers = new Map<string, StablePeer>();
+	readonly #helperGenerations = new Set<string>();
+	readonly #registrations = new Map<StablePeer, OwnershipRegistration>();
+	readonly #helperSockets = new WeakMap<HelperWireSession, StablePeer>();
+	#blocked = false;
+	#busy = false;
+	#ready = false;
+
+	constructor(identity: OwnershipIdentity, system: OwnershipSystem) {
+		this.#identity = Object.freeze(ownershipIdentity(identity));
+		this.#system = system;
+		ownershipToken(system.dispatcher);
+	}
+
+	static async open(identity: OwnershipIdentity, system: OwnershipSystem): Promise<OwnershipDispatcher> {
+		const dispatcher = new OwnershipDispatcher(identity, system);
+		await system.ready();
+		dispatcher.#ready = true;
+		return dispatcher;
+	}
+
+	/** Trusted supervisor control seam, separate from the ordinary client socket. Return releases no worker itself. */
+	async registerHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void> {
+		return this.#serial(async () => {
+			this.#assertAvailable(); ownershipGeneration(generation);
+			if (this.#pendingHelpers.get(generation) !== control) throw new OwnershipError("ownership_unresolved");
+			if (this.#helpers.has(helper) || [...this.#helpers.values()].includes(generation)) {
+				throw new OwnershipError("ownership_protocol");
+			}
+			if (this.#helpers.size >= OWNERSHIP_LIMITS.helpers) throw new OwnershipError("ownership_limit");
+			try { await this.#system.protectHelper(control, helper, generation); }
+			catch (error) { this.#blocked = true; throw error; }
+			this.#assertAvailable();
+			this.#helpers.set(helper, generation);
+			this.#helperControllers.set(generation, control);
+			this.#pendingHelpers.delete(generation);
+		});
+	}
+
+	/** Active helper socket supplies the actual helper peer; its Host is selected from the prior authenticated prepare. */
+	async registerHelperPeer(helper: StablePeer, generation: string): Promise<void> {
+		const control = this.#pendingHelpers.get(ownershipGeneration(generation));
+		if (!control) throw new OwnershipError("ownership_unresolved");
+		await this.registerHelper(control, helper, generation);
+	}
+
+	/** One actual helper socket, routed separately from ordinary Native operations; no claimed PID is decoded. */
+	async handleHelper(peer: StablePeer, session: HelperWireSession, frame: string): Promise<string> {
+		const bound = this.#helperSockets.get(session);
+		if (bound && bound !== peer) throw new OwnershipError("ownership_unresolved");
+		this.#helperSockets.set(session, peer);
+		const request = session.decode(frame);
+		if (request.operation.op === "register_helper") await this.registerHelperPeer(peer, request.operation.generation);
+		else {
+			if (this.#helpers.get(peer) !== request.operation.generation) throw new OwnershipError("ownership_unresolved");
+			await this.completeHelper(peer);
+		}
+		return session.acknowledge(request);
+	}
+
+	/** Helper loss fences globally before storage I/O; no new shared registration may exploit orphan reparenting. */
+	async helperUncertain(helper: StablePeer): Promise<void> {
+		this.#blocked = true;
+		const generation = this.#helpers.get(helper);
+		if (!generation) throw new OwnershipError("ownership_unresolved");
+		await this.#system.markUnresolved(generation);
+	}
+
+	/** Failed/unavailable extinction proof remains incomplete and cannot be reset through the client protocol. */
+	async completeHelper(helper: StablePeer): Promise<void> {
+		return this.#serial(async () => {
+			const generation = this.#helpers.get(helper);
+			if (!generation) throw new OwnershipError("ownership_unresolved");
+			try { await this.#system.completeHelper(helper, generation); }
+			catch (error) { this.#blocked = true; throw error; }
+			this.#helpers.delete(helper);
+			this.#helperControllers.delete(generation);
+		});
+	}
+
+	/** Each request, including reconnect/publish, is classified from the actual authenticated peer again. */
+	async handle(peer: StablePeer, frame: string): Promise<OwnershipResponse> {
+		const request = decodeOwnershipRequest(frame);
+		try {
+			const result = await this.#serial(() => this.#dispatch(peer, request));
+			return { version: OWNERSHIP_VERSION, id: request.id, ok: true, identity: this.#identity, result };
+		} catch (error) {
+			return { version: OWNERSHIP_VERSION, id: request.id, ok: false,
+				error: error instanceof OwnershipError ? error.code : "ownership_unresolved" };
+		}
+	}
+
+	async #dispatch(peer: StablePeer, request: OwnershipRequest): Promise<OwnershipResult> {
+		this.#assertAvailable();
+		if (request.identity.closure !== this.#identity.closure || request.identity.schema !== this.#identity.schema) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		const registration = await this.#registration(peer);
+		this.#assertAvailable();
+		if (request.operation.op === "classify") return { op: "classify", registration };
+		if (registration.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if (request.operation.op === "prepare_helper") return this.#prepareHelper(peer, request.operation.generation);
+		if (request.operation.op === "helper_status") return this.#helperStatus(peer, request.operation.generation);
+		const scope = await this.#system.canonicalScope(request.operation.scope);
+		if (!sameOwnershipScope(scope, request.operation.scope)) throw new OwnershipError("ownership_unresolved");
+		this.#assertAvailable();
+		const permit: PublicationPermit = { assertCurrent: () => this.#assertAvailable() };
+		try {
+			if (request.operation.op === "publish") {
+				await this.#system.publish(peer, scope, request.operation.generation, permit);
+				this.#assertAvailable();
+				return { op: "publish", generation: request.operation.generation };
+			}
+			const broker = await this.#system.broker(scope, permit);
+			this.#assertAvailable();
+			return { op: "broker", scope, ...broker };
+		} catch (error) {
+			// A lost backend answer can follow an irreversible spawn. Only durable operator recovery can reopen.
+			this.#blocked = true;
+			throw error;
+		}
+	}
+
+	#prepareHelper(control: StablePeer, generation: string): OwnershipResult {
+		if (this.#helperGenerations.has(generation)) throw new OwnershipError("ownership_protocol");
+		if (this.#pendingHelpers.size + this.#helpers.size >= OWNERSHIP_LIMITS.helpers
+			|| this.#helperGenerations.size >= OWNERSHIP_LIMITS.helperGenerations) throw new OwnershipError("ownership_limit");
+		this.#helperGenerations.add(generation);
+		this.#pendingHelpers.set(generation, control);
+		return { op: "prepare_helper", generation };
+	}
+
+	async #helperStatus(control: StablePeer, generation: string): Promise<OwnershipResult> {
+		if (this.#pendingHelpers.get(generation) === control) return { op: "helper_status", generation, status: "pending" };
+		if (this.#helperControllers.get(generation) !== control) throw new OwnershipError("ownership_unresolved");
+		const helper = [...this.#helpers].find(([, value]) => value === generation)?.[0];
+		if (!helper) throw new OwnershipError("ownership_unresolved");
+		const facts = await this.#system.classify(helper);
+		if (facts.kind !== "private" || facts.generation !== generation) {
+			await this.helperUncertain(helper);
+			throw new OwnershipError("ownership_unresolved");
+		}
+		this.#assertAvailable();
+		return { op: "helper_status", generation, status: "registered" };
+	}
+
+	async #registration(peer: StablePeer): Promise<OwnershipRegistration> {
+		const facts = await this.#system.classify(peer);
+		if (facts.kind === "unresolved" || (facts.kind === "private" && ![...this.#helpers.values()].includes(facts.generation))) {
+			throw new OwnershipError("ownership_unresolved");
+		}
+		const existing = this.#registrations.get(peer);
+		if (existing) {
+			if (existing.policy !== facts.kind || (facts.kind === "private" && existing.generation !== facts.generation)) {
+				this.#blocked = true;
+				throw new OwnershipError("ownership_unresolved");
+			}
+			return existing;
+		}
+		if (this.#registrations.size >= OWNERSHIP_LIMITS.registrations) throw new OwnershipError("ownership_limit");
+		const registration = Object.freeze({ registration: crypto.randomUUID(), dispatcher: this.#system.dispatcher,
+			policy: facts.kind, generation: facts.kind === "private" ? facts.generation : crypto.randomUUID() });
+		this.#registrations.set(peer, registration);
+		return registration;
+	}
+
+	#assertAvailable(): void {
+		if (!this.#ready) throw new OwnershipError("ownership_backend_unavailable");
+		if (this.#blocked) throw new OwnershipError("maintenance_fenced");
+	}
+	async #serial<T>(operation: () => Promise<T>): Promise<T> {
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		try { return await operation(); } finally { this.#busy = false; }
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/entry.ts b/packages/coding-agent/src/launch/ownership/entry.ts
new file mode 100644
index 0000000000..b00b709cc8
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/entry.ts
@@ -0,0 +1,10 @@
+import { OwnershipError } from "./protocol";
+
+/**
+ * Public independent dispatcher entry. Source preparation deliberately admits no OS backend yet.
+ * A backend must prove SO_PEERPIDFD, durable fences and external lifetime protectors before replacing this refusal.
+ * This entry must never load the Session/UI/provider graph or silently become a client-side broker spawner.
+ */
+export async function startOwnershipDispatcher(): Promise<never> {
+	throw new OwnershipError("ownership_backend_unavailable");
+}
diff --git a/packages/coding-agent/src/launch/ownership/fences.ts b/packages/coding-agent/src/launch/ownership/fences.ts
new file mode 100644
index 0000000000..adbb1f4496
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/fences.ts
@@ -0,0 +1,150 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { OWNERSHIP_LIMITS, OwnershipError, ownershipGeneration, ownershipIdentity,
+	type OwnershipIdentity } from "./protocol";
+
+export interface OwnershipFenceApproval {
+	/** Stable independently pinned directory OUTSIDE the mutable release and private helper's own fence directory. */
+	directory: { path: string; device: string; inode: string };
+	releaseRoot: string;
+	installation: string;
+	identity: OwnershipIdentity;
+}
+interface HeldFence { file: fs.promises.FileHandle; device: bigint; inode: bigint }
+
+/**
+ * Public Native durable lifecycle metadata, never Session history or PID signal authority.
+ * Opening a nonempty directory fails closed: restart cannot silently adopt/erase an incomplete generation.
+ * A concrete backend must also retain maintenance protection and independently validate actual helper extinction.
+ */
+export class OwnershipFences {
+	readonly #approval: OwnershipFenceApproval;
+	readonly #directory: fs.promises.FileHandle;
+	readonly #fences = new Map<string, HeldFence>();
+	#closed = false;
+	#blocked = false;
+	#busy = false;
+
+	constructor(approval: OwnershipFenceApproval, directory: fs.promises.FileHandle) {
+		ownershipGeneration(approval.installation);
+		this.#approval = Object.freeze({ ...approval, directory: Object.freeze({ ...approval.directory }),
+			identity: Object.freeze(ownershipIdentity(approval.identity)) });
+		this.#directory = directory;
+	}
+
+	static async open(approval: OwnershipFenceApproval): Promise<OwnershipFences> {
+		ownershipGeneration(approval.installation);
+		for (const value of [approval.directory.path, approval.releaseRoot]) {
+			if (!path.isAbsolute(value) || path.resolve(value) !== value) throw new OwnershipError("maintenance_fenced");
+		}
+		if (approval.directory.path === approval.releaseRoot || approval.directory.path.startsWith(`${approval.releaseRoot}/`)
+			|| !/^\d+$/.test(approval.directory.device) || !/^[1-9]\d*$/.test(approval.directory.inode)) {
+			throw new OwnershipError("maintenance_fenced");
+		}
+		const directory = await fs.promises.open(approval.directory.path,
+			fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+		const fences = new OwnershipFences(approval, directory);
+		try { await fences.verify(); return fences; }
+		catch (error) { await fences.close(); throw error; }
+	}
+
+	async verify(): Promise<void> { await this.#operation(() => this.#verify()); }
+
+	/** Durably record uncertainty BEFORE publication/worker START. A failed write leaves its partial fence intact. */
+	async create(generation: string, kind: "private-helper" | "external-lifetime"): Promise<void> {
+		await this.#operation(async () => {
+			ownershipGeneration(generation);
+			if (kind !== "private-helper" && kind !== "external-lifetime") throw new OwnershipError("ownership_protocol");
+			await this.#verify();
+			if (this.#fences.has(generation) || this.#fences.size >= OWNERSHIP_LIMITS.helperGenerations) {
+				throw new OwnershipError("ownership_limit");
+			}
+			const file = await fs.promises.open(this.#file(generation),
+				fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);
+			let retained = false;
+			try {
+				const stat = await file.stat({ bigint: true });
+				this.#fences.set(generation, { file, device: stat.dev, inode: stat.ino }); retained = true;
+				await file.writeFile(JSON.stringify({ version: "omp-execution-fence/1", installation: this.#approval.installation,
+					identity: this.#approval.identity, kind, generation, state: "incomplete" }) + "\n");
+				await file.sync(); await this.#directory.sync();
+				await this.#verify();
+			} catch (error) { if (!retained) await file.close(); throw error; }
+		});
+	}
+
+	/**
+	 * Storage retirement only, after the trusted backend has accepted the actual helper's extinction proof.
+	 * This method supplies no process ownership/proof itself. Caller retains maintenance protection through return.
+	 */
+	async retireCompleted(generation: string): Promise<void> {
+		await this.#operation(async () => {
+			ownershipGeneration(generation);
+			await this.#verify();
+			const held = this.#fences.get(generation);
+			if (!held) throw new OwnershipError("maintenance_fenced");
+			await fs.promises.unlink(this.#file(generation));
+			await this.#directory.sync();
+			await held.file.close();
+			this.#fences.delete(generation);
+			await this.#verify();
+		});
+	}
+
+	/** Closes owned metadata descriptors only; files remain. This never proves process extinction. */
+	async close(): Promise<void> {
+		if (this.#closed) return;
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#closed = true;
+		const results = await Promise.allSettled([...this.#fences.values()].map(value => value.file.close()));
+		await this.#directory.close(); this.#fences.clear();
+		if (results.some(result => result.status === "rejected")) throw new OwnershipError("ownership_unresolved");
+	}
+
+	#file(generation: string): string { return path.join(this.#approval.directory.path, `dispatcher-${generation}.json`); }
+
+	async #verifyDirectory(): Promise<void> {
+		const approval = this.#approval.directory, uid = process.getuid?.();
+		if (uid === undefined || await fs.promises.realpath(approval.path) !== approval.path) {
+			throw new OwnershipError("maintenance_fenced");
+		}
+		const stats = [await fs.promises.lstat(approval.path, { bigint: true }), await this.#directory.stat({ bigint: true })];
+		for (const stat of stats) {
+			if (!stat.isDirectory() || String(stat.dev) !== approval.device || String(stat.ino) !== approval.inode
+				|| stat.uid !== BigInt(uid) || (stat.mode & 0o777n) !== 0o700n) throw new OwnershipError("maintenance_fenced");
+		}
+	}
+
+	async #verify(): Promise<void> {
+		await this.#verifyDirectory();
+		let count = 0;
+		const directory = await fs.promises.opendir(this.#approval.directory.path);
+		try {
+			while (true) {
+				const entry = await directory.read();
+				if (!entry) break;
+				if (++count > OWNERSHIP_LIMITS.helperGenerations) throw new OwnershipError("ownership_limit");
+				const generation = /^dispatcher-([a-f0-9]{64})\.json$/.exec(entry.name)?.[1];
+				const held = generation ? this.#fences.get(generation) : undefined;
+				if (!generation || !held) throw new OwnershipError("maintenance_fenced");
+				const stats = [await fs.promises.lstat(this.#file(generation), { bigint: true }), await held.file.stat({ bigint: true })];
+				for (const stat of stats) {
+					if (!stat.isFile() || stat.nlink !== 1n || stat.dev !== held.device || stat.ino !== held.inode
+						|| stat.uid !== BigInt(process.getuid?.() ?? -1) || (stat.mode & 0o777n) !== 0o600n
+						|| stat.size > 2048n) throw new OwnershipError("maintenance_fenced");
+				}
+			}
+		} finally { await directory.close(); }
+		if (count !== this.#fences.size) throw new OwnershipError("maintenance_fenced");
+		await this.#verifyDirectory();
+	}
+
+	async #operation<T>(action: () => Promise<T>): Promise<T> {
+		if (this.#closed || this.#blocked) throw new OwnershipError("maintenance_fenced");
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		try { return await action(); }
+		catch (error) { this.#blocked = true; throw error; }
+		finally { this.#busy = false; }
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/framing.ts b/packages/coding-agent/src/launch/ownership/framing.ts
new file mode 100644
index 0000000000..2a1ca28fe7
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/framing.ts
@@ -0,0 +1,32 @@
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+
+/** Bounded LF framing. A transport must also bound its receive queue and close on any thrown error. */
+export class OwnershipFrames {
+	readonly #bytes = new Uint8Array(OWNERSHIP_LIMITS.frameBytes);
+	#used = 0;
+	#ended = false;
+
+	push(chunk: Uint8Array): string[] {
+		if (this.#ended) throw new OwnershipError("ownership_protocol");
+		// More than one maximum-sized frame is never an admitted per-connection queue.
+		if (chunk.byteLength + this.#used > OWNERSHIP_LIMITS.queuedBytesPerConnection) throw new OwnershipError("ownership_limit");
+		const frames: string[] = [];
+		for (const byte of chunk) {
+			if (byte !== 10) {
+				if (this.#used === this.#bytes.length) throw new OwnershipError("ownership_limit");
+				this.#bytes[this.#used++] = byte;
+				continue;
+			}
+			if (frames.length === OWNERSHIP_LIMITS.pendingPerConnection) throw new OwnershipError("ownership_limit");
+			try { frames.push(new TextDecoder("utf-8", { fatal: true }).decode(this.#bytes.subarray(0, this.#used))); }
+			catch { throw new OwnershipError("ownership_protocol"); }
+			this.#used = 0;
+		}
+		return frames;
+	}
+
+	end(): void {
+		this.#ended = true;
+		if (this.#used !== 0) throw new OwnershipError("ownership_protocol");
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/helper-protocol.ts b/packages/coding-agent/src/launch/ownership/helper-protocol.ts
new file mode 100644
index 0000000000..5f7910ccd6
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/helper-protocol.ts
@@ -0,0 +1,76 @@
+import { OwnershipError, ownershipGeneration } from "./protocol";
+
+/** Fixed canonical C-helper protocol, routed by version at the selected ownership endpoint. No closure hash cycle. */
+export const HELPER_OWNERSHIP_VERSION = "omp-execution-helper/1";
+export const HELPER_OWNERSHIP_FRAME_BYTES = 512;
+export interface HelperOwnershipRequest {
+	version: typeof HELPER_OWNERSHIP_VERSION;
+	id: string;
+	installation: string;
+	operation: { op: "register_helper" | "complete_helper"; generation: string };
+}
+
+function record(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) throw new OwnershipError("ownership_protocol");
+	const result = value as Record<string, unknown>;
+	if (Object.keys(result).length !== keys.length || Object.keys(result).some(key => !keys.includes(key))) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	return result;
+}
+export function helperOwnershipGeneration(value: unknown): string {
+	return ownershipGeneration(value);
+}
+
+/** Decode one frame excluding LF; the C protocol's 512-byte budget includes that LF. */
+export function decodeHelperRequest(frame: string, installation: string): HelperOwnershipRequest {
+	if (new TextEncoder().encode(frame).length >= HELPER_OWNERSHIP_FRAME_BYTES) throw new OwnershipError("ownership_limit");
+	let value: unknown;
+	try { value = JSON.parse(frame); } catch { throw new OwnershipError("ownership_protocol"); }
+	const source = record(value, ["version", "id", "installation", "operation"]);
+	if (source.version !== HELPER_OWNERSHIP_VERSION || source.installation !== helperOwnershipGeneration(installation)) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	const operation = record(source.operation, ["op", "generation"]);
+	if (operation.op !== "register_helper" && operation.op !== "complete_helper") throw new OwnershipError("ownership_protocol");
+	const generation = helperOwnershipGeneration(operation.generation);
+	const id = helperOwnershipGeneration(source.id);
+	if (id === generation) throw new OwnershipError("ownership_protocol");
+	return Object.freeze({ version: HELPER_OWNERSHIP_VERSION, id, installation,
+		operation: Object.freeze({ op: operation.op, generation }) });
+}
+
+/** Exact canonical success bytes; called only after authenticated peer verification and durable system action. */
+export function encodeHelperSuccess(request: HelperOwnershipRequest): string {
+	return JSON.stringify({ version: HELPER_OWNERSHIP_VERSION, id: request.id, ok: true,
+		operation: request.operation.op, generation: request.operation.generation }) + "\n";
+}
+
+/** A stale success, duplicate phase, wrong operation or wrong generation never grants START/extinction. */
+export function verifyHelperAcknowledgement(frame: string, expected: HelperOwnershipRequest): void {
+	if (frame !== encodeHelperSuccess(expected)) throw new OwnershipError("dispatcher_mismatch");
+}
+
+/** One authenticated helper socket, retained REGISTER through COMPLETE; acknowledge only after durable system work. */
+export class HelperWireSession {
+	readonly #installation: string;
+	#registered: HelperOwnershipRequest | undefined;
+	#pending: HelperOwnershipRequest | undefined;
+	#complete = false;
+	constructor(installation: string) { this.#installation = helperOwnershipGeneration(installation); }
+	decode(frame: string): HelperOwnershipRequest {
+		if (this.#pending || this.#complete) throw new OwnershipError("ownership_protocol");
+		const request = decodeHelperRequest(frame, this.#installation), old = this.#registered;
+		if (!old ? request.operation.op !== "register_helper"
+			: request.operation.op !== "complete_helper" || request.id === old.id
+				|| request.operation.generation !== old.operation.generation) throw new OwnershipError("ownership_protocol");
+		this.#pending = request;
+		return request;
+	}
+	acknowledge(request: HelperOwnershipRequest): string {
+		if (this.#pending !== request) throw new OwnershipError("ownership_protocol");
+		this.#pending = undefined;
+		if (request.operation.op === "register_helper") this.#registered = request; else this.#complete = true;
+		return encodeHelperSuccess(request);
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/linux-bridge.c b/packages/coding-agent/src/launch/ownership/linux-bridge.c
new file mode 100644
index 0000000000..f2952b794f
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/linux-bridge.c
@@ -0,0 +1,339 @@
+/* Native execution ownership ABI 1. COMPILE-ONLY PREPARATION: no kernel-validated capability.
+ * No Agent, Session, provider, arbitrary executable, environment or signal operation lives here.
+ * All descriptors stay inside this library. Callers receive checked table handles, never raw fds.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#ifndef SO_PEERPIDFD
+#define SO_PEERPIDFD 77
+#endif
+
+#define OWNERSHIP_HANDLES 1024
+#define OWNERSHIP_FDS 2048
+#define OWNERSHIP_CONNECTIONS 64
+#define OWNERSHIP_ANCESTORS 256
+#define OWNERSHIP_HELPERS 64
+#define OWNERSHIP_FRAME 16384
+
+enum handle_kind { UNUSED = 0, LISTENER = 1, CONNECTION = 2, IDENTITY = 3, CONNECTING = 4 };
+struct handle { enum handle_kind kind; int fd; int peerfd; pid_t pid; uint64_t start; int key; };
+struct task { int fd; pid_t pid; pid_t parent; uint64_t start; };
+static struct handle handles[OWNERSHIP_HANDLES];
+static unsigned descriptor_count;
+static unsigned connection_count;
+static unsigned handle_serial;
+
+static int failure(void) { return -(errno ? errno : EIO); }
+static void drop_fd(int fd) {
+	if (fd < 0) return;
+	/* Retrying close after EINTR can close a reused Linux fd. Ownership ends after this close. */
+	(void)close(fd);
+	if (descriptor_count) descriptor_count--;
+}
+static int own_fd(int fd) {
+	if (fd < 0) return failure();
+	if (descriptor_count >= OWNERSHIP_FDS) { (void)close(fd); return -EMFILE; }
+	descriptor_count++;
+	return fd;
+}
+static int pidfd_open_owned(pid_t pid) {
+#ifdef SYS_pidfd_open
+	return own_fd((int)syscall(SYS_pidfd_open, pid, 0));
+#else
+	(void)pid; return -ENOSYS;
+#endif
+}
+static struct handle *lookup(int key, enum handle_kind kind) {
+	if (key <= 0) return NULL;
+	struct handle *value = &handles[(key - 1) % OWNERSHIP_HANDLES];
+	return value->key == key && value->kind == kind ? value : NULL;
+}
+static int keep(enum handle_kind kind, int fd, int peerfd, pid_t pid, uint64_t start) {
+	if (handle_serial >= (unsigned)(INT_MAX / OWNERSHIP_HANDLES) - 1) {
+		drop_fd(fd); drop_fd(peerfd); return -EOVERFLOW;
+	}
+	for (unsigned i = 0; i < OWNERSHIP_HANDLES; i++) {
+		if (handles[i].kind != UNUSED) continue;
+		int key = (int)(++handle_serial * OWNERSHIP_HANDLES + i + 1);
+		handles[i] = (struct handle){ kind, fd, peerfd, pid, start, key };
+		if (kind == CONNECTION || kind == CONNECTING) connection_count++;
+		return key;
+	}
+	drop_fd(fd); drop_fd(peerfd);
+	return -EMFILE;
+}
+static int alive(int fd) {
+	struct pollfd pollfd = { .fd = fd, .events = POLLIN };
+	int result = poll(&pollfd, 1, 0);
+	if (result < 0) return failure();
+	/* pidfds become readable at exit. HUP/ERR/NVAL never grant classification authority. */
+	return result == 0 ? 1 : -ESTALE;
+}
+static int same_pid_namespace(pid_t pid) {
+	char name[64];
+	struct stat self, other;
+	if (snprintf(name, sizeof(name), "/proc/%ld/ns/pid", (long)pid) >= (int)sizeof(name)) return -EOVERFLOW;
+	if (stat("/proc/self/ns/pid", &self) || stat(name, &other)) return failure();
+	return self.st_dev == other.st_dev && self.st_ino == other.st_ino ? 0 : -EXDEV;
+}
+static int read_task(pid_t pid, int pidfd, struct task *task) {
+	char name[64], bytes[4096];
+	if (alive(pidfd) < 0) return -ESTALE;
+	if (snprintf(name, sizeof(name), "/proc/%ld/stat", (long)pid) >= (int)sizeof(name)) return -EOVERFLOW;
+	int fd = own_fd(open(name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+	if (fd < 0) return fd;
+	ssize_t size = read(fd, bytes, sizeof(bytes) - 1);
+	int saved = errno;
+	drop_fd(fd); errno = saved;
+	if (size < 0) return failure();
+	if (size == 0 || size >= (ssize_t)sizeof(bytes) - 1) return -EPROTO;
+	bytes[size] = '\0';
+	/* comm can contain spaces, newlines and ')'; stat fields begin after its final ')'. */
+	char *cursor = strrchr(bytes, ')');
+	if (!cursor || cursor + 3 >= bytes + size || cursor[1] != ' ' || cursor[2] == '\0' || cursor[3] != ' ') return -EPROTO;
+	cursor += 4; /* field 4 (ppid), after field 3 (state) */
+	uint64_t parent = 0, start = 0;
+	for (unsigned field = 4; field <= 22; field++) {
+		if (*cursor == '\0' || *cursor == '\n') return -EPROTO;
+		char *end;
+		if (field == 4 || field == 22) {
+			errno = 0;
+			if (*cursor < '0' || *cursor > '9') return -EPROTO;
+			unsigned long long value = strtoull(cursor, &end, 10);
+			if (errno || end == cursor || (*end != ' ' && *end != '\n' && *end != '\0')) return -EPROTO;
+			if (field == 4) parent = value; else start = value;
+		} else {
+			end = strchr(cursor, ' ');
+			if (!end) return -EPROTO;
+		}
+		cursor = end;
+		while (*cursor == ' ') cursor++;
+	}
+	if (parent > INT_MAX || start == 0 || alive(pidfd) < 0) return -ESTALE;
+	*task = (struct task){ .fd = pidfd, .pid = pid, .parent = (pid_t)parent, .start = start };
+	return 0;
+}
+static int peer_identity(int fd, uid_t expected_uid, int *peerfd, pid_t *pid, uint64_t *start) {
+	struct ucred credential;
+	socklen_t size = sizeof(credential);
+	if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credential, &size)) return failure();
+	if (size != sizeof(credential) || credential.uid != expected_uid || credential.pid <= 0) return -EACCES;
+	/* Validate namespace on authenticated peers. Ancestors may be root-owned with unreadable ns links. */
+	if (same_pid_namespace(credential.pid) < 0) return -EXDEV;
+	int obtained = -1;
+	size = sizeof(obtained);
+	if (getsockopt(fd, SOL_SOCKET, SO_PEERPIDFD, &obtained, &size)) return failure();
+	int owned = own_fd(obtained);
+	if (owned < 0) return owned;
+	if (size != sizeof(obtained)) { drop_fd(owned); return -EPROTO; }
+	int flags = fcntl(owned, F_GETFD);
+	if (flags < 0 || fcntl(owned, F_SETFD, flags | FD_CLOEXEC) < 0) { int error = failure(); drop_fd(owned); return error; }
+	struct task task;
+	int result = read_task(credential.pid, owned, &task);
+	if (result < 0) { drop_fd(owned); return result; }
+	*peerfd = owned; *pid = credential.pid; *start = task.start;
+	return 0;
+}
+
+int omp_ownership_abi(void) { return 1; }
+unsigned omp_ownership_fd_count(void) { return descriptor_count; }
+
+/* Real operation probe, never inferred from a version string. The caller still needs lifecycle fixtures. */
+int omp_ownership_probe(void) {
+	int pair[2];
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0, pair)) return failure();
+	int left = own_fd(pair[0]);
+	int right = own_fd(pair[1]);
+	if (left < 0 || right < 0) { if (left >= 0) drop_fd(left); if (right >= 0) drop_fd(right); return -EMFILE; }
+	int identity = -1; pid_t pid; uint64_t start;
+	int result = peer_identity(left, getuid(), &identity, &pid, &start);
+	drop_fd(identity); drop_fd(left); drop_fd(right);
+	return result;
+}
+
+/* Parent directories/ownership/mode and maintenance fencing MUST be verified by the selected Native adapter first.
+ * Existing endpoint is never unlinked or replaced; operator recovery handles stale/unknown listeners. */
+int omp_ownership_listen(const char *endpoint) {
+	if (!endpoint || endpoint[0] != '/' || strlen(endpoint) >= sizeof(((struct sockaddr_un *)0)->sun_path)) return -EINVAL;
+	int fd = own_fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0));
+	if (fd < 0) return fd;
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	memcpy(address.sun_path, endpoint, strlen(endpoint) + 1);
+	if (bind(fd, (struct sockaddr *)&address, sizeof(address)) || chmod(endpoint, 0600) || listen(fd, OWNERSHIP_CONNECTIONS)) {
+		int error = failure(); drop_fd(fd); return error;
+	}
+	return keep(LISTENER, fd, -1, 0, 0);
+}
+
+int omp_ownership_accept(int listener, unsigned expected_uid) {
+	struct handle *source = lookup(listener, LISTENER);
+	if (!source) return -EBADF;
+	if (connection_count >= OWNERSHIP_CONNECTIONS) return -EMFILE;
+	int raw = accept4(source->fd, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+	if (raw < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return 0;
+	int fd = own_fd(raw);
+	if (fd < 0) return fd;
+	int peerfd = -1; pid_t pid; uint64_t start;
+	int result = peer_identity(fd, (uid_t)expected_uid, &peerfd, &pid, &start);
+	if (result < 0) { drop_fd(fd); return result; }
+	return keep(CONNECTION, fd, peerfd, pid, start);
+}
+
+/* Nonblocking client connection; the Native caller enforces the fixed one-second total connect deadline. */
+int omp_ownership_connect_begin(const char *endpoint) {
+	if (!endpoint || endpoint[0] != '/' || strlen(endpoint) >= sizeof(((struct sockaddr_un *)0)->sun_path)) return -EINVAL;
+	if (connection_count >= OWNERSHIP_CONNECTIONS) return -EMFILE;
+	int fd = own_fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0));
+	if (fd < 0) return fd;
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	memcpy(address.sun_path, endpoint, strlen(endpoint) + 1);
+	if (connect(fd, (struct sockaddr *)&address, sizeof(address)) && errno != EINPROGRESS) {
+		int error = failure(); drop_fd(fd); return error;
+	}
+	return keep(CONNECTING, fd, -1, 0, 0);
+}
+int omp_ownership_connect_ready(int connection, unsigned expected_uid) {
+	struct handle *source = lookup(connection, CONNECTING);
+	if (!source) return -EBADF;
+	struct pollfd descriptor = { .fd = source->fd, .events = POLLOUT };
+	int polled = poll(&descriptor, 1, 0);
+	if (polled < 0) return failure();
+	if (polled == 0) return 0;
+	int error = 0;
+	socklen_t size = sizeof(error);
+	if (getsockopt(source->fd, SOL_SOCKET, SO_ERROR, &error, &size)) return failure();
+	if (error || size != sizeof(error)) return -(error ? error : EPROTO);
+	int peerfd = -1; pid_t pid; uint64_t start;
+	int result = peer_identity(source->fd, (uid_t)expected_uid, &peerfd, &pid, &start);
+	if (result < 0) return result;
+	source->kind = CONNECTION; source->peerfd = peerfd; source->pid = pid; source->start = start;
+	return 1;
+}
+
+int omp_ownership_peer(int connection) {
+	struct handle *source = lookup(connection, CONNECTION);
+	if (!source || alive(source->peerfd) < 0) return -ESTALE;
+	int fd = own_fd(fcntl(source->peerfd, F_DUPFD_CLOEXEC, 0));
+	if (fd < 0) return fd;
+	return keep(IDENTITY, fd, -1, source->pid, source->start);
+}
+
+int omp_ownership_peer_pid(int identity) {
+	struct handle *source = lookup(identity, IDENTITY);
+	return source && alive(source->fd) > 0 ? source->pid : -ESTALE;
+}
+uint64_t omp_ownership_peer_start(int identity) {
+	struct handle *source = lookup(identity, IDENTITY);
+	return source && alive(source->fd) > 0 ? source->start : 0;
+}
+int omp_ownership_peer_alive(int identity) {
+	struct handle *source = lookup(identity, IDENTITY);
+	if (!source) return -EBADF;
+	struct pollfd descriptor = { .fd = source->fd, .events = POLLIN };
+	int result = poll(&descriptor, 1, 0);
+	if (result < 0) return failure();
+	if (result == 0) return 1;
+	if (descriptor.revents & (POLLERR | POLLNVAL)) return -EIO;
+	return descriptor.revents & (POLLIN | POLLHUP) ? 0 : -EPROTO;
+}
+int omp_ownership_same_peer(int left, int right) {
+	struct handle *a = lookup(left, IDENTITY), *b = lookup(right, IDENTITY);
+	if (!a || !b || alive(a->fd) < 0 || alive(b->fd) < 0) return -ESTALE;
+	return a->pid == b->pid && a->start == b->start;
+}
+
+/* Actual authenticated identities only; never a numeric-PID registration or signal authority. */
+int omp_ownership_direct_child(int child_key, int parent_key) {
+	struct handle *child = lookup(child_key, IDENTITY), *parent = lookup(parent_key, IDENTITY);
+	if (!child || !parent) return -EINVAL;
+	struct task first, parent_task, again;
+	int result = read_task(child->pid, child->fd, &first);
+	if (result < 0 || first.start != child->start) return -ESTALE;
+	result = read_task(parent->pid, parent->fd, &parent_task);
+	if (result < 0 || parent_task.start != parent->start) return -ESTALE;
+	result = read_task(child->pid, child->fd, &again);
+	if (result < 0 || again.start != first.start || again.parent != first.parent || alive(parent->fd) < 0) return -ESTALE;
+	return first.parent == parent->pid;
+}
+
+/* Return helper index + 1, 0 for verified external ancestry, negative for every missing/changing/overflowed chain.
+ * This grants classification only. It contains no signal/wait operation and cannot grant cleanup authority. */
+int omp_ownership_classify(int identity, const int *helper_keys, unsigned helper_count) {
+	struct handle *peer = lookup(identity, IDENTITY);
+	if (!peer || helper_count > OWNERSHIP_HELPERS || (helper_count && !helper_keys)) return -EINVAL;
+	struct task chain[OWNERSHIP_ANCESTORS];
+	unsigned count = 0;
+	int result = -ESTALE, nextfd = peer->fd;
+	pid_t nextpid = peer->pid;
+	int found = 0;
+	while (count < OWNERSHIP_ANCESTORS) {
+		struct task current;
+		result = read_task(nextpid, nextfd, &current);
+		if (result < 0) { if (count) drop_fd(nextfd); goto finished; }
+		if (count == 0 && current.start != peer->start) { result = -ESTALE; goto finished; }
+		for (unsigned previous = 0; previous < count; previous++) {
+			if (chain[previous].pid == current.pid) { if (count) drop_fd(nextfd); result = -ELOOP; goto finished; }
+		}
+		chain[count++] = current;
+		for (unsigned i = 0; i < helper_count; i++) {
+			struct handle *helper = lookup(helper_keys[i], IDENTITY);
+			if (!helper || alive(helper->fd) < 0) { result = -ESTALE; goto finished; }
+			if (helper->pid == current.pid && helper->start == current.start) found = (int)i + 1;
+		}
+		if (found || current.parent == 0) break;
+		if (count == OWNERSHIP_ANCESTORS) { result = -EOVERFLOW; goto finished; }
+		nextpid = current.parent;
+		nextfd = pidfd_open_owned(nextpid);
+		if (nextfd < 0) { result = nextfd; goto finished; }
+	}
+	/* Revalidate all held task identities and parent edges after acquisition; a changed chain is never external. */
+	for (unsigned i = 0; i < count; i++) {
+		struct task again;
+		result = read_task(chain[i].pid, chain[i].fd, &again);
+		if (result < 0 || again.start != chain[i].start || again.parent != chain[i].parent) { result = -ESTALE; goto finished; }
+	}
+	result = found;
+finished:
+	for (unsigned i = 1; i < count; i++) drop_fd(chain[i].fd);
+	return result;
+}
+
+int omp_ownership_read(int connection, void *bytes, unsigned size) {
+	struct handle *source = lookup(connection, CONNECTION);
+	if (!source || !bytes || size == 0 || size > OWNERSHIP_FRAME) return -EINVAL;
+	ssize_t result = recv(source->fd, bytes, size, MSG_DONTWAIT);
+	return result < 0 ? failure() : (int)result;
+}
+int omp_ownership_write(int connection, const void *bytes, unsigned size) {
+	struct handle *source = lookup(connection, CONNECTION);
+	if (!source || !bytes || size == 0 || size > OWNERSHIP_FRAME + 1) return -EINVAL;
+	ssize_t result = send(source->fd, bytes, size, MSG_DONTWAIT | MSG_NOSIGNAL);
+	return result < 0 ? failure() : (int)result;
+}
+int omp_ownership_close(int key) {
+	if (key <= 0) return -EBADF;
+	struct handle *source = &handles[(key - 1) % OWNERSHIP_HANDLES];
+	if (source->key != key || source->kind == UNUSED) return -EBADF;
+	struct handle value = *source;
+	*source = (struct handle){0};
+	if ((value.kind == CONNECTION || value.kind == CONNECTING) && connection_count) connection_count--;
+	drop_fd(value.fd); drop_fd(value.peerfd);
+	return 0;
+}
+void omp_ownership_close_all(void) {
+	for (unsigned i = 0; i < OWNERSHIP_HANDLES; i++) if (handles[i].kind != UNUSED) (void)omp_ownership_close(handles[i].key);
+}
diff --git a/packages/coding-agent/src/launch/ownership/linux-bridge.ts b/packages/coding-agent/src/launch/ownership/linux-bridge.ts
new file mode 100644
index 0000000000..878699c0f0
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/linux-bridge.ts
@@ -0,0 +1,209 @@
+/** Loaded only by the explicit Linux execution-ownership backend, never catalog/preflight. */
+import { dlopen, FFIType, ptr, type FFIFunction, type Library } from "bun:ffi";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+import type { StablePeer } from "./dispatcher";
+
+const nativeFunctions = {
+	omp_ownership_abi: { args: [], returns: FFIType.i32 },
+	omp_ownership_fd_count: { args: [], returns: FFIType.u32 },
+	omp_ownership_probe: { args: [], returns: FFIType.i32 },
+	omp_ownership_listen: { args: [FFIType.ptr], returns: FFIType.i32 },
+	omp_ownership_accept: { args: [FFIType.i32, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_connect_begin: { args: [FFIType.ptr], returns: FFIType.i32 },
+	omp_ownership_connect_ready: { args: [FFIType.i32, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_peer: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_peer_pid: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_peer_start: { args: [FFIType.i32], returns: FFIType.u64 },
+	omp_ownership_peer_alive: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_same_peer: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_direct_child: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_classify: { args: [FFIType.i32, FFIType.ptr, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_read: { args: [FFIType.i32, FFIType.ptr, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_write: { args: [FFIType.i32, FFIType.ptr, FFIType.u32], returns: FFIType.i32 },
+	omp_ownership_close: { args: [FFIType.i32], returns: FFIType.i32 },
+	omp_ownership_close_all: { args: [], returns: FFIType.void },
+} as const satisfies Record<string, FFIFunction>;
+
+export interface OwnershipBridgeSelection {
+	/** Approved canonical direct library within the selected maintained Native release, never a browser choice. */
+	file: string;
+	/** Independent operator/build trust input, not obtained by hashing the selected file itself. */
+	sha256: string;
+	/** Revalidate independently held installation maintenance protection before/after loading. */
+	verify(): Promise<void>;
+}
+
+/** Opaque connection/listener identities. The bridge validates object membership before its generational C handle. */
+export type OwnershipSocket = object;
+const libraryAuthority = Symbol("ownership-library-authority");
+let activeBridge: LinuxOwnershipBridge | undefined;
+let loadingBridge = false;
+
+/**
+ * Linux syscall adapter, ABI 1. Only bounded socket/pidfd primitives have fixture evidence; no lifecycle capability.
+ * It owns accept/read/write/connect and stable peer handles; no Bun socket private fields/casts are used.
+ * Call from the main Native thread only. It provides classification, never signal or wait authority.
+ */
+export class LinuxOwnershipBridge {
+	readonly #library: Library<typeof nativeFunctions>;
+	readonly #sockets = new Map<OwnershipSocket, number>();
+	readonly #listeners = new Map<OwnershipSocket, number>();
+	readonly #peers = new Map<StablePeer, number>();
+	#closed = false;
+
+	constructor(library: Library<typeof nativeFunctions>, authority: symbol) {
+		if (authority !== libraryAuthority) throw new OwnershipError("ownership_backend_unavailable");
+		this.#library = library;
+	}
+
+	static async open(selection: OwnershipBridgeSelection): Promise<LinuxOwnershipBridge> {
+		if (activeBridge || loadingBridge) throw new OwnershipError("ownership_limit");
+		loadingBridge = true;
+		try {
+			const bridge = await LinuxOwnershipBridge.#load(selection);
+			activeBridge = bridge;
+			return bridge;
+		} finally { loadingBridge = false; }
+	}
+
+	static async #load(selection: OwnershipBridgeSelection): Promise<LinuxOwnershipBridge> {
+		if (process.platform !== "linux" || !Bun.isMainThread || !process.getuid || !process.geteuid
+			|| process.getuid() !== process.geteuid()) throw new OwnershipError("ownership_backend_unavailable");
+		if (!/^[a-f0-9]{64}$/.test(selection.sha256) || !path.isAbsolute(selection.file)
+			|| path.resolve(selection.file) !== selection.file || await fs.realpath(selection.file) !== selection.file) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		await selection.verify();
+		const before = await fs.lstat(selection.file, { bigint: true });
+		if (!before.isFile() || before.nlink !== 1n || before.size > 1_048_576n) throw new OwnershipError("dispatcher_mismatch");
+		const bytes = await Bun.file(selection.file).arrayBuffer();
+		const digest = Buffer.from(await crypto.subtle.digest("SHA-256", bytes)).toString("hex");
+		const after = await fs.lstat(selection.file, { bigint: true });
+		if (digest !== selection.sha256 || before.dev !== after.dev || before.ino !== after.ino
+			|| before.size !== after.size || before.mtimeNs !== after.mtimeNs || before.ctimeNs !== after.ctimeNs) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		const library = dlopen(selection.file, nativeFunctions);
+		const bridge = new LinuxOwnershipBridge(library, libraryAuthority);
+		try {
+			await selection.verify();
+			if (library.symbols.omp_ownership_abi() !== 1) throw new OwnershipError("ownership_backend_unavailable");
+			const probe = library.symbols.omp_ownership_probe();
+			if (probe !== 0) throw new OwnershipError("ownership_backend_unavailable", -probe);
+			return bridge;
+		} catch (error) { bridge.close(); throw error; }
+	}
+
+	listen(endpoint: string): OwnershipSocket {
+		const bytes = this.#endpoint(endpoint);
+		return this.#store(this.#listeners, this.#library.symbols.omp_ownership_listen(ptr(bytes)));
+	}
+	accept(listener: OwnershipSocket, uid: number): OwnershipSocket | undefined {
+		const value = this.#library.symbols.omp_ownership_accept(this.#handle(this.#listeners, listener), uid);
+		return value === 0 ? undefined : this.#store(this.#sockets, value);
+	}
+	connect(endpoint: string): OwnershipSocket {
+		const bytes = this.#endpoint(endpoint);
+		return this.#store(this.#sockets, this.#library.symbols.omp_ownership_connect_begin(ptr(bytes)));
+	}
+	connected(socket: OwnershipSocket, uid: number): boolean {
+		const result = this.#library.symbols.omp_ownership_connect_ready(this.#handle(this.#sockets, socket), uid);
+		if (result < 0) throw new OwnershipError("dispatcher_unavailable", -result);
+		return result === 1;
+	}
+
+	capturePeer(socket: OwnershipSocket): StablePeer {
+		if (this.#peers.size >= OWNERSHIP_LIMITS.registrations) throw new OwnershipError("ownership_limit");
+		return this.#store(this.#peers, this.#library.symbols.omp_ownership_peer(this.#handle(this.#sockets, socket)));
+	}
+	samePeer(left: StablePeer, right: StablePeer): boolean {
+		const result = this.#library.symbols.omp_ownership_same_peer(this.#handle(this.#peers, left), this.#handle(this.#peers, right));
+		if (result < 0) throw new OwnershipError("ownership_unresolved", -result);
+		return result === 1;
+	}
+	/** False means the held kernel pidfd reports exit; fd/protocol failures remain unresolved. */
+	peerAlive(peer: StablePeer): boolean {
+		const result = this.#library.symbols.omp_ownership_peer_alive(this.#handle(this.#peers, peer));
+		if (result < 0) throw new OwnershipError("ownership_unresolved", -result);
+		return result === 1;
+	}
+	/** Verify parentage using retained actual peers and rechecked kernel edges, never control-frame PID hints. */
+	isDirectChild(child: StablePeer, parent: StablePeer): boolean {
+		const result = this.#library.symbols.omp_ownership_direct_child(this.#handle(this.#peers, child), this.#handle(this.#peers, parent));
+		if (result < 0) throw new OwnershipError("ownership_unresolved", -result);
+		return result === 1;
+	}
+	/** Hints for audit/control correlation only; this result never grants classification or signal authority. */
+	peerHints(peer: StablePeer): { pid: number; startTime: string } {
+		const handle = this.#handle(this.#peers, peer);
+		const pid = this.#library.symbols.omp_ownership_peer_pid(handle);
+		const start = this.#library.symbols.omp_ownership_peer_start(handle);
+		if (pid <= 0 || start === 0n) throw new OwnershipError("ownership_unresolved");
+		return { pid, startTime: String(start) };
+	}
+	/** Returns a verified registered helper, or undefined only for a complete stable external chain. */
+	classify(peer: StablePeer, helpers: readonly StablePeer[]): StablePeer | undefined {
+		if (helpers.length > OWNERSHIP_LIMITS.helpers) throw new OwnershipError("ownership_limit");
+		const keys = new Int32Array(Math.max(1, helpers.length));
+		helpers.forEach((helper, index) => { keys[index] = this.#handle(this.#peers, helper); });
+		const result = this.#library.symbols.omp_ownership_classify(this.#handle(this.#peers, peer), ptr(keys), helpers.length);
+		if (result < 0 || result > helpers.length) throw new OwnershipError("ownership_unresolved", result < 0 ? -result : undefined);
+		return result === 0 ? undefined : helpers[result - 1];
+	}
+
+	/** Undefined is Linux EAGAIN; an empty array is EOF. Caller owns total queue/idle/deadline enforcement. */
+	read(socket: OwnershipSocket): Uint8Array | undefined {
+		const bytes = Buffer.alloc(OWNERSHIP_LIMITS.frameBytes);
+		const count = this.#library.symbols.omp_ownership_read(this.#handle(this.#sockets, socket), ptr(bytes), bytes.length);
+		if (count === -11) return undefined;
+		if (count < 0 || count > bytes.length) throw new OwnershipError("dispatcher_unavailable", count < 0 ? -count : undefined);
+		return bytes.subarray(0, count);
+	}
+	/** May write partially; the caller must retain at most the fixed queue budget and honor the request deadline. */
+	write(socket: OwnershipSocket, bytes: Uint8Array): number {
+		if (!bytes.byteLength || bytes.byteLength > OWNERSHIP_LIMITS.frameBytes + 1) throw new OwnershipError("ownership_limit");
+		const count = this.#library.symbols.omp_ownership_write(this.#handle(this.#sockets, socket), ptr(bytes), bytes.byteLength);
+		if (count === -11) return 0;
+		if (count < 0 || count > bytes.byteLength) throw new OwnershipError("dispatcher_unavailable", count < 0 ? -count : undefined);
+		return count;
+	}
+
+	releaseSocket(socket: OwnershipSocket): void { this.#release(this.#sockets.has(socket) ? this.#sockets : this.#listeners, socket); }
+	releasePeer(peer: StablePeer): void { this.#release(this.#peers, peer); }
+	ownedDescriptorCount(): number { this.#assertOpen(); return this.#library.symbols.omp_ownership_fd_count(); }
+	/** Close is an error/shutdown primitive, never an extinction receipt. Durable generation fences must remain. */
+	close(): void {
+		if (this.#closed) return;
+		this.#closed = true;
+		this.#library.symbols.omp_ownership_close_all();
+		this.#library.close(); this.#sockets.clear(); this.#listeners.clear(); this.#peers.clear();
+		if (activeBridge === this) activeBridge = undefined;
+	}
+
+	#endpoint(endpoint: string): Buffer {
+		this.#assertOpen();
+		if (!endpoint.startsWith("/") || endpoint.includes("\0") || Buffer.byteLength(endpoint) >= 108) {
+			throw new OwnershipError("ownership_protocol");
+		}
+		return Buffer.from(`${endpoint}\0`);
+	}
+	#assertOpen(): void { if (this.#closed) throw new OwnershipError("dispatcher_unavailable"); }
+	#handle(map: Map<object, number>, value: object): number {
+		this.#assertOpen();
+		const handle = map.get(value);
+		if (handle === undefined) throw new OwnershipError("ownership_unresolved");
+		return handle;
+	}
+	#store(map: Map<object, number>, handle: number): object {
+		this.#assertOpen();
+		if (handle <= 0) throw new OwnershipError("ownership_unresolved", handle < 0 ? -handle : undefined);
+		const object = Object.freeze({}); map.set(object, handle); return object;
+	}
+	#release(map: Map<object, number>, value: object): void {
+		const handle = this.#handle(map, value);
+		map.delete(value);
+		if (this.#library.symbols.omp_ownership_close(handle) !== 0) throw new OwnershipError("ownership_unresolved");
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/protocol.ts b/packages/coding-agent/src/launch/ownership/protocol.ts
new file mode 100644
index 0000000000..e6186c0b2f
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/protocol.ts
@@ -0,0 +1,172 @@
+/** Public Native lifecycle IPC. No request can name a PID, executable, argv, token path or environment. */
+export const OWNERSHIP_VERSION = "omp-execution-ownership/1";
+
+/** Fixed resource limits; exceeding one fails closed and never falls back to a local broker. */
+export const OWNERSHIP_LIMITS = Object.freeze({
+	frameBytes: 16_384, connections: 64, pendingPerConnection: 1, queuedBytesPerConnection: 32_768,
+	registrations: 512, helpers: 64, helperGenerations: 512, ancestryDepth: 256,
+	bridgeHandles: 1024, bridgeDescriptors: 2048, brokerScopes: 64, externalLifetimes: 256,
+	connectMs: 1_000, requestMs: 10_000, idleMs: 30_000,
+	contextRequests: 64,
+	workerBootstrapMessages: 64, workerBootstrapBytes: 67_108_864, workerBootstrapValues: 65_536,
+});
+
+const errorCodes = ["ownership_protocol", "ownership_limit", "dispatcher_unavailable", "dispatcher_mismatch",
+	"ownership_unresolved", "maintenance_fenced", "shared_service_unsupported", "ownership_backend_unavailable"] as const;
+export type OwnershipErrorCode = (typeof errorCodes)[number];
+
+/** Stable native error code; consumers must not translate a refusal into successful tool execution. */
+export class OwnershipError extends Error {
+	constructor(readonly code: OwnershipErrorCode, readonly nativeErrno?: number) {
+		super(code); this.name = "OwnershipError";
+	}
+}
+
+/** Independently selected immutable release closure and effective RPC schema digests. */
+export interface OwnershipIdentity { closure: string; schema: string }
+export type OwnershipScope =
+	| { kind: "project"; directory: string }
+	| { kind: "global"; service: "browser-relay" | "text-predict" };
+export type OwnershipOperation =
+	| { op: "classify" }
+	| { op: "prepare_helper"; generation: string }
+	| { op: "helper_status"; generation: string }
+	| { op: "broker"; scope: OwnershipScope }
+	| { op: "publish"; scope: OwnershipScope; generation: string };
+export interface OwnershipRequest {
+	version: typeof OWNERSHIP_VERSION;
+	id: string;
+	identity: OwnershipIdentity;
+	operation: OwnershipOperation;
+}
+
+export interface OwnershipRegistration {
+	/** A connection is always authenticated again; this identifier grants no bearer authority. */
+	registration: string;
+	dispatcher: string;
+	policy: "private" | "external";
+	generation: string;
+}
+export type OwnershipResult =
+	| { op: "classify"; registration: OwnershipRegistration }
+	| { op: "prepare_helper"; generation: string }
+	| { op: "helper_status"; generation: string; status: "pending" | "registered" }
+	| { op: "broker"; scope: OwnershipScope; generation: string; runtimeDirectory: string; token: string }
+	| { op: "publish"; generation: string };
+export type OwnershipResponse =
+	| { version: typeof OWNERSHIP_VERSION; id: string; ok: true; identity: OwnershipIdentity; result: OwnershipResult }
+	| { version: typeof OWNERSHIP_VERSION; id: string; ok: false; error: OwnershipErrorCode };
+
+function record(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (value === null || typeof value !== "object" || Array.isArray(value)) throw new OwnershipError("ownership_protocol");
+	const result = value as Record<string, unknown>;
+	if (Object.keys(result).some(key => !keys.includes(key))) throw new OwnershipError("ownership_protocol");
+	return result;
+}
+function text(value: unknown, pattern: RegExp): string {
+	if (typeof value !== "string" || !pattern.test(value)) throw new OwnershipError("ownership_protocol");
+	return value;
+}
+export function ownershipToken(value: unknown): string { return text(value, /^[A-Za-z0-9_-]{16,128}$/); }
+export function ownershipGeneration(value: unknown): string { return text(value, /^[a-f0-9]{64}$/); }
+export function ownershipIdentity(value: unknown): OwnershipIdentity {
+	const source = record(value, ["closure", "schema"]);
+	return { closure: text(source.closure, /^[a-f0-9]{64}$/), schema: text(source.schema, /^[a-f0-9]{64}$/) };
+}
+
+/** Lexical validation only. The authenticated server must realpath and pin the directory before use. */
+export function ownershipScope(value: unknown): OwnershipScope {
+	const source = record(value, ["kind", "directory", "service"]);
+	if (source.kind === "global" && source.directory === undefined
+		&& (source.service === "browser-relay" || source.service === "text-predict")) {
+		return { kind: "global", service: source.service };
+	}
+	if (source.kind !== "project" || source.service !== undefined || typeof source.directory !== "string") {
+		throw new OwnershipError("ownership_protocol");
+	}
+	const directory = source.directory;
+	if (directory.length > 4096 || !directory.startsWith("/") || directory.includes("\0")
+		|| (directory !== "/" && directory.split("/").slice(1).some(part => !part || part === "." || part === ".."))) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	return { kind: "project", directory };
+}
+
+/** A single UTF-8 JSON frame, without its LF delimiter. Strict decoder rejects extra authority fields. */
+export function decodeOwnershipRequest(frame: string): OwnershipRequest {
+	if (new TextEncoder().encode(frame).length > OWNERSHIP_LIMITS.frameBytes) throw new OwnershipError("ownership_limit");
+	let decoded: unknown;
+	try { decoded = JSON.parse(frame); } catch { throw new OwnershipError("ownership_protocol"); }
+	const source = record(decoded, ["version", "id", "identity", "operation"]);
+	if (source.version !== OWNERSHIP_VERSION) throw new OwnershipError("dispatcher_mismatch");
+	const operation = record(source.operation, ["op", "scope", "generation"]);
+	let parsed: OwnershipOperation;
+	if (operation.op === "classify" && Object.keys(operation).length === 1) parsed = { op: "classify" };
+	else if ((operation.op === "prepare_helper" || operation.op === "helper_status") && Object.keys(operation).length === 2) {
+		parsed = { op: operation.op, generation: ownershipGeneration(operation.generation) };
+	}
+	else if (operation.op === "broker" && operation.generation === undefined) {
+		parsed = { op: "broker", scope: ownershipScope(operation.scope) };
+	} else if (operation.op === "publish") {
+		parsed = { op: "publish", scope: ownershipScope(operation.scope), generation: ownershipToken(operation.generation) };
+	} else throw new OwnershipError("ownership_protocol");
+	return { version: OWNERSHIP_VERSION, id: ownershipToken(source.id), identity: ownershipIdentity(source.identity), operation: parsed };
+}
+
+export function sameOwnershipScope(left: OwnershipScope, right: OwnershipScope): boolean {
+	return left.kind === "project" ? right.kind === "project" && left.directory === right.directory
+		: right.kind === "global" && left.service === right.service;
+}
+
+function registration(value: unknown): OwnershipRegistration {
+	const source = record(value, ["registration", "dispatcher", "policy", "generation"]);
+	if (source.policy !== "private" && source.policy !== "external") throw new OwnershipError("ownership_protocol");
+	return { registration: ownershipToken(source.registration), dispatcher: ownershipToken(source.dispatcher),
+		policy: source.policy, generation: ownershipToken(source.generation) };
+}
+
+function result(value: unknown, expected: OwnershipOperation): OwnershipResult {
+	const source = record(value, ["op", "registration", "scope", "generation", "runtimeDirectory", "token", "status"]);
+	if (source.op !== expected.op) throw new OwnershipError("ownership_protocol");
+	if (expected.op === "prepare_helper" && Object.keys(source).length === 2 && source.generation === expected.generation) {
+		return { op: "prepare_helper", generation: ownershipGeneration(source.generation) };
+	}
+	if (expected.op === "helper_status" && Object.keys(source).length === 3 && source.generation === expected.generation
+		&& (source.status === "pending" || source.status === "registered")) {
+		return { op: "helper_status", generation: ownershipGeneration(source.generation), status: source.status };
+	}
+	if (source.op === "classify" && Object.keys(source).length === 2) {
+		return { op: "classify", registration: registration(source.registration) };
+	}
+	if (source.op === "publish" && expected.op === "publish" && Object.keys(source).length === 2
+		&& source.generation === expected.generation) return { op: "publish", generation: expected.generation };
+	if (source.op !== "broker" || expected.op !== "broker" || Object.keys(source).length !== 5) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	const scope = ownershipScope(source.scope);
+	if (!sameOwnershipScope(scope, expected.scope)) throw new OwnershipError("ownership_protocol");
+	const directory = ownershipScope({ kind: "project", directory: source.runtimeDirectory });
+	if (directory.kind !== "project") throw new OwnershipError("ownership_protocol");
+	return { op: "broker", scope, generation: ownershipToken(source.generation), runtimeDirectory: directory.directory,
+		token: text(source.token, /^[a-f0-9]{64}$/) };
+}
+
+/** Validate correlation, matched release/schema and operation before any endpoint/token reaches a Native client. */
+export function decodeOwnershipResponse(frame: string, expected: OwnershipRequest): OwnershipResponse {
+	if (new TextEncoder().encode(frame).length > OWNERSHIP_LIMITS.frameBytes) throw new OwnershipError("ownership_limit");
+	let decoded: unknown;
+	try { decoded = JSON.parse(frame); } catch { throw new OwnershipError("ownership_protocol"); }
+	const source = record(decoded, ["version", "id", "ok", "identity", "result", "error"]);
+	if (source.version !== OWNERSHIP_VERSION || source.id !== expected.id) throw new OwnershipError("dispatcher_mismatch");
+	if (source.ok === false && Object.keys(source).length === 4) {
+		const code = errorCodes.find(code => code === source.error);
+		if (!code) throw new OwnershipError("ownership_protocol");
+		return { version: OWNERSHIP_VERSION, id: expected.id, ok: false, error: code };
+	}
+	if (source.ok !== true || Object.keys(source).length !== 5) throw new OwnershipError("ownership_protocol");
+	const identity = ownershipIdentity(source.identity);
+	if (identity.closure !== expected.identity.closure || identity.schema !== expected.identity.schema) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	return { version: OWNERSHIP_VERSION, id: expected.id, ok: true, identity, result: result(source.result, expected.operation) };
+}
