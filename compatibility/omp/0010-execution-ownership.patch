+import { expect, test } from "bun:test";
+import { decodeOwnershipControlIo } from "../src/launch/ownership/control-selection";
+
+const root = "/synthetic/release", digest = "a".repeat(64);
+const member = (name: string) => ({ file: `${root}/${name}`, sha256: digest });
+export function controlRecord() {
+  return { version: "omp-execution-control-io/1" as const, abi: 1 as const,
+    ...member("lib/libomp-control-io.so"), source: member("provenance/owned-control-io.c"),
+    header: member("provenance/owned-control-io.h"), inventory: member("release.json"),
+    package: { entry: member("control-io/index.js"), types: member("control-io/index.d.ts"),
+      manifest: member("control-io/package.json"), build: member("provenance/control-io-build.json") },
+    native: { dispatcher: member("provenance/native/dispatcher.ts"), client: member("provenance/native/uds-client.ts"),
+      bundle: member("worker/cli.js"), schema: member("contracts/wire.schema.json") } };
+}
+test("composed control selection requires the complete versioned signed inventory and public package roles", () => {
