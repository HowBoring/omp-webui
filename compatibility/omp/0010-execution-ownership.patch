@@ -0,0 +1,95 @@
+import * as fs from "node:fs";
+import type { LoadedOwnershipApproval } from "./approval";
+import type { OwnershipSystem, PublicationPermit, StablePeer } from "./dispatcher";
+import { OwnershipFences } from "./fences";
+import type { LinuxOwnershipBridge } from "./linux-bridge";
+import type { OwnershipControlIoOwner } from "./control-io-owner";
+import { OwnershipError, ownershipGeneration, type OwnershipScope } from "./protocol";
+
+/** Concrete Linux peer/helper spine. Broker creation/publication remains unavailable until protector integration. */
+export class LinuxOwnershipSystem implements OwnershipSystem {
+	readonly dispatcher: string;
+	readonly #owner: OwnershipControlIoOwner;
+	readonly #approval: LoadedOwnershipApproval;
+	readonly #bridge: LinuxOwnershipBridge;
+	readonly #fences: OwnershipFences;
+	readonly #helpers = new Map<StablePeer, string>();
+	#unresolved = false;
+	constructor(approval: LoadedOwnershipApproval, bridge: LinuxOwnershipBridge, fences: OwnershipFences, generation: string, owner: OwnershipControlIoOwner) {
+		this.#owner = owner; this.#approval = approval; this.#bridge = bridge; this.#fences = fences; this.dispatcher = ownershipGeneration(generation);
+	}
+	async ready(): Promise<void> { await this.#verify(); }
+	assertReady(): void {
+		if (this.#unresolved) throw new OwnershipError("maintenance_fenced");
+		this.#owner.assertReady(); this.#fences.assertCurrent();
+	}
+	async classify(peer: StablePeer) {
+		await this.#verify();
+		const helper = this.#bridge.classify(peer, [...this.#helpers.keys()]);
+		if (!helper) return { kind: "external" as const };
+		const generation = this.#helpers.get(helper);
+		if (!generation) throw new OwnershipError("ownership_unresolved");
+		return { kind: "private" as const, generation };
+	}
+	async protectHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void> {
+		try {
+			await this.#verify();
+			if (!this.#bridge.isDirectChild(helper, control) || (await this.classify(control)).kind !== "external") {
+				throw new OwnershipError("ownership_unresolved");
+			}
+			await this.#verifyHelper(helper);
+			await this.#fences.create(generation, "private-helper");
+			this.#helpers.set(helper, generation);
+			await this.#verifyHelper(helper); await this.#verify();
+			if (!this.#bridge.isDirectChild(helper, control)) throw new OwnershipError("ownership_unresolved");
+		} catch (error) { this.#unresolved = true; throw error; }
+	}
+	async markUnresolved(_generation: string): Promise<void> { this.#unresolved = true; }
+	async completeHelper(helper: StablePeer, generation: string): Promise<void> {
+		try {
+			await this.#verify(); await this.#verifyHelper(helper);
+			if (this.#helpers.get(helper) !== generation) throw new OwnershipError("ownership_unresolved");
+			// Only the approved helper on its original held socket can assert its trusted P_ALL/ECHILD completion.
+			await this.#fences.retireCompleted(generation); this.#helpers.delete(helper);
+		} catch (error) { this.#unresolved = true; throw error; }
+	}
+	async canonicalScope(scope: OwnershipScope): Promise<OwnershipScope> {
+		await this.#verify();
+		if (scope.kind === "global") return scope;
+		const directory = await fs.promises.realpath(scope.directory), stat = await fs.promises.lstat(directory);
+		if (!stat.isDirectory() || directory !== scope.directory) throw new OwnershipError("ownership_unresolved");
+		return { kind: "project", directory };
+	}
+	async broker(_scope: OwnershipScope, _permit: PublicationPermit): Promise<never> {
+		throw new OwnershipError("ownership_backend_unavailable");
+	}
+	async inspectBroker(_scope: OwnershipScope, _generation: string, _permit: PublicationPermit): Promise<undefined> {
+		await this.#verify(); return undefined;
+	}
+	async publish(): Promise<never> { throw new OwnershipError("ownership_backend_unavailable"); }
+	async #verify(): Promise<void> {
+		if (this.#unresolved) throw new OwnershipError("maintenance_fenced");
+		await this.#owner.ready(); await this.#approval.verify(); await this.#fences.verify();
+		for (const helper of this.#helpers.keys()) {
+			if (!this.#bridge.peerAlive(helper)) { this.#unresolved = true; throw new OwnershipError("maintenance_fenced"); }
+		}
+		this.#owner.assertReady();
+	}
+	async #verifyHelper(peer: StablePeer): Promise<void> {
+		const hints = this.#bridge.peerHints(peer), approved = this.#approval.helper;
+		const target = `/proc/${hints.pid}/exe`;
+		if (!this.#bridge.peerAlive(peer) || await fs.promises.readlink(target) !== approved.file) {
+			throw new OwnershipError("ownership_unresolved");
+		}
+		const file = await fs.promises.open(target, fs.constants.O_RDONLY);
+		try {
+			const stat = await file.stat();
+			if (!stat.isFile() || stat.size > 1_048_576) throw new OwnershipError("ownership_unresolved");
+			const bytes = Buffer.alloc(1_048_577), read = await file.read(bytes, 0, bytes.length, 0);
+			if (read.bytesRead > 1_048_576 || new Bun.CryptoHasher("sha256").update(bytes.subarray(0, read.bytesRead)).digest("hex") !== approved.sha256
+				|| !this.#bridge.peerAlive(peer) || await fs.promises.readlink(target) !== approved.file) {
+				throw new OwnershipError("ownership_unresolved");
+			}
+		} finally { await file.close(); }
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/maintenance-handoff.ts b/packages/coding-agent/src/launch/ownership/maintenance-handoff.ts
new file mode 100644
index 0000000000..e74571a4ae
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/maintenance-handoff.ts
@@ -0,0 +1,135 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { isMainThread } from "node:worker_threads";
+import type { OwnershipApprovalPin } from "./approval";
+import { OwnershipError } from "./protocol";
+
+const reserved = "--omp-maintenance-handoff";
+const guards = new WeakMap<object, OwnershipApprovalPin>();
+/** Process protection only. No close/unlock API: generation release cannot shorten the C launcher's lifetime. */
+export interface LauncherMaintenanceGuard {
+  assertCurrent(): void;
+  verify(): Promise<void>;
+}
+export interface LauncherMaintenanceHandoff {
+  readonly arguments: readonly string[];
+  claim(approval: { readonly control: OwnershipApprovalPin }): LauncherMaintenanceGuard;
+}
+
+/** The first reserved argv member is a locator, never authority. No environment or descriptor discovery. */
+export function captureLauncherMaintenanceHandoff(argv: readonly string[]): LauncherMaintenanceHandoff {
+  const locations = argv.flatMap((value, index) => value.startsWith(reserved) ? [index] : []);
+  let descriptor: number | undefined;
+  if (locations.length) {
+    const match = /^--omp-maintenance-handoff=1:(0|[1-9][0-9]{0,9})$/.exec(argv[0] ?? "");
+    if (locations.length !== 1 || locations[0] !== 0 || !match || Number(match[1]) > 2_147_483_647) {
+      throw new OwnershipError("dispatcher_mismatch");
+    }
+    descriptor = Number(match[1]);
+  }
+  const args = Object.freeze(argv.slice(locations.length ? 1 : 0));
+  return Object.freeze({ arguments: args, claim(approval: { readonly control: OwnershipApprovalPin }) {
+    if (!isMainThread || process.platform !== "linux" || descriptor === undefined) {
+      throw new OwnershipError("maintenance_fenced");
+    }
+    return createGuard(descriptor, approval.control);
+  } });
+}
+
+function integer(text: string, base: 8 | 10 | 16): bigint {
+  const pattern = base === 8 ? /^[0-7]{1,12}$/ : base === 16 ? /^[0-9a-f]{1,8}$/ : /^(0|[1-9][0-9]{0,19})$/;
+  if (!pattern.test(text)) throw new OwnershipError("maintenance_fenced");
+  const value = BigInt((base === 8 ? "0o" : base === 16 ? "0x" : "") + text);
+  if (value > 0xffffffffffffffffn) throw new OwnershipError("maintenance_fenced");
+  return value;
+}
+function fdinfo(descriptor: number, pin: OwnershipApprovalPin): void {
+  const file = fs.openSync(`/proc/self/fdinfo/${descriptor}`, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+  let bytes: Buffer;
+  try {
+    const buffer = Buffer.alloc(16_385);
+    let total = 0;
+    while (total < buffer.length) {
+      const count = fs.readSync(file, buffer, total, buffer.length - total, total);
+      if (!count) break; total += count;
+    }
+    if (total <= 0 || total > 16_384) throw new OwnershipError("maintenance_fenced");
+    bytes = buffer.subarray(0, total);
+  } finally { fs.closeSync(file); } // This closes only the temporary fdinfo reader, never the inherited descriptor.
+  const text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  const values = new Map<string, string>();
+  if (!text.endsWith("\n")) throw new OwnershipError("maintenance_fenced");
+  for (const line of text.slice(0, -1).split("\n")) {
+    const match = /^(pos|flags|mnt_id|ino|lock):[ \t]+(.+)$/.exec(line);
+    if (!match || values.has(match[1]!)) throw new OwnershipError("maintenance_fenced");
+    values.set(match[1]!, match[2]!);
+  }
+  if (values.size !== 5 || values.get("pos") !== "0" || integer(values.get("ino") ?? "", 10) !== BigInt(pin.inode)) {
+    throw new OwnershipError("maintenance_fenced");
+  }
+  integer(values.get("mnt_id") ?? "", 10);
+  const flags = integer(values.get("flags") ?? "", 8);
+  const nofollow = BigInt(fs.constants.O_NOFOLLOW);
+  if (flags !== nofollow && flags !== (nofollow | 0o100000n)) throw new OwnershipError("maintenance_fenced");
+  const lock = /^[1-9][0-9]{0,19}: FLOCK +ADVISORY +READ +([1-9][0-9]{0,19}) +([0-9a-f]{1,8}):([0-9a-f]{1,8}):([1-9][0-9]{0,19}) +0 +EOF$/.exec(values.get("lock") ?? "");
+  if (!lock) throw new OwnershipError("maintenance_fenced");
+  const device = integer(pin.device, 10);
+  const major = ((device >> 8n) & 0xfffn) | ((device >> 32n) & 0xfffff000n);
+  const minor = (device & 0xffn) | ((device >> 12n) & 0xffffff00n);
+  if (integer(lock[1]!, 10) !== BigInt(process.pid) || integer(lock[2]!, 16) !== major
+    || integer(lock[3]!, 16) !== minor || integer(lock[4]!, 10) !== BigInt(pin.inode)) {
+    throw new OwnershipError("maintenance_fenced");
+  }
+}
+function metadata(descriptor: number, pin: OwnershipApprovalPin): string {
+  if (fs.realpathSync(pin.path) !== pin.path) throw new OwnershipError("maintenance_fenced");
+  const held = fs.fstatSync(descriptor, { bigint: true }), named = fs.lstatSync(pin.path, { bigint: true });
+  const stamp = (stat: fs.BigIntStats) => [stat.dev, stat.ino, stat.uid, stat.gid, stat.mode, stat.nlink,
+    stat.size, stat.mtimeNs, stat.ctimeNs].join(":");
+  for (const stat of [held, named]) {
+    if (!stat.isFile() || stat.nlink !== 1n || String(stat.dev) !== pin.device || String(stat.ino) !== pin.inode
+      || stat.uid !== BigInt(process.getuid?.() ?? -1) || (stat.mode & 0o7777n) !== 0o600n) {
+      throw new OwnershipError("maintenance_fenced");
+    }
+  }
+  if (stamp(held) !== stamp(named)) throw new OwnershipError("maintenance_fenced");
+  return stamp(held);
+}
+function createGuard(descriptor: number, value: OwnershipApprovalPin): LauncherMaintenanceGuard {
+  const pin = Object.freeze({ ...value });
+  if (!path.isAbsolute(pin.path) || path.resolve(pin.path) !== pin.path || pin.path.length > 4096
+    || pin.path.includes("\0") || !/^(0|[1-9][0-9]{0,19})$/.test(pin.device)
+    || !/^[1-9][0-9]{0,19}$/.test(pin.inode) || !/^[a-f0-9]{64}$/.test(pin.sha256)) {
+    throw new OwnershipError("maintenance_fenced");
+  }
+  let failed = false;
+  const assertCurrent = (): void => {
+    try {
+      if (failed || !isMainThread || process.platform !== "linux") throw new OwnershipError("maintenance_fenced");
+      const before = metadata(descriptor, pin); fdinfo(descriptor, pin);
+      if (metadata(descriptor, pin) !== before) throw new OwnershipError("maintenance_fenced");
+    } catch { failed = true; throw new OwnershipError("maintenance_fenced"); }
+  };
+  assertCurrent();
+  const guard = Object.freeze({ assertCurrent, async verify() { assertCurrent(); } });
+  guards.set(guard, pin); return guard;
+}
+
+/** Nominal check prevents an arbitrary verify callback from authorizing a production selection. */
+export function assertLauncherMaintenanceGuard(guard: LauncherMaintenanceGuard, control: OwnershipApprovalPin): void {
+  const selected = guards.get(guard);
+  if (!selected || JSON.stringify(selected) !== JSON.stringify(control)) throw new OwnershipError("maintenance_fenced");
+  guard.assertCurrent();
+}
+
+let mainHandoff: LauncherMaintenanceHandoff | undefined;
+/** Main CLI consumes its single launcher locator before ordinary argument parsing. SDK imports do not consume argv. */
+export function consumeLauncherMaintenanceArguments(argv: readonly string[]): readonly string[] {
+  if (!isMainThread || mainHandoff) throw new OwnershipError("maintenance_fenced");
+  mainHandoff = captureLauncherMaintenanceHandoff(argv); return mainHandoff.arguments;
+}
+/** Explicit server composition only. An independently invoked SDK/client never receives this process guard. */
+export function claimLauncherMaintenance(approval: { readonly control: OwnershipApprovalPin }): LauncherMaintenanceGuard {
+  if (!mainHandoff) throw new OwnershipError("maintenance_fenced");
+  return mainHandoff.claim(approval);
+}
diff --git a/packages/coding-agent/src/launch/ownership/platform-closure.ts b/packages/coding-agent/src/launch/ownership/platform-closure.ts
