diff --git a/packages/coding-agent/test/execution-ownership-client.test.ts b/packages/coding-agent/test/execution-ownership-client.test.ts
new file mode 100644
index 0000000000..aef89d4177
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-client.test.ts
@@ -0,0 +1,76 @@
+import { expect, test } from "bun:test";
+import { OwnershipClient, type OwnershipTransport } from "../src/launch/ownership/client";
+import { decodeOwnershipRequest, type OwnershipRegistration } from "../src/launch/ownership/protocol";
+
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+
+/** Dispatcher wire fixture, not actual SO_PEERPIDFD or local socket evidence. */
+class WireFixture implements OwnershipTransport {
+	readonly effects: string[] = [];
+	registration: OwnershipRegistration = { registration: "registration-0001", dispatcher: "dispatcher-000001",
+		policy: "private", generation: "generation-000001" };
+	async exchange(frame: string, _signal: AbortSignal): Promise<string> {
+		const request = decodeOwnershipRequest(frame);
+		this.effects.push(request.operation.op);
+		return JSON.stringify({ version: request.version, id: request.id, identity, ok: true,
+			result: { op: "classify", registration: this.registration } });
+	}
+	close(): void {}
+}
+
+test("private Native registration rejects shared broker use before another wire request", async () => {
+	const wire = new WireFixture(), client = new OwnershipClient(identity, wire);
+	await client.classify();
+	await expect(client.broker({ kind: "project", directory: "/work" })).rejects.toThrow("shared_service_unsupported");
+	expect(wire.effects).toEqual(["classify"]);
+});
+
+test("private Native registration rejects the publication handshake without any completion or control request", async () => {
+	const wire = new WireFixture(), client = new OwnershipClient(identity, wire);
+	await client.classify();
+	await expect(client.publish({ kind: "project", directory: "/work" }, "broker-generation-0001"))
+		.rejects.toThrow("shared_service_unsupported");
+	expect(wire.effects).toEqual(["classify"]);
+});
+
+test("a replacement dispatcher registration permanently refuses further operations without spawning a fallback", async () => {
+	const wire = new WireFixture(), client = new OwnershipClient(identity, wire);
+	wire.registration.policy = "external";
+	await client.classify();
+	wire.registration = { ...wire.registration, dispatcher: "replacement-00001" };
+	await expect(client.broker({ kind: "project", directory: "/work" })).rejects.toThrow("dispatcher_mismatch");
+	await expect(client.broker({ kind: "project", directory: "/work" })).rejects.toThrow("dispatcher_unavailable");
+	expect(wire.effects).toEqual(["classify", "classify"]);
+});
+
+test("a broker grant stays bound to the requested project while process reclassification is pending", async () => {
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) {
+			const request = decodeOwnershipRequest(frame);
+			const result = request.operation.op === "classify"
+				? { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+					policy: "external", generation: "generation-000001" } }
+				: request.operation.op === "broker"
+					? { op: "broker", scope: request.operation.scope, generation: "broker-generation-0001",
+						runtimeDirectory: "/run/owned-broker", token: "c".repeat(64) }
+					: undefined;
+			return JSON.stringify({ version: request.version, id: request.id, identity, ok: true, result });
+		}, close() {},
+	});
+	await client.classify();
+	const scope = { kind: "project" as const, directory: "/work/requested-project" };
+	const grant = client.broker(scope);
+	scope.directory = "/work/replacement-project";
+	expect((await grant).scope).toEqual({ kind: "project", directory: "/work/requested-project" });
+});
+
+test("closing before a queued request reaches the transport prevents its dispatch", async () => {
+	let requests = 0;
+	const client = new OwnershipClient(identity, {
+		async exchange() { requests++; return "unexpected"; }, close() {},
+	});
+	const pending = client.classify();
+	client.close();
+	await expect(pending).rejects.toMatchObject({ code: "dispatcher_unavailable" });
+	expect(requests).toBe(0);
+});
diff --git a/packages/coding-agent/test/execution-ownership-context.test.ts b/packages/coding-agent/test/execution-ownership-context.test.ts
