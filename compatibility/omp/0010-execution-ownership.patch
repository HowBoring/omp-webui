+function record(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) throw new OwnershipError("ownership_protocol");
+	const source = value as Record<string, unknown>;
+	if (Object.keys(source).length !== keys.length || Object.keys(source).some(key => !keys.includes(key))) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	return source;
+}
+function frame(value: unknown, maximum: number = OWNERSHIP_LIMITS.frameBytes): string {
+	if (typeof value !== "string" || new TextEncoder().encode(value).length > maximum) {
+		throw new OwnershipError("ownership_limit");
+	}
+	return value;
+}
+function parse(value: string, keys: readonly string[], maximum: number = OWNERSHIP_LIMITS.frameBytes): Record<string, unknown> {
+	const bounded = frame(value, maximum);
+	let decoded: unknown;
+	try { decoded = JSON.parse(bounded); } catch { throw new OwnershipError("ownership_protocol"); }
+	return record(decoded, keys);
+}
+function sameIdentity(left: OwnershipIdentity, right: OwnershipIdentity): void {
+	if (left.closure !== right.closure || left.schema !== right.schema) throw new OwnershipError("dispatcher_mismatch");
+}
+function base64(value: string, bytes: number): Uint8Array<ArrayBuffer> {
+	const decoded = Uint8Array.from(Buffer.from(value, "base64url"));
+	if (decoded.length !== bytes || Buffer.from(decoded).toString("base64url") !== value) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	return decoded;
+}
+async function sha256(value: string): Promise<string> {
+	return Buffer.from(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value))).toString("hex");
+}
+/** Fixed field ordering is part of this wire version, independent of incoming JSON key order. */
+function signedBytes(reply: Omit<SignedReply, "signature">): Uint8Array<ArrayBuffer> {
+	return new TextEncoder().encode(JSON.stringify([reply.version, reply.installation, reply.nonce, reply.requestSha256,
+		reply.requestId, reply.operation, reply.identity.closure, reply.identity.schema, reply.serverGeneration, reply.response]));
+}
+
+/** Decode and hash the actual received request before its actual authenticated kernel peer reaches dispatch. */
+export async function decodeOwnershipChallenge(value: string,
+	approval: Pick<OwnershipAuthenticationApproval, "installation" | "identity">): Promise<DecodedOwnershipChallenge> {
+	const source = parse(value, ["version", "installation", "nonce", "request"]);
+	if (source.version !== OWNERSHIP_AUTH_VERSION || source.installation !== ownershipGeneration(approval.installation)) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	const requestFrame = frame(source.request), request = decodeOwnershipRequest(requestFrame);
+	sameIdentity(request.identity, ownershipIdentity(approval.identity));
+	return Object.freeze({ installation: approval.installation, nonce: ownershipGeneration(source.nonce),
+		requestSha256: await sha256(requestFrame), request });
+}
+
+/**
+ * Sign only the fixed dispatcher's matched response. This is not kernel peer verification or lifecycle admission.
+ * The private key is loaded independently by the dispatcher from protected local data, never a request/environment.
+ */
+export async function signOwnershipReply(challenge: DecodedOwnershipChallenge, response: string,
+	server: { installation: string; identity: OwnershipIdentity; serverGeneration: string; privateKey: CryptoKey }): Promise<string> {
+	if (challenge.installation !== ownershipGeneration(server.installation)) throw new OwnershipError("dispatcher_mismatch");
+	sameIdentity(challenge.request.identity, ownershipIdentity(server.identity));
+	decodeOwnershipResponse(frame(response, OWNERSHIP_LIMITS.responseFrameBytes), challenge.request);
+	const reply: Omit<SignedReply, "signature"> = { version: OWNERSHIP_AUTH_VERSION, installation: server.installation,
+		nonce: challenge.nonce, requestSha256: challenge.requestSha256, requestId: challenge.request.id,
+		operation: challenge.request.operation.op, identity: ownershipIdentity(server.identity),
+		serverGeneration: ownershipGeneration(server.serverGeneration), response };
+	// Bound the final authenticated envelope, including its fixed-size signature, BEFORE signing/canonicalization.
+	frame(JSON.stringify({ ...reply, signature: "A".repeat(86) }), OWNERSHIP_LIMITS.responseFrameBytes);
+	const signature = await crypto.subtle.sign("Ed25519", server.privateKey, signedBytes(reply));
+	return frame(JSON.stringify({ ...reply, signature: Buffer.from(signature).toString("base64url") }), OWNERSHIP_LIMITS.responseFrameBytes);
+}
+
+/** Fresh-nonce authentication for public Bun UDS clients in any realm. No socket descriptor/FFI access is needed. */
+export class OwnershipReplyVerifier {
+	readonly #approval: Readonly<OwnershipAuthenticationApproval>;
+	readonly #key: Promise<CryptoKey>;
+	#pending: { challenge: OwnershipChallenge; decoded: DecodedOwnershipChallenge } | undefined;
+	#creating = false;
+	#verifying = false;
+	#serverGeneration: string | undefined;
+	#failed = false;
+	constructor(approval: OwnershipAuthenticationApproval) {
+		this.#approval = Object.freeze({ installation: ownershipGeneration(approval.installation),
+			identity: Object.freeze(ownershipIdentity(approval.identity)), publicKey: approval.publicKey });
+		this.#key = crypto.subtle.importKey("raw", base64(approval.publicKey, 32), "Ed25519", false, ["verify"]);
+	}
+
+	async challenge(requestFrame: string): Promise<OwnershipChallenge> {
+		if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+		if (this.#creating || this.#verifying || this.#pending) throw new OwnershipError("ownership_limit");
+		this.#creating = true;
+		try {
+			const nonce = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("hex");
+			const wire = frame(JSON.stringify({ version: OWNERSHIP_AUTH_VERSION, installation: this.#approval.installation,
+				nonce, request: frame(requestFrame) }));
+			const decoded = await decodeOwnershipChallenge(wire, this.#approval);
+			if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+			const challenge = Object.freeze({ frame: wire });
+			this.#pending = { challenge, decoded };
+			return challenge;
+		} finally { this.#creating = false; }
+	}
+
+	async verify(value: string, challenge: OwnershipChallenge): Promise<string> {
+		const expected = this.#pending?.challenge === challenge ? this.#pending.decoded : undefined;
+		this.#pending = undefined;
+		this.#verifying = true;
+		try {
+			if (this.#failed || !expected) throw new OwnershipError("dispatcher_mismatch");
+			const reply = this.#reply(value, expected);
+			const valid = await crypto.subtle.verify("Ed25519", await this.#key, base64(reply.signature, 64), signedBytes(reply));
+			if (!valid || this.#failed) throw new OwnershipError("dispatcher_mismatch");
+			const response = decodeOwnershipResponse(reply.response, expected.request);
+			if (response.ok && response.result.op === "classify" && response.result.registration.dispatcher !== reply.serverGeneration) {
+				throw new OwnershipError("dispatcher_mismatch");
+			}
+			this.#serverGeneration = reply.serverGeneration;
+			return reply.response;
+		} catch (error) {
+			this.#failed = true;
+			if (error instanceof OwnershipError && error.code === "ownership_limit") throw error;
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		finally { this.#verifying = false; }
+	}
+
+	close(): void { this.#failed = true; this.#pending = undefined; }
+
+	#reply(value: string, expected: DecodedOwnershipChallenge): SignedReply {
+		const source = parse(value, ["version", "installation", "nonce", "requestSha256", "requestId", "operation",
+			"identity", "serverGeneration", "response", "signature"], OWNERSHIP_LIMITS.responseFrameBytes);
+		const identity = ownershipIdentity(source.identity), generation = ownershipGeneration(source.serverGeneration);
+		sameIdentity(identity, this.#approval.identity);
+		if (source.version !== OWNERSHIP_AUTH_VERSION || source.installation !== expected.installation
+			|| source.nonce !== expected.nonce || source.requestSha256 !== expected.requestSha256
+			|| source.requestId !== expected.request.id || source.operation !== expected.request.operation.op
+			|| (this.#serverGeneration !== undefined && generation !== this.#serverGeneration)
+			|| typeof source.signature !== "string") throw new OwnershipError("dispatcher_mismatch");
+		return { version: OWNERSHIP_AUTH_VERSION, installation: expected.installation, nonce: expected.nonce,
+			requestSha256: expected.requestSha256, requestId: expected.request.id, operation: expected.request.operation.op,
+			identity, serverGeneration: generation, response: frame(source.response, OWNERSHIP_LIMITS.responseFrameBytes), signature: source.signature };
+	}
+}
