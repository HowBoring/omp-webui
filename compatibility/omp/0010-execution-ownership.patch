@@ -0,0 +1,48 @@
+import { expect, test } from "bun:test";
+import { OwnershipWorkerBootstrap, type OwnershipWorkerScope } from "../src/launch/ownership/worker-bootstrap";
+
+/** Synthetic worker delivery seam; no Worker, MessageChannel, subprocess or socket is created. */
+class WorkerPort {
+	readonly #listeners = new Set<(value: unknown) => void>();
+	on(_event: "message", listener: (value: unknown) => void): void { this.#listeners.add(listener); }
+	off(_event: "message", listener: (value: unknown) => void): void { this.#listeners.delete(listener); }
+	deliver(value: unknown): void { for (const listener of this.#listeners) listener(value); }
+}
+
+test("early parent-port messages survive ownership registration and hand off once to the central inbox", () => {
+	const port = new WorkerPort(), scope: OwnershipWorkerScope = { onmessage: null };
+	const bootstrap = new OwnershipWorkerBootstrap(port, scope);
+	port.deliver({ type: "init", counter: new SharedArrayBuffer(4) });
+	const received: unknown[] = [];
+	bootstrap.adoptPort(port)?.on("message", value => received.push(value));
+	bootstrap.finish();
+	port.deliver({ type: "after-registration" });
+	expect(received).toMatchObject([{ type: "init" }, { type: "after-registration" }]);
+	bootstrap.close();
+});
+
+test("early stats messages replay to the installed global handler and a cancelled bootstrap retains no handler", () => {
+	const port = new WorkerPort(), scope: OwnershipWorkerScope = { onmessage: null };
+	const bootstrap = new OwnershipWorkerBootstrap(port, scope), received: unknown[] = [];
+	scope.onmessage?.(new MessageEvent("message", { data: { type: "ping" } }));
+	scope.onmessage = event => received.push(event.data);
+	bootstrap.finish();
+	expect(received).toEqual([{ type: "ping" }]);
+	const cancelledScope: OwnershipWorkerScope = { onmessage: null };
+	const cancelled = new OwnershipWorkerBootstrap(new WorkerPort(), cancelledScope);
+	cancelled.close();
+	expect(cancelledScope.onmessage).toBe(null);
+});
+
+test("message-count and payload budgets refuse startup before unbounded early work can accumulate", () => {
+	const port = new WorkerPort(), scope: OwnershipWorkerScope = { onmessage: null };
+	const bootstrap = new OwnershipWorkerBootstrap(port, scope, { messages: 2, bytes: 128 });
+	port.deliver("first"); port.deliver("second");
+	expect(() => port.deliver("third")).toThrow("ownership_limit");
+	expect(() => bootstrap.assertCurrent()).toThrow("dispatcher_unavailable");
+	bootstrap.close();
+	const oversized = new WorkerPort(), other = new OwnershipWorkerBootstrap(oversized, { onmessage: null },
+		{ messages: 2, bytes: 128 });
+	expect(() => oversized.deliver(new Uint8Array(129))).toThrow("ownership_limit");
+	other.close();
+});
