index 0000000000000000000000000000000000000000..d9c6607f9bdf6089b8ca97ce02e695c547b8d400
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/dispatcher.ts
@@ -0,0 +1,225 @@
+import {
+	decodeOwnershipRequest, OWNERSHIP_LIMITS, OWNERSHIP_VERSION, OwnershipError,
+	ownershipGeneration, ownershipIdentity, ownershipToken, sameOwnershipScope,
+	type OwnershipIdentity, type OwnershipRegistration, type OwnershipRequest, type OwnershipResponse,
+	type OwnershipResult, type OwnershipScope,
+} from "./protocol";
+import { HelperWireSession } from "./helper-protocol";
+
+/** Opaque retained OS peer identity, supplied only by the authenticated local transport, never decoded from wire. */
+export type StablePeer = object;
+export type PeerClassification =
+	| { kind: "external" } | { kind: "private"; generation: string } | { kind: "unresolved" };
+/** Backend must check synchronously at every spawn/publication barrier, after all awaited work. */
+export interface PublicationPermit { assertCurrent(): void }
+
+/**
+ * OS/durable-storage seam. The Linux adapter MUST obtain SO_PEERPIDFD, retain peer/ancestor pidfds,
+ * and recheck ancestry without trusting environment, numeric PID claims or command names.
+ * No implementation is admitted by this interface alone; a missing backend fails before serving.
+ */
+export interface OwnershipSystem {
+	readonly dispatcher: string;
+	/** Probe actual kernel operations and load durable fences. Any unresolved generation rejects startup. */
+	ready(): Promise<void>;
+	classify(peer: StablePeer): Promise<PeerClassification>;
+	/** Verify trusted supervisor/helper identities, retain pidfds and durably fsync an incomplete fence before return. */
+	protectHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void>;
+	/** Persist uncertainty. Failure must retain the existing incomplete fence; never erase it as recovery. */
+	markUnresolved(generation: string): Promise<void>;
+	/** Only authenticated helper root-reaped + closed-admission + P_ALL/ECHILD proof may clear/fsync the fence. */
+	completeHelper(helper: StablePeer, generation: string): Promise<void>;
+	/** Canonicalize and pin a real directory; no create-on-read or missing-path lexical fallback. */
+	canonicalScope(scope: OwnershipScope): Promise<OwnershipScope>;
+	/**
+	 * Fixed Native broker operation only. Before any spawn, protect the broker AND every permitted surviving
+	 * service lifetime with independent maintenance leases/durable fences outside all private helper domains.
+	 * Unknown start outcome retains its fence. Never accept arbitrary argv from this interface.
+	 */
+	broker(scope: OwnershipScope, permit: PublicationPermit): Promise<{ generation: string; runtimeDirectory: string; token: string }>;
+	/** Verify exact owned broker pidfd, scope, release/schema and independent protector before publication. */
+	publish(peer: StablePeer, scope: OwnershipScope, generation: string, permit: PublicationPermit): Promise<void>;
+}
+
+/** Public Native dispatcher decision module. No process launch or signaling authority is granted to Host/browser. */
+export class OwnershipDispatcher {
+	readonly #identity: OwnershipIdentity;
+	readonly #system: OwnershipSystem;
+	readonly #helpers = new Map<StablePeer, string>();
+	readonly #helperControllers = new Map<string, StablePeer>();
+	readonly #pendingHelpers = new Map<string, StablePeer>();
+	readonly #helperGenerations = new Set<string>();
+	readonly #registrations = new Map<StablePeer, OwnershipRegistration>();
+	readonly #helperSockets = new WeakMap<HelperWireSession, StablePeer>();
+	#blocked = false;
+	#busy = false;
+	#ready = false;
+
+	constructor(identity: OwnershipIdentity, system: OwnershipSystem) {
+		this.#identity = Object.freeze(ownershipIdentity(identity));
+		this.#system = system;
+		ownershipToken(system.dispatcher);
+	}
+
+	static async open(identity: OwnershipIdentity, system: OwnershipSystem): Promise<OwnershipDispatcher> {
+		const dispatcher = new OwnershipDispatcher(identity, system);
+		await system.ready();
+		dispatcher.#ready = true;
+		return dispatcher;
+	}
+
+	/** Trusted supervisor control seam, separate from the ordinary client socket. Return releases no worker itself. */
+	async registerHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void> {
+		return this.#serial(async () => {
+			this.#assertAvailable(); ownershipGeneration(generation);
+			if (this.#pendingHelpers.get(generation) !== control) throw new OwnershipError("ownership_unresolved");
+			if (this.#helpers.has(helper) || [...this.#helpers.values()].includes(generation)) {
+				throw new OwnershipError("ownership_protocol");
+			}
+			if (this.#helpers.size >= OWNERSHIP_LIMITS.helpers) throw new OwnershipError("ownership_limit");
+			try { await this.#system.protectHelper(control, helper, generation); }
+			catch (error) { this.#blocked = true; throw error; }
+			this.#assertAvailable();
+			this.#helpers.set(helper, generation);
+			this.#helperControllers.set(generation, control);
+			this.#pendingHelpers.delete(generation);
+		});
+	}
+
+	/** Active helper socket supplies the actual helper peer; its Host is selected from the prior authenticated prepare. */
+	async registerHelperPeer(helper: StablePeer, generation: string): Promise<void> {
+		const control = this.#pendingHelpers.get(ownershipGeneration(generation));
+		if (!control) throw new OwnershipError("ownership_unresolved");
+		await this.registerHelper(control, helper, generation);
+	}
+
+	/** One actual helper socket, routed separately from ordinary Native operations; no claimed PID is decoded. */
+	async handleHelper(peer: StablePeer, session: HelperWireSession, frame: string): Promise<string> {
+		const bound = this.#helperSockets.get(session);
+		if (bound && bound !== peer) throw new OwnershipError("ownership_unresolved");
+		this.#helperSockets.set(session, peer);
+		const request = session.decode(frame);
+		if (request.operation.op === "register_helper") await this.registerHelperPeer(peer, request.operation.generation);
+		else {
+			if (this.#helpers.get(peer) !== request.operation.generation) throw new OwnershipError("ownership_unresolved");
+			await this.completeHelper(peer);
+		}
+		return session.acknowledge(request);
+	}
+
+	/** Helper loss fences globally before storage I/O; no new shared registration may exploit orphan reparenting. */
+	async helperUncertain(helper: StablePeer): Promise<void> {
+		this.#blocked = true;
+		const generation = this.#helpers.get(helper);
+		if (!generation) throw new OwnershipError("ownership_unresolved");
+		await this.#system.markUnresolved(generation);
+	}
+
+	/** Failed/unavailable extinction proof remains incomplete and cannot be reset through the client protocol. */
+	async completeHelper(helper: StablePeer): Promise<void> {
+		return this.#serial(async () => {
+			const generation = this.#helpers.get(helper);
+			if (!generation) throw new OwnershipError("ownership_unresolved");
+			try { await this.#system.completeHelper(helper, generation); }
+			catch (error) { this.#blocked = true; throw error; }
+			this.#helpers.delete(helper);
+			this.#helperControllers.delete(generation);
+		});
+	}
+
+	/** Each request, including reconnect/publish, is classified from the actual authenticated peer again. */
+	async handle(peer: StablePeer, frame: string): Promise<OwnershipResponse> {
+		const request = decodeOwnershipRequest(frame);
+		try {
+			const result = await this.#serial(() => this.#dispatch(peer, request));
+			return { version: OWNERSHIP_VERSION, id: request.id, ok: true, identity: this.#identity, result };
+		} catch (error) {
+			return { version: OWNERSHIP_VERSION, id: request.id, ok: false,
+				error: error instanceof OwnershipError ? error.code : "ownership_unresolved" };
+		}
+	}
+
+	async #dispatch(peer: StablePeer, request: OwnershipRequest): Promise<OwnershipResult> {
+		this.#assertAvailable();
+		if (request.identity.closure !== this.#identity.closure || request.identity.schema !== this.#identity.schema) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		const registration = await this.#registration(peer);
+		this.#assertAvailable();
+		if (request.operation.op === "classify") return { op: "classify", registration };
+		if (registration.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if (request.operation.op === "prepare_helper") return this.#prepareHelper(peer, request.operation.generation);
+		if (request.operation.op === "helper_status") return this.#helperStatus(peer, request.operation.generation);
+		const scope = await this.#system.canonicalScope(request.operation.scope);
+		if (!sameOwnershipScope(scope, request.operation.scope)) throw new OwnershipError("ownership_unresolved");
+		this.#assertAvailable();
+		const permit: PublicationPermit = { assertCurrent: () => this.#assertAvailable() };
+		try {
+			if (request.operation.op === "publish") {
+				await this.#system.publish(peer, scope, request.operation.generation, permit);
+				this.#assertAvailable();
+				return { op: "publish", generation: request.operation.generation };
+			}
+			const broker = await this.#system.broker(scope, permit);
+			this.#assertAvailable();
+			return { op: "broker", scope, ...broker };
+		} catch (error) {
+			// A lost backend answer can follow an irreversible spawn. Only durable operator recovery can reopen.
+			this.#blocked = true;
+			throw error;
+		}
+	}
+
+	#prepareHelper(control: StablePeer, generation: string): OwnershipResult {
+		if (this.#helperGenerations.has(generation)) throw new OwnershipError("ownership_protocol");
+		if (this.#pendingHelpers.size + this.#helpers.size >= OWNERSHIP_LIMITS.helpers
+			|| this.#helperGenerations.size >= OWNERSHIP_LIMITS.helperGenerations) throw new OwnershipError("ownership_limit");
+		this.#helperGenerations.add(generation);
+		this.#pendingHelpers.set(generation, control);
+		return { op: "prepare_helper", generation };
+	}
+
+	async #helperStatus(control: StablePeer, generation: string): Promise<OwnershipResult> {
+		if (this.#pendingHelpers.get(generation) === control) return { op: "helper_status", generation, status: "pending" };
+		if (this.#helperControllers.get(generation) !== control) throw new OwnershipError("ownership_unresolved");
+		const helper = [...this.#helpers].find(([, value]) => value === generation)?.[0];
+		if (!helper) throw new OwnershipError("ownership_unresolved");
+		const facts = await this.#system.classify(helper);
+		if (facts.kind !== "private" || facts.generation !== generation) {
+			await this.helperUncertain(helper);
+			throw new OwnershipError("ownership_unresolved");
+		}
+		this.#assertAvailable();
+		return { op: "helper_status", generation, status: "registered" };
+	}
+
+	async #registration(peer: StablePeer): Promise<OwnershipRegistration> {
+		const facts = await this.#system.classify(peer);
+		if (facts.kind === "unresolved" || (facts.kind === "private" && ![...this.#helpers.values()].includes(facts.generation))) {
+			throw new OwnershipError("ownership_unresolved");
+		}
+		const existing = this.#registrations.get(peer);
+		if (existing) {
+			if (existing.policy !== facts.kind || (facts.kind === "private" && existing.generation !== facts.generation)) {
+				this.#blocked = true;
+				throw new OwnershipError("ownership_unresolved");
+			}
+			return existing;
+		}
+		if (this.#registrations.size >= OWNERSHIP_LIMITS.registrations) throw new OwnershipError("ownership_limit");
+		const registration = Object.freeze({ registration: crypto.randomUUID(), dispatcher: this.#system.dispatcher,
+			policy: facts.kind, generation: facts.kind === "private" ? facts.generation : crypto.randomUUID() });
+		this.#registrations.set(peer, registration);
+		return registration;
+	}
+
+	#assertAvailable(): void {
+		if (!this.#ready) throw new OwnershipError("ownership_backend_unavailable");
+		if (this.#blocked) throw new OwnershipError("maintenance_fenced");
+	}
+	async #serial<T>(operation: () => Promise<T>): Promise<T> {
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		try { return await operation(); } finally { this.#busy = false; }
+	}
+}
