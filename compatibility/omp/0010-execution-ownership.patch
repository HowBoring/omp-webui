index 0000000000..9710a568b8
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/reply-queue.ts
@@ -0,0 +1,26 @@
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+
+/** One bounded server reply, including its partial-write tail. No socket or production authority is created here. */
+export class OwnershipReplyQueue {
+  #pending: { bytes: Uint8Array; authority: boolean } | undefined;
+  readonly #assertCurrent: (authority: boolean) => void;
+  constructor(assertCurrent: (authority: boolean) => void) { this.#assertCurrent = assertCurrent; }
+  get pending(): boolean { return this.#pending !== undefined; }
+  enqueue(response: string, authority: boolean): void {
+    if (this.#pending) throw new OwnershipError("ownership_limit");
+    this.#pending = { bytes: new TextEncoder().encode(response), authority };
+  }
+  clear(): void { this.#pending = undefined; }
+  write(transport: (bytes: Uint8Array) => number): void {
+    const pending = this.#pending;
+    if (!pending) return;
+    const bytes = pending.bytes.subarray(0, OWNERSHIP_LIMITS.frameBytes);
+    let count: number;
+    try { this.#assertCurrent(pending.authority); count = transport(bytes); }
+    catch (error) { this.clear(); throw error; }
+    if (!Number.isInteger(count) || count < 0 || count > bytes.length) {
+      this.clear(); throw new OwnershipError("ownership_protocol");
+    }
+    this.#pending = count === pending.bytes.length ? undefined : { ...pending, bytes: pending.bytes.subarray(count) };
+  }
+}
diff --git a/packages/coding-agent/src/launch/ownership/selected-control-release.ts b/packages/coding-agent/src/launch/ownership/selected-control-release.ts
new file mode 100644
index 0000000000..23db637cc6
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/selected-control-release.ts
@@ -0,0 +1,76 @@
+import * as path from "node:path";
+import type { ControlReleaseManifest } from "@omp-webui/control-io";
+import { assertOwnershipControlApproval, readOwnershipPinnedFile, type LoadedOwnershipApproval } from "./approval";
+import type { LoadedOwnershipControlApproval, OwnershipControlSelection } from "./control-selection";
+import { assertLauncherMaintenanceGuard, type LauncherMaintenanceGuard } from "./maintenance-handoff";
+import { inspectOwnershipInventory } from "./release-inventory";
+import { OwnershipError } from "./protocol";
+
+const selections = new WeakMap<object, LoadedOwnershipControlApproval>();
+const retained = new Set<OwnershipControlSelection>();
+const claimed = new WeakSet<LoadedOwnershipControlApproval>();
+function roles(approval: LoadedOwnershipControlApproval, manifest: ControlReleaseManifest): void {
+  const selected = approval.controlIo;
+  for (const member of [selected, selected.source, selected.header, ...Object.values(selected.package),
+    ...Object.values(selected.native), approval.bridge, approval.helper, approval.validator]) {
+    const relative = path.relative(approval.releaseRoot, member.file);
+    if (!manifest.assets.some(asset => asset.path === relative && asset.kind === "file" && asset.identity === member.sha256)) {
+      throw new OwnershipError("dispatcher_mismatch");
+    }
+  }
+  const required = ["control-io/index.js", "control-io/package.json", "provenance/control-io/package.json",
+    "provenance/build-control-io.ts", "provenance/build-control-io-public.ts", "provenance/control-io-build.json",
+    "provenance/control-io-toolchain-package.json", "provenance/control-io-toolchain-bun.lock",
+    ...["index", "loader", "socket", "selection", "errors"].flatMap(name =>
+      [`control-io/${name}.d.ts`, `provenance/control-io/${name}.ts`])];
+  if (required.some(name => !manifest.assets.some(asset => asset.path === name && asset.kind === "file"))
+    || manifest.assets.some(asset => /^control-io\/testing\./.test(asset.path))) {
+    throw new OwnershipError("dispatcher_mismatch");
+  }
+}
+/**
+ * Concrete Native adapter to the public package's existing selection contract. It loads no library.
+ * Verification is guard -> authenticated snapshot -> exhaustive bytes/platform closure -> snapshot -> guard.
+ * The C descriptor is process-owned forever; releasing a generation drops only this snapshot/reference.
+ */
+export async function selectOwnershipControlRelease(approval: LoadedOwnershipControlApproval,
+  guard: LauncherMaintenanceGuard): Promise<OwnershipControlSelection> {
+  assertOwnershipControlApproval(approval);
+  if (claimed.has(approval)) throw new OwnershipError("ownership_limit");
+  claimed.add(approval); // First construction, including failed protection/inventory, consumes this immutable generation.
+  assertLauncherMaintenanceGuard(guard, approval.control);
+  await approval.verify(); await readOwnershipPinnedFile(approval.control);
+  const inventory = await inspectOwnershipInventory(approval.releaseRoot, approval.controlIo.inventory);
+  roles(approval, inventory.manifest);
+  await approval.verify(); assertLauncherMaintenanceGuard(guard, approval.control);
+  let released = false, failed = false, tail = Promise.resolve();
+  const assertCurrent = (): void => {
+    if (released || failed) throw new OwnershipError("maintenance_fenced");
+    try { assertOwnershipControlApproval(approval); assertLauncherMaintenanceGuard(guard, approval.control); }
+    catch { failed = true; throw new OwnershipError("maintenance_fenced"); }
+  };
+  const verify = (): Promise<void> => {
+    const work = tail.then(async () => {
+      try {
+        assertCurrent(); await approval.verify(); await readOwnershipPinnedFile(approval.control);
+        await inventory.verify(); roles(approval, inventory.manifest);
+        await approval.verify(); assertCurrent();
+      } catch { failed = true; throw new OwnershipError("dispatcher_mismatch"); }
+    });
+    tail = work.catch(() => {}); return work;
+  };
+  const selection = Object.freeze({ selected: Object.freeze({ release: Object.freeze({ root: approval.releaseRoot,
+    identity: approval.controlIo.inventory.sha256, manifest: inventory.manifest }) }), assertCurrent, verify,
+    async release(): Promise<void> {
+      // Caller must first finish public module disposal. Never unlock/close the inherited process descriptor.
+      released = true; await tail; retained.delete(selection);
+    } });
+  selections.set(selection, approval); retained.add(selection); return selection;
+}
+/** A structural callback fake or historical approval cannot enter the production server/load graph. */
+export function assertOwnershipControlSelection(selection: OwnershipControlSelection | undefined,
+  approval: LoadedOwnershipApproval): asserts selection is OwnershipControlSelection {
+  assertOwnershipControlApproval(approval);
+  if (!selection || selections.get(selection) !== approval) throw new OwnershipError("maintenance_fenced");
+  selection.assertCurrent();
+}
diff --git a/packages/coding-agent/src/launch/ownership/server-key.ts b/packages/coding-agent/src/launch/ownership/server-key.ts
new file mode 100644
index 0000000000..566fa7141f
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/server-key.ts
@@ -0,0 +1,24 @@
+import { readOwnershipPinnedFile, type LoadedOwnershipApproval, type OwnershipApprovalPin } from "./approval";
+import { OwnershipError } from "./protocol";
+
+/** Separate protected dispatcher key record; ordinary clients never read it and no endpoint can supply it. */
+export async function loadOwnershipSigningKey(pin: OwnershipApprovalPin, approval: LoadedOwnershipApproval): Promise<CryptoKey> {
+	try {
+		if (pin.path === approval.releaseRoot || pin.path.startsWith(`${approval.releaseRoot}/`)) throw new OwnershipError("dispatcher_mismatch");
+		const value: unknown = JSON.parse(await readOwnershipPinnedFile(pin));
+		if (typeof value !== "object" || value === null || Array.isArray(value)) throw new OwnershipError("dispatcher_mismatch");
+		const record = value as Record<string, unknown>;
+		if (Object.keys(record).length !== 4 || record.version !== "omp-execution-signing-key/1"
+			|| record.installation !== approval.installation || record.publicKey !== approval.publicKey
+			|| typeof record.privateKey !== "string" || record.privateKey.length > 256) throw new OwnershipError("dispatcher_mismatch");
+		const bytes = Buffer.from(record.privateKey, "base64url");
+		if (bytes.toString("base64url") !== record.privateKey) throw new OwnershipError("dispatcher_mismatch");
+		const key = await crypto.subtle.importKey("pkcs8", bytes, "Ed25519", false, ["sign"]);
+		const publicKey = await crypto.subtle.importKey("raw", Buffer.from(approval.publicKey, "base64url"), "Ed25519", false, ["verify"]);
+		const challenge = crypto.getRandomValues(new Uint8Array(32));
+		if (!await crypto.subtle.verify("Ed25519", publicKey, await crypto.subtle.sign("Ed25519", key, challenge), challenge)) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		await approval.verify(); return key;
+	} catch { throw new OwnershipError("dispatcher_mismatch"); }
+}
diff --git a/packages/coding-agent/src/launch/ownership/server.ts b/packages/coding-agent/src/launch/ownership/server.ts
new file mode 100644
index 0000000000..5f645e22b5
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/server.ts
@@ -0,0 +1,220 @@
+import * as fs from "node:fs/promises";
+import { assertOwnershipControlApproval, type LoadedOwnershipApproval, type OwnershipApprovalPin } from "./approval";
+import { decodeOwnershipChallenge, signOwnershipReply } from "./authentication";
+import { OwnershipDispatcher, type StablePeer } from "./dispatcher";
+import { OwnershipFences } from "./fences";
+import { OwnershipFrames } from "./framing";
+import { HELPER_OWNERSHIP_VERSION, HelperWireSession } from "./helper-protocol";
+import type { LinuxOwnershipBridge, OwnershipSocket } from "./linux-bridge";
+import type { LoadedOwnershipControlApproval, OwnershipControlSelection } from "./control-selection";
+import { assertOwnershipControlSelection } from "./selected-control-release";
+import { OwnershipReplyQueue } from "./reply-queue";
+import { assertOwnershipControlIoOwner, OwnershipControlIoOwner } from "./control-io-owner";
+import { LinuxOwnershipSystem } from "./linux-system";
+import { loadOwnershipSigningKey } from "./server-key";
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+
+interface Connection {
+	readonly socket: OwnershipSocket;
+	readonly peer: StablePeer;
+	readonly frames: OwnershipFrames;
+	readonly helper: HelperWireSession;
+	active: boolean;
+	closed: boolean;
+	helperRegistered: boolean;
+	helperCompleted: boolean;
+	deadline: number;
+	readonly output: OwnershipReplyQueue;
+}
+
+// Failed starts retain all known handles and selection through ambiguous bridge initialization/disposal.
+const retainedStarts = new Set<{ owner: OwnershipControlIoOwner; bridge?: LinuxOwnershipBridge; fences?: OwnershipFences }>();
+const retainedServers = new Set<LinuxOwnershipServer>();
+
+/** Main-thread Linux server. Poll callbacks never block; only this independent dispatcher loads ownership FFI. */
+export class LinuxOwnershipServer {
+	readonly #owner: OwnershipControlIoOwner;
+	readonly #selection: OwnershipControlSelection;
+	readonly #approval: LoadedOwnershipControlApproval;
+	readonly #bridge: LinuxOwnershipBridge;
+	readonly #fences: OwnershipFences;
+	readonly #dispatcher: OwnershipDispatcher;
+	readonly #key: CryptoKey;
+	readonly #generation: string;
+	readonly #listener: OwnershipSocket;
+	readonly #connections = new Set<Connection>();
+	readonly #peers: StablePeer[] = [];
+	#tail = Promise.resolve();
+	#timer: Timer | undefined;
+	#closed = false;
+	#closing: Promise<void> | undefined;
+	#uncertain = false;
+	#endpointIdentity: { device: bigint; inode: bigint } | undefined;
+
+	private constructor(approval: LoadedOwnershipControlApproval, bridge: LinuxOwnershipBridge, fences: OwnershipFences,
+		dispatcher: OwnershipDispatcher, key: CryptoKey, generation: string, listener: OwnershipSocket, owner: OwnershipControlIoOwner, selection: OwnershipControlSelection) {
+		this.#owner = owner; this.#selection = selection; this.#approval = approval; this.#bridge = bridge; this.#fences = fences; this.#dispatcher = dispatcher;
+		this.#key = key; this.#generation = generation; this.#listener = listener;
+	}
+
+	/** Explicit synthetic/selected operator start; no ordinary client can invoke this as a fallback. */
+	static async open(approval: LoadedOwnershipApproval, keyPin: OwnershipApprovalPin,
+    selection?: OwnershipControlSelection): Promise<LinuxOwnershipServer> {
+    // Mandatory before even importing the bridge/FFI graph; historical v2 and structural fakes cannot enter.
+    assertOwnershipControlApproval(approval); assertOwnershipControlSelection(selection, approval);
+    const owner = await OwnershipControlIoOwner.open(approval, selection);
+    const resources: { owner: OwnershipControlIoOwner; bridge?: LinuxOwnershipBridge; fences?: OwnershipFences } = { owner };
+    retainedStarts.add(resources);
+    try {
+      const key = await loadOwnershipSigningKey(keyPin, approval);
+      await owner.ready(); owner.assertReady();
+      // Intentional main-only dynamic import: actual public control-I/O load must finish before this import.
+      const { LinuxOwnershipBridge } = await import("./linux-bridge");
+      await owner.ready(); owner.assertReady();
+      const bridge = await LinuxOwnershipBridge.open({ ...approval.bridge, approval, selection, owner });
+      resources.bridge = bridge;
+      const fences = await OwnershipFences.open({ directory: approval.fenceDirectory, releaseRoot: approval.releaseRoot,
+        installation: approval.installation, identity: approval.identity });
+      resources.fences = fences;
+      const generation = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("hex");
+      const system = new LinuxOwnershipSystem(approval, bridge, fences, generation, owner);
+      const dispatcher = await OwnershipDispatcher.open(approval.identity, system);
+      await owner.ready(); owner.assertReady();
+      const listener = bridge.listen(approval.endpoint);
+      const server = new LinuxOwnershipServer(approval, bridge, fences, dispatcher, key, generation, listener, owner, selection);
+      retainedServers.add(server);
+      const stat = await fs.lstat(approval.endpoint, { bigint: true });
+      if (!stat.isSocket()) throw new OwnershipError("dispatcher_mismatch");
+      server.#endpointIdentity = { device: stat.dev, inode: stat.ino };
+      await owner.ready(); owner.assertReady();
+      server.#schedule(); retainedStarts.delete(resources); return server;
+    } catch (error) {
+      // No admission was scheduled. Best-effort descriptor disposal supplies no library/extinction receipt.
+      try { resources.bridge?.close(); } catch { /* Retained above: never retry uncertain native close. */ }
+      try { await resources.fences?.close(); } catch { /* Preserve fence descriptors/files and generation owner. */ }
+      throw error;
+    }
+  }
+
+  /** Stops admission immediately. No COMPLETE, EOF or server close substitutes for the Host original reap. */
+  close(): Promise<void> {
+    if (this.#closing) return this.#closing;
+    this.#closed = true; this.#dispatcher.stopAdmission(); clearTimeout(this.#timer);
+    this.#closing = this.#shutdown(); return this.#closing;
+  }
+  async #shutdown(): Promise<void> {
+    try { this.#bridge.releaseSocket(this.#listener); } catch { this.#uncertain = true; }
+    for (const connection of this.#connections) {
+      try { this.#drop(connection); } catch { this.#uncertain = true; }
+    }
+    // Closing a connection can append uncertainty work while an older response is suspended.
+    for (;;) { const tail = this.#tail; await tail; if (tail === this.#tail) break; }
+    await this.#owner.close(async () => {
+      if (this.#uncertain || this.#connections.size) throw new OwnershipError("ownership_unresolved");
+      this.#dispatcher.assertDrained();
+      await this.#fences.verify(); this.#fences.assertDrained(); this.#dispatcher.assertDrained();
+      const stat = await fs.lstat(this.#approval.endpoint, { bigint: true });
+      if (!stat.isSocket() || stat.dev !== this.#endpointIdentity?.device || stat.ino !== this.#endpointIdentity.inode) {
+        throw new OwnershipError("ownership_unresolved");
+      }
+      await fs.unlink(this.#approval.endpoint);
+      this.#bridge.close(); await this.#fences.close();
+    });
+    retainedServers.delete(this);
+  }
+
+
+	#schedule(): void { this.#timer = setTimeout(() => this.#poll(), 5); }
+	#poll(): void {
+		if (this.#closed) return;
+		try {
+			for (let count = this.#connections.size; count < OWNERSHIP_LIMITS.connections; count++) {
+				const socket = this.#bridge.accept(this.#listener, process.getuid?.() ?? -1);
+				if (!socket) break;
+				try { this.#admit(socket); } catch { this.#bridge.releaseSocket(socket); }
+			}
+			for (const connection of this.#connections) {
+				try { this.#advance(connection); } catch { this.#drop(connection); }
+			}
+		} catch { void this.close().catch(() => undefined); return; }
+		this.#schedule();
+	}
+	#admit(socket: OwnershipSocket): void {
+		const captured = this.#bridge.capturePeer(socket);
+		let peer: StablePeer;
+		try {
+			const existing = this.#peers.find(value => this.#bridge.peerAlive(value) && this.#bridge.samePeer(value, captured));
+			peer = existing ?? captured;
+			if (!existing) this.#peers.push(peer);
+		} catch (error) { this.#bridge.releasePeer(captured); throw error; }
+		if (peer !== captured) this.#bridge.releasePeer(captured);
+		const connection: Connection = { socket, peer, frames: new OwnershipFrames(),
+			helper: new HelperWireSession(this.#approval.installation), active: false, closed: false,
+			helperRegistered: false, helperCompleted: false, deadline: performance.now() + OWNERSHIP_LIMITS.idleMs,
+			output: new OwnershipReplyQueue(authority => this.#assertReplyCurrent(connection, authority)) };
+		this.#connections.add(connection);
+	}
+	#advance(connection: Connection): void {
+		if (performance.now() >= connection.deadline) { this.#drop(connection); return; }
+		if (connection.output.pending) {
+			connection.output.write(bytes => this.#bridge.write(connection.socket, bytes));
+			if (!connection.output.pending) { connection.active = false; connection.deadline = performance.now() + OWNERSHIP_LIMITS.idleMs; }
+		}
+		const bytes = this.#bridge.read(connection.socket);
+		if (bytes === undefined) return;
+		if (!bytes.length) { connection.frames.end(); this.#drop(connection); return; }
+		if (connection.active) throw new OwnershipError("ownership_limit");
+		connection.deadline = Math.min(connection.deadline, performance.now() + OWNERSHIP_LIMITS.requestMs);
+		for (const frame of connection.frames.push(bytes)) {
+			connection.active = true;
+			this.#tail = this.#tail.then(() => this.#respond(connection, frame)).catch(() => this.#drop(connection));
+		}
+	}
+	async #respond(connection: Connection, frame: string): Promise<void> {
+		if (connection.closed || this.#closed || performance.now() >= connection.deadline) return;
+		await this.#owner.ready();
+		await this.#approval.verify();
+		const value: unknown = JSON.parse(frame);
+		let response: string, authority = true;
+		if (typeof value === "object" && value !== null && "version" in value && value.version === HELPER_OWNERSHIP_VERSION) {
+			response = await this.#dispatcher.handleHelper(connection.peer, connection.helper, frame);
+			if (!connection.helperRegistered) connection.helperRegistered = true;
+			else { connection.helperCompleted = true; authority = false; } // COMPLETE drains; it grants no new admission.
+			if ((connection.closed || this.#closed) && !connection.helperCompleted) {
+				await this.#dispatcher.helperUncertain(connection.peer); return;
+			}
+		} else {
+			const challenge = await decodeOwnershipChallenge(frame, this.#approval);
+			const result = await this.#dispatcher.handle(connection.peer, JSON.stringify(challenge.request));
+			authority = result.ok; // Signed refusals remain inspectable after a dispatcher fence.
+			response = await signOwnershipReply(challenge, JSON.stringify(result), { installation: this.#approval.installation,
+				identity: this.#approval.identity, serverGeneration: this.#generation, privateKey: this.#key }) + "\n";
+		}
+		await this.#owner.ready();
+		await this.#approval.verify();
+		if (connection.closed || this.#closed || performance.now() >= connection.deadline) return;
+		this.#owner.assertReady();
+		connection.output.enqueue(response, authority);
+	}
+	#assertReplyCurrent(connection: Connection, authority: boolean): void {
+		if (connection.closed || this.#closed || performance.now() >= connection.deadline) {
+			throw new OwnershipError("maintenance_fenced");
+		}
+		assertOwnershipControlIoOwner(this.#owner, this.#selection, this.#approval);
+		if (authority) {
+			if (this.#uncertain) throw new OwnershipError("maintenance_fenced");
+			this.#dispatcher.assertPublication();
+		}
+	}
+	#drop(connection: Connection): void {
+		if (connection.closed) return;
+		connection.closed = true; connection.output.clear(); this.#connections.delete(connection);
+		if (connection.helperRegistered && !connection.helperCompleted) {
+			// Set the dispatcher fence synchronously, before any already queued external request can resume.
+			const uncertainty = this.#dispatcher.helperUncertain(connection.peer).catch(() => { this.#uncertain = true; });
+			this.#tail = this.#tail.then(() => uncertainty).catch(() => undefined);
+		}
+		try { this.#bridge.releaseSocket(connection.socket); }
+		catch (error) { this.#uncertain = true; throw error; }
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/strict-record.ts b/packages/coding-agent/src/launch/ownership/strict-record.ts
new file mode 100644
index 0000000000..224aa53b00
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/strict-record.ts
@@ -0,0 +1,11 @@
+import { OwnershipError } from "./protocol";
+
+/** Exact own-key record policy for signed approval and release-inventory schemas. */
+export function strictOwnershipRecord(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) throw new OwnershipError("dispatcher_mismatch");
+	const source = value as Record<string, unknown>;
+	if (Object.keys(source).length !== keys.length || Object.keys(source).some(key => !keys.includes(key))) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	return source;
+}
diff --git a/packages/coding-agent/src/launch/ownership/uds-client.ts b/packages/coding-agent/src/launch/ownership/uds-client.ts
new file mode 100644
index 0000000000..37e09c4d99
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/uds-client.ts
@@ -0,0 +1,86 @@
+import type { Socket } from "bun";
+import type { LoadedOwnershipApproval } from "./approval";
+import { OwnershipReplyVerifier } from "./authentication";
+import { OwnershipClient, type OwnershipTransport } from "./client";
+import { OwnershipFrames } from "./framing";
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+
+/** Public Bun UDS only, including worker realms. Authentication never reads a private socket field or loads FFI. */
+export class BunOwnershipTransport implements OwnershipTransport {
+	readonly #approval: LoadedOwnershipApproval;
+	readonly #verifier: OwnershipReplyVerifier;
+	readonly #frames = new OwnershipFrames("response");
+	#socket: Socket<undefined> | undefined;
+	#pending: { resolve(value: string): void; reject(error: unknown): void; received: boolean } | undefined;
+	#write: Uint8Array | undefined;
+	#connectReject: ((error: unknown) => void) | undefined;
+	#closed = false;
+	#busy = false;
+	constructor(approval: LoadedOwnershipApproval) {
+		this.#approval = approval; this.#verifier = new OwnershipReplyVerifier(approval);
+	}
+	async exchange(frame: string, signal: AbortSignal): Promise<string> {
+		if (this.#closed || signal.aborted) throw new OwnershipError("dispatcher_unavailable");
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		const reply = Promise.withResolvers<string>();
+		const abort = (): void => this.close();
+		signal.addEventListener("abort", abort, { once: true });
+		try {
+			await this.#approval.verify();
+			const challenge = await this.#verifier.challenge(frame);
+			await this.#connect();
+			await this.#approval.verify();
+			if (this.#closed || signal.aborted) throw new OwnershipError("dispatcher_unavailable");
+			this.#pending = { resolve: reply.resolve, reject: reply.reject, received: false };
+			this.#write = new TextEncoder().encode(`${challenge.frame}\n`); this.#drain();
+			const response = await this.#verifier.verify(await reply.promise, challenge);
+			await this.#approval.verify();
+			if (this.#closed || signal.aborted) throw new OwnershipError("dispatcher_unavailable");
+			return response;
+		} catch (error) {
+			this.close();
+			throw error instanceof OwnershipError ? error : new OwnershipError("dispatcher_unavailable");
+		} finally { this.#pending = undefined; this.#busy = false; signal.removeEventListener("abort", abort); }
+	}
+	close(): void {
+		if (this.#closed) return;
+		this.#closed = true; this.#verifier.close(); this.#write = undefined;
+		this.#connectReject?.(new OwnershipError("dispatcher_unavailable"));
+		this.#pending?.reject(new OwnershipError("dispatcher_unavailable")); this.#socket?.terminate(); this.#socket = undefined;
+	}
+	async #connect(): Promise<void> {
+		if (this.#socket) return;
+		const cancelled = Promise.withResolvers<never>(); this.#connectReject = cancelled.reject;
+		const timeout: Timer = setTimeout(() => this.close(), OWNERSHIP_LIMITS.connectMs);
+		try {
+			const connecting = Bun.connect<undefined>({ unix: this.#approval.endpoint, socket: {
+				data: (_socket, bytes) => this.#receive(bytes), drain: () => this.#drain(),
+				close: () => this.close(), error: () => this.close(), connectError: () => this.close(),
+			} });
+			const socket = await Promise.race([connecting.then(value => {
+				if (this.#closed) { value.terminate(); throw new OwnershipError("dispatcher_unavailable"); }
+				return value;
+			}), cancelled.promise]);
+			if (this.#closed) { socket.terminate(); throw new OwnershipError("dispatcher_unavailable"); }
+			this.#socket = socket;
+		} finally { clearTimeout(timeout); this.#connectReject = undefined; }
+	}
+	#receive(bytes: Uint8Array): void {
+		try {
+			if (!this.#pending || this.#pending.received) throw new OwnershipError("ownership_protocol");
+			for (const frame of this.#frames.push(bytes)) { this.#pending.received = true; this.#pending.resolve(frame); }
+		} catch { this.close(); }
+	}
+	#drain(): void {
+		if (!this.#write || !this.#socket || this.#closed) return;
+		const written = this.#socket.write(this.#write);
+		if (written < 0 || written > this.#write.length) { this.close(); return; }
+		this.#write = written === this.#write.length ? undefined : this.#write.subarray(written);
+	}
+}
+
+/** Explicit selected approval; no automatic rendezvous discovery, server launch or reconnect fallback. */
+export function connectApprovedOwnershipClient(approval: LoadedOwnershipApproval): OwnershipClient {
+	return new OwnershipClient(approval.identity, new BunOwnershipTransport(approval));
+}
