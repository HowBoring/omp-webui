+	const responseFrame = JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000002", identity, ok: true,
+		result: { op: "list_scopes", scopes: Array.from({ length: 64 }, (_, index) => ({
+			scope: { kind: "project", directory: `/project-${index}/${escaped}` },
+			generation: `generation-${String(index).padStart(16, "0")}`, runtimeDirectory: `/run-${index}/${escaped}`,
+		})) } });
+	expect(new TextEncoder().encode(responseFrame).length).toBeLessThan(1_048_576);
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	await expect(signOwnershipReply(decoded, responseFrame, { installation, identity, serverGeneration, privateKey: key }))
+		.rejects.toMatchObject({ code: "ownership_limit" });
+});
