+import { OwnershipError } from "./protocol";
+
+/**
+ * Public independent dispatcher entry. Source preparation deliberately admits no OS backend yet.
+ * A backend must prove SO_PEERPIDFD, durable fences and external lifetime protectors before replacing this refusal.
+ * This entry must never load the Session/UI/provider graph or silently become a client-side broker spawner.
+ */
+export async function startOwnershipDispatcher(): Promise<never> {
+	throw new OwnershipError("ownership_backend_unavailable");
+}
diff --git a/packages/coding-agent/src/launch/ownership/framing.ts b/packages/coding-agent/src/launch/ownership/framing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a1ca28fe7b2c00ddaf1593a5cb4359b2d3653fd
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/framing.ts
@@ -0,0 +1,32 @@
+import { OWNERSHIP_LIMITS, OwnershipError } from "./protocol";
+
+/** Bounded LF framing. A transport must also bound its receive queue and close on any thrown error. */
+export class OwnershipFrames {
+	readonly #bytes = new Uint8Array(OWNERSHIP_LIMITS.frameBytes);
+	#used = 0;
+	#ended = false;
+
+	push(chunk: Uint8Array): string[] {
+		if (this.#ended) throw new OwnershipError("ownership_protocol");
+		// More than one maximum-sized frame is never an admitted per-connection queue.
+		if (chunk.byteLength + this.#used > OWNERSHIP_LIMITS.queuedBytesPerConnection) throw new OwnershipError("ownership_limit");
+		const frames: string[] = [];
+		for (const byte of chunk) {
+			if (byte !== 10) {
+				if (this.#used === this.#bytes.length) throw new OwnershipError("ownership_limit");
+				this.#bytes[this.#used++] = byte;
+				continue;
+			}
+			if (frames.length === OWNERSHIP_LIMITS.pendingPerConnection) throw new OwnershipError("ownership_limit");
+			try { frames.push(new TextDecoder("utf-8", { fatal: true }).decode(this.#bytes.subarray(0, this.#used))); }
+			catch { throw new OwnershipError("ownership_protocol"); }
+			this.#used = 0;
+		}
+		return frames;
+	}
+
+	end(): void {
+		this.#ended = true;
+		if (this.#used !== 0) throw new OwnershipError("ownership_protocol");
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/helper-protocol.ts b/packages/coding-agent/src/launch/ownership/helper-protocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5f7910ccd6c2eed73706ddda7f919274ab7f7f6c
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/helper-protocol.ts
@@ -0,0 +1,76 @@
+import { OwnershipError, ownershipGeneration } from "./protocol";
+
+/** Fixed canonical C-helper protocol, routed by version at the selected ownership endpoint. No closure hash cycle. */
+export const HELPER_OWNERSHIP_VERSION = "omp-execution-helper/1";
+export const HELPER_OWNERSHIP_FRAME_BYTES = 512;
+export interface HelperOwnershipRequest {
+	version: typeof HELPER_OWNERSHIP_VERSION;
+	id: string;
+	installation: string;
+	operation: { op: "register_helper" | "complete_helper"; generation: string };
+}
+
+function record(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) throw new OwnershipError("ownership_protocol");
+	const result = value as Record<string, unknown>;
+	if (Object.keys(result).length !== keys.length || Object.keys(result).some(key => !keys.includes(key))) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	return result;
+}
+export function helperOwnershipGeneration(value: unknown): string {
+	return ownershipGeneration(value);
+}
+
+/** Decode one frame excluding LF; the C protocol's 512-byte budget includes that LF. */
+export function decodeHelperRequest(frame: string, installation: string): HelperOwnershipRequest {
+	if (new TextEncoder().encode(frame).length >= HELPER_OWNERSHIP_FRAME_BYTES) throw new OwnershipError("ownership_limit");
+	let value: unknown;
+	try { value = JSON.parse(frame); } catch { throw new OwnershipError("ownership_protocol"); }
+	const source = record(value, ["version", "id", "installation", "operation"]);
+	if (source.version !== HELPER_OWNERSHIP_VERSION || source.installation !== helperOwnershipGeneration(installation)) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	const operation = record(source.operation, ["op", "generation"]);
+	if (operation.op !== "register_helper" && operation.op !== "complete_helper") throw new OwnershipError("ownership_protocol");
+	const generation = helperOwnershipGeneration(operation.generation);
+	const id = helperOwnershipGeneration(source.id);
+	if (id === generation) throw new OwnershipError("ownership_protocol");
+	return Object.freeze({ version: HELPER_OWNERSHIP_VERSION, id, installation,
+		operation: Object.freeze({ op: operation.op, generation }) });
+}
+
+/** Exact canonical success bytes; called only after authenticated peer verification and durable system action. */
+export function encodeHelperSuccess(request: HelperOwnershipRequest): string {
+	return JSON.stringify({ version: HELPER_OWNERSHIP_VERSION, id: request.id, ok: true,
+		operation: request.operation.op, generation: request.operation.generation }) + "\n";
+}
+
+/** A stale success, duplicate phase, wrong operation or wrong generation never grants START/extinction. */
+export function verifyHelperAcknowledgement(frame: string, expected: HelperOwnershipRequest): void {
+	if (frame !== encodeHelperSuccess(expected)) throw new OwnershipError("dispatcher_mismatch");
+}
+
+/** One authenticated helper socket, retained REGISTER through COMPLETE; acknowledge only after durable system work. */
+export class HelperWireSession {
+	readonly #installation: string;
+	#registered: HelperOwnershipRequest | undefined;
+	#pending: HelperOwnershipRequest | undefined;
+	#complete = false;
+	constructor(installation: string) { this.#installation = helperOwnershipGeneration(installation); }
+	decode(frame: string): HelperOwnershipRequest {
+		if (this.#pending || this.#complete) throw new OwnershipError("ownership_protocol");
+		const request = decodeHelperRequest(frame, this.#installation), old = this.#registered;
+		if (!old ? request.operation.op !== "register_helper"
+			: request.operation.op !== "complete_helper" || request.id === old.id
+				|| request.operation.generation !== old.operation.generation) throw new OwnershipError("ownership_protocol");
+		this.#pending = request;
+		return request;
+	}
+	acknowledge(request: HelperOwnershipRequest): string {
+		if (this.#pending !== request) throw new OwnershipError("ownership_protocol");
+		this.#pending = undefined;
+		if (request.operation.op === "register_helper") this.#registered = request; else this.#complete = true;
+		return encodeHelperSuccess(request);
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/linux-bridge.c b/packages/coding-agent/src/launch/ownership/linux-bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..f2952b794f21802e38dda98aebc845d770936d51
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/linux-bridge.c
@@ -0,0 +1,339 @@
+/* Native execution ownership ABI 1. COMPILE-ONLY PREPARATION: no kernel-validated capability.
+ * No Agent, Session, provider, arbitrary executable, environment or signal operation lives here.
+ * All descriptors stay inside this library. Callers receive checked table handles, never raw fds.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#ifndef SO_PEERPIDFD
+#define SO_PEERPIDFD 77
+#endif
+
+#define OWNERSHIP_HANDLES 1024
+#define OWNERSHIP_FDS 2048
+#define OWNERSHIP_CONNECTIONS 64
+#define OWNERSHIP_ANCESTORS 256
+#define OWNERSHIP_HELPERS 64
+#define OWNERSHIP_FRAME 16384
+
+enum handle_kind { UNUSED = 0, LISTENER = 1, CONNECTION = 2, IDENTITY = 3, CONNECTING = 4 };
+struct handle { enum handle_kind kind; int fd; int peerfd; pid_t pid; uint64_t start; int key; };
+struct task { int fd; pid_t pid; pid_t parent; uint64_t start; };
+static struct handle handles[OWNERSHIP_HANDLES];
+static unsigned descriptor_count;
+static unsigned connection_count;
+static unsigned handle_serial;
+
+static int failure(void) { return -(errno ? errno : EIO); }
+static void drop_fd(int fd) {
+	if (fd < 0) return;
+	/* Retrying close after EINTR can close a reused Linux fd. Ownership ends after this close. */
+	(void)close(fd);
+	if (descriptor_count) descriptor_count--;
+}
+static int own_fd(int fd) {
+	if (fd < 0) return failure();
+	if (descriptor_count >= OWNERSHIP_FDS) { (void)close(fd); return -EMFILE; }
+	descriptor_count++;
+	return fd;
+}
+static int pidfd_open_owned(pid_t pid) {
+#ifdef SYS_pidfd_open
+	return own_fd((int)syscall(SYS_pidfd_open, pid, 0));
+#else
+	(void)pid; return -ENOSYS;
+#endif
+}
+static struct handle *lookup(int key, enum handle_kind kind) {
+	if (key <= 0) return NULL;
+	struct handle *value = &handles[(key - 1) % OWNERSHIP_HANDLES];
+	return value->key == key && value->kind == kind ? value : NULL;
+}
+static int keep(enum handle_kind kind, int fd, int peerfd, pid_t pid, uint64_t start) {
+	if (handle_serial >= (unsigned)(INT_MAX / OWNERSHIP_HANDLES) - 1) {
+		drop_fd(fd); drop_fd(peerfd); return -EOVERFLOW;
+	}
+	for (unsigned i = 0; i < OWNERSHIP_HANDLES; i++) {
+		if (handles[i].kind != UNUSED) continue;
+		int key = (int)(++handle_serial * OWNERSHIP_HANDLES + i + 1);
+		handles[i] = (struct handle){ kind, fd, peerfd, pid, start, key };
+		if (kind == CONNECTION || kind == CONNECTING) connection_count++;
+		return key;
+	}
+	drop_fd(fd); drop_fd(peerfd);
+	return -EMFILE;
+}
+static int alive(int fd) {
+	struct pollfd pollfd = { .fd = fd, .events = POLLIN };
+	int result = poll(&pollfd, 1, 0);
+	if (result < 0) return failure();
+	/* pidfds become readable at exit. HUP/ERR/NVAL never grant classification authority. */
+	return result == 0 ? 1 : -ESTALE;
+}
+static int same_pid_namespace(pid_t pid) {
+	char name[64];
+	struct stat self, other;
+	if (snprintf(name, sizeof(name), "/proc/%ld/ns/pid", (long)pid) >= (int)sizeof(name)) return -EOVERFLOW;
+	if (stat("/proc/self/ns/pid", &self) || stat(name, &other)) return failure();
+	return self.st_dev == other.st_dev && self.st_ino == other.st_ino ? 0 : -EXDEV;
+}
+static int read_task(pid_t pid, int pidfd, struct task *task) {
+	char name[64], bytes[4096];
+	if (alive(pidfd) < 0) return -ESTALE;
+	if (snprintf(name, sizeof(name), "/proc/%ld/stat", (long)pid) >= (int)sizeof(name)) return -EOVERFLOW;
+	int fd = own_fd(open(name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+	if (fd < 0) return fd;
+	ssize_t size = read(fd, bytes, sizeof(bytes) - 1);
+	int saved = errno;
+	drop_fd(fd); errno = saved;
+	if (size < 0) return failure();
+	if (size == 0 || size >= (ssize_t)sizeof(bytes) - 1) return -EPROTO;
+	bytes[size] = '\0';
+	/* comm can contain spaces, newlines and ')'; stat fields begin after its final ')'. */
+	char *cursor = strrchr(bytes, ')');
+	if (!cursor || cursor + 3 >= bytes + size || cursor[1] != ' ' || cursor[2] == '\0' || cursor[3] != ' ') return -EPROTO;
+	cursor += 4; /* field 4 (ppid), after field 3 (state) */
+	uint64_t parent = 0, start = 0;
+	for (unsigned field = 4; field <= 22; field++) {
+		if (*cursor == '\0' || *cursor == '\n') return -EPROTO;
+		char *end;
+		if (field == 4 || field == 22) {
+			errno = 0;
+			if (*cursor < '0' || *cursor > '9') return -EPROTO;
+			unsigned long long value = strtoull(cursor, &end, 10);
+			if (errno || end == cursor || (*end != ' ' && *end != '\n' && *end != '\0')) return -EPROTO;
+			if (field == 4) parent = value; else start = value;
+		} else {
+			end = strchr(cursor, ' ');
+			if (!end) return -EPROTO;
+		}
+		cursor = end;
+		while (*cursor == ' ') cursor++;
+	}
+	if (parent > INT_MAX || start == 0 || alive(pidfd) < 0) return -ESTALE;
+	*task = (struct task){ .fd = pidfd, .pid = pid, .parent = (pid_t)parent, .start = start };
+	return 0;
+}
+static int peer_identity(int fd, uid_t expected_uid, int *peerfd, pid_t *pid, uint64_t *start) {
+	struct ucred credential;
+	socklen_t size = sizeof(credential);
+	if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credential, &size)) return failure();
+	if (size != sizeof(credential) || credential.uid != expected_uid || credential.pid <= 0) return -EACCES;
+	/* Validate namespace on authenticated peers. Ancestors may be root-owned with unreadable ns links. */
+	if (same_pid_namespace(credential.pid) < 0) return -EXDEV;
+	int obtained = -1;
+	size = sizeof(obtained);
+	if (getsockopt(fd, SOL_SOCKET, SO_PEERPIDFD, &obtained, &size)) return failure();
+	int owned = own_fd(obtained);
+	if (owned < 0) return owned;
+	if (size != sizeof(obtained)) { drop_fd(owned); return -EPROTO; }
+	int flags = fcntl(owned, F_GETFD);
+	if (flags < 0 || fcntl(owned, F_SETFD, flags | FD_CLOEXEC) < 0) { int error = failure(); drop_fd(owned); return error; }
+	struct task task;
+	int result = read_task(credential.pid, owned, &task);
+	if (result < 0) { drop_fd(owned); return result; }
+	*peerfd = owned; *pid = credential.pid; *start = task.start;
+	return 0;
+}
+
+int omp_ownership_abi(void) { return 1; }
+unsigned omp_ownership_fd_count(void) { return descriptor_count; }
+
+/* Real operation probe, never inferred from a version string. The caller still needs lifecycle fixtures. */
+int omp_ownership_probe(void) {
+	int pair[2];
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0, pair)) return failure();
+	int left = own_fd(pair[0]);
+	int right = own_fd(pair[1]);
+	if (left < 0 || right < 0) { if (left >= 0) drop_fd(left); if (right >= 0) drop_fd(right); return -EMFILE; }
+	int identity = -1; pid_t pid; uint64_t start;
+	int result = peer_identity(left, getuid(), &identity, &pid, &start);
+	drop_fd(identity); drop_fd(left); drop_fd(right);
+	return result;
+}
+
+/* Parent directories/ownership/mode and maintenance fencing MUST be verified by the selected Native adapter first.
+ * Existing endpoint is never unlinked or replaced; operator recovery handles stale/unknown listeners. */
+int omp_ownership_listen(const char *endpoint) {
+	if (!endpoint || endpoint[0] != '/' || strlen(endpoint) >= sizeof(((struct sockaddr_un *)0)->sun_path)) return -EINVAL;
+	int fd = own_fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0));
+	if (fd < 0) return fd;
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	memcpy(address.sun_path, endpoint, strlen(endpoint) + 1);
+	if (bind(fd, (struct sockaddr *)&address, sizeof(address)) || chmod(endpoint, 0600) || listen(fd, OWNERSHIP_CONNECTIONS)) {
+		int error = failure(); drop_fd(fd); return error;
+	}
+	return keep(LISTENER, fd, -1, 0, 0);
+}
+
+int omp_ownership_accept(int listener, unsigned expected_uid) {
+	struct handle *source = lookup(listener, LISTENER);
+	if (!source) return -EBADF;
+	if (connection_count >= OWNERSHIP_CONNECTIONS) return -EMFILE;
+	int raw = accept4(source->fd, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+	if (raw < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return 0;
+	int fd = own_fd(raw);
+	if (fd < 0) return fd;
+	int peerfd = -1; pid_t pid; uint64_t start;
+	int result = peer_identity(fd, (uid_t)expected_uid, &peerfd, &pid, &start);
+	if (result < 0) { drop_fd(fd); return result; }
+	return keep(CONNECTION, fd, peerfd, pid, start);
+}
+
+/* Nonblocking client connection; the Native caller enforces the fixed one-second total connect deadline. */
+int omp_ownership_connect_begin(const char *endpoint) {
+	if (!endpoint || endpoint[0] != '/' || strlen(endpoint) >= sizeof(((struct sockaddr_un *)0)->sun_path)) return -EINVAL;
+	if (connection_count >= OWNERSHIP_CONNECTIONS) return -EMFILE;
+	int fd = own_fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0));
+	if (fd < 0) return fd;
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	memcpy(address.sun_path, endpoint, strlen(endpoint) + 1);
+	if (connect(fd, (struct sockaddr *)&address, sizeof(address)) && errno != EINPROGRESS) {
+		int error = failure(); drop_fd(fd); return error;
+	}
+	return keep(CONNECTING, fd, -1, 0, 0);
+}
+int omp_ownership_connect_ready(int connection, unsigned expected_uid) {
+	struct handle *source = lookup(connection, CONNECTING);
+	if (!source) return -EBADF;
+	struct pollfd descriptor = { .fd = source->fd, .events = POLLOUT };
+	int polled = poll(&descriptor, 1, 0);
+	if (polled < 0) return failure();
+	if (polled == 0) return 0;
+	int error = 0;
+	socklen_t size = sizeof(error);
+	if (getsockopt(source->fd, SOL_SOCKET, SO_ERROR, &error, &size)) return failure();
+	if (error || size != sizeof(error)) return -(error ? error : EPROTO);
+	int peerfd = -1; pid_t pid; uint64_t start;
+	int result = peer_identity(source->fd, (uid_t)expected_uid, &peerfd, &pid, &start);
+	if (result < 0) return result;
+	source->kind = CONNECTION; source->peerfd = peerfd; source->pid = pid; source->start = start;
+	return 1;
+}
+
+int omp_ownership_peer(int connection) {
+	struct handle *source = lookup(connection, CONNECTION);
+	if (!source || alive(source->peerfd) < 0) return -ESTALE;
+	int fd = own_fd(fcntl(source->peerfd, F_DUPFD_CLOEXEC, 0));
+	if (fd < 0) return fd;
+	return keep(IDENTITY, fd, -1, source->pid, source->start);
+}
+
+int omp_ownership_peer_pid(int identity) {
+	struct handle *source = lookup(identity, IDENTITY);
+	return source && alive(source->fd) > 0 ? source->pid : -ESTALE;
+}
+uint64_t omp_ownership_peer_start(int identity) {
+	struct handle *source = lookup(identity, IDENTITY);
+	return source && alive(source->fd) > 0 ? source->start : 0;
+}
+int omp_ownership_peer_alive(int identity) {
+	struct handle *source = lookup(identity, IDENTITY);
+	if (!source) return -EBADF;
+	struct pollfd descriptor = { .fd = source->fd, .events = POLLIN };
+	int result = poll(&descriptor, 1, 0);
+	if (result < 0) return failure();
+	if (result == 0) return 1;
+	if (descriptor.revents & (POLLERR | POLLNVAL)) return -EIO;
+	return descriptor.revents & (POLLIN | POLLHUP) ? 0 : -EPROTO;
+}
+int omp_ownership_same_peer(int left, int right) {
+	struct handle *a = lookup(left, IDENTITY), *b = lookup(right, IDENTITY);
+	if (!a || !b || alive(a->fd) < 0 || alive(b->fd) < 0) return -ESTALE;
+	return a->pid == b->pid && a->start == b->start;
+}
+
+/* Actual authenticated identities only; never a numeric-PID registration or signal authority. */
+int omp_ownership_direct_child(int child_key, int parent_key) {
+	struct handle *child = lookup(child_key, IDENTITY), *parent = lookup(parent_key, IDENTITY);
+	if (!child || !parent) return -EINVAL;
+	struct task first, parent_task, again;
+	int result = read_task(child->pid, child->fd, &first);
+	if (result < 0 || first.start != child->start) return -ESTALE;
+	result = read_task(parent->pid, parent->fd, &parent_task);
+	if (result < 0 || parent_task.start != parent->start) return -ESTALE;
+	result = read_task(child->pid, child->fd, &again);
+	if (result < 0 || again.start != first.start || again.parent != first.parent || alive(parent->fd) < 0) return -ESTALE;
+	return first.parent == parent->pid;
+}
+
+/* Return helper index + 1, 0 for verified external ancestry, negative for every missing/changing/overflowed chain.
+ * This grants classification only. It contains no signal/wait operation and cannot grant cleanup authority. */
+int omp_ownership_classify(int identity, const int *helper_keys, unsigned helper_count) {
+	struct handle *peer = lookup(identity, IDENTITY);
+	if (!peer || helper_count > OWNERSHIP_HELPERS || (helper_count && !helper_keys)) return -EINVAL;
+	struct task chain[OWNERSHIP_ANCESTORS];
+	unsigned count = 0;
+	int result = -ESTALE, nextfd = peer->fd;
+	pid_t nextpid = peer->pid;
+	int found = 0;
+	while (count < OWNERSHIP_ANCESTORS) {
+		struct task current;
+		result = read_task(nextpid, nextfd, &current);
+		if (result < 0) { if (count) drop_fd(nextfd); goto finished; }
+		if (count == 0 && current.start != peer->start) { result = -ESTALE; goto finished; }
+		for (unsigned previous = 0; previous < count; previous++) {
+			if (chain[previous].pid == current.pid) { if (count) drop_fd(nextfd); result = -ELOOP; goto finished; }
+		}
+		chain[count++] = current;
+		for (unsigned i = 0; i < helper_count; i++) {
+			struct handle *helper = lookup(helper_keys[i], IDENTITY);
+			if (!helper || alive(helper->fd) < 0) { result = -ESTALE; goto finished; }
+			if (helper->pid == current.pid && helper->start == current.start) found = (int)i + 1;
+		}
+		if (found || current.parent == 0) break;
+		if (count == OWNERSHIP_ANCESTORS) { result = -EOVERFLOW; goto finished; }
+		nextpid = current.parent;
+		nextfd = pidfd_open_owned(nextpid);
+		if (nextfd < 0) { result = nextfd; goto finished; }
+	}
+	/* Revalidate all held task identities and parent edges after acquisition; a changed chain is never external. */
+	for (unsigned i = 0; i < count; i++) {
+		struct task again;
+		result = read_task(chain[i].pid, chain[i].fd, &again);
+		if (result < 0 || again.start != chain[i].start || again.parent != chain[i].parent) { result = -ESTALE; goto finished; }
+	}
+	result = found;
+finished:
+	for (unsigned i = 1; i < count; i++) drop_fd(chain[i].fd);
+	return result;
+}
+
+int omp_ownership_read(int connection, void *bytes, unsigned size) {
+	struct handle *source = lookup(connection, CONNECTION);
+	if (!source || !bytes || size == 0 || size > OWNERSHIP_FRAME) return -EINVAL;
+	ssize_t result = recv(source->fd, bytes, size, MSG_DONTWAIT);
+	return result < 0 ? failure() : (int)result;
+}
+int omp_ownership_write(int connection, const void *bytes, unsigned size) {
+	struct handle *source = lookup(connection, CONNECTION);
+	if (!source || !bytes || size == 0 || size > OWNERSHIP_FRAME + 1) return -EINVAL;
+	ssize_t result = send(source->fd, bytes, size, MSG_DONTWAIT | MSG_NOSIGNAL);
+	return result < 0 ? failure() : (int)result;
+}
+int omp_ownership_close(int key) {
+	if (key <= 0) return -EBADF;
+	struct handle *source = &handles[(key - 1) % OWNERSHIP_HANDLES];
+	if (source->key != key || source->kind == UNUSED) return -EBADF;
+	struct handle value = *source;
+	*source = (struct handle){0};
+	if ((value.kind == CONNECTION || value.kind == CONNECTING) && connection_count) connection_count--;
+	drop_fd(value.fd); drop_fd(value.peerfd);
+	return 0;
+}
+void omp_ownership_close_all(void) {
+	for (unsigned i = 0; i < OWNERSHIP_HANDLES; i++) if (handles[i].kind != UNUSED) (void)omp_ownership_close(handles[i].key);
+}
