+  const dispatcher = await OwnershipDispatcher.open(identity, system);
+  let entered = false;
+  system.ready = async () => { entered = true; await pending.promise; };
+  const response = dispatcher.handle(host, frame({ op: "prepare_helper", generation }));
+  while (!entered) await Promise.resolve();
+  dispatcher.stopAdmission();
+  expect(() => dispatcher.assertDrained()).toThrow("ownership_unresolved");
