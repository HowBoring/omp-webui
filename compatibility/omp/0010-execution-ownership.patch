@@ -0,0 +1,58 @@
+import { expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { LinuxOwnershipBridge } from "../src/launch/ownership/linux-bridge";
+import { OwnershipError } from "../src/launch/ownership/protocol";
+
+const manifestPath = process.env.OMP_OWNERSHIP_BRIDGE_FIXTURE_MANIFEST;
+
+/** Opt-in harmless OS seam; default skip is NOT RUN, never backend admission or actual Native/global evidence. */
+test.skipIf(!manifestPath)("Linux bridge authenticates actual local peers, transfers bounded bytes and releases its pidfds", async () => {
+	if (!manifestPath || !process.getuid) throw new Error("OWNERSHIP_FIXTURE_ENVIRONMENT_REQUIRED");
+	const manifest: unknown = await Bun.file(manifestPath).json();
+	if (typeof manifest !== "object" || manifest === null || !("artifact" in manifest)
+		|| typeof manifest.artifact !== "object" || manifest.artifact === null
+		|| !("file" in manifest.artifact) || !("sha256" in manifest.artifact)
+		|| typeof manifest.artifact.file !== "string" || typeof manifest.artifact.sha256 !== "string") {
+		throw new Error("OWNERSHIP_FIXTURE_ARTIFACT_REQUIRED");
+	}
+	const directory = await fs.mkdtemp("/tmp/ownership-bridge-fixture-");
+	await fs.chmod(directory, 0o700);
+	const endpoint = path.join(directory, "socket");
+	const selection = { file: manifest.artifact.file, sha256: manifest.artifact.sha256,
+		async verify() { /* Isolated test-owned compiler output only; no production trust/admission. */ } };
+	let bridge: LinuxOwnershipBridge | undefined;
+	try {
+		bridge = await LinuxOwnershipBridge.open(selection);
+		expect(bridge.ownedDescriptorCount()).toBe(0);
+		await expect(LinuxOwnershipBridge.open(selection)).rejects.toThrow("ownership_limit");
+		const listener = bridge.listen(endpoint), client = bridge.connect(endpoint);
+		const uid = process.getuid();
+		const deadline = performance.now() + 1_000;
+		let accepted = bridge.accept(listener, uid);
+		while (!accepted && performance.now() < deadline) { await Bun.sleep(5); accepted = bridge.accept(listener, uid); }
+		if (!accepted) throw new Error("OWNERSHIP_FIXTURE_ACCEPT_TIMEOUT");
+		while (!bridge.connected(client, uid)) {
+			if (performance.now() >= deadline) throw new Error("OWNERSHIP_FIXTURE_CONNECT_TIMEOUT");
+			await Bun.sleep(5);
+		}
+		const serverPeer = bridge.capturePeer(accepted), clientPeer = bridge.capturePeer(client);
+		expect(bridge.samePeer(serverPeer, clientPeer)).toBe(true);
+		expect(bridge.peerAlive(serverPeer)).toBe(true);
+		expect(bridge.peerHints(serverPeer).pid).toBe(process.pid);
+		expect(bridge.isDirectChild(serverPeer, clientPeer)).toBe(false);
+		expect(bridge.classify(serverPeer, [])).toBeUndefined();
+		const bytes = new TextEncoder().encode("owned-bytes\n");
+		expect(bridge.write(client, bytes)).toBe(bytes.length);
+		let received = bridge.read(accepted);
+		while (received === undefined && performance.now() < deadline) { await Bun.sleep(5); received = bridge.read(accepted); }
+		expect(received && new TextDecoder().decode(received)).toBe("owned-bytes\n");
+		bridge.releasePeer(serverPeer); bridge.releasePeer(clientPeer);
+		bridge.releaseSocket(client); bridge.releaseSocket(accepted); bridge.releaseSocket(listener);
+		expect(bridge.ownedDescriptorCount()).toBe(0);
+	} catch (error) {
+		if (error instanceof OwnershipError) console.error(JSON.stringify({ fixture: "ownership-linux-bridge",
+			code: error.code, nativeErrno: error.nativeErrno ?? null }));
+		throw error;
+	} finally { bridge?.close(); await fs.rm(directory, { recursive: true, force: true }); }
+}, 5_000);
