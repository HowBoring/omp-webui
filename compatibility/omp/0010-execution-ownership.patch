+	close(): void { this.#failed = true; this.#activeAbort?.abort(); this.#transport.close(); }
+
+	async #request(operation: OwnershipOperation): Promise<OwnershipResult> {
+		if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+		if (this.#busy) throw new OwnershipError("ownership_limit");
