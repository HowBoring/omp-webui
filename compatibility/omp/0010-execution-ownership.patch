+		.rejects.toMatchObject({ code: "ownership_limit" });
+});
+
+test("oversized or exceptionally escaped responses fail with an explicit limit instead of partial metadata", async () => {
+	const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+	const challenge = await verifier.challenge(request);
+	await expect(verifier.verify("x".repeat(1_048_577), challenge)).rejects.toMatchObject({ code: "ownership_limit" });
