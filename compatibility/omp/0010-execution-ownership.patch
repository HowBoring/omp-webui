@@ -0,0 +1,23 @@
+import { OwnershipError } from "./protocol";
+import { OwnershipApprovalGeneration, type OwnershipApprovalPin } from "./approval";
+import { connectApprovedOwnershipClient } from "./uds-client";
+
+/** Build injects ONLY the stable anchor pin. Release closure/schema/approval digest never enter this define. */
+declare const OMP_EXECUTION_OWNERSHIP_ANCHOR: OwnershipApprovalPin | undefined;
+import type { OwnershipClient } from "./client";
+
+let generation: OwnershipApprovalGeneration | undefined;
+
+/**
+ * Fixed selected-installation bootstrap. Missing compiled operator approval stays unavailable.
+ * Future client transport uses public Bun UDS in every realm; only the dispatcher loads the C/FFI backend.
+ * Each realm re-registers the same authenticated OS process, never inherits authority from an environment flag.
+ * No HOME/profile/cwd rendezvous, automatic dispatcher spawn, legacy peer or local broker fallback is permitted.
+ */
+export async function connectProcessOwnershipClient(): Promise<OwnershipClient> {
+	if (typeof OMP_EXECUTION_OWNERSHIP_ANCHOR === "undefined" || !OMP_EXECUTION_OWNERSHIP_ANCHOR) {
+		throw new OwnershipError("ownership_backend_unavailable");
+	}
+	generation ??= new OwnershipApprovalGeneration(OMP_EXECUTION_OWNERSHIP_ANCHOR);
+	return connectApprovedOwnershipClient(await generation.load());
+}
diff --git a/packages/coding-agent/src/launch/ownership/client.ts b/packages/coding-agent/src/launch/ownership/client.ts
new file mode 100644
index 0000000000..5dc255c6f8
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/client.ts
@@ -0,0 +1,135 @@
+import {
+	decodeOwnershipResponse, OWNERSHIP_LIMITS, OWNERSHIP_VERSION, OwnershipError, ownershipGeneration, ownershipIdentity, ownershipScope, ownershipToken,
+	type OwnershipBrokerScope, type OwnershipIdentity, type OwnershipOperation, type OwnershipRegistration, type OwnershipRequest, type OwnershipResult, type OwnershipScope,
+} from "./protocol";
+
+/**
+ * Authenticated Native-only local transport. Bun clients verify nonce/request-bound replies against an independent
+ * operator-approved public key; the dispatcher obtains the clients' actual kernel SO_PEERPIDFD identities.
+ * Enforce connect/frame/queue/idle limits and close on authentication, signal or protocol failure.
+ * A missing endpoint or legacy peer is an error; this interface has no spawn, shell or reconnect fallback.
+ */
+export interface OwnershipTransport {
+	exchange(frame: string, signal: AbortSignal): Promise<string>;
+	close(): void;
+}
+
+/** Immutable process registration plus typed, fixed Native dispatcher operations. Never exposed as a browser tunnel. */
+export class OwnershipClient {
+	readonly #identity: OwnershipIdentity;
+	readonly #transport: OwnershipTransport;
+	#registration: OwnershipRegistration | undefined;
+	#busy = false;
+	#failed = false;
+	#activeAbort: AbortController | undefined;
+
+	constructor(identity: OwnershipIdentity, transport: OwnershipTransport) {
+		this.#identity = Object.freeze(ownershipIdentity(identity));
+		this.#transport = transport;
+	}
+
+	/** Immutable independently selected expected release/schema, never taken from an unverified peer reply. */
+	get identity(): Readonly<OwnershipIdentity> { return this.#identity; }
+
+	async classify(): Promise<OwnershipRegistration> {
+		const result = await this.#request({ op: "classify" });
+		if (result.op !== "classify") throw this.#fail("ownership_protocol");
+		const registration = result.registration, old = this.#registration;
+		if (old && (old.dispatcher !== registration.dispatcher || old.registration !== registration.registration
+			|| old.generation !== registration.generation || old.policy !== registration.policy)) {
+			throw this.#fail("dispatcher_mismatch");
+		}
+		this.#registration = Object.freeze(registration);
+		return this.#registration;
+	}
+
+	async broker(scope: OwnershipScope): Promise<OwnershipResult & { op: "broker" }> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const requestedScope = ownershipScope(scope);
+		const registration = await this.classify();
+		if (registration.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "broker", scope: requestedScope });
+		if (result.op !== "broker") throw this.#fail("ownership_protocol");
+		return result;
+	}
+
+	/** Read only registered dispatcher-owned scopes; acquiring each target remains a separate authenticated operation. */
+	async listScopes(): Promise<OwnershipBrokerScope[]> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "list_scopes" });
+		if (result.op !== "list_scopes") throw this.#fail("ownership_protocol");
+		return result.scopes;
+	}
+
+	/** Generation-bound read/administration grant. The server MUST NOT start, replace or recreate any broker. */
+	async inspectBroker(scope: OwnershipScope, generation: string): Promise<OwnershipResult & { op: "inspect_broker" }> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const requested = ownershipScope(scope), expected = ownershipToken(generation);
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "inspect_broker", scope: requested, generation: expected });
+		if (result.op !== "inspect_broker") throw this.#fail("ownership_protocol");
+		return result;
+	}
+
+	/** Host must prepare before spawning the held helper; this never grants worker START. */
+	async prepareHelper(generation: string): Promise<void> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "prepare_helper", generation: ownershipGeneration(generation) });
+		if (result.op !== "prepare_helper") throw this.#fail("ownership_protocol");
+	}
+
+	/** Only the same actual Host peer can observe its prepared/registered helper generation before START. */
+	async helperStatus(generation: string): Promise<"pending" | "registered"> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "helper_status", generation: ownershipGeneration(generation) });
+		if (result.op !== "helper_status") throw this.#fail("ownership_protocol");
+		return result.status;
+	}
+
+	/** Only the exact dispatcher-spawned broker peer can successfully use this public publication handshake. */
+	async publish(scope: OwnershipScope, generation: string): Promise<void> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "publish", scope: ownershipScope(scope), generation });
+		if (result.op !== "publish") throw this.#fail("ownership_protocol");
+	}
+
+	close(): void { this.#failed = true; this.#activeAbort?.abort(); this.#transport.close(); }
+
+	async #request(operation: OwnershipOperation): Promise<OwnershipResult> {
+		if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		const request: OwnershipRequest = { version: OWNERSHIP_VERSION, id: crypto.randomUUID(), identity: this.#identity, operation };
+		const controller = new AbortController(), cancellation = Promise.withResolvers<string>();
+		this.#activeAbort = controller;
+		const abort = (): void => cancellation.reject(new OwnershipError("dispatcher_unavailable"));
+		controller.signal.addEventListener("abort", abort, { once: true });
+		const timer: Timer = setTimeout(() => controller.abort(), OWNERSHIP_LIMITS.requestMs);
+		try {
+			const exchange = Promise.resolve().then(() => {
+				if (this.#failed || controller.signal.aborted) throw new OwnershipError("dispatcher_unavailable");
+				return this.#transport.exchange(JSON.stringify(request), controller.signal);
+			});
+			const frame = await Promise.race([exchange, cancellation.promise]);
+			if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+			const response = decodeOwnershipResponse(frame, request);
+			if (!response.ok) throw new OwnershipError(response.error);
+			return response.result;
+		} catch (error) {
+			this.close();
+			if (error instanceof OwnershipError) throw error;
+			throw new OwnershipError("dispatcher_unavailable");
+		} finally {
+			clearTimeout(timer); controller.signal.removeEventListener("abort", abort);
+			this.#activeAbort = undefined; this.#busy = false;
+		}
+	}
+
+	#fail(code: "ownership_protocol" | "dispatcher_mismatch"): OwnershipError {
+		this.close(); return new OwnershipError(code);
+	}
+}
