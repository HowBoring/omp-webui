@@ -0,0 +1,70 @@
+import { expect, test, spyOn } from "bun:test";
+import * as fs from "node:fs";
+import { captureLauncherMaintenanceHandoff } from "../src/launch/ownership/maintenance-handoff";
+
+// Approved pure filesystem seam. Fakes describe kernel bytes; they grant no production/runtime evidence.
+test("reserved locator is exact, first, single and versioned; absent locator cannot claim protection", () => {
+  for (const args of [["--omp-maintenance-handoff=2:7"], ["--omp-maintenance-handoff=1:03"],
+    ["--omp-maintenance-handoff=1:-1"], ["--omp-maintenance-handoff"],
+    ["--x", "--omp-maintenance-handoff=1:7"],
+    ["--omp-maintenance-handoff=1:7", "--omp-maintenance-handoff=1:8"]]) {
+    expect(() => captureLauncherMaintenanceHandoff(args)).toThrow("dispatcher_mismatch");
+  }
+  expect(() => captureLauncherMaintenanceHandoff([]).claim({ control: {
+    path: "/synthetic/control", device: "27", inode: "42", sha256: "a".repeat(64),
+  } })).toThrow("maintenance_fenced");
+});
+
+test("only the explicit descriptor's shared whole-file FLOCK can protect the signed stable inode", async () => {
+  const root = fs.mkdtempSync("/tmp/ownership-handoff-pure-");
+  const file = `${root}/control`; fs.writeFileSync(file, "synthetic protected inode", { mode: 0o600 });
+  const metadata = fs.statSync(file, { bigint: true }); metadata.dev = 27n; metadata.ino = 42n;
+  const control = { path: file, device: "27", inode: "42", sha256: "a".repeat(64) };
+  const good = `pos:\t0\nflags:\t0500000\nmnt_id:\t1\nino:\t42\nlock:\t1: FLOCK  ADVISORY  READ ${process.pid} 00:1b:42 0 EOF\n`;
+  let info = good, closed = 0, drift = false;
+  const fstat = spyOn(fs, "fstatSync").mockReturnValue(metadata);
+  const lstat = spyOn(fs, "lstatSync").mockReturnValue(metadata);
+  const realpath = spyOn(fs, "realpathSync").mockReturnValue(file);
+  const open = spyOn(fs, "openSync").mockImplementation(location => {
+    expect(location).toBe("/proc/self/fdinfo/7"); return 101;
+  });
+  const read = spyOn(fs, "readSync").mockImplementation((_fd, buffer, offset = 0, length = buffer.byteLength, position = 0) => {
+    if (typeof offset !== "number" || typeof length !== "number") throw new Error("PURE_READ_ARGUMENTS");
+    const bytes = Buffer.from(info).subarray(Number(position), Number(position) + length);
+    new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength).set(bytes, offset);
+    if (drift && bytes.length) metadata.ino = 43n;
+    return bytes.length;
+  });
+  const close = spyOn(fs, "closeSync").mockImplementation(fd => { expect(fd).toBe(101); closed++; });
+  try {
+    const handoff = captureLauncherMaintenanceHandoff(["--omp-maintenance-handoff=1:7", "--execution-dispatcher"]);
+    expect(handoff.arguments).toEqual(["--execution-dispatcher"]);
+    const guard = handoff.claim({ control }); await guard.verify(); guard.assertCurrent();
+    expect(Object.keys(guard).sort()).toEqual(["assertCurrent", "verify"]);
+    const mode = metadata.mode;
+    metadata.mode = 0o140600n;
+    expect(() => captureLauncherMaintenanceHandoff(["--omp-maintenance-handoff=1:3"]).claim({ control }))
+      .toThrow("maintenance_fenced");
+    metadata.mode = mode;
+    expect(() => handoff.claim({ control: { ...control, device: "28" } })).toThrow("maintenance_fenced");
+    realpath.mockReturnValue("/replaced/control");
+    expect(() => handoff.claim({ control })).toThrow("maintenance_fenced");
+    realpath.mockReturnValue(file);
+    drift = true; expect(() => handoff.claim({ control })).toThrow("maintenance_fenced");
+    drift = false; metadata.ino = 42n;
+    for (const invalid of [good.replace("READ", "WRITE"), good.replace(` ${process.pid} `, " 1 "),
+      good.replace("00:1b:42", "00:1b:43"), good.replace(" 0 EOF", " 1 EOF"),
+      good.replace("0500000", "0500002"), good.replace("ino:\t42", "ino:\t43"),
+      good.split("lock:")[0]!, good + good, "x".repeat(16385)]) {
+      info = invalid;
+      expect(() => handoff.claim({ control })).toThrow("maintenance_fenced");
+    }
+    info = good; const sticky = handoff.claim({ control });
+    metadata.ino = 43n; expect(() => sticky.assertCurrent()).toThrow("maintenance_fenced");
+    metadata.ino = 42n; expect(() => sticky.assertCurrent()).toThrow("maintenance_fenced");
+    expect(closed).toBeGreaterThan(0);
+  } finally {
+    for (const mock of [fstat, lstat, realpath, open, read, close]) mock.mockRestore();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
