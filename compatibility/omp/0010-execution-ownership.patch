+import { expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import { createHash } from "node:crypto";
+import { inspectOwnershipInventory } from "../src/launch/ownership/release-inventory";
+
+// Independently pinned synthetic bytes exercise a filesystem seam, not production approval or ELF execution.
+test("signed inventory cannot omit real directory members or accept a self-declared identity", async () => {
+  const root = await fs.mkdtemp("/tmp/ownership-inventory-pure-");
+  try {
+    await fs.writeFile(`${root}/unlisted`, "unlisted bytes");
+    const manifest = { format: "omp-webui-release-inventory-v1", stage: "unaccepted-artifact",
+      platform: process.platform, arch: process.arch,
+      assets: [{ path: ".", kind: "directory", identity: "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", mode: 0o700 }],
+      platformDependencies: [] };
+    const bytes = JSON.stringify(manifest, null, 2) + "\n";
+    await fs.writeFile(`${root}/release.json`, bytes);
+    const signed = { file: `${root}/release.json`, sha256: createHash("sha256").update(bytes).digest("hex") };
+    await expect(inspectOwnershipInventory(root, signed)).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    await expect(inspectOwnershipInventory(root, { ...signed, sha256: "0".repeat(64) }))
+      .rejects.toMatchObject({ code: "dispatcher_mismatch" });
+  } finally { await fs.rm(root, { recursive: true, force: true }); }
+});
+
+/** Synthetic ELF64 fixture metadata only; these bytes are never loaded or executed. */
+function elfFixture(needed: string[], interpreter?: string): Buffer {
+  const bytes = Buffer.alloc(1024), count = interpreter ? 3 : needed.length ? 2 : 1;
+  bytes.set([127, 69, 76, 70, 2, 1, 1]); bytes.writeUInt16LE(3, 16);
+  bytes.writeUInt16LE(process.arch === "x64" ? 62 : 183, 18); bytes.writeUInt32LE(1, 20);
+  bytes.writeBigUInt64LE(64n, 32); bytes.writeUInt16LE(64, 52); bytes.writeUInt16LE(56, 54); bytes.writeUInt16LE(count, 56);
+  const segment = (index: number, type: number, offset: number, size: number) => {
+    const at = 64 + index * 56; bytes.writeUInt32LE(type, at); bytes.writeBigUInt64LE(BigInt(offset), at + 8);
+    bytes.writeBigUInt64LE(BigInt(offset), at + 16); bytes.writeBigUInt64LE(BigInt(size), at + 32);
+  };
+  segment(0, 1, 0, bytes.length);
+  if (needed.length) {
+    const strings = Buffer.from("\0" + needed.join("\0") + "\0"); strings.copy(bytes, 512);
+    const entries = [[5, 512], [10, strings.length], ...needed.map((name, index) =>
+      [1, 1 + needed.slice(0, index).reduce((sum, value) => sum + value.length + 1, 0)]), [0, 0]];
+    segment(1, 2, 256, entries.length * 16);
+    entries.forEach(([tag, value], index) => {
+      bytes.writeBigUInt64LE(BigInt(tag!), 256 + index * 16); bytes.writeBigUInt64LE(BigInt(value!), 264 + index * 16);
+    });
+  }
+  if (interpreter) { const value = Buffer.from(interpreter + "\0"); value.copy(bytes, 768); segment(2, 3, 768, value.length); }
+  return bytes;
+}
+async function completeFixture(aliases = false) {
+  const base = await fs.mkdtemp("/tmp/ownership-inventory-complete-");
+  const root = `${base}/release`, dependencies = `${base}/platform`;
+  await fs.mkdir(root, { mode: 0o700 }); await fs.mkdir(dependencies, { mode: 0o700 });
+  await fs.mkdir(`${root}/runtime`, { mode: 0o700 });
+  const loader = `${dependencies}/ld-linux-fixture.so`, libc = `${dependencies}/libc.so.6`;
+  await fs.writeFile(loader, elfFixture([]), { mode: 0o600 });
+  await fs.writeFile(libc, elfFixture(["ld-linux-fixture.so"]), { mode: 0o600 });
+  if (aliases) {
+    await fs.symlink("platform", `${base}/alias`);
+    await fs.symlink("ld-linux-fixture.so", `${dependencies}/loader`);
+  }
+  await fs.writeFile(`${root}/runtime/bun`, elfFixture(["libc.so.6"], aliases ? `${base}/alias/loader` : loader), { mode: 0o600 });
+  await fs.symlink("runtime/bun", `${root}/linked`);
+  const sha = (bytes: string | Uint8Array) => createHash("sha256").update(bytes).digest("hex");
+  const file = async (name: string, absolute: string) => ({ path: name, kind: "file", identity: sha(await fs.readFile(absolute)), mode: 0o600 });
+  const manifest = { format: "omp-webui-release-inventory-v1", stage: "unaccepted-artifact", platform: process.platform,
+    arch: process.arch, assets: [
+      { path: ".", kind: "directory", identity: sha('["linked","runtime"]'), mode: 0o700 },
+      { path: "linked", kind: "link", identity: "runtime/bun", mode: 0o777 },
+      { path: "runtime", kind: "directory", identity: sha('["bun"]'), mode: 0o700 },
+      await file("runtime/bun", `${root}/runtime/bun`)],
+    platformDependencies: [await file(libc, libc), await file(loader, loader), ...(aliases ? [
+      { path: `${base}/alias`, kind: "link", identity: "platform", mode: 0o777 },
+      { path: `${dependencies}/loader`, kind: "link", identity: "ld-linux-fixture.so", mode: 0o777 },
+    ] : [])] };
+  const bytes = JSON.stringify(manifest, null, 2) + "\n";
+  await fs.writeFile(`${root}/release.json`, bytes);
+  return { base, root, libc, loader, manifest, selected: { file: `${root}/release.json`, sha256: sha(bytes) } };
+}
+
+test("complete fixture protects real rosters, modes, direct links and the exhaustive ELF metadata closure", async () => {
+  const f = await completeFixture();
+  try {
+    const selected = await inspectOwnershipInventory(f.root, f.selected);
+    expect(Object.isFrozen(selected.manifest.assets[0])).toBe(true);
+    await selected.verify();
+    await fs.writeFile(`${f.root}/extra`, "unapproved");
+    await expect(selected.verify()).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    await fs.unlink(`${f.root}/extra`);
+    await expect(selected.verify()).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    const modes = await inspectOwnershipInventory(f.root, f.selected);
+    await fs.chmod(`${f.root}/runtime/bun`, 0o640);
+    await expect(modes.verify()).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    await fs.chmod(`${f.root}/runtime/bun`, 0o600);
+    const links = await inspectOwnershipInventory(f.root, f.selected);
+    await fs.unlink(`${f.root}/linked`); await fs.symlink(f.libc, `${f.root}/linked`);
+    await expect(links.verify()).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+  } finally { await fs.rm(f.base, { recursive: true, force: true }); }
+});
+
+test("signed platform dependencies cannot drift, omit a DT_NEEDED provider or name the wrong architecture", async () => {
+  const f = await completeFixture();
+  try {
+    const selected = await inspectOwnershipInventory(f.root, f.selected);
+    await fs.appendFile(f.libc, "changed");
+    await expect(selected.verify()).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    await fs.writeFile(f.libc, elfFixture(["ld-linux-fixture.so"]));
+    for (const manifest of [{ ...f.manifest, arch: "unsupported" },
+      { ...f.manifest, platformDependencies: f.manifest.platformDependencies.slice(0, 1) },
+      { ...f.manifest, platformDependencies: [...f.manifest.platformDependencies, f.manifest.platformDependencies[0]] },
+      { ...f.manifest, assets: [...f.manifest.assets, f.manifest.assets[0]] }]) {
+      const bytes = JSON.stringify(manifest, null, 2) + "\n"; await fs.writeFile(f.selected.file, bytes);
+      await expect(inspectOwnershipInventory(f.root, { ...f.selected,
+        sha256: createHash("sha256").update(bytes).digest("hex") })).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    }
+  } finally { await fs.rm(f.base, { recursive: true, force: true }); }
+});
+
+
+test("interpreter aliases require every signed link and reject omission, replacement and unused aliases", async () => {
+  const f = await completeFixture(true);
+  try {
+    const selected = await inspectOwnershipInventory(f.root, f.selected);
+    await selected.verify();
+    await fs.unlink(`${f.base}/alias`); await fs.symlink("other", `${f.base}/alias`);
+    await expect(selected.verify()).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    await fs.unlink(`${f.base}/alias`); await fs.symlink("platform", `${f.base}/alias`);
+    for (const dependencies of [f.manifest.platformDependencies.slice(0, -1),
+      [...f.manifest.platformDependencies, { path: `${f.base}/unused`, kind: "link", identity: "platform", mode: 0o777 }]]) {
+      await fs.symlink("platform", `${f.base}/unused`).catch(() => {});
+      const bytes = JSON.stringify({ ...f.manifest, platformDependencies: dependencies }, null, 2) + "\n";
+      await fs.writeFile(f.selected.file, bytes);
+      await expect(inspectOwnershipInventory(f.root, { ...f.selected,
+        sha256: createHash("sha256").update(bytes).digest("hex") })).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+    }
+  } finally { await fs.rm(f.base, { recursive: true, force: true }); }
+});
