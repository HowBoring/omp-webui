+++ b/packages/coding-agent/test/execution-ownership-dispatcher.test.ts
@@ -0,0 +1,170 @@
+import { expect, test } from "bun:test";
+import { OwnershipClient } from "../src/launch/ownership/client";
+import { HelperWireSession, verifyHelperAcknowledgement, type HelperOwnershipRequest } from "../src/launch/ownership/helper-protocol";
+import { OwnershipDispatcher, type OwnershipSystem, type PublicationPermit, type StablePeer } from "../src/launch/ownership/dispatcher";
+import { OWNERSHIP_VERSION, type OwnershipIdentity, type OwnershipScope } from "../src/launch/ownership/protocol";
+
+const identity: OwnershipIdentity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+const generation = "e".repeat(64);
+
+/** Synthetic OS facts at the public native lifecycle seam; no kernel/process proof is claimed. */
+class SyntheticSystem implements OwnershipSystem {
+	readonly dispatcher = "dispatcher-generation-0001";
+	readonly policies = new Map<StablePeer, "external" | "private" | "unresolved">();
+	readonly durable = new Set<string>();
+	readonly publications: OwnershipScope[] = [];
+	failDurability = false;
+	async ready(): Promise<void> {}
+	async classify(peer: StablePeer) {
+		const kind = this.policies.get(peer) ?? "unresolved";
+		return kind === "private" ? { kind, generation } as const : { kind };
+	}
+	async protectHelper(_control: StablePeer, _helper: StablePeer, value: string): Promise<void> {
+		if (this.failDurability) throw new Error("disk failure");
+		this.durable.add(value);
+		this.policies.set(_helper, "private");
+	}
+	async markUnresolved(value: string): Promise<void> { this.durable.add(value); }
+	async completeHelper(_helper: StablePeer, _value: string): Promise<void> { throw new Error("no extinction proof"); }
+	async canonicalScope(scope: OwnershipScope): Promise<OwnershipScope> { return scope; }
+	async broker(scope: OwnershipScope, permit: PublicationPermit) {
+		permit.assertCurrent();
+		this.publications.push(scope);
+		return { generation: "broker-generation-0001", runtimeDirectory: "/run/native/project", token: "d".repeat(64) };
+	}
+	async publish(): Promise<void> { throw new Error("not an authenticated owned broker"); }
+}
+
+function frame(op: unknown): string {
+	return JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000001", identity, operation: op });
+}
+async function register(dispatcher: OwnershipDispatcher, system: SyntheticSystem, helper: StablePeer): Promise<void> {
+	const control = {};
+	system.policies.set(control, "external");
+	const prepared = await dispatcher.handle(control, frame({ op: "prepare_helper", generation }));
+	if (!prepared.ok) throw new Error(prepared.error);
+	await dispatcher.registerHelper(control, helper, generation);
+}
+
+test("Host prepares before helper registration and another authenticated Host cannot claim its generation", async () => {
+	const system = new SyntheticSystem(), host = {}, foreign = {}, helper = {};
+	system.policies.set(host, "external"); system.policies.set(foreign, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) { return JSON.stringify(await dispatcher.handle(host, frame)); }, close() {},
+	});
+	await client.prepareHelper(generation);
+	expect(await client.helperStatus(generation)).toBe("pending");
+	await expect(dispatcher.registerHelper(foreign, helper, generation)).rejects.toThrow("ownership_unresolved");
+	await dispatcher.registerHelperPeer(helper, generation);
+	expect(await client.helperStatus(generation)).toBe("registered");
+	expect(await dispatcher.handle(foreign, frame({ op: "helper_status", generation })))
+		.toMatchObject({ ok: false, error: "ownership_unresolved" });
+});
+
+test("helper REGISTER is acknowledged after durable registration and COMPLETE stays fenced without extinction proof", async () => {
+	const system = new SyntheticSystem(), host = {}, helper = {}, installation = "f".repeat(64);
+	system.policies.set(host, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	await dispatcher.handle(host, frame({ op: "prepare_helper", generation }));
+	const session = new HelperWireSession(installation);
+	const request: HelperOwnershipRequest = { version: "omp-execution-helper/1", id: "a".repeat(64), installation,
+		operation: { op: "register_helper", generation } };
+	const ack = await dispatcher.handleHelper(helper, session, JSON.stringify(request));
+	verifyHelperAcknowledgement(ack, request);
+	expect(system.durable.has(generation)).toBe(true);
+	const completion: HelperOwnershipRequest = { ...request, id: "b".repeat(64), operation: { op: "complete_helper", generation } };
+	await expect(dispatcher.handleHelper(helper, session, JSON.stringify(completion))).rejects.toThrow("no extinction proof");
+	expect(system.durable.has(generation)).toBe(true);
+	expect(await dispatcher.handle(host, frame({ op: "helper_status", generation })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+});
+
+test("peers classified private or unresolved by the OS adapter cannot publish shared execution", async () => {
+	const system = new SyntheticSystem();
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	const helper = {}, nested = {}, unresolved = {};
+	await register(dispatcher, system, helper);
+	system.policies.set(nested, "private");
+	const scope = { kind: "project", directory: "/work" };
+	expect(await dispatcher.handle(nested, frame({ op: "broker", scope }))).toMatchObject({
+		ok: false, error: "shared_service_unsupported",
+	});
+	expect(await dispatcher.handle(unresolved, frame({ op: "broker", scope }))).toMatchObject({
+		ok: false, error: "ownership_unresolved",
+	});
+	expect(system.publications).toEqual([]);
+});
+
+test("matched external client and server negotiate a fixed canonical broker scope through the public wire", async () => {
+	const system = new SyntheticSystem(), peer = {};
+	system.policies.set(peer, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) { return JSON.stringify(await dispatcher.handle(peer, frame)); }, close() {},
+	});
+	const result = await client.broker({ kind: "project", directory: "/work" });
+	expect(result).toEqual({ op: "broker", scope: { kind: "project", directory: "/work" },
+		generation: "broker-generation-0001", runtimeDirectory: "/run/native/project", token: "d".repeat(64) });
+	expect(system.publications).toEqual([{ kind: "project", directory: "/work" }]);
+});
+
+test("helper uncertainty during an awaited broker prepare invalidates its publication barrier", async () => {
+	class HeldSystem extends SyntheticSystem {
+		readonly arrived = Promise.withResolvers<void>();
+		readonly release = Promise.withResolvers<void>();
+		override async broker(scope: OwnershipScope, permit: PublicationPermit) {
+			this.arrived.resolve();
+			await this.release.promise;
+			return super.broker(scope, permit);
+		}
+	}
+	const system = new HeldSystem(), peer = {}, helper = {};
+	system.policies.set(peer, "external");
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	await register(dispatcher, system, helper);
+	const response = dispatcher.handle(peer, frame({ op: "broker", scope: { kind: "project", directory: "/work" } }));
+	await system.arrived.promise;
+	await dispatcher.helperUncertain(helper);
+	system.release.resolve();
+	expect(await response).toMatchObject({ ok: false, error: "maintenance_fenced" });
+	expect(system.publications).toEqual([]);
+});
+
+test("uncertain helper death globally blocks a new unrelated external registration and maintenance remains fenced", async () => {
+	const system = new SyntheticSystem(), helper = {}, external = {};
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	await register(dispatcher, system, helper);
+	system.policies.set(external, "external");
+	await dispatcher.helperUncertain(helper);
+	expect(await dispatcher.handle(external, frame({ op: "broker", scope: { kind: "project", directory: "/work" } })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+	expect(system.durable.has(generation)).toBe(true);
+	expect(system.publications).toEqual([]);
+});
+
+test("durability failure never releases worker admission and failed extinction cannot retire its fence", async () => {
+	const system = new SyntheticSystem(), helper = {}, external = {};
+	const dispatcher = await OwnershipDispatcher.open(identity, system);
+	system.failDurability = true;
+	await expect(register(dispatcher, system, helper)).rejects.toThrow("disk failure");
+	system.policies.set(external, "external");
+	expect(await dispatcher.handle(external, frame({ op: "classify" })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+	const other = new SyntheticSystem();
+	const second = await OwnershipDispatcher.open(identity, other);
+	await register(second, other, helper);
+	await expect(second.completeHelper(helper)).rejects.toThrow("no extinction proof");
+	expect(other.durable.has(generation)).toBe(true);
+	expect(await second.handle(external, frame({ op: "classify" })))
+		.toMatchObject({ ok: false, error: "maintenance_fenced" });
+});
+
+test("no client can bypass actual backend readiness by constructing an uninitialized dispatcher", async () => {
+	const system = new SyntheticSystem(), peer = {};
+	system.policies.set(peer, "external");
+	const dispatcher = new OwnershipDispatcher(identity, system);
+	expect(await dispatcher.handle(peer, frame({ op: "broker", scope: { kind: "project", directory: "/work" } })))
+		.toMatchObject({ ok: false, error: "ownership_backend_unavailable" });
+	expect(system.publications).toEqual([]);
+});
