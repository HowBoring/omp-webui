+test("another helper-status request fences queued grants and partial tails while signed refusals can drain", async () => {
+  for (const partial of [false, true]) {
+    const system = new SyntheticSystem(), host = {}, helper = {};
+    system.policies.set(host, "external");
+    const dispatcher = await OwnershipDispatcher.open(identity, system);
+    expect(await dispatcher.handle(host, frame({ op: "prepare_helper", generation }))).toMatchObject({ ok: true });
+    await dispatcher.registerHelper(host, helper, generation);
+    const reply = await dispatcher.handle(host, frame({ op: "helper_status", generation }));
+    expect(reply).toMatchObject({ ok: true, result: { op: "helper_status", status: "registered" } });
+    const output = new OwnershipReplyQueue(authority => { if (authority) dispatcher.assertPublication(); });
+    const encoded = JSON.stringify(reply) + "\n", writes: string[] = [];
+    output.enqueue(encoded, reply.ok);
+    if (partial) output.write(bytes => { writes.push(new TextDecoder().decode(bytes.subarray(0, 8))); return 8; });
+    system.policies.set(helper, "unresolved");
+    expect(await dispatcher.handle(host, frame({ op: "helper_status", generation })))
+      .toMatchObject({ ok: false, error: "ownership_unresolved" });
+    expect(() => output.write(bytes => { writes.push(new TextDecoder().decode(bytes)); return bytes.length; }))
+      .toThrow("maintenance_fenced");
+    expect(writes).toEqual(partial ? [encoded.slice(0, 8)] : []);
+    expect(output.pending).toBe(false);
+    const request = frame({ op: "inspect_broker", scope: { kind: "project", directory: "/work/owned" },
+      generation: "missing-generation" });
+    const refusal = await dispatcher.handle(host, request);
+    expect(refusal).toMatchObject({ ok: false, error: "maintenance_fenced" });
+    // RFC 8032 fixture material, never generated or enrolled as production trust.
+    const installation = "c".repeat(64), publicKey = "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo";
+    const key = await crypto.subtle.importKey("pkcs8", Buffer.from(
+      "302e020100300506032b6570042204209d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "hex"),
+      "Ed25519", false, ["sign"]);
+    const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+    const challenge = await verifier.challenge(request);
+    const decoded = await decodeOwnershipChallenge(challenge.frame, { installation, identity });
+    const signed = await signOwnershipReply(decoded, JSON.stringify(refusal),
+      { installation, identity, serverGeneration: "d".repeat(64), privateKey: key });
+    output.enqueue(signed + "\n", refusal.ok);
+    output.write(bytes => { writes.push(new TextDecoder().decode(bytes)); return bytes.length; });
+    const transmitted = writes.at(-1);
+    if (!transmitted) throw new Error("missing signed refusal");
+    expect(await verifier.verify(transmitted.trimEnd(), challenge)).toBe(JSON.stringify(refusal));
+  }
+});
+
+test("a live queued grant drains partial writes but stopAdmission refuses its remaining tail", async () => {
+  const system = new SyntheticSystem(), host = {};
+  system.policies.set(host, "external");
+  const dispatcher = await OwnershipDispatcher.open(identity, system);
+  const reply = await dispatcher.handle(host, frame({ op: "prepare_helper", generation }));
+  expect(reply).toMatchObject({ ok: true, result: { op: "prepare_helper", generation } });
+  const output = new OwnershipReplyQueue(authority => { if (authority) dispatcher.assertPublication(); });
+  const encoded = JSON.stringify(reply) + "\n", writes: string[] = [];
+  output.enqueue(encoded, reply.ok);
+  const write = (bytes: Uint8Array): number => {
+    const count = Math.min(7, bytes.length); writes.push(new TextDecoder().decode(bytes.subarray(0, count))); return count;
+  };
+  while (output.pending) output.write(write);
+  expect(writes.join("")).toBe(encoded);
+  output.enqueue(encoded, reply.ok); output.write(write);
+  dispatcher.stopAdmission();
+  expect(() => output.write(write)).toThrow("maintenance_fenced");
+  expect(writes.join("")).toBe(encoded + encoded.slice(0, 7));
+  expect(output.pending).toBe(false);
+});
