+import { OwnershipReplyVerifier } from "../src/launch/ownership/authentication";
+import { connectApprovedOwnershipClient } from "../src/launch/ownership/uds-client";
+
+// RFC 8032 test vectors. Public synthetic fixture material, never installation/operator keys.
+const approvalPublicKey = "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo";
+const replyPublicKey = "PUAXw-hDiVqStwqnTRt-vJyYLM8uxJaMwM1V8Sr0Zgw";
+const seed = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60";
+const hash = (value: string | Uint8Array): string => new Bun.CryptoHasher("sha256").update(value).digest("hex");
+async function pin(file: string) {
+	const stat = await fs.stat(file, { bigint: true });
+	return { path: file, device: String(stat.dev), inode: String(stat.ino), sha256: hash(await fs.readFile(file)) };
+}
+async function directory(file: string) {
+	const stat = await fs.stat(file, { bigint: true });
+	return { path: file, device: String(stat.dev), inode: String(stat.ino) };
+}
+async function fixture(composed = false) {
+	const root = await fs.mkdtemp("/tmp/ownership-approval-"); await fs.chmod(root, 0o700);
+	for (const name of ["release", "operator", "state", "state/fences"]) await fs.mkdir(path.join(root, name), { mode: 0o700 });
+	const release = path.join(root, "release"), operator = path.join(root, "operator");
+	const record = path.join(operator, "approval.json"), anchorFile = path.join(operator, "anchor.json");
+	const file = { path: path.join(root, "entry"), device: "27", inode: "12", sha256: "f".repeat(64) };
+	const payload = { version: composed ? "omp-execution-approval/3" : "omp-execution-approval/2", policy: "omp-execution-ownership/1", installation: "c".repeat(64),
+		identity: { closure: "a".repeat(64), schema: "b".repeat(64) }, dispatcherReplyPublicKey: replyPublicKey, releaseRoot: release,
+		releaseDirectory: await directory(release), entry: file, control: { ...file, path: path.join(root, "control") },
+		endpoint: path.join(root, "state/socket"), stateDirectory: await directory(path.join(root, "state")),
+		fenceDirectory: await directory(path.join(root, "state/fences")),
+		bridge: { file: path.join(release, "bridge.so"), sha256: "d".repeat(64) },
+		helper: { file: path.join(release, "helper"), sha256: "e".repeat(64) },
+		controlIo: composed ? {
+      version: "omp-execution-control-io/1", abi: 1, file: path.join(release, "lib/libomp-control-io.so"), sha256: "1".repeat(64),
+      source: { file: path.join(release, "provenance/owned-control-io.c"), sha256: "2".repeat(64) },
+      header: { file: path.join(release, "provenance/owned-control-io.h"), sha256: "3".repeat(64) },
+      inventory: { file: path.join(release, "release.json"), sha256: "4".repeat(64) },
+      package: Object.fromEntries(Object.entries({ entry: "control-io/index.js", types: "control-io/index.d.ts",
+        manifest: "control-io/package.json", build: "provenance/control-io-build.json" }).map(([role, file]) =>
+        [role, { file: path.join(release, file), sha256: "5".repeat(64) }])),
+      native: Object.fromEntries(Object.entries({ dispatcher: "provenance/native/dispatcher.ts", client: "provenance/native/client.ts",
+        bundle: "worker/cli.js", schema: "contracts/wire.schema.json" }).map(([role, file]) =>
+        [role, { file: path.join(release, file), sha256: "6".repeat(64) }])),
+    } : { file: path.join(release, "control-io.so"), sha256: "1".repeat(64) },
+		validator: { file: path.join(release, "validator.js"), sha256: "2".repeat(64) } };
+	const anchor = { version: composed ? "omp-execution-approval-anchor/2" : "omp-execution-approval-anchor/1", installation: payload.installation,
+		approvalPublicKey, approvalRecord: { path: record, parent: await directory(operator) },
+		approvalVersion: composed ? "omp-execution-approval/3" : "omp-execution-approval/2", recordBytes: 16384 };
+	await fs.writeFile(anchorFile, JSON.stringify(anchor), { mode: 0o600 });
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(`302e020100300506032b657004220420${seed}`, "hex"),
+		"Ed25519", false, ["sign"]);
+	async function publish(value: unknown = payload, domain = composed ? "omp-execution-release-approval/3\0" : "omp-execution-release-approval/2\0") {
+		const bytes = typeof value === "string" ? value : JSON.stringify(value), signature = await crypto.subtle.sign("Ed25519", key, new TextEncoder().encode(domain + bytes));
+		await fs.writeFile(record, JSON.stringify({ version: "omp-execution-signed-approval/1", payload: bytes,
+			signature: Buffer.from(signature).toString("base64url") }), { mode: 0o600 });
+	}
+	await publish();
+	return { root, record, anchorFile, anchor, payload, publish, selected: await pin(anchorFile),
+		cleanup: () => fs.rm(root, { recursive: true, force: true }) };
+}
+
+/** Public approved-client authentication seam; no socket, FFI, Native entry or global selection. */
+test("stable anchor authenticates final approval and rejects requests for another release tuple", async () => {
+	const f = await fixture();
+	try {
+		const approval = await loadOwnershipApproval(f.selected), verifier = new OwnershipReplyVerifier(approval);
+		const request = { version: "omp-execution-ownership/1", id: "request-00000001",
+			identity: f.payload.identity, operation: { op: "classify" } };
+		const challenge = await verifier.challenge(JSON.stringify(request));
+		expect(JSON.parse(challenge.frame)).toMatchObject({ installation: f.payload.installation });
+		verifier.close();
+		await expect(new OwnershipReplyVerifier(approval).challenge(JSON.stringify({ ...request,
+			identity: { ...request.identity, closure: "f".repeat(64) } })))
+			.rejects.toMatchObject({ code: "dispatcher_mismatch" });
+	} finally { await f.cleanup(); }
+});
+
+test("pinned operator file refuses symlink substitution, same-inode byte changes and writable permissions", async () => {
+	const root = await fs.mkdtemp("/tmp/ownership-approval-file-");
+	try {
+		await fs.chmod(root, 0o700);
+		const file = path.join(root, "record"), bytes = "operator-approved-record";
+		await fs.writeFile(file, bytes, { mode: 0o600 });
+		const stat = await fs.stat(file, { bigint: true });
+		const pin = { path: file, device: String(stat.dev), inode: String(stat.ino),
+			sha256: new Bun.CryptoHasher("sha256").update(bytes).digest("hex") };
