+	const source = record(value, ["path", "device", "inode", "sha256"]);
+	return Object.freeze({ path: canonical(source.path), device: numeric(source.device), inode: numeric(source.inode, true),
+		sha256: ownershipGeneration(source.sha256) });
+}
