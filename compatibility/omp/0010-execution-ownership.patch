@@ -0,0 +1,112 @@
+import { expect, test } from "bun:test";
+import { OwnershipClient } from "../src/launch/ownership/client";
+import {
+	ExecutionOwnershipContext, getExecutionOwnership, initializeExecutionOwnership, requireExecutionOwnership,
+	requireSharedExecution,
+} from "../src/launch/ownership/context";
+import { decodeOwnershipRequest } from "../src/launch/ownership/protocol";
+
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+
+test("process normalization is single-flight and private policy refuses shared factories before another request", async () => {
+	const requests: string[] = [];
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) {
+			const request = decodeOwnershipRequest(frame); requests.push(request.operation.op);
+			return JSON.stringify({ version: request.version, id: request.id, identity, ok: true,
+				result: { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+					policy: "private", generation: "generation-000001" } } });
+		}, close() {},
+	});
+	const context = new ExecutionOwnershipContext(client);
+	expect(() => context.requireExecutionOwnership()).toThrow("ownership_backend_unavailable");
+	const [first, second] = await Promise.all([context.initializeExecutionOwnership(), context.initializeExecutionOwnership()]);
+	expect(first).toBe(second);
+	expect(Reflect.set(first, "policy", "external")).toBe(false);
+	expect(() => context.requireSharedExecution()).toThrow("shared_service_unsupported");
+	await expect(context.acquireExecutionBroker({ kind: "project", directory: "/work" })).rejects.toThrow("shared_service_unsupported");
+	expect(requests).toEqual(["classify"]);
+});
+
+test("unconfigured process context stays unavailable across pure reads and refused initialization", async () => {
+	expect(getExecutionOwnership()).toEqual({ status: "unavailable", code: "ownership_backend_unavailable" });
+	expect(() => requireExecutionOwnership()).toThrow("ownership_backend_unavailable");
+	expect(() => requireSharedExecution()).toThrow("ownership_backend_unavailable");
+	await expect(initializeExecutionOwnership()).rejects.toMatchObject({ code: "ownership_backend_unavailable" });
+	expect(getExecutionOwnership()).toEqual({ status: "unavailable", code: "ownership_backend_unavailable" });
+});
+
+test("a mismatched broker grant revokes the registered context before subsequent shared effects", async () => {
+	let closed = false;
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) {
+			const request = decodeOwnershipRequest(frame);
+			const result = request.operation.op === "classify"
+				? { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+					policy: "external", generation: "generation-000001" } }
+				: { op: "broker", scope: { kind: "project", directory: "/different-project" },
+					generation: "broker-generation-0001", runtimeDirectory: "/run/owned-broker", token: "c".repeat(64) };
+			return JSON.stringify({ version: request.version, id: request.id, identity, ok: true, result });
+		},
+		close() { closed = true; },
+	});
+	const context = new ExecutionOwnershipContext(client);
+	await context.initializeExecutionOwnership();
+	expect(context.requireSharedExecution().policy).toBe("external");
+	await expect(context.acquireExecutionBroker({ kind: "project", directory: "/work/project" }))
+		.rejects.toMatchObject({ code: "ownership_protocol" });
+	expect(context.getExecutionOwnership()).toEqual({ status: "unavailable", code: "ownership_protocol" });
+	expect(() => context.requireSharedExecution()).toThrow("ownership_protocol");
+	expect(closed).toBe(true);
+});
+
+test("concurrent shared consumers receive their own matched broker grants without revoking process policy", async () => {
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) {
+			const request = decodeOwnershipRequest(frame);
+			const result = request.operation.op === "classify"
+				? { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+					policy: "external", generation: "generation-000001" } }
+				: request.operation.op === "broker"
+					? { op: "broker", scope: request.operation.scope, generation: "broker-generation-0001",
+						runtimeDirectory: "/run/owned-broker", token: "c".repeat(64) }
+					: undefined;
+			return JSON.stringify({ version: request.version, id: request.id, identity, ok: true, result });
+		}, close() {},
+	});
+	const context = new ExecutionOwnershipContext(client);
+	await context.initializeExecutionOwnership();
+	const grants = await Promise.all([
+		context.acquireExecutionBroker({ kind: "project", directory: "/first" }),
+		context.acquireExecutionBroker({ kind: "project", directory: "/second" }),
+	]);
+	expect(grants.map(grant => grant.scope)).toEqual([
+		{ kind: "project", directory: "/first" }, { kind: "project", directory: "/second" },
+	]);
+	expect(context.requireSharedExecution().policy).toBe("external");
+});
+
+test("a full process broker queue refuses only unstarted excess work and preserves admitted consumers", async () => {
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) {
+			const request = decodeOwnershipRequest(frame);
+			const result = request.operation.op === "classify"
+				? { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+					policy: "external", generation: "generation-000001" } }
+				: request.operation.op === "broker"
+					? { op: "broker", scope: request.operation.scope, generation: "broker-generation-0001",
+						runtimeDirectory: "/run/owned-broker", token: "c".repeat(64) }
+					: undefined;
+			return JSON.stringify({ version: request.version, id: request.id, identity, ok: true, result });
+		}, close() {},
+	});
+	const context = new ExecutionOwnershipContext(client);
+	await context.initializeExecutionOwnership();
+	const results = await Promise.allSettled(Array.from({ length: 65 }, (_, index) =>
+		context.acquireExecutionBroker({ kind: "project", directory: `/project-${index}` })));
+	expect(results.filter(result => result.status === "fulfilled")).toHaveLength(64);
+	expect(results.filter(result => result.status === "rejected")).toMatchObject([
+		{ status: "rejected", reason: { code: "ownership_limit" } },
+	]);
+	expect(context.requireSharedExecution().policy).toBe("external");
+});
diff --git a/packages/coding-agent/test/execution-ownership-contract.test.ts b/packages/coding-agent/test/execution-ownership-contract.test.ts
