+	]);
+	expect(context.requireSharedExecution().policy).toBe("external");
+});
+
+test("a full process broker queue refuses only unstarted excess work and preserves admitted consumers", async () => {
+	const client = new OwnershipClient(identity, {
+		async exchange(frame) {
+			const request = decodeOwnershipRequest(frame);
+			const result = request.operation.op === "classify"
