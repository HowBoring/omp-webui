+import { OwnershipError } from "./protocol";
+import type { OwnershipClient } from "./client";
+
+/**
+ * Fixed selected-installation bootstrap, deliberately unavailable in this source preparation.
+ * Future client transport uses public Bun UDS in every realm; only the dispatcher loads the C/FFI backend.
+ * Each realm re-registers the same authenticated OS process, never inherits authority from an environment flag.
+ * No HOME/profile/cwd rendezvous, automatic dispatcher spawn, legacy peer or local broker fallback is permitted.
+ */
+export async function connectProcessOwnershipClient(): Promise<OwnershipClient> {
+	throw new OwnershipError("ownership_backend_unavailable");
+}
