diff --git a/packages/coding-agent/test/execution-ownership-authentication.test.ts b/packages/coding-agent/test/execution-ownership-authentication.test.ts
new file mode 100644
index 0000000000..8f6fc997fa
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-authentication.test.ts
@@ -0,0 +1,87 @@
+import { expect, test } from "bun:test";
+import {
+	OwnershipReplyVerifier, decodeOwnershipChallenge, signOwnershipReply,
+} from "../src/launch/ownership/authentication";
+import { OWNERSHIP_VERSION } from "../src/launch/ownership/protocol";
+
+const installation = "c".repeat(64), serverGeneration = "d".repeat(64);
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+// RFC 8032 test key material. Fixture-only; never generated or enrolled as production operator trust.
+const publicKey = "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo";
+const privateKeyPkcs8 = "302e020100300506032b6570042204209d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60";
+const request = JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000001", identity,
+	operation: { op: "classify" } });
+const response = JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000001", identity, ok: true,
+	result: { op: "classify", registration: { registration: "registration-0001", dispatcher: serverGeneration,
+		policy: "external", generation: "generation-000001" } } });
+
+test("operator-pinned signed reply authenticates one fresh request and refuses replayed authority", async () => {
+	const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+	const challenge = await verifier.challenge(request);
+	const decoded = await decodeOwnershipChallenge(challenge.frame, { installation, identity });
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	const signed = await signOwnershipReply(decoded, response, { installation, identity, serverGeneration, privateKey: key });
+	expect(await verifier.verify(signed, challenge)).toBe(response);
+	await expect(verifier.verify(signed, challenge)).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+});
+
+test("any altered signed field fails closed without a fresh challenge or fallback", async () => {
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	const mutations: Record<string, unknown> = {
+		version: "legacy", installation: "e".repeat(64), nonce: "e".repeat(64), requestSha256: "e".repeat(64),
+		requestId: "different-request-0001", operation: "broker", identity: { ...identity, closure: "e".repeat(64) },
+		serverGeneration: "e".repeat(64), response: response.replace('"external"', '"private"'), signature: "A".repeat(86),
+	};
+	for (const [field, changed] of Object.entries(mutations)) {
+		const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+		const challenge = await verifier.challenge(request);
+		const decoded = await decodeOwnershipChallenge(challenge.frame, { installation, identity });
+		const signed = await signOwnershipReply(decoded, response, { installation, identity, serverGeneration, privateKey: key });
+		const altered: Record<string, unknown> = JSON.parse(signed);
+		altered[field] = changed;
+		await expect(verifier.verify(JSON.stringify(altered), challenge)).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+		await expect(verifier.challenge(request)).rejects.toMatchObject({ code: "dispatcher_unavailable" });
+	}
+});
+
+test("fresh requests refuse concurrent challenges and an authentically signed replacement dispatcher", async () => {
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+	const first = await verifier.challenge(request);
+	await expect(verifier.challenge(request)).rejects.toMatchObject({ code: "ownership_limit" });
+	const decoded = await decodeOwnershipChallenge(first.frame, { installation, identity });
+	const signed = await signOwnershipReply(decoded, response, { installation, identity, serverGeneration, privateKey: key });
+	await verifier.verify(signed, first);
+	const second = await verifier.challenge(request);
+	expect(second.frame).not.toBe(first.frame);
+	const replacement = "e".repeat(64);
+	const next = await decodeOwnershipChallenge(second.frame, { installation, identity });
+	const replacementReply = await signOwnershipReply(next, response.replace(serverGeneration, replacement),
+		{ installation, identity, serverGeneration: replacement, privateKey: key });
+	await expect(verifier.verify(replacementReply, second)).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+});
+
+test("closing during asynchronous signature verification cannot restore authenticated authority", async () => {
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+	const challenge = await verifier.challenge(request);
+	const decoded = await decodeOwnershipChallenge(challenge.frame, { installation, identity });
+	const signed = await signOwnershipReply(decoded, response, { installation, identity, serverGeneration, privateKey: key });
+	const pending = verifier.verify(signed, challenge);
+	const concurrent = verifier.challenge(request);
+	verifier.close();
+	await expect(concurrent).rejects.toMatchObject({ code: "ownership_limit" });
+	await expect(pending).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+});
+
+test("a well-formed response signed by another key cannot enroll new operator trust", async () => {
+	const wrongPublicKey = Buffer.from("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c", "hex")
+		.toString("base64url");
+	const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey: wrongPublicKey });
+	const challenge = await verifier.challenge(request);
+	const decoded = await decodeOwnershipChallenge(challenge.frame, { installation, identity });
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	const signed = await signOwnershipReply(decoded, response, { installation, identity, serverGeneration, privateKey: key });
+	await expect(verifier.verify(signed, challenge)).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+	await expect(verifier.challenge(request)).rejects.toMatchObject({ code: "dispatcher_unavailable" });
+});
