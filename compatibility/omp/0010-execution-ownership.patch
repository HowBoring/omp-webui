index 0000000000..9ec4075f5a
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/platform-closure.ts
@@ -0,0 +1,159 @@
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import type { ControlReleaseMember } from "@omp-webui/control-io";
+import type { BigIntStats } from "node:fs";
+import type { FileHandle } from "node:fs/promises";
+import { OwnershipError } from "./protocol";
+
+interface Segment { type: number; offset: number; address: bigint; size: number }
+export interface OwnershipElfMetadata { needed: readonly string[]; interpreter: string | undefined; soname: string | undefined }
+function fail(): never { throw new OwnershipError("dispatcher_mismatch"); }
+function number(value: bigint): number { if (value > 1_073_741_824n) fail(); return Number(value); }
+async function read(file: FileHandle, offset: number, size: number): Promise<Buffer> {
+  if (size < 0 || size > 1_048_576 || offset + size > 1_073_741_824) fail();
+  const bytes = Buffer.alloc(size); let count = 0;
+  while (count < size) {
+    const result = await file.read(bytes, count, size - count, offset + count);
+    if (!result.bytesRead) fail(); count += result.bytesRead;
+  }
+  return bytes;
+}
+function text(bytes: Buffer, offset: number): string {
+  const end = bytes.indexOf(0, offset);
+  if (offset < 0 || end < offset || end - offset > 4096) fail();
+  return new TextDecoder("utf-8", { fatal: true }).decode(bytes.subarray(offset, end));
+}
+/** Bounded Linux ELF64 LE metadata only. No loader, subprocess, FFI, mappings or runtime probing. */
+async function elf(location: string): Promise<OwnershipElfMetadata | undefined> {
+  const file = await fs.open(location, "r");
+  try {
+    const stat = await file.stat();
+    if (stat.size < 4) return undefined;
+    const magic = await read(file, 0, 4);
+    if (!magic.equals(Buffer.from([0x7f, 0x45, 0x4c, 0x46]))) return undefined;
+    const header = await read(file, 0, 64);
+    const machine = process.arch === "x64" ? 62 : process.arch === "arm64" ? 183 : fail();
+    if (header[4] !== 2 || header[5] !== 1 || header[6] !== 1 || header.readUInt32LE(20) !== 1
+      || ![2, 3].includes(header.readUInt16LE(16)) || header.readUInt16LE(18) !== machine
+      || header.readUInt16LE(52) !== 64 || header.readUInt16LE(54) !== 56) fail();
+    const count = header.readUInt16LE(56), offset = number(header.readBigUInt64LE(32));
+    if (count < 1 || count > 128 || offset > 1_048_576) fail();
+    const table = await read(file, offset, count * 56), segments: Segment[] = [];
+    for (let index = 0; index < count; index++) {
+      const at = index * 56;
+      const segment = { type: table.readUInt32LE(at), offset: number(table.readBigUInt64LE(at + 8)),
+        address: table.readBigUInt64LE(at + 16), size: number(table.readBigUInt64LE(at + 32)) };
+      if (segment.offset + segment.size > stat.size || segment.address + BigInt(segment.size) > 0xffffffffffffffffn) fail();
+      segments.push(segment);
+    }
+    let interpreter: string | undefined;
+    const interpreters = segments.filter(value => value.type === 3);
+    if (interpreters.length > 1) fail();
+    if (interpreters[0]) {
+      const bytes = await read(file, interpreters[0].offset, interpreters[0].size);
+      interpreter = text(bytes, 0);
+      if (!path.isAbsolute(interpreter) || path.resolve(interpreter) !== interpreter
+        || bytes.length !== Buffer.byteLength(interpreter) + 1) fail();
+    }
+    return { ...await dynamicMetadata(file, segments), interpreter };
+  } finally { await file.close(); }
+}
+
+async function dynamicMetadata(file: FileHandle, segments: readonly Segment[]): Promise<Pick<OwnershipElfMetadata, "needed" | "soname">> {
+  const dynamic = segments.filter(value => value.type === 2);
+  if (dynamic.length > 1) fail();
+  if (!dynamic[0]) return { needed: [], soname: undefined };
+  const bytes = await read(file, dynamic[0].offset, dynamic[0].size);
+  if (bytes.length % 16 !== 0) fail();
+  const needed: number[] = []; let strings: bigint | undefined, size: number | undefined, name: number | undefined;
+  let terminated = false;
+  for (let at = 0; at < bytes.length; at += 16) {
+    const tag = bytes.readBigUInt64LE(at), value = bytes.readBigUInt64LE(at + 8);
+    if (tag === 0n) { terminated = true; break; }
+    if ([15n, 29n, 0x6ffffefbn, 0x6ffffefcn, 0x7ffffffdn, 0x7fffffffn].includes(tag)) fail();
+    if (tag === 1n) { if (needed.length >= 256) fail(); needed.push(number(value)); }
+    if (tag === 5n) { if (strings !== undefined) fail(); strings = value; }
+    if (tag === 10n) { if (size !== undefined) fail(); size = number(value); }
+    if (tag === 14n) { if (name !== undefined) fail(); name = number(value); }
+  }
+  if (!terminated || strings === undefined || size === undefined || size < 1 || size > 1_048_576) fail();
+  const mapping = segments.filter(value => value.type === 1 && strings! >= value.address
+    && strings! + BigInt(size!) <= value.address + BigInt(value.size));
+  if (mapping.length !== 1) fail();
+  const segment = mapping[0]!, contents = await read(file, segment.offset + number(strings - segment.address), size);
+  const names = [...needed, ...(name === undefined ? [] : [name])].map(value => text(contents, value));
+  if (names.some(value => !/^[A-Za-z0-9_.+-]{1,255}$/.test(value))
+    || new Set(names.slice(0, needed.length)).size !== needed.length) fail();
+  return { needed: names.slice(0, needed.length), soname: name === undefined ? undefined : names.at(-1) };
+}
+
+function stamp(stat: BigIntStats): string {
+  return [stat.dev, stat.ino, stat.mode, stat.nlink, stat.mtimeNs, stat.ctimeNs].join(":");
+}
+/** Resolve only this interpreter's named components, requiring every encountered alias in the signed inventory. */
+async function interpreter(location: string, dependencies: readonly ControlReleaseMember[], used: Set<string>): Promise<string> {
+  let pending = location.split("/").slice(1), current = "/", hops = 0, components = 0;
+  const observed: { location: string; stamp: string; link: string | undefined }[] = [];
+  while (pending.length) {
+    if (++components > 256) fail();
+    const candidate = path.join(current, pending.shift()!), metadata = await fs.lstat(candidate, { bigint: true });
+    let link: string | undefined;
+    if (metadata.isSymbolicLink()) {
+      if (++hops > 16) fail();
+      link = await fs.readlink(candidate);
+      const selected = dependencies.find(value => value.path === candidate && value.kind === "link");
+      if (!selected || selected.identity !== link || selected.mode !== Number(metadata.mode & 0o7777n)
+        || path.isAbsolute(link)) fail();
+      used.add(candidate);
+      const target = path.resolve(current, link);
+      pending = [...target.split("/").slice(1), ...pending]; current = "/";
+    } else {
+      if (pending.length && !metadata.isDirectory()) fail();
+      current = candidate;
+    }
+    observed.push({ location: candidate, stamp: stamp(metadata), link });
+  }
+  if (!dependencies.some(value => value.path === current && value.kind === "file")
+    || await fs.realpath(location) !== current) fail();
+  used.add(current);
+  for (const value of observed) {
+    if (stamp(await fs.lstat(value.location, { bigint: true })) !== value.stamp
+      || (value.link !== undefined && await fs.readlink(value.location) !== value.link)) fail();
+  }
+  return current;
+}
+
+/** Verify all supported ELF DT_NEEDED/PT_INTERP edges against the signed, exhaustive dependency bytes/aliases. */
+export async function verifyOwnershipPlatformClosure(files: readonly string[], dependencies: readonly ControlReleaseMember[]): Promise<void> {
+  const platformFiles = dependencies.filter(value => value.kind === "file").map(value => value.path);
+  const entries: { file: string; elf: OwnershipElfMetadata | undefined }[] = [];
+  // Large inventories must never open one descriptor per member concurrently.
+  for (const file of [...files, ...platformFiles]) entries.push({ file, elf: await elf(file) });
+  const providers = new Map<string, string>();
+  for (const entry of entries) {
+    if (!entry.elf) continue;
+    for (const name of new Set([path.basename(entry.file), ...(entry.elf.soname ? [entry.elf.soname] : [])])) {
+      if (providers.has(name) && providers.get(name) !== entry.file) fail(); providers.set(name, entry.file);
+    }
+  }
+  const used = new Set<string>(), visited = new Set<string>(), pending = [...files];
+  while (pending.length) {
+    const file = pending.shift()!;
+    if (visited.has(file)) continue; visited.add(file);
+    const entry = entries.find(value => value.file === file);
+    if (!entry?.elf) continue;
+    for (const name of entry.elf.needed) {
+      const selected = providers.get(name); if (!selected) fail();
+      if (platformFiles.includes(selected)) used.add(selected); pending.push(selected);
+    }
+    if (entry.elf.interpreter) pending.push(await interpreter(entry.elf.interpreter, dependencies, used));
+  }
+  if (dependencies.some(value => !used.has(value.path))
+    || !platformFiles.some(file => /\/libc(?:-[^/]+)?\.so(?:\.\d+)*$/.test(file))
+    || !platformFiles.some(file => /\/(?:ld-linux[^/]*|ld-[^/]+\.so[^/]*)$/.test(file))) fail();
+}
+
+/** Read-only ELF metadata seam for source feasibility audit. This neither loads the file nor approves its bytes. */
+export async function inspectOwnershipElfMetadata(location: string): Promise<OwnershipElfMetadata | undefined> {
+  return elf(location);
+}
