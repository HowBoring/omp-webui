index 0000000000..c345643593
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-contract.test.ts
@@ -0,0 +1,54 @@
+import { expect, test } from "bun:test";
+import { decodeOwnershipRequest, decodeOwnershipResponse, OwnershipError, type OwnershipResponse } from "../src/launch/ownership/protocol";
+import { OwnershipFrames } from "../src/launch/ownership/framing";
+
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) };
+const request = (operation: unknown): string => JSON.stringify({
+	version: "omp-execution-ownership/1", id: "request-00000001", identity, operation,
+});
+
+test("Native client rejects a valid-looking reply for a different request, release or operation", () => {
+	const expected = decodeOwnershipRequest(request({ op: "classify" }));
+	const response = { version: expected.version, id: expected.id, identity, ok: true,
+		result: { op: "classify", registration: { registration: "registration-0001", dispatcher: "dispatcher-000001",
+			policy: "private", generation: "generation-000001" } } } satisfies OwnershipResponse;
+	for (const invalid of [
+		{ ...response, id: "different-request-001" },
+		{ ...response, identity: { ...identity, schema: "c".repeat(64) } },
+		{ ...response, result: { op: "publish", generation: "generation-000001" } },
+		{ ...response, result: { ...response.result, executable: "/bin/sh" } },
+	]) expect(() => decodeOwnershipResponse(JSON.stringify(invalid), expected)).toThrow(OwnershipError);
+	expect(decodeOwnershipResponse(JSON.stringify(response), expected)).toEqual(response);
+});
+
+test("dispatcher framing rejects invalid UTF-8, oversized partial frames and incomplete EOF", () => {
+	const frames = new OwnershipFrames();
+	const frame = new TextEncoder().encode(`${request({ op: "classify" })}\n`);
+	expect(frames.push(frame.slice(0, 17))).toEqual([]);
+	expect(frames.push(frame.slice(17))).toEqual([request({ op: "classify" })]);
+	frames.end();
+	expect(() => new OwnershipFrames().push(new Uint8Array([0xff, 10]))).toThrow("ownership_protocol");
+	expect(() => new OwnershipFrames().push(new Uint8Array(16_385).fill(65))).toThrow("ownership_limit");
+	const partial = new OwnershipFrames();
+	partial.push(new TextEncoder().encode("{}"));
+	expect(() => partial.end()).toThrow("ownership_protocol");
+});
+
+test("dispatcher rejects claimed process identity and executable choices before admission", () => {
+	for (const operation of [
+		{ op: "classify", pid: 123 },
+		{ op: "broker", scope: { kind: "project", directory: "/work" }, argv: ["sh"] },
+		{ op: "broker", scope: { kind: "global", service: "arbitrary-command" } },
+	]) {
+		expect(() => decodeOwnershipRequest(request(operation))).toThrow(OwnershipError);
+	}
+	expect(decodeOwnershipRequest(request({ op: "classify" })).operation).toEqual({ op: "classify" });
+});
+
+test("response framing permits exactly one MiB while request framing retains its smaller allowance", () => {
+	const response = new OwnershipFrames("response");
+	expect(response.push(new TextEncoder().encode("x".repeat(1_048_576) + "\n"))[0]?.length).toBe(1_048_576);
+	const excess = new OwnershipFrames("response");
+	expect(() => excess.push(new Uint8Array(1_048_577))).toThrow("ownership_limit");
+	expect(() => new OwnershipFrames().push(new Uint8Array(16_385))).toThrow("ownership_limit");
+});
diff --git a/packages/coding-agent/test/execution-ownership-control-owner.test.ts b/packages/coding-agent/test/execution-ownership-control-owner.test.ts
new file mode 100644
index 0000000000..da4848cdf0
--- /dev/null
+++ b/packages/coding-agent/test/execution-ownership-control-owner.test.ts
@@ -0,0 +1,162 @@
+import { expect, test } from "bun:test";
+import type { ControlIoErrorCode, OwnedControlApproval } from "@omp-webui/control-io";
+import { OwnershipReplyQueue } from "../src/launch/ownership/reply-queue";
+import { OwnershipControlIoGeneration } from "../src/launch/ownership/control-io-generation";
+
+const approval: OwnedControlApproval = { abi: 1, binaryDigest: "a".repeat(64), sourceDigest: "b".repeat(64),
+  headerDigest: "c".repeat(64) };
+function fixture() {
+  const events: string[] = [];
+  const selection = { selected: { release: { root: "/non-authorizing-fixture", identity: "d".repeat(64),
+    manifest: { format: "omp-webui-release-inventory-v1" as const, stage: "unaccepted-artifact" as const,
+      platform: "linux", arch: "x64", assets: [], platformDependencies: [] } } },
+    assertCurrent() {}, async verify() { events.push("verify"); }, async release() { events.push("release"); } };
+  return { events, selection };
+}
+
+test("missing public module fails readiness and retains the generation selection", async () => {
+  const { events, selection } = fixture();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => { throw new Error("missing module"); });
+  await expect(owner.load()).rejects.toThrow("missing module");
+  await expect(owner.ready()).rejects.toThrow("maintenance_fenced");
+  await expect(owner.close(async () => {})).rejects.toThrow("maintenance_fenced");
+  expect(events).not.toContain("release");
+});
+
+// Synthetic public interface only; never passed to the nominal production owner or server.
+class PublicError extends Error {
+  readonly errno = 0;
+  constructor(readonly code: ControlIoErrorCode) { super(code); }
+}
+function publicModule(close: () => Promise<void>, load = async () => {}) {
+  return { ControlIoError: PublicError, async loadOwnedControlIo() {
+    await load(); return { openControl(): never { throw new Error("no synthetic descriptors"); }, close };
+  } };
+}
+
+test("concurrent close shares disposal and releases selection only after awaited module close", async () => {
+  const { events, selection } = fixture(), closing = Promise.withResolvers<void>();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {
+    events.push("module-close"); await closing.promise; events.push("module-closed");
+  }));
+  await owner.load();
+  const first = owner.close(async () => { events.push("drained"); });
+  const second = owner.close(async () => { throw new Error("duplicate drain"); });
+  // Attach before yielding so a broken concurrent-close implementation cannot create an unhandled rejection.
+  const both = Promise.all([first, second]);
+  expect(events).not.toContain("release");
+  await expect(owner.ready()).rejects.toThrow("maintenance_fenced");
+  closing.resolve(); await both;
+  expect(events.filter(value => value !== "verify")).toEqual(["drained", "module-close", "module-closed", "release"]);
+  await owner.close(async () => { throw new Error("already disposed"); });
+});
+
+test("unproven drain retains the module and permits retry only before disposal begins", async () => {
+  const { events, selection } = fixture();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {
+    events.push("module-close");
+  }));
+  await owner.load();
+  await expect(owner.close(async () => { throw new Error("Host original reap unavailable"); }))
+    .rejects.toThrow("Host original reap unavailable");
+  expect(events.filter(value => value !== "verify")).toEqual([]);
+  await expect(owner.ready()).rejects.toThrow("maintenance_fenced");
+  await owner.close(async () => { events.push("drained"); });
+  expect(events.filter(value => value !== "verify")).toEqual(["drained", "module-close", "release"]);
+});
+
+test("shutdown waits for an in-flight readiness check and rejects its stale admission result", async () => {
+  const { events, selection } = fixture();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {
+    events.push("module-close");
+  }));
+  await owner.load();
+  const check = Promise.withResolvers<void>(); selection.verify = async () => { events.push("pending-check"); await check.promise; };
+  const stale = owner.ready().then(() => "accepted", (error: Error) => error.message);
+  const closing = owner.close(async () => { events.push("drained"); });
+  await Promise.resolve(); await Promise.resolve();
+  const closedBeforeCheck = events.includes("module-close");
+  check.resolve(); expect(await stale).toBe("maintenance_fenced"); await closing;
+  expect(closedBeforeCheck).toBe(false);
+  expect(events.filter(value => value !== "verify")).toEqual(["pending-check", "drained", "module-close", "release"]);
+});
+
+test("synchronous readiness drift permanently fences the loaded generation", async () => {
+  const { events, selection } = fixture();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {}));
+  await owner.load();
+  selection.assertCurrent = () => { throw new Error("guard changed"); };
+  expect(() => owner.assertReady()).toThrow("guard changed");
+  selection.assertCurrent = () => {};
+  await expect(owner.ready()).rejects.toThrow("maintenance_fenced");
+  await expect(owner.close(async () => {})).rejects.toThrow("maintenance_fenced");
+  expect(events).not.toContain("release");
+});
+
+test("entry drift after import denies the public loader and cannot be retried or released", async () => {
+  const { events, selection } = fixture();
+  let current = true;
+  selection.assertCurrent = () => { if (!current) throw new Error("entry replaced"); };
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => {
+    current = false; return publicModule(async () => {}, async () => { events.push("loaded"); });
+  });
+  await expect(owner.load()).rejects.toThrow("entry replaced");
+  current = true;
+  await expect(owner.load()).rejects.toThrow("ownership_limit");
+  await expect(owner.close(async () => {})).rejects.toThrow("maintenance_fenced");
+  expect(events.filter(value => value !== "verify")).toEqual([]);
+});
+
+test("prepare readiness is refused during loading and duplicate load cannot enter a second public loader", async () => {
+  const { events, selection } = fixture(), loading = Promise.withResolvers<void>();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {}, async () => {
+    events.push("loading"); await loading.promise;
+  }));
+  const loaded = owner.load();
+  await expect(owner.ready()).rejects.toThrow("maintenance_fenced");
+  await expect(owner.load()).rejects.toThrow("ownership_limit");
+  loading.resolve(); await loaded; await owner.ready();
+  expect(events.filter(value => value === "loading")).toEqual(["loading"]);
+});
+
+test("public busy close is retryable while uncertain disposal permanently retains protection", async () => {
+  const { events, selection } = fixture();
+  let attempts = 0;
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {
+    if (++attempts === 1) throw new PublicError("CONTROL_IO_BUSY");
+    throw new PublicError("CONTROL_IO_DISPOSAL_UNCERTAIN");
+  }));
+  await owner.load();
+  await expect(owner.close(async () => {})).rejects.toThrow("CONTROL_IO_BUSY");
+  await expect(owner.close(async () => {})).rejects.toThrow("CONTROL_IO_DISPOSAL_UNCERTAIN");
+  await expect(owner.close(async () => {})).rejects.toThrow("CONTROL_IO_DISPOSAL_UNCERTAIN");
+  expect(attempts).toBe(2); expect(events).not.toContain("release");
+});
+
+test("failed public load with no returned module preserves disposal uncertainty and selection", async () => {
+  const { events, selection } = fixture();
+  const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {}, async () => {
+    throw new PublicError("CONTROL_IO_DISPOSAL_UNCERTAIN");
+  }));
+  await expect(owner.load()).rejects.toThrow("CONTROL_IO_DISPOSAL_UNCERTAIN");
+  await expect(owner.close(async () => {})).rejects.toThrow("maintenance_fenced");
+  expect(events).not.toContain("release");
+});
+
+
+test("queued reply and partial tail refuse an owner invalidated by another readiness check", async () => {
+  for (const [partial, authority] of [[false, true], [true, true], [false, false], [true, false]] as const) {
+    const { selection } = fixture();
+    const owner = new OwnershipControlIoGeneration(selection, approval, async () => publicModule(async () => {}));
+    await owner.load();
+    const output = new OwnershipReplyQueue(() => owner.assertReady()), writes: string[] = [];
+    output.enqueue(authority ? '{"ok":true}\n' : '{"ok":false}\n', authority);
+    const write = (bytes: Uint8Array): number => { writes.push(new TextDecoder().decode(bytes)); return bytes.length; };
+    if (partial) output.write(bytes => { writes.push(new TextDecoder().decode(bytes.subarray(0, 4))); return 4; });
+    selection.verify = async () => { throw new Error("selection drift from another request"); };
+    await expect(owner.ready()).rejects.toThrow("selection drift from another request");
+    expect(() => output.write(write)).toThrow("maintenance_fenced");
+    expect(writes).toEqual(partial ? ['{"ok'] : []);
+    expect(output.pending).toBe(false);
+  }
+});
