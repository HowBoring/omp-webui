+/** Explicit protected-file identity. Bootstrap compiles ONLY the stable anchor pin, never a release approval digest. */
+export interface OwnershipApprovalPin { readonly path: string; readonly device: string; readonly inode: string; readonly sha256: string }
+export interface OwnershipFileApproval { readonly file: string; readonly sha256: string }
+export interface OwnershipDirectoryApproval { readonly path: string; readonly device: string; readonly inode: string }
+export interface LoadedOwnershipApproval extends OwnershipAuthenticationApproval {
+	readonly releaseRoot: string;
+	readonly releaseDirectory: OwnershipDirectoryApproval;
+	readonly entry: OwnershipApprovalPin;
+	readonly control: OwnershipApprovalPin;
+	readonly controlIo: OwnershipFileApproval;
+	readonly validator: OwnershipFileApproval;
+	readonly endpoint: string;
+	readonly stateDirectory: OwnershipDirectoryApproval;
+	readonly fenceDirectory: OwnershipDirectoryApproval;
+	readonly bridge: OwnershipFileApproval;
+	readonly helper: OwnershipFileApproval;
+	/** Recheck this immutable generation snapshot before/after async admission. Any failure permanently invalidates it. */
+	verify(): Promise<void>;
+}
+
+function canonical(value: unknown): string {
+	if (typeof value !== "string" || value.length > 4096 || value.includes("\0")
+		|| !path.isAbsolute(value) || path.resolve(value) !== value) throw new OwnershipError("dispatcher_mismatch");
+	return value;
+}
+function outside(value: string, root: string): void {
+	if (root === "/" || value === root || value.startsWith(`${root}/`)) throw new OwnershipError("dispatcher_mismatch");
+}
+function numeric(value: unknown, nonzero = false): string {
+	if (typeof value !== "string" || !(nonzero ? /^[1-9]\d*$/ : /^\d+$/).test(value)) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	return value;
+}
+function directory(value: unknown): OwnershipDirectoryApproval {
+	const source = record(value, ["path", "device", "inode"]);
+	return Object.freeze({ path: canonical(source.path), device: numeric(source.device), inode: numeric(source.inode, true) });
+}
