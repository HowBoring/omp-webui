@@ -0,0 +1,64 @@
+import { expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { OwnershipDispatcher, type OwnershipSystem, type StablePeer } from "../src/launch/ownership/dispatcher";
+import { OwnershipFences } from "../src/launch/ownership/fences";
+import { OWNERSHIP_VERSION } from "../src/launch/ownership/protocol";
+
+const identity = { closure: "a".repeat(64), schema: "b".repeat(64) }, installation = "c".repeat(64);
+const generation = "d".repeat(64);
+
+/** Public dispatcher seam with synthetic OS facts and the real owned durable filesystem adapter. */
+function system(fences: OwnershipFences): OwnershipSystem {
+	const helpers = new Set<StablePeer>();
+	return {
+		dispatcher: "dispatcher-generation-0001", async ready() {},
+		async classify(peer) { return helpers.has(peer) ? { kind: "private", generation } : { kind: "external" }; },
+		async protectHelper(_control, helper) { await fences.create(generation, "private-helper"); helpers.add(helper); },
+		async markUnresolved() { await fences.verify(); },
+		async completeHelper() { throw new Error("no kernel extinction proof"); },
+		async canonicalScope(scope) { return scope; },
+		async broker() { throw new Error("external protector unavailable"); },
+		async publish() { throw new Error("external protector unavailable"); },
+	};
+}
+
+test("dispatcher state loss preserves a durable helper fence and reopening cannot silently admit another generation", async () => {
+	const root = await fs.mkdtemp("/tmp/ownership-fence-fixture-");
+	const directory = path.join(root, "dispatcher-fences");
+	await fs.mkdir(directory, { mode: 0o700 });
+	const stat = await fs.stat(directory, { bigint: true });
+	const approval = { directory: { path: directory, device: String(stat.dev), inode: String(stat.ino) },
+		releaseRoot: path.join(root, "release"), installation, identity };
+	let fences: OwnershipFences | undefined;
+	try {
+		fences = await OwnershipFences.open(approval);
+		const dispatcher = await OwnershipDispatcher.open(identity, system(fences)), host = {}, helper = {};
+		const prepared = await dispatcher.handle(host, JSON.stringify({ version: OWNERSHIP_VERSION, id: "prepare-request-0001",
+			identity, operation: { op: "prepare_helper", generation } }));
+		expect(prepared).toMatchObject({ ok: true, result: { op: "prepare_helper", generation } });
+		await dispatcher.registerHelperPeer(helper, generation);
+		await fences.close(); fences = undefined;
+		await expect(OwnershipFences.open(approval)).rejects.toThrow("maintenance_fenced");
+	} finally { await fences?.close(); await fs.rm(root, { recursive: true, force: true }); }
+});
+
+test("only an owned completed generation can retire its durable record and leave the directory reusable", async () => {
+	const root = await fs.mkdtemp("/tmp/ownership-fence-complete-");
+	const directory = path.join(root, "dispatcher-fences");
+	await fs.mkdir(directory, { mode: 0o700 });
+	const stat = await fs.stat(directory, { bigint: true });
+	const approval = { directory: { path: directory, device: String(stat.dev), inode: String(stat.ino) },
+		releaseRoot: path.join(root, "release"), installation, identity };
+	let fences: OwnershipFences | undefined;
+	try {
+		fences = await OwnershipFences.open(approval);
+		await fences.create(generation, "private-helper");
+		await fences.retireCompleted(generation);
+		await fences.close(); fences = undefined;
+		fences = await OwnershipFences.open(approval);
+		await fences.create("e".repeat(64), "external-lifetime");
+		await fences.verify();
+		expect(await fs.readdir(directory)).toEqual([`dispatcher-${"e".repeat(64)}.json`]);
+	} finally { await fences?.close(); await fs.rm(root, { recursive: true, force: true }); }
+});
