+	const signed = await signOwnershipReply(decoded, response, { installation, identity, serverGeneration, privateKey: key });
+	await expect(verifier.verify(signed, challenge)).rejects.toMatchObject({ code: "dispatcher_mismatch" });
+	await expect(verifier.challenge(request)).rejects.toMatchObject({ code: "dispatcher_unavailable" });
+});
+
+test("bounded administration responses exceed request budget without expanding the request allowance", async () => {
+	const verifier = new OwnershipReplyVerifier({ installation, identity, publicKey });
+	const requestFrame = JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000002", identity,
+		operation: { op: "list_scopes" } });
+	const challenge = await verifier.challenge(requestFrame);
+	const decoded = await decodeOwnershipChallenge(challenge.frame, { installation, identity });
+	const responseFrame = JSON.stringify({ version: OWNERSHIP_VERSION, id: "request-00000002", identity, ok: true,
+		result: { op: "list_scopes", scopes: Array.from({ length: 64 }, (_, index) => ({
+			scope: { kind: "project", directory: `/project-${index}/${"a".repeat(2048)}` },
+			generation: `generation-${String(index).padStart(16, "0")}`, runtimeDirectory: `/run/${"b".repeat(2048)}/${index}`,
+		})) } });
+	const key = await crypto.subtle.importKey("pkcs8", Buffer.from(privateKeyPkcs8, "hex"), "Ed25519", false, ["sign"]);
+	const signed = await signOwnershipReply(decoded, responseFrame, { installation, identity, serverGeneration, privateKey: key });
+	expect(new TextEncoder().encode(signed).length).toBeGreaterThan(16_384);
+	expect(new TextEncoder().encode(signed).length).toBeLessThanOrEqual(1_048_576);
