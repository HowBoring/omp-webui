index 0000000000..d2c9b68911
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/authentication.ts
@@ -0,0 +1,169 @@
+import {
+	decodeOwnershipRequest, decodeOwnershipResponse, OWNERSHIP_LIMITS, OwnershipError, ownershipGeneration,
+	ownershipIdentity, type OwnershipIdentity, type OwnershipRequest,
+} from "./protocol";
+
+/** Asymmetric peer authentication: server uses kernel peer pidfds; Bun clients verify operator-pinned signatures. */
+export const OWNERSHIP_AUTH_VERSION = "omp-execution-auth/1";
+export interface OwnershipAuthenticationApproval {
+	readonly installation: string;
+	readonly identity: OwnershipIdentity;
+	/** Independently approved Ed25519 raw public key, canonical base64url. Never enrolled from a server response. */
+	readonly publicKey: string;
+}
+export interface OwnershipChallenge { readonly frame: string }
+export interface DecodedOwnershipChallenge {
+	readonly installation: string;
+	readonly nonce: string;
+	readonly requestSha256: string;
+	readonly request: OwnershipRequest;
+}
+interface SignedReply {
+	version: typeof OWNERSHIP_AUTH_VERSION;
+	installation: string;
+	nonce: string;
+	requestSha256: string;
+	requestId: string;
+	operation: OwnershipRequest["operation"]["op"];
+	identity: OwnershipIdentity;
+	serverGeneration: string;
+	response: string;
+	signature: string;
+}
+
+function record(value: unknown, keys: readonly string[]): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) throw new OwnershipError("ownership_protocol");
+	const source = value as Record<string, unknown>;
+	if (Object.keys(source).length !== keys.length || Object.keys(source).some(key => !keys.includes(key))) {
+		throw new OwnershipError("ownership_protocol");
+	}
+	return source;
+}
+function frame(value: unknown): string {
+	if (typeof value !== "string" || new TextEncoder().encode(value).length > OWNERSHIP_LIMITS.frameBytes) {
+		throw new OwnershipError("ownership_limit");
+	}
+	return value;
+}
+function parse(value: string, keys: readonly string[]): Record<string, unknown> {
+	const bounded = frame(value);
+	let decoded: unknown;
+	try { decoded = JSON.parse(bounded); } catch { throw new OwnershipError("ownership_protocol"); }
+	return record(decoded, keys);
+}
+function sameIdentity(left: OwnershipIdentity, right: OwnershipIdentity): void {
+	if (left.closure !== right.closure || left.schema !== right.schema) throw new OwnershipError("dispatcher_mismatch");
+}
+function base64(value: string, bytes: number): Uint8Array<ArrayBuffer> {
+	const decoded = Uint8Array.from(Buffer.from(value, "base64url"));
+	if (decoded.length !== bytes || Buffer.from(decoded).toString("base64url") !== value) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	return decoded;
+}
+async function sha256(value: string): Promise<string> {
+	return Buffer.from(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value))).toString("hex");
+}
+/** Fixed field ordering is part of this wire version, independent of incoming JSON key order. */
+function signedBytes(reply: Omit<SignedReply, "signature">): Uint8Array<ArrayBuffer> {
+	return new TextEncoder().encode(JSON.stringify([reply.version, reply.installation, reply.nonce, reply.requestSha256,
+		reply.requestId, reply.operation, reply.identity.closure, reply.identity.schema, reply.serverGeneration, reply.response]));
+}
+
+/** Decode and hash the actual received request before its actual authenticated kernel peer reaches dispatch. */
+export async function decodeOwnershipChallenge(value: string,
+	approval: Pick<OwnershipAuthenticationApproval, "installation" | "identity">): Promise<DecodedOwnershipChallenge> {
+	const source = parse(value, ["version", "installation", "nonce", "request"]);
+	if (source.version !== OWNERSHIP_AUTH_VERSION || source.installation !== ownershipGeneration(approval.installation)) {
+		throw new OwnershipError("dispatcher_mismatch");
+	}
+	const requestFrame = frame(source.request), request = decodeOwnershipRequest(requestFrame);
+	sameIdentity(request.identity, ownershipIdentity(approval.identity));
+	return Object.freeze({ installation: approval.installation, nonce: ownershipGeneration(source.nonce),
+		requestSha256: await sha256(requestFrame), request });
+}
+
+/**
+ * Sign only the fixed dispatcher's matched response. This is not kernel peer verification or lifecycle admission.
+ * The private key is loaded independently by the dispatcher from protected local data, never a request/environment.
+ */
+export async function signOwnershipReply(challenge: DecodedOwnershipChallenge, response: string,
+	server: { installation: string; identity: OwnershipIdentity; serverGeneration: string; privateKey: CryptoKey }): Promise<string> {
+	if (challenge.installation !== ownershipGeneration(server.installation)) throw new OwnershipError("dispatcher_mismatch");
+	sameIdentity(challenge.request.identity, ownershipIdentity(server.identity));
+	decodeOwnershipResponse(frame(response), challenge.request);
+	const reply: Omit<SignedReply, "signature"> = { version: OWNERSHIP_AUTH_VERSION, installation: server.installation,
+		nonce: challenge.nonce, requestSha256: challenge.requestSha256, requestId: challenge.request.id,
+		operation: challenge.request.operation.op, identity: ownershipIdentity(server.identity),
+		serverGeneration: ownershipGeneration(server.serverGeneration), response };
+	const signature = await crypto.subtle.sign("Ed25519", server.privateKey, signedBytes(reply));
+	return frame(JSON.stringify({ ...reply, signature: Buffer.from(signature).toString("base64url") }));
+}
+
+/** Fresh-nonce authentication for public Bun UDS clients in any realm. No socket descriptor/FFI access is needed. */
+export class OwnershipReplyVerifier {
+	readonly #approval: Readonly<OwnershipAuthenticationApproval>;
+	readonly #key: Promise<CryptoKey>;
+	#pending: { challenge: OwnershipChallenge; decoded: DecodedOwnershipChallenge } | undefined;
+	#creating = false;
+	#verifying = false;
+	#serverGeneration: string | undefined;
+	#failed = false;
+	constructor(approval: OwnershipAuthenticationApproval) {
+		this.#approval = Object.freeze({ installation: ownershipGeneration(approval.installation),
+			identity: Object.freeze(ownershipIdentity(approval.identity)), publicKey: approval.publicKey });
+		this.#key = crypto.subtle.importKey("raw", base64(approval.publicKey, 32), "Ed25519", false, ["verify"]);
+	}
+
+	async challenge(requestFrame: string): Promise<OwnershipChallenge> {
+		if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+		if (this.#creating || this.#verifying || this.#pending) throw new OwnershipError("ownership_limit");
+		this.#creating = true;
+		try {
+			const nonce = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("hex");
+			const wire = frame(JSON.stringify({ version: OWNERSHIP_AUTH_VERSION, installation: this.#approval.installation,
+				nonce, request: frame(requestFrame) }));
+			const decoded = await decodeOwnershipChallenge(wire, this.#approval);
+			if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+			const challenge = Object.freeze({ frame: wire });
+			this.#pending = { challenge, decoded };
+			return challenge;
+		} finally { this.#creating = false; }
+	}
+
+	async verify(value: string, challenge: OwnershipChallenge): Promise<string> {
+		const expected = this.#pending?.challenge === challenge ? this.#pending.decoded : undefined;
+		this.#pending = undefined;
+		this.#verifying = true;
+		try {
+			if (this.#failed || !expected) throw new OwnershipError("dispatcher_mismatch");
+			const reply = this.#reply(value, expected);
+			const valid = await crypto.subtle.verify("Ed25519", await this.#key, base64(reply.signature, 64), signedBytes(reply));
+			if (!valid || this.#failed) throw new OwnershipError("dispatcher_mismatch");
+			const response = decodeOwnershipResponse(reply.response, expected.request);
+			if (response.ok && response.result.op === "classify" && response.result.registration.dispatcher !== reply.serverGeneration) {
+				throw new OwnershipError("dispatcher_mismatch");
+			}
+			this.#serverGeneration = reply.serverGeneration;
+			return reply.response;
+		} catch { this.#failed = true; throw new OwnershipError("dispatcher_mismatch"); }
+		finally { this.#verifying = false; }
+	}
+
+	close(): void { this.#failed = true; this.#pending = undefined; }
+
+	#reply(value: string, expected: DecodedOwnershipChallenge): SignedReply {
+		const source = parse(value, ["version", "installation", "nonce", "requestSha256", "requestId", "operation",
+			"identity", "serverGeneration", "response", "signature"]);
+		const identity = ownershipIdentity(source.identity), generation = ownershipGeneration(source.serverGeneration);
+		sameIdentity(identity, this.#approval.identity);
+		if (source.version !== OWNERSHIP_AUTH_VERSION || source.installation !== expected.installation
+			|| source.nonce !== expected.nonce || source.requestSha256 !== expected.requestSha256
+			|| source.requestId !== expected.request.id || source.operation !== expected.request.operation.op
+			|| (this.#serverGeneration !== undefined && generation !== this.#serverGeneration)
+			|| typeof source.signature !== "string") throw new OwnershipError("dispatcher_mismatch");
+		return { version: OWNERSHIP_AUTH_VERSION, installation: expected.installation, nonce: expected.nonce,
+			requestSha256: expected.requestSha256, requestId: expected.request.id, operation: expected.request.operation.op,
+			identity, serverGeneration: generation, response: frame(source.response), signature: source.signature };
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/bootstrap.ts b/packages/coding-agent/src/launch/ownership/bootstrap.ts
new file mode 100644
index 0000000000..bdbdc3c144
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/bootstrap.ts
@@ -0,0 +1,12 @@
+import { OwnershipError } from "./protocol";
+import type { OwnershipClient } from "./client";
+
+/**
+ * Fixed selected-installation bootstrap, deliberately unavailable in this source preparation.
+ * Future client transport uses public Bun UDS in every realm; only the dispatcher loads the C/FFI backend.
+ * Each realm re-registers the same authenticated OS process, never inherits authority from an environment flag.
+ * No HOME/profile/cwd rendezvous, automatic dispatcher spawn, legacy peer or local broker fallback is permitted.
+ */
+export async function connectProcessOwnershipClient(): Promise<OwnershipClient> {
+	throw new OwnershipError("ownership_backend_unavailable");
+}
diff --git a/packages/coding-agent/src/launch/ownership/client.ts b/packages/coding-agent/src/launch/ownership/client.ts
new file mode 100644
index 0000000000..296a300620
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/client.ts
@@ -0,0 +1,116 @@
+import {
+	decodeOwnershipResponse, OWNERSHIP_LIMITS, OWNERSHIP_VERSION, OwnershipError, ownershipGeneration, ownershipIdentity, ownershipScope,
+	type OwnershipIdentity, type OwnershipOperation, type OwnershipRegistration, type OwnershipRequest, type OwnershipResult, type OwnershipScope,
+} from "./protocol";
+
+/**
+ * Authenticated Native-only local transport. Bun clients verify nonce/request-bound replies against an independent
+ * operator-approved public key; the dispatcher obtains the clients' actual kernel SO_PEERPIDFD identities.
+ * Enforce connect/frame/queue/idle limits and close on authentication, signal or protocol failure.
+ * A missing endpoint or legacy peer is an error; this interface has no spawn, shell or reconnect fallback.
+ */
+export interface OwnershipTransport {
+	exchange(frame: string, signal: AbortSignal): Promise<string>;
+	close(): void;
+}
+
+/** Immutable process registration plus typed, fixed Native dispatcher operations. Never exposed as a browser tunnel. */
+export class OwnershipClient {
+	readonly #identity: OwnershipIdentity;
+	readonly #transport: OwnershipTransport;
+	#registration: OwnershipRegistration | undefined;
+	#busy = false;
+	#failed = false;
+	#activeAbort: AbortController | undefined;
+
+	constructor(identity: OwnershipIdentity, transport: OwnershipTransport) {
+		this.#identity = Object.freeze(ownershipIdentity(identity));
+		this.#transport = transport;
+	}
+
+	/** Immutable independently selected expected release/schema, never taken from an unverified peer reply. */
+	get identity(): Readonly<OwnershipIdentity> { return this.#identity; }
+
+	async classify(): Promise<OwnershipRegistration> {
+		const result = await this.#request({ op: "classify" });
+		if (result.op !== "classify") throw this.#fail("ownership_protocol");
+		const registration = result.registration, old = this.#registration;
+		if (old && (old.dispatcher !== registration.dispatcher || old.registration !== registration.registration
+			|| old.generation !== registration.generation || old.policy !== registration.policy)) {
+			throw this.#fail("dispatcher_mismatch");
+		}
+		this.#registration = Object.freeze(registration);
+		return this.#registration;
+	}
+
+	async broker(scope: OwnershipScope): Promise<OwnershipResult & { op: "broker" }> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const requestedScope = ownershipScope(scope);
+		const registration = await this.classify();
+		if (registration.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "broker", scope: requestedScope });
+		if (result.op !== "broker") throw this.#fail("ownership_protocol");
+		return result;
+	}
+
+	/** Host must prepare before spawning the held helper; this never grants worker START. */
+	async prepareHelper(generation: string): Promise<void> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "prepare_helper", generation: ownershipGeneration(generation) });
+		if (result.op !== "prepare_helper") throw this.#fail("ownership_protocol");
+	}
+
+	/** Only the same actual Host peer can observe its prepared/registered helper generation before START. */
+	async helperStatus(generation: string): Promise<"pending" | "registered"> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "helper_status", generation: ownershipGeneration(generation) });
+		if (result.op !== "helper_status") throw this.#fail("ownership_protocol");
+		return result.status;
+	}
+
+	/** Only the exact dispatcher-spawned broker peer can successfully use this public publication handshake. */
+	async publish(scope: OwnershipScope, generation: string): Promise<void> {
+		if (this.#registration?.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if ((await this.classify()).policy === "private") throw new OwnershipError("shared_service_unsupported");
+		const result = await this.#request({ op: "publish", scope: ownershipScope(scope), generation });
+		if (result.op !== "publish") throw this.#fail("ownership_protocol");
+	}
+
+	close(): void { this.#failed = true; this.#activeAbort?.abort(); this.#transport.close(); }
+
+	async #request(operation: OwnershipOperation): Promise<OwnershipResult> {
+		if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		const request: OwnershipRequest = { version: OWNERSHIP_VERSION, id: crypto.randomUUID(), identity: this.#identity, operation };
+		const controller = new AbortController(), cancellation = Promise.withResolvers<string>();
+		this.#activeAbort = controller;
+		const abort = (): void => cancellation.reject(new OwnershipError("dispatcher_unavailable"));
+		controller.signal.addEventListener("abort", abort, { once: true });
+		const timer: Timer = setTimeout(() => controller.abort(), OWNERSHIP_LIMITS.requestMs);
+		try {
+			const exchange = Promise.resolve().then(() => {
+				if (this.#failed || controller.signal.aborted) throw new OwnershipError("dispatcher_unavailable");
+				return this.#transport.exchange(JSON.stringify(request), controller.signal);
+			});
+			const frame = await Promise.race([exchange, cancellation.promise]);
+			if (this.#failed) throw new OwnershipError("dispatcher_unavailable");
+			const response = decodeOwnershipResponse(frame, request);
+			if (!response.ok) throw new OwnershipError(response.error);
+			return response.result;
+		} catch (error) {
+			this.close();
+			if (error instanceof OwnershipError) throw error;
+			throw new OwnershipError("dispatcher_unavailable");
+		} finally {
+			clearTimeout(timer); controller.signal.removeEventListener("abort", abort);
+			this.#activeAbort = undefined; this.#busy = false;
+		}
+	}
+
+	#fail(code: "ownership_protocol" | "dispatcher_mismatch"): OwnershipError {
+		this.close(); return new OwnershipError(code);
+	}
+}
diff --git a/packages/coding-agent/src/launch/ownership/context.ts b/packages/coding-agent/src/launch/ownership/context.ts
new file mode 100644
index 0000000000..2683a029e8
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/context.ts
@@ -0,0 +1,128 @@
+import { connectProcessOwnershipClient } from "./bootstrap";
+import type { OwnershipClient } from "./client";
+import { OWNERSHIP_LIMITS, OwnershipError, ownershipScope, type OwnershipErrorCode, type OwnershipIdentity,
+	type OwnershipRegistration, type OwnershipScope } from "./protocol";
+
+export type RegisteredExecutionOwnership = Readonly<OwnershipRegistration & {
+	status: "registered"; identity: Readonly<OwnershipIdentity>;
+}>;
+export type ProcessExecutionOwnership = RegisteredExecutionOwnership
+	| Readonly<{ status: "unavailable"; code: OwnershipErrorCode }>;
+export interface ExecutionBrokerSelection {
+	readonly scope: OwnershipScope;
+	readonly generation: string;
+	readonly runtimeDirectory: string;
+	readonly token: string;
+	readonly dispatcher: string;
+	readonly identity: Readonly<OwnershipIdentity>;
+}
+
+function unavailable(code: OwnershipErrorCode): ProcessExecutionOwnership {
+	return Object.freeze({ status: "unavailable", code });
+}
+
+/** Immutable process-policy module. Callers normalize before factories; pure getters never connect or create files. */
+export class ExecutionOwnershipContext {
+	readonly #client: OwnershipClient;
+	#state = unavailable("ownership_backend_unavailable");
+	#initialization: Promise<RegisteredExecutionOwnership> | undefined;
+	#brokerTail = Promise.resolve();
+	#brokerOutstanding = 0;
+	constructor(client: OwnershipClient) { this.#client = client; }
+
+	getExecutionOwnership(): ProcessExecutionOwnership { return this.#state; }
+	initializeExecutionOwnership(): Promise<RegisteredExecutionOwnership> {
+		this.#initialization ??= this.#initialize();
+		return this.#initialization;
+	}
+	async #initialize(): Promise<RegisteredExecutionOwnership> {
+		try {
+			const registration = await this.#client.classify();
+			const state = Object.freeze({ ...registration, status: "registered" as const, identity: this.#client.identity });
+			this.#state = state;
+			return state;
+		} catch (error) { throw this.#failure(error); }
+	}
+
+	requireExecutionOwnership(): RegisteredExecutionOwnership {
+		if (this.#state.status !== "registered") throw new OwnershipError(this.#state.code);
+		return this.#state;
+	}
+	requireSharedExecution(): RegisteredExecutionOwnership & { policy: "external" } {
+		const state = this.requireExecutionOwnership();
+		if (state.policy !== "external") throw new OwnershipError("shared_service_unsupported");
+		return Object.freeze({ ...state, policy: "external" as const });
+	}
+	async acquireExecutionBroker(scope: OwnershipScope): Promise<ExecutionBrokerSelection> {
+		this.requireSharedExecution();
+		const requested = ownershipScope(scope);
+		if (this.#brokerOutstanding >= OWNERSHIP_LIMITS.contextRequests) throw new OwnershipError("ownership_limit");
+		this.#brokerOutstanding++;
+		const result = Promise.withResolvers<ExecutionBrokerSelection>();
+		let expired = false, dispatched = false;
+		const timer: Timer = setTimeout(() => {
+			expired = true;
+			const error = new OwnershipError("dispatcher_unavailable");
+			result.reject(dispatched ? this.#failure(error) : error);
+		}, OWNERSHIP_LIMITS.requestMs);
+		this.#brokerTail = this.#brokerTail.then(async () => {
+			try {
+				if (expired) return;
+				const state = this.requireSharedExecution();
+				dispatched = true;
+				const grant = await this.#client.broker(requested);
+				if (!expired) result.resolve(Object.freeze({ scope: Object.freeze(grant.scope), generation: grant.generation,
+					runtimeDirectory: grant.runtimeDirectory, token: grant.token, dispatcher: state.dispatcher, identity: state.identity }));
+			} catch (error) { if (!expired) result.reject(this.#failure(error)); }
+			finally { clearTimeout(timer); this.#brokerOutstanding--; }
+		});
+		return result.promise;
+	}
+	#failure(error: unknown): OwnershipError {
+		const failure = error instanceof OwnershipError ? error : new OwnershipError("dispatcher_unavailable");
+		this.#state = unavailable(failure.code); this.#client.close();
+		return failure;
+	}
+}
+
+let processContext: ExecutionOwnershipContext | undefined;
+let initialization: Promise<RegisteredExecutionOwnership> | undefined;
+let initialState = unavailable("ownership_backend_unavailable");
+
+/** Pure read, including before initialization; unavailable is never silently interpreted as external/private fallback. */
+export function getExecutionOwnership(): ProcessExecutionOwnership {
+	return processContext?.getExecutionOwnership() ?? initialState;
+}
+
+/** Before normal CLI/strict graph imports and as the first SDK factory action, including every worker realm. */
+export function initializeExecutionOwnership(): Promise<RegisteredExecutionOwnership> {
+	initialization ??= connectProcessOwnershipClient().then(client => {
+		processContext = new ExecutionOwnershipContext(client);
+		return processContext.initializeExecutionOwnership();
+	}).catch((error: unknown) => {
+		const code = error instanceof OwnershipError ? error.code : "dispatcher_unavailable";
+		initialState = unavailable(code);
+		throw error;
+	});
+	return initialization;
+}
+
+export function requireExecutionOwnership(): RegisteredExecutionOwnership {
+	const state = getExecutionOwnership();
+	if (state.status !== "registered") throw new OwnershipError(state.code);
+	return state;
+}
+
+/** Guard before every shared factory/token/directory/connect/request/completion effect, including ping/reconnect. */
+export function requireSharedExecution(): RegisteredExecutionOwnership & { policy: "external" } {
+	const state = requireExecutionOwnership();
+	if (state.policy !== "external") throw new OwnershipError("shared_service_unsupported");
+	return Object.freeze({ ...state, policy: "external" as const });
+}
+
+/** Fixed Native dispatcher operation; never accepts executable/argv or a browser-supplied endpoint. */
+export async function acquireExecutionBroker(scope: OwnershipScope): Promise<ExecutionBrokerSelection> {
+	requireSharedExecution();
+	if (!processContext) throw new OwnershipError("ownership_backend_unavailable");
+	return processContext.acquireExecutionBroker(scope);
+}
diff --git a/packages/coding-agent/src/launch/ownership/dispatcher.ts b/packages/coding-agent/src/launch/ownership/dispatcher.ts
new file mode 100644
index 0000000000..d9c6607f9b
--- /dev/null
+++ b/packages/coding-agent/src/launch/ownership/dispatcher.ts
@@ -0,0 +1,225 @@
+import {
+	decodeOwnershipRequest, OWNERSHIP_LIMITS, OWNERSHIP_VERSION, OwnershipError,
+	ownershipGeneration, ownershipIdentity, ownershipToken, sameOwnershipScope,
+	type OwnershipIdentity, type OwnershipRegistration, type OwnershipRequest, type OwnershipResponse,
+	type OwnershipResult, type OwnershipScope,
+} from "./protocol";
+import { HelperWireSession } from "./helper-protocol";
+
+/** Opaque retained OS peer identity, supplied only by the authenticated local transport, never decoded from wire. */
+export type StablePeer = object;
+export type PeerClassification =
+	| { kind: "external" } | { kind: "private"; generation: string } | { kind: "unresolved" };
+/** Backend must check synchronously at every spawn/publication barrier, after all awaited work. */
+export interface PublicationPermit { assertCurrent(): void }
+
+/**
+ * OS/durable-storage seam. The Linux adapter MUST obtain SO_PEERPIDFD, retain peer/ancestor pidfds,
+ * and recheck ancestry without trusting environment, numeric PID claims or command names.
+ * No implementation is admitted by this interface alone; a missing backend fails before serving.
+ */
+export interface OwnershipSystem {
+	readonly dispatcher: string;
+	/** Probe actual kernel operations and load durable fences. Any unresolved generation rejects startup. */
+	ready(): Promise<void>;
+	classify(peer: StablePeer): Promise<PeerClassification>;
+	/** Verify trusted supervisor/helper identities, retain pidfds and durably fsync an incomplete fence before return. */
+	protectHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void>;
+	/** Persist uncertainty. Failure must retain the existing incomplete fence; never erase it as recovery. */
+	markUnresolved(generation: string): Promise<void>;
+	/** Only authenticated helper root-reaped + closed-admission + P_ALL/ECHILD proof may clear/fsync the fence. */
+	completeHelper(helper: StablePeer, generation: string): Promise<void>;
+	/** Canonicalize and pin a real directory; no create-on-read or missing-path lexical fallback. */
+	canonicalScope(scope: OwnershipScope): Promise<OwnershipScope>;
+	/**
+	 * Fixed Native broker operation only. Before any spawn, protect the broker AND every permitted surviving
+	 * service lifetime with independent maintenance leases/durable fences outside all private helper domains.
+	 * Unknown start outcome retains its fence. Never accept arbitrary argv from this interface.
+	 */
+	broker(scope: OwnershipScope, permit: PublicationPermit): Promise<{ generation: string; runtimeDirectory: string; token: string }>;
+	/** Verify exact owned broker pidfd, scope, release/schema and independent protector before publication. */
+	publish(peer: StablePeer, scope: OwnershipScope, generation: string, permit: PublicationPermit): Promise<void>;
+}
+
+/** Public Native dispatcher decision module. No process launch or signaling authority is granted to Host/browser. */
+export class OwnershipDispatcher {
+	readonly #identity: OwnershipIdentity;
+	readonly #system: OwnershipSystem;
+	readonly #helpers = new Map<StablePeer, string>();
+	readonly #helperControllers = new Map<string, StablePeer>();
+	readonly #pendingHelpers = new Map<string, StablePeer>();
+	readonly #helperGenerations = new Set<string>();
+	readonly #registrations = new Map<StablePeer, OwnershipRegistration>();
+	readonly #helperSockets = new WeakMap<HelperWireSession, StablePeer>();
+	#blocked = false;
+	#busy = false;
+	#ready = false;
+
+	constructor(identity: OwnershipIdentity, system: OwnershipSystem) {
+		this.#identity = Object.freeze(ownershipIdentity(identity));
+		this.#system = system;
+		ownershipToken(system.dispatcher);
+	}
+
+	static async open(identity: OwnershipIdentity, system: OwnershipSystem): Promise<OwnershipDispatcher> {
+		const dispatcher = new OwnershipDispatcher(identity, system);
+		await system.ready();
+		dispatcher.#ready = true;
+		return dispatcher;
+	}
+
+	/** Trusted supervisor control seam, separate from the ordinary client socket. Return releases no worker itself. */
+	async registerHelper(control: StablePeer, helper: StablePeer, generation: string): Promise<void> {
+		return this.#serial(async () => {
+			this.#assertAvailable(); ownershipGeneration(generation);
+			if (this.#pendingHelpers.get(generation) !== control) throw new OwnershipError("ownership_unresolved");
+			if (this.#helpers.has(helper) || [...this.#helpers.values()].includes(generation)) {
+				throw new OwnershipError("ownership_protocol");
+			}
+			if (this.#helpers.size >= OWNERSHIP_LIMITS.helpers) throw new OwnershipError("ownership_limit");
+			try { await this.#system.protectHelper(control, helper, generation); }
+			catch (error) { this.#blocked = true; throw error; }
+			this.#assertAvailable();
+			this.#helpers.set(helper, generation);
+			this.#helperControllers.set(generation, control);
+			this.#pendingHelpers.delete(generation);
+		});
+	}
+
+	/** Active helper socket supplies the actual helper peer; its Host is selected from the prior authenticated prepare. */
+	async registerHelperPeer(helper: StablePeer, generation: string): Promise<void> {
+		const control = this.#pendingHelpers.get(ownershipGeneration(generation));
+		if (!control) throw new OwnershipError("ownership_unresolved");
+		await this.registerHelper(control, helper, generation);
+	}
+
+	/** One actual helper socket, routed separately from ordinary Native operations; no claimed PID is decoded. */
+	async handleHelper(peer: StablePeer, session: HelperWireSession, frame: string): Promise<string> {
+		const bound = this.#helperSockets.get(session);
+		if (bound && bound !== peer) throw new OwnershipError("ownership_unresolved");
+		this.#helperSockets.set(session, peer);
+		const request = session.decode(frame);
+		if (request.operation.op === "register_helper") await this.registerHelperPeer(peer, request.operation.generation);
+		else {
+			if (this.#helpers.get(peer) !== request.operation.generation) throw new OwnershipError("ownership_unresolved");
+			await this.completeHelper(peer);
+		}
+		return session.acknowledge(request);
+	}
+
+	/** Helper loss fences globally before storage I/O; no new shared registration may exploit orphan reparenting. */
+	async helperUncertain(helper: StablePeer): Promise<void> {
+		this.#blocked = true;
+		const generation = this.#helpers.get(helper);
+		if (!generation) throw new OwnershipError("ownership_unresolved");
+		await this.#system.markUnresolved(generation);
+	}
+
+	/** Failed/unavailable extinction proof remains incomplete and cannot be reset through the client protocol. */
+	async completeHelper(helper: StablePeer): Promise<void> {
+		return this.#serial(async () => {
+			const generation = this.#helpers.get(helper);
+			if (!generation) throw new OwnershipError("ownership_unresolved");
+			try { await this.#system.completeHelper(helper, generation); }
+			catch (error) { this.#blocked = true; throw error; }
+			this.#helpers.delete(helper);
+			this.#helperControllers.delete(generation);
+		});
+	}
+
+	/** Each request, including reconnect/publish, is classified from the actual authenticated peer again. */
+	async handle(peer: StablePeer, frame: string): Promise<OwnershipResponse> {
+		const request = decodeOwnershipRequest(frame);
+		try {
+			const result = await this.#serial(() => this.#dispatch(peer, request));
+			return { version: OWNERSHIP_VERSION, id: request.id, ok: true, identity: this.#identity, result };
+		} catch (error) {
+			return { version: OWNERSHIP_VERSION, id: request.id, ok: false,
+				error: error instanceof OwnershipError ? error.code : "ownership_unresolved" };
+		}
+	}
+
+	async #dispatch(peer: StablePeer, request: OwnershipRequest): Promise<OwnershipResult> {
+		this.#assertAvailable();
+		if (request.identity.closure !== this.#identity.closure || request.identity.schema !== this.#identity.schema) {
+			throw new OwnershipError("dispatcher_mismatch");
+		}
+		const registration = await this.#registration(peer);
+		this.#assertAvailable();
+		if (request.operation.op === "classify") return { op: "classify", registration };
+		if (registration.policy === "private") throw new OwnershipError("shared_service_unsupported");
+		if (request.operation.op === "prepare_helper") return this.#prepareHelper(peer, request.operation.generation);
+		if (request.operation.op === "helper_status") return this.#helperStatus(peer, request.operation.generation);
+		const scope = await this.#system.canonicalScope(request.operation.scope);
+		if (!sameOwnershipScope(scope, request.operation.scope)) throw new OwnershipError("ownership_unresolved");
+		this.#assertAvailable();
+		const permit: PublicationPermit = { assertCurrent: () => this.#assertAvailable() };
+		try {
+			if (request.operation.op === "publish") {
+				await this.#system.publish(peer, scope, request.operation.generation, permit);
+				this.#assertAvailable();
+				return { op: "publish", generation: request.operation.generation };
+			}
+			const broker = await this.#system.broker(scope, permit);
+			this.#assertAvailable();
+			return { op: "broker", scope, ...broker };
+		} catch (error) {
+			// A lost backend answer can follow an irreversible spawn. Only durable operator recovery can reopen.
+			this.#blocked = true;
+			throw error;
+		}
+	}
+
+	#prepareHelper(control: StablePeer, generation: string): OwnershipResult {
+		if (this.#helperGenerations.has(generation)) throw new OwnershipError("ownership_protocol");
+		if (this.#pendingHelpers.size + this.#helpers.size >= OWNERSHIP_LIMITS.helpers
+			|| this.#helperGenerations.size >= OWNERSHIP_LIMITS.helperGenerations) throw new OwnershipError("ownership_limit");
+		this.#helperGenerations.add(generation);
+		this.#pendingHelpers.set(generation, control);
+		return { op: "prepare_helper", generation };
+	}
+
+	async #helperStatus(control: StablePeer, generation: string): Promise<OwnershipResult> {
+		if (this.#pendingHelpers.get(generation) === control) return { op: "helper_status", generation, status: "pending" };
+		if (this.#helperControllers.get(generation) !== control) throw new OwnershipError("ownership_unresolved");
+		const helper = [...this.#helpers].find(([, value]) => value === generation)?.[0];
+		if (!helper) throw new OwnershipError("ownership_unresolved");
+		const facts = await this.#system.classify(helper);
+		if (facts.kind !== "private" || facts.generation !== generation) {
+			await this.helperUncertain(helper);
+			throw new OwnershipError("ownership_unresolved");
+		}
+		this.#assertAvailable();
+		return { op: "helper_status", generation, status: "registered" };
+	}
+
+	async #registration(peer: StablePeer): Promise<OwnershipRegistration> {
+		const facts = await this.#system.classify(peer);
+		if (facts.kind === "unresolved" || (facts.kind === "private" && ![...this.#helpers.values()].includes(facts.generation))) {
+			throw new OwnershipError("ownership_unresolved");
+		}
+		const existing = this.#registrations.get(peer);
+		if (existing) {
+			if (existing.policy !== facts.kind || (facts.kind === "private" && existing.generation !== facts.generation)) {
+				this.#blocked = true;
+				throw new OwnershipError("ownership_unresolved");
+			}
+			return existing;
+		}
+		if (this.#registrations.size >= OWNERSHIP_LIMITS.registrations) throw new OwnershipError("ownership_limit");
+		const registration = Object.freeze({ registration: crypto.randomUUID(), dispatcher: this.#system.dispatcher,
+			policy: facts.kind, generation: facts.kind === "private" ? facts.generation : crypto.randomUUID() });
+		this.#registrations.set(peer, registration);
+		return registration;
+	}
+
+	#assertAvailable(): void {
+		if (!this.#ready) throw new OwnershipError("ownership_backend_unavailable");
+		if (this.#blocked) throw new OwnershipError("maintenance_fenced");
+	}
+	async #serial<T>(operation: () => Promise<T>): Promise<T> {
+		if (this.#busy) throw new OwnershipError("ownership_limit");
+		this.#busy = true;
+		try { return await operation(); } finally { this.#busy = false; }
+	}
+}
