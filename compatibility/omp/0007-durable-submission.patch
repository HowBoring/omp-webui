+export type SubmissionOperationOutcome = "succeeded" | "failed" | "cancelled" | "unknown";
+export interface NativeSubmission {
+  operationOutcome?: SubmissionOperationOutcome;
+  reservedAt?: string; completedAt?: string; origin: SubmissionOrigin; fingerprint: string; preparationId: string; terminal: boolean;
+  inputOutcome: "unresolved" | "generated" | "no_input"; entryFacts?: { entryId: string; role: string }[]; noEntries: SubmissionNoEntry[];
+}
+/** Persisted causal carriers are untrusted native data until their complete base shape is checked. */
+export function validSubmissionOrigin(value: unknown): value is SubmissionOrigin {
+  return isRecord(value) && typeof value.clientSubmissionId === "string" && /^[A-Za-z0-9_-]{1,96}$/.test(value.clientSubmissionId)
+    && typeof value.sourceId === "string" && /^[a-f0-9]{64}$/.test(value.sourceId)
+    && typeof value.instanceId === "string" && /^[a-f0-9]{64}$/.test(value.instanceId)
+    && typeof value.nativeSessionId === "string" && value.nativeSessionId.length > 0
+    && value.nativeSessionId.length <= 128 && !value.nativeSessionId.includes("\0");
+}
+export function validSubmissionRole(value: unknown): value is SubmissionRole {
+  return value === "input" || value === "prepared" || value === "additional" || value === "execution";
+}
+export function validSubmissionCausality(value: unknown): value is SubmissionCausality {
+  return isRecord(value) && validSubmissionOrigin(value.origin) && validSubmissionRole(value.role);
+}
+/** Safe public identity projection. Unknown native fields never become public history payloads. */
+export function publicSubmissionCausality(value: unknown): SubmissionCausality | undefined {
+  if (value === undefined) return;
+  if (!validSubmissionCausality(value)) throw new Error("SUBMISSION_CAUSALITY_CORRUPT");
+  return { origin: { sourceId: value.origin.sourceId, instanceId: value.origin.instanceId,
+    nativeSessionId: value.origin.nativeSessionId, clientSubmissionId: value.origin.clientSubmissionId }, role: value.role };
+}
+const scope = new asyncHooks.AsyncLocalStorage<SubmissionScope | undefined>();
+const originals = new WeakMap<object, SubmissionCausality>();
+export function runSubmission<T>(value: SubmissionScope | undefined, run: () => T): T {
+  return scope.run(value, run);
+}
+export function submissionScope(): SubmissionScope | undefined { return scope.getStore(); }
+export function messageSubmission(message: object): SubmissionCausality | undefined { return originals.get(message); }
+/** Carry an explicit native construction origin into its actual message. */
+export function copySubmission(source: object, target: object): void {
+  const cause = originals.get(source);
+  if (cause && !originals.has(target)) originals.set(target, structuredClone(cause));
+}
+export function captureSubmission(message: object, role: string, value = scope.getStore()): void {
+  if (!value || originals.has(message)) return;
+  originals.set(message, { origin: value.origin, role: role === "user" && value.phase === "input" ? "input"
+    : role === "assistant" || role === "toolResult" ? "execution" : value.phase === "input" ? "prepared" : "additional" });
+}
+export function causalSubmission(message?: object): SubmissionCausality | undefined {
+  const explicit = message && originals.get(message);
+  if (explicit) return explicit;
+  const value = scope.getStore();
+  return value ? { origin: value.origin, role: "additional" } : undefined;
+}
+export function sameSubmission(a: SubmissionOrigin, b: SubmissionOrigin): boolean {
+  return a.clientSubmissionId === b.clientSubmissionId && a.sourceId === b.sourceId
+    && a.instanceId === b.instanceId && a.nativeSessionId === b.nativeSessionId;
+}
+
+/** Retain native admitted work, including preprocessing that has not started an agent loop yet. */
+export function trackSubmissionTask<T>(task: Promise<T>): void {
+  const tasks = scope.getStore()?.tasks;
+  if (!tasks) return;
+  if (tasks.size >= submissionPolicy.maxPendingTasks) { scope.getStore()?.onTaskOverflow?.(); return; }
+  tasks.add(task);
+  void task.then(() => tasks.delete(task), () => tasks.delete(task));
+}
+
+/** Revalidate protected native authority at an actual scoped effect boundary. Ordinary callers stay unchanged. */
+export function assertSubmissionCurrent(readTarget: () => SubmissionTarget, origin: SubmissionTarget | undefined = scope.getStore()?.origin): void {
+  if (!origin) return;
+  const target = readTarget();
+  if (target.sourceId !== origin.sourceId || target.instanceId !== origin.instanceId
+    || target.nativeSessionId !== origin.nativeSessionId) throw new Error("SUBMISSION_TARGET_CHANGED");
+}
