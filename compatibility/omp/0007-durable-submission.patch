+/** Native control records are serialized in the journal but excluded from its conversation/tree index. */
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import type { CustomEntry, SessionEntry } from "./session-entries";
+import type { NativeSubmission } from "./submission-provenance";
+import { sameSubmission, validSubmissionCausality, validSubmissionRole, validSubmissionOrigin } from "./submission-provenance";
+import { nativeSubmissionPolicy as policy } from "./submission-policy";
+export const nativeControlRecordBytes = 8 * 1024 * 1024;
+export const SUBMISSION_CONTROL = "omp.native-control/submission-v1";
+function boundedString(value: unknown, maximum: number): value is string {
+  return typeof value === "string" && value.length > 0 && value.length <= maximum;
+}
+export function isSubmissionControl(entry: SessionEntry): entry is CustomEntry {
+  return entry.type === "custom" && entry.customType === SUBMISSION_CONTROL;
+}
+export function submissionRecord(value: NativeSubmission): CustomEntry {
+  const payload = structuredClone(value), checksum = Bun.SHA256.hash(JSON.stringify(payload), "hex");
+  return { type: "custom", customType: SUBMISSION_CONTROL, id: `control-${checksum.slice(0, 32)}`,
+    parentId: null, activeLeafId: null, timestamp: value.completedAt ?? value.reservedAt ?? "1970-01-01T00:00:00.000Z",
+    data: { version: 1, submission: payload, checksum } };
+}
+export function readSubmissionRecords(entries: SessionEntry[]): NativeSubmission[] {
+  const values = new Map<string, NativeSubmission>();
+  let bytes = 0;
+  for (const entry of entries) {
+    if (entry.submission !== undefined && !validSubmissionCausality(entry.submission))
+      throw new Error("SUBMISSION_CAUSALITY_CORRUPT");
+    if (!isSubmissionControl(entry)) continue;
+    const recordBytes = Buffer.byteLength(JSON.stringify(entry)) + 1;
+    bytes += recordBytes;
+    if (recordBytes > nativeControlRecordBytes || bytes > policy.maxMetadataBytes || !isRecord(entry.data) || entry.data.version !== 1
+      || !isRecord(entry.data.submission) || typeof entry.data.checksum !== "string"
+      || Bun.SHA256.hash(JSON.stringify(entry.data.submission), "hex") !== entry.data.checksum)
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    const value = entry.data.submission;
+    if (!validSubmissionOrigin(value.origin) || typeof value.fingerprint !== "string"
+      || !/^[a-f0-9]{64}$/.test(value.fingerprint) || !boundedString(value.preparationId, 96)
+      || (value.operationOutcome !== undefined && !["succeeded", "failed", "cancelled", "unknown"].includes(String(value.operationOutcome)))
+      || typeof value.terminal !== "boolean" || !["generated", "no_input", "unresolved"].includes(String(value.inputOutcome))
+      || !Array.isArray(value.noEntries) || value.noEntries.length > policy.maxNoEntryFacts
+      || (value.entryFacts !== undefined && (!Array.isArray(value.entryFacts) || value.entryFacts.length > policy.maxEntryFacts)))
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    for (const fact of value.entryFacts ?? []) if (!isRecord(fact) || !boundedString(fact.entryId, 256) || !validSubmissionRole(fact.role))
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    for (const fact of value.noEntries) if (!isRecord(fact) || !boundedString(fact.relationId, 256)
+      || !validSubmissionRole(fact.role) || !["no_entry", "failed"].includes(String(fact.status)) || !boundedString(fact.reason, 512))
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    if (new Set((value.entryFacts ?? []).map(fact => fact.entryId)).size !== (value.entryFacts?.length ?? 0)
+      || new Set(value.noEntries.map(fact => fact.relationId)).size !== value.noEntries.length)
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    const record = value as unknown as NativeSubmission, prior = values.get(record.origin.clientSubmissionId);
+    const entryFacts = new Map((record.entryFacts ?? []).map(fact => [fact.entryId, fact]));
+    const noEntries = new Map(record.noEntries.map(fact => [fact.relationId, fact]));
+    if (prior && (!sameSubmission(prior.origin, record.origin) || prior.fingerprint !== record.fingerprint
+      || (prior.terminal && !record.terminal)
+      || (prior.operationOutcome !== undefined && prior.operationOutcome !== "unknown" && prior.operationOutcome !== record.operationOutcome)
+      || (prior.inputOutcome !== "unresolved" && prior.inputOutcome !== record.inputOutcome)
+      || prior.preparationId !== record.preparationId
+      || prior.entryFacts?.some(fact => entryFacts.get(fact.entryId)?.role !== fact.role)
+      || prior.noEntries.some(fact => {
+        const next = noEntries.get(fact.relationId);
+        return !next || next.role !== fact.role || next.status !== fact.status || next.reason !== fact.reason;
+      })))
+      throw new Error("SUBMISSION_METADATA_CONFLICT");
+    values.set(record.origin.clientSubmissionId, record);
+    if (values.size > policy.maxSubmissions) throw new Error("SUBMISSION_METADATA_LIMIT");
+  }
+  const submissions = [...values.values()];
+  assertSubmissionEntries(entries, submissions);
+  return submissions;
+}
+/** A causal carrier is authenticated only together with its permanent native reservation. */
+export function assertSubmissionEntries(entries: SessionEntry[], submissions: NativeSubmission[]): void {
+  const reservations = new Map(submissions.map(value => [value.origin.clientSubmissionId, value]));
+  for (const entry of entries) {
+    if (entry.submission === undefined) continue;
+    if (!validSubmissionCausality(entry.submission)) throw new Error("SUBMISSION_CAUSALITY_CORRUPT");
+    const reservation = reservations.get(entry.submission.origin.clientSubmissionId);
+    if (!reservation || !sameSubmission(reservation.origin, entry.submission.origin))
+      throw new Error("SUBMISSION_CAUSALITY_ORPHAN");
+  }
+}
