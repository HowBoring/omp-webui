index 0000000000..85ef1dd61e
--- /dev/null
+++ b/packages/coding-agent/src/session/session-required-features.ts
@@ -0,0 +1,14 @@
+/** Shared pure header decoder. Unsupported rollback sees ompsub1 instead of a usable session header. */
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import type { SessionHeader } from "./session-entries";
+export function nativeSessionHeader(value: unknown): SessionHeader | undefined {
+  if (!isRecord(value) || (value.type !== "session" && value.type !== "ompsub1") || typeof value.id !== "string") return;
+  if (value.requiredFeatures !== undefined && (!Array.isArray(value.requiredFeatures)
+    || value.requiredFeatures.some(feature => feature !== "durable-submission-v1"))) throw new Error("SESSION_REQUIRED_FEATURE_UNSUPPORTED");
+  if (value.type === "ompsub1" && (!Array.isArray(value.requiredFeatures)
+    || !value.requiredFeatures.includes("durable-submission-v1")))
+    throw new Error("SUBMISSION_METADATA_CORRUPT");
+  if (value.nativeSubmissions !== undefined && (!Array.isArray(value.nativeSubmissions) || value.nativeSubmissions.length > 16
+    || Buffer.byteLength(JSON.stringify(value.nativeSubmissions)) > 12_000)) throw new Error("SUBMISSION_METADATA_CORRUPT");
+  return { ...value, type: "session" } as SessionHeader;
+}
