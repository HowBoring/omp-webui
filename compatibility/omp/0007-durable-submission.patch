+export const nativeSubmissionPolicy = Object.freeze({
+  version: "durable-submission-v1", status: "prototype", ownership: "native-exclusive-pinned-storage",
+  durability: "process-crash-only", dedup: "permanent-refuse-at-capacity", query: "read-only-no-execution",
+  logicalHeader: "ompsub1", carrier: "ompgen2", maxSubmissions: 10_000, maxMetadataBytes: 32 * 1024 * 1024,
+  maxEntryFacts: 100_000, maxNoEntryFacts: 4096, maxQueryRelations: 128, maxMessageBytes: 262_144,
+  maxImagesBytes: 524_288, maxPendingTasks: 4096,
