index 0000000000..8af5938efb
--- /dev/null
+++ b/packages/coding-agent/src/session/submission-records.ts
@@ -0,0 +1,50 @@
+/** Native control records are serialized in the journal but excluded from its conversation/tree index. */
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import type { CustomEntry, SessionEntry } from "./session-entries";
+import type { NativeSubmission } from "./submission-provenance";
+import { sameSubmission } from "./submission-provenance";
+import { nativeSubmissionPolicy as policy } from "./submission-policy";
+export const SUBMISSION_CONTROL = "omp.native-control/submission-v1";
+export function isSubmissionControl(entry: SessionEntry): entry is CustomEntry {
+  return entry.type === "custom" && entry.customType === SUBMISSION_CONTROL;
+}
+export function submissionRecord(value: NativeSubmission): CustomEntry {
+  const payload = structuredClone(value), checksum = Bun.SHA256.hash(JSON.stringify(payload), "hex");
+  return { type: "custom", customType: SUBMISSION_CONTROL, id: `control-${checksum.slice(0, 32)}`,
+    parentId: null, activeLeafId: null, timestamp: value.completedAt ?? value.reservedAt ?? "1970-01-01T00:00:00.000Z",
+    data: { version: 1, submission: payload, checksum } };
+}
+export function readSubmissionRecords(entries: SessionEntry[]): NativeSubmission[] {
+  const values = new Map<string, NativeSubmission>();
+  let bytes = 0;
+  for (const entry of entries) {
+    if (!isSubmissionControl(entry)) continue;
+    bytes += Buffer.byteLength(JSON.stringify(entry));
+    if (bytes > policy.maxMetadataBytes || !isRecord(entry.data) || entry.data.version !== 1
+      || !isRecord(entry.data.submission) || typeof entry.data.checksum !== "string"
+      || Bun.SHA256.hash(JSON.stringify(entry.data.submission), "hex") !== entry.data.checksum)
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    const value = entry.data.submission;
+    if (!isRecord(value.origin) || typeof value.origin.clientSubmissionId !== "string"
+      || !/^[A-Za-z0-9_-]{1,96}$/.test(value.origin.clientSubmissionId)
+      || typeof value.origin.sourceId !== "string" || !/^[a-f0-9]{64}$/.test(value.origin.sourceId)
+      || typeof value.origin.instanceId !== "string" || !/^[a-f0-9]{64}$/.test(value.origin.instanceId)
+      || typeof value.origin.nativeSessionId !== "string" || typeof value.fingerprint !== "string"
+      || !/^[a-f0-9]{64}$/.test(value.fingerprint) || typeof value.preparationId !== "string"
+      || typeof value.terminal !== "boolean" || !["generated", "no_input", "unresolved"].includes(String(value.inputOutcome))
+      || !Array.isArray(value.noEntries) || value.noEntries.length > policy.maxNoEntryFacts
+      || (value.entryFacts !== undefined && (!Array.isArray(value.entryFacts) || value.entryFacts.length > policy.maxEntryFacts)))
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    for (const fact of value.entryFacts ?? []) if (!isRecord(fact) || typeof fact.entryId !== "string" || typeof fact.role !== "string")
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    for (const fact of value.noEntries) if (!isRecord(fact) || typeof fact.relationId !== "string"
+      || typeof fact.role !== "string" || !["no_entry", "failed"].includes(String(fact.status)) || typeof fact.reason !== "string")
+      throw new Error("SUBMISSION_METADATA_CORRUPT");
+    const record = value as unknown as NativeSubmission, prior = values.get(record.origin.clientSubmissionId);
+    if (prior && (!sameSubmission(prior.origin, record.origin) || prior.fingerprint !== record.fingerprint
+      || (prior.terminal && !record.terminal))) throw new Error("SUBMISSION_METADATA_CONFLICT");
+    values.set(record.origin.clientSubmissionId, record);
+    if (values.size > policy.maxSubmissions) throw new Error("SUBMISSION_METADATA_LIMIT");
+  }
+  return [...values.values()];
+}
