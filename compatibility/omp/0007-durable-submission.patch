@@ -0,0 +1,41 @@
+/** Native causal carrier. Queued originals retain their origin independently of the task that drains them. */
+import * as asyncHooks from "node:async_hooks";
+export interface SubmissionTarget { sourceId: string; instanceId: string; nativeSessionId: string }
+export interface SubmissionOrigin extends SubmissionTarget { clientSubmissionId: string }
+export interface SubmissionCausality { origin: SubmissionOrigin; role: "input" | "prepared" | "additional" | "execution" }
+export interface SubmissionScope { origin: SubmissionOrigin; phase: "extension" | "input"; tasks?: Set<Promise<unknown>> }
+export interface SubmissionNoEntry { relationId: string; role: string; status: "no_entry" | "failed"; reason: string }
+export interface NativeSubmission {
+  origin: SubmissionOrigin; fingerprint: string; preparationId: string; terminal: boolean;
+  inputOutcome: "unresolved" | "generated" | "no_input"; noEntries: SubmissionNoEntry[];
+}
+const scope = new asyncHooks.AsyncLocalStorage<SubmissionScope | undefined>();
+const originals = new WeakMap<object, SubmissionCausality>();
+export function runSubmission<T>(value: SubmissionScope | undefined, run: () => T): T {
+  return scope.run(value, run);
+}
+export function submissionScope(): SubmissionScope | undefined { return scope.getStore(); }
+export function messageSubmission(message: object): SubmissionCausality | undefined { return originals.get(message); }
+export function captureSubmission(message: object, role: string, value = scope.getStore()): void {
+  if (!value || originals.has(message)) return;
+  originals.set(message, { origin: value.origin, role: role === "user" && value.phase === "input" ? "input"
+    : role === "assistant" || role === "toolResult" ? "execution" : value.phase === "input" ? "prepared" : "additional" });
+}
+export function causalSubmission(message?: object): SubmissionCausality | undefined {
+  const explicit = message && originals.get(message);
+  if (explicit) return explicit;
+  const value = scope.getStore();
+  return value ? { origin: value.origin, role: "additional" } : undefined;
+}
+export function sameSubmission(a: SubmissionOrigin, b: SubmissionOrigin): boolean {
+  return a.clientSubmissionId === b.clientSubmissionId && a.sourceId === b.sourceId
+    && a.instanceId === b.instanceId && a.nativeSessionId === b.nativeSessionId;
+}
+
+/** Retain native admitted work, including preprocessing that has not started an agent loop yet. */
+export function trackSubmissionTask<T>(task: Promise<T>): void {
+  const tasks = scope.getStore()?.tasks;
+  if (!tasks) return;
+  tasks.add(task);
+  void task.then(() => tasks.delete(task), () => tasks.delete(task));
+}
