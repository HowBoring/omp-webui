+      if (observation.kind !== "message_settlement" || !observation.settlement) return;
+      const cause = messageSubmission(observation.message);
+      if (!cause) return;
+      const pending = this.#pending.get(cause.origin.clientSubmissionId);
+      if (!pending || !sameSubmission(pending.origin, cause.origin)) return;
+      const decision = observation.settlement;
+      if (decision.status === "observed") return;
