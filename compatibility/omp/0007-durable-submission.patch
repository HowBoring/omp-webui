+    if (!value) return { version: "durable-submission-v1", clientSubmissionId, target, found: false, duplicate, admission: "absent",
+      reservation: "absent", operationOutcome: "unknown", inputOutcome: "unresolved", persistence: this.#failures.get(clientSubmissionId) ?? "unresolved", terminal: false, relations: [], nextOffset: null };
