diff --git a/packages/coding-agent/src/modes/rpc/rpc-submissions.ts b/packages/coding-agent/src/modes/rpc/rpc-submissions.ts
new file mode 100644
index 0000000000..345c18f6b9
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-submissions.ts
@@ -0,0 +1,126 @@
+import { nativeSubmissionPolicy as submissionPolicy } from "../../session/submission-policy";
+/** Native durable submission coordinator. This owns metadata only; OMP retains the conversation. */
+import type { AgentSession } from "../../session/agent-session";
+import type { ImageContent } from "@oh-my-pi/pi-ai";
+import { messageSubmission, runSubmission, sameSubmission } from "../../session/submission-provenance";
+import type { NativeSubmission, SubmissionNoEntry, SubmissionOrigin, SubmissionScope, SubmissionTarget } from "../../session/submission-provenance";
+import { validSubmissionCommand } from "./submissions.generated";
+import type { SubmissionResult } from "./wire/rpc-wire.generated";
+export type { SubmissionResult } from "./wire/rpc-wire.generated";
+export interface SubmissionSubmit {
+  id?: string; type: "submission_submit"; clientSubmissionId: string; sourceId: string; instanceId: string; nativeSessionId: string; preparationId: string;
+  inputType: "prompt" | "steer" | "follow_up" | "abort_and_prompt"; message: string; images?: ImageContent[];
+  streamingBehavior?: "steer" | "followUp";
+}
+export type SubmissionCommand = SubmissionSubmit | { id?: string; type: "submission_query"; clientSubmissionId: string; offset?: number; limit?: number };
+interface PendingSubmission { origin: SubmissionOrigin; noEntries: Map<string, SubmissionNoEntry>; overflow: boolean; tasks: Set<Promise<unknown>> }
+export class RpcSubmissions {
+  readonly #pending = new Map<string, PendingSubmission>();
+  #target: SubmissionTarget | undefined;
+  readonly #failures = new Map<string, "failed" | "unknown">();
+  constructor(readonly session: AgentSession) {
+    try { this.#target = session.sessionManager.getSubmissionTarget(); } catch { /* Ordinary unprotected sessions refuse this API. */ }
+    session.subscribeMessageObservations(observation => {
+      if (observation.kind !== "message_settlement" || !observation.settlement) return;
+      const cause = messageSubmission(observation.message);
+      if (!cause) return;
+      const pending = this.#pending.get(cause.origin.clientSubmissionId);
+      if (!pending || !sameSubmission(pending.origin, cause.origin)) return;
+      const decision = observation.settlement;
+      if (decision.status === "observed") return;
+      if (pending.noEntries.size >= submissionPolicy.maxNoEntryFacts) { pending.overflow = true; return; }
+      pending.noEntries.set(observation.live.messageId, { relationId: observation.live.messageId,
+        role: cause.role, status: decision.status, reason: decision.reason ?? "native_no_entry" });
+    });
+  }
+  validate(command: unknown): void {
+    if (!validSubmissionCommand(command)) throw new Error("SUBMISSION_COMMAND_SCHEMA");
+    const value = command as SubmissionCommand;
+    if (!/^[A-Za-z0-9_-]{1,96}$/.test(value.clientSubmissionId) || (value.id !== undefined && value.id.length > 96))
+      throw new Error("SUBMISSION_COMMAND_SCHEMA");
+    if (value.type === "submission_query") {
+      if ((value.offset ?? 0) < 0 || (value.limit ?? 64) < 1 || (value.limit ?? 64) > submissionPolicy.maxQueryRelations)
+        throw new Error("SUBMISSION_QUERY_BOUNDS");
+      return;
+    }
+    if (value.preparationId.length < 1 || value.preparationId.length > 96 || Buffer.byteLength(value.message) > submissionPolicy.maxMessageBytes
+      || !/^[a-f0-9]{64}$/.test(value.sourceId) || !/^[a-f0-9]{64}$/.test(value.instanceId)
+      || value.nativeSessionId.length < 1 || value.nativeSessionId.length > 128
+      || Buffer.byteLength(JSON.stringify(value.images ?? [])) > submissionPolicy.maxImagesBytes) throw new Error("SUBMISSION_COMMAND_SCHEMA");
+  }
+  async reserve(command: SubmissionSubmit): Promise<{ admitted: boolean; scope: SubmissionScope }> {
+    this.validate(command);
+    const target = this.session.sessionManager.getSubmissionTarget();
+    if (target.sourceId !== command.sourceId || target.instanceId !== command.instanceId
+        || target.nativeSessionId !== command.nativeSessionId) throw new Error("SUBMISSION_TARGET_MISMATCH");
+    const origin = { ...target, clientSubmissionId: command.clientSubmissionId };
+    const fingerprint = Bun.SHA256.hash(JSON.stringify({ target, preparationId: command.preparationId,
+      type: command.inputType, message: command.message, images: command.images ?? [], streamingBehavior: command.streamingBehavior ?? null }), "hex");
+    const reservation: NativeSubmission = { origin, fingerprint, preparationId: command.preparationId,
+      terminal: false, inputOutcome: "unresolved", noEntries: [] };
+    let admitted: boolean;
+    try { admitted = await this.session.sessionManager.reserveSubmission(reservation); }
+    catch (failure) {
+      if (!(failure instanceof Error && failure.message === "SUBMISSION_CONFLICT")) this.fail(origin, failure);
+      throw failure;
+    }
+    const tasks = new Set<Promise<unknown>>();
+    if (admitted) this.#pending.set(origin.clientSubmissionId, { origin, noEntries: new Map(), overflow: false, tasks });
+    return { admitted, scope: { origin, phase: "extension", tasks, onTaskOverflow: () => {
+      const pending = this.#pending.get(origin.clientSubmissionId); if (pending) pending.overflow = true;
+    } } };
+  }
+  run<T>(scope: SubmissionScope, run: () => T): T { return runSubmission(scope, run); }
+  async complete(origin: SubmissionOrigin, local: boolean): Promise<void> {
+    const pending = this.#pending.get(origin.clientSubmissionId);
+    if (!pending) return;
+    try {
+      while (pending.tasks.size) await Promise.allSettled([...pending.tasks]);
+      await this.session.waitForAdmittedSubmissions();
+      await this.session.waitForIdle();
+      if (pending.overflow) throw new Error("SUBMISSION_RELATION_LIMIT");
+      const state = this.session.sessionManager.readSubmissionState();
+      const generated = state.entries.some(entry => entry.submission && sameSubmission(entry.submission.origin, origin)
+        && entry.submission.role === "input");
+      await this.session.sessionManager.completeSubmission(origin, generated ? "generated" : local ? "no_input" : "unresolved",
+        [...pending.noEntries.values()]);
+    } catch (failure) { this.fail(origin, failure); }
+    finally { this.#pending.delete(origin.clientSubmissionId); }
+  }
+  fail(origin: SubmissionOrigin, failure: unknown): void {
+    const code = failure instanceof Error ? failure.message : "SUBMISSION_FAILURE";
+    this.#failures.set(origin.clientSubmissionId, /UNKNOWN|INDETERMINATE|BINDING|SOURCE|IDENTITY/.test(code) ? "unknown" : "failed");
+  }
+  query(clientSubmissionId: string, offset = 0, limit = 64, duplicate = false): SubmissionResult {
+    this.validate({ type: "submission_query", clientSubmissionId, offset, limit });
+    let target = this.#target;
+    let state;
+    try { target = this.session.sessionManager.getSubmissionTarget(); this.#target = target;
+      state = this.session.sessionManager.readSubmissionState(); }
+    catch (failure) { if (!target) throw failure; return { version: "durable-submission-v1", clientSubmissionId, target, found: false, duplicate, admission: "absent",
+      reservation: "unknown", inputOutcome: "unresolved", persistence: "unknown", terminal: false, relations: [], nextOffset: null,
+      code: "SUBMISSION_SOURCE_UNREADABLE" }; }
+    const value = state.submissions.find(item => item.origin.clientSubmissionId === clientSubmissionId);
+    if (!value) return { version: "durable-submission-v1", clientSubmissionId, target, found: false, duplicate, admission: "absent",
+      reservation: "absent", inputOutcome: "unresolved", persistence: this.#failures.get(clientSubmissionId) ?? "unresolved", terminal: false, relations: [], nextOffset: null };
+    const durableEntries = state.entries.filter(entry => entry.submission && sameSubmission(entry.submission.origin, value.origin));
+    const retained = new Set(durableEntries.map(entry => entry.id));
+    const facts = new Map((value.entryFacts ?? []).map(fact => [fact.entryId, fact]));
+    for (const entry of durableEntries) facts.set(entry.id, { entryId: entry.id, role: entry.submission!.role });
+    const relations: SubmissionResult["relations"] = [...facts.values()].map(fact => ({ relationId: `entry:${fact.entryId}`,
+      role: fact.role, status: "observed", persistence: "committed", entryId: fact.entryId,
+      availability: retained.has(fact.entryId) ? "retained" : "removed" }));
+    for (const entry of this.session.sessionManager.getEntries()) {
+      if (facts.has(entry.id) || !entry.submission || !sameSubmission(entry.submission.origin, value.origin)) continue;
+      relations.push({ relationId: `entry:${entry.id}`, role: entry.submission.role, status: "observed", persistence: "observed", entryId: entry.id });
+    }
+    relations.push(...value.noEntries.map(item => ({ ...item, persistence: "committed" as const })));
+    const end = Math.min(offset + limit, relations.length);
+    return { version: "durable-submission-v1", clientSubmissionId, target, found: true, duplicate,
+      admission: value.origin.sourceId === target.sourceId && value.origin.instanceId === target.instanceId
+        && value.origin.nativeSessionId === target.nativeSessionId ? "local" : "inherited", origin: value.origin,
+      reservation: "committed", inputOutcome: [...facts.values()].some(fact => fact.role === "input") ? "generated" : value.inputOutcome, terminal: value.terminal,
+      persistence: this.#failures.get(clientSubmissionId) ?? (value.terminal ? "committed" : "unresolved"),
+      relations: relations.slice(offset, end), nextOffset: end < relations.length ? end : null };
+  }
+}
