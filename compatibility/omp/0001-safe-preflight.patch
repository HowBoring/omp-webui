index 00000000..5a9731a9
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/preflight.ts
@@ -0,0 +1,43 @@
+/** Public startup path: no Session, user configuration, extensions, native UI or model imports. */
+import { RpcFrameEncoder, MAX_RPC_FRAME_BYTES, MAX_RPC_REASSEMBLED_BYTES } from "./rpc-frame";
+import { compatibilityBuild, validateCommand } from "./preflight.generated";
+import type { CompatibilityReport } from "./wire/rpc-wire.generated";
+
+export async function runPreflight(): Promise<void> {
+  const encoder = new RpcFrameEncoder();
+  const write = async (frame: object): Promise<void> => {
+    for (const line of encoder.encodeFrames(frame)) {
+      await Bun.stdout.write(line);
+    }
+  };
+  await write({
+    type: "ready", protocolVersion: 1, supportedProtocolVersions: [1, 2],
+    maxFrameBytes: MAX_RPC_FRAME_BYTES, maxReassembledFrameBytes: MAX_RPC_REASSEMBLED_BYTES,
+  });
+  const buffer = new Uint8Array(MAX_RPC_FRAME_BYTES);
+  let used = 0;
+  for await (const bytes of Bun.stdin.stream()) {
+    for (const byte of bytes) {
+      if (used === buffer.length) throw new Error("preflight physical limit");
+      buffer[used++] = byte;
+      if (byte !== 10) continue;
+      const command: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(buffer.subarray(0, used - 1)));
+      used = 0;
+      if (!validateCommand(command)) throw new Error("preflight command schema");
+      if (command.type === "negotiate_protocol") {
+        if (command.protocolVersion !== 2) throw new Error("preflight requires protocol v2");
+        encoder.setProtocolVersion(2);
+        await write({ type: "response", id: command.id, command: command.type, success: true,
+          data: { protocolVersion: 2 } });
+      } else {
+        const report: CompatibilityReport = {
+          candidate: "omp-webui-s0", ...compatibilityBuild, safePreflight: true, sessionAdmission: "blocked",
+          capabilities: ["safe-preflight-v1", "rpc-framing-v2"],
+          runtime: { name: "bun", version: Bun.version, platform: process.platform, arch: process.arch },
+        };
+        await write({ type: "response", id: command.id, command: command.type, success: true, data: report });
+      }
+    }
+  }
+  if (used !== 0) throw new Error("preflight partial EOF");
+}
