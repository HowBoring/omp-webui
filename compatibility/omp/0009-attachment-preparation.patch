+++ b/packages/coding-agent/src/attachments/limits.ts
@@ -0,0 +1,15 @@
+/** Versioned independently from raw originals: all limits are refusal ceilings, never silent fallback. */
+export const ATTACHMENT_BUDGET_VERSION = "attachment-budgets-v1";
+export const ATTACHMENT_LIMITS = Object.freeze({
+	imageBytes: 10 * 1024 * 1024, documentBytes: 5 * 1024 * 1024,
+	objects: 8, originalBytes: 32 * 1024 * 1024,
+	imagePixels: 16_777_216, imageDimension: 16_384, decodedBytes: 64 * 1024 * 1024,
+	preparedImageBytes: 500 * 1024, preparedImageDimension: 1568,
+	textBytes: 50 * 1024, textLines: 3000, convertedBytes: 2 * 1024 * 1024,
+	archiveBytes: 32 * 1024 * 1024, archiveMemberBytes: 8 * 1024 * 1024,
+	archiveIndexBytes: 512 * 1024, archiveEntries: 2048, archivePathBytes: 1024,
+	conversionMs: 10_000, inputMs: 60_000, preparedBytes: 8 * 1024 * 1024,
+	conversionDataBytes: 512 * 1024 * 1024, conversionCpuSeconds: 8,
+	messageBytes: 128 * 1024, rpcBytes: 48 * 1024 * 1024,
+	receiptMs: 300_000, receipts: 2, stagedBytes: 16 * 1024 * 1024,
+});
diff --git a/packages/coding-agent/src/attachments/prepare.ts b/packages/coding-agent/src/attachments/prepare.ts
new file mode 100644
index 0000000000..a94faaffdf
--- /dev/null
+++ b/packages/coding-agent/src/attachments/prepare.ts
@@ -0,0 +1,68 @@
+import { truncateHead, truncateHeadBytes } from "@oh-my-pi/pi-tui/tools/streaming-output";
+import { imageDecodeFailureReason } from "@oh-my-pi/pi-tui/chat/image-loading";
+import { parseImageMetadata } from "@oh-my-pi/pi-utils/mime";
+import { imageAnimation } from "@oh-my-pi/pi-utils/image-animation";
+import { resizeImage } from "../utils/image-resize";
+import { ATTACHMENT_LIMITS } from "./limits";
+import { convertAttachmentDocument } from "./document";
+
+/** Native conversion boundary. It never dispatches input or calls an Agent, extension, model or tool. */
+export type AttachmentFormat = "utf8" | "png" | "jpeg" | "webp" | "gif" | "pdf" | "docx" | "pptx" | "xlsx" | "epub";
+export interface AttachmentInput { format: AttachmentFormat; bytes: Uint8Array }
+export type AttachmentPreparation =
+	| { status: "failed"; code: string }
+	| { status: "ready"; representation: PreparedRepresentation; degradations: string[] };
+export type PreparedRepresentation = { kind: "text"; text: string }
+	| { kind: "image"; mimeType: string; data: string; width: number; height: number };
+
+function prepareText(text: string): AttachmentPreparation {
+	const truncated = truncateHead(text);
+	const content = truncated.firstLineExceedsLimit ? truncateHeadBytes(text, 50 * 1024).text : truncated.content;
+	return { status: "ready", representation: { kind: "text", text: content },
+		degradations: truncated.truncated ? ["text_truncated"] : [] };
+}
+
+async function prepareImage(input: AttachmentInput): Promise<AttachmentPreparation> {
+	const metadata = parseImageMetadata(input.bytes);
+	const mimeType = `image/${input.format}`;
+	if (!metadata || metadata.mimeType !== mimeType) return { status: "failed", code: "attachment_format_mismatch" };
+	const { width, height } = metadata;
+	if (!width || !height) return { status: "failed", code: "attachment_invalid_image" };
+	let animation;
+	try { animation = imageAnimation(input.bytes, mimeType); }
+	catch { return { status: "failed", code: "attachment_invalid_image" }; }
+	if (width > ATTACHMENT_LIMITS.imageDimension || height > ATTACHMENT_LIMITS.imageDimension ||
+		width * height * animation.frames > ATTACHMENT_LIMITS.imagePixels ||
+		width * height * animation.frames * 4 > ATTACHMENT_LIMITS.decodedBytes) {
+		return { status: "failed", code: "attachment_decoded_budget" };
+	}
+	const image = { type: "image" as const, mimeType, data: input.bytes.toBase64() };
+	if (await imageDecodeFailureReason(image)) return { status: "failed", code: "attachment_invalid_image" };
+	const source = animation.animated ? await new Bun.Image(input.bytes).png().bytes() : input.bytes;
+	const result = await resizeImage({ bytes: source, mimeType: animation.animated ? "image/png" : mimeType }, { excludeWebP: true });
+	if (result.decodeFailed) return { status: "failed", code: "attachment_image_conversion_failed" };
+	if (result.buffer.length > ATTACHMENT_LIMITS.preparedImageBytes) return { status: "failed", code: "attachment_prepared_budget" };
+	const degradations = result.wasResized ? ["image_transformed"] : [];
+	if (animation.animated) degradations.push("animation_first_frame_only");
+	return { status: "ready", representation: { kind: "image", mimeType: result.mimeType, data: result.data,
+		width: result.width, height: result.height }, degradations };
+}
+
+export async function prepareAttachment(input: AttachmentInput): Promise<AttachmentPreparation> {
+	const isImage = ["png", "jpeg", "webp", "gif"].includes(input.format);
+	const ceiling = isImage ? ATTACHMENT_LIMITS.imageBytes : ATTACHMENT_LIMITS.documentBytes;
+	if (input.bytes.byteLength > ceiling) return { status: "failed", code: "attachment_original_budget" };
+	if (isImage) return prepareImage(input);
+	if (input.format !== "utf8") {
+		const converted = await convertAttachmentDocument(input);
+		if (converted.status === "failed" || converted.representation.kind !== "text") return converted;
+		const result = prepareText(converted.representation.text);
+		return result.status === "ready" ? { ...result, degradations: [...converted.degradations, ...result.degradations] } : result;
+	}
+	try {
+		const text = new TextDecoder("utf-8", { fatal: true }).decode(input.bytes);
+		return prepareText(text);
+	} catch {
+		return { status: "failed", code: "attachment_invalid_utf8" };
+	}
+}
diff --git a/packages/coding-agent/src/attachments/receipts.ts b/packages/coding-agent/src/attachments/receipts.ts
new file mode 100644
index 0000000000..a18646cc88
--- /dev/null
+++ b/packages/coding-agent/src/attachments/receipts.ts
@@ -0,0 +1,161 @@
+import type { ImageContent } from "@oh-my-pi/pi-ai";
+import type { FileMentionMessage } from "../session/messages";
+import { decodeBase64ImageData } from "@oh-my-pi/pi-utils/mime";
+import type { AttachmentFormat, AttachmentPreparation } from "./prepare";
+import { prepareAttachmentIsolated } from "./isolated";
+import { ATTACHMENT_BUDGET_VERSION, ATTACHMENT_LIMITS } from "./limits";
+
+export interface AttachmentBinding {
+	sourceId: string; instanceId: string; nativeSessionId: string; contextId: string;
+	modelFingerprint: string; imageCapable: boolean;
+}
+export interface ControlledOriginal { originalId: string; format: AttachmentFormat; sha256: string; data: string }
+export interface AttachmentDraft {
+	preparationId: string; draftId: string; draftRevision: string; authorityGeneration: string;
+	message: string; objects: ControlledOriginal[];
+}
+export type AttachmentPreparedItem = AttachmentPreparation & { originalId: string; originalSha256: string;
+	preparedId: string; preparedSha256: string };
+export interface AttachmentReceipt {
+	version: "attachment-preparation-v1"; budgetVersion: string; receiptId: string; preparationId: string;
+	draftId: string; draftRevision: string; authorityGeneration: string; draftFingerprint: string;
+	binding: AttachmentBinding; expiresAt: number; status: "ready" | "failed"; resultDigest: string;
+	items: AttachmentPreparedItem[];
+}
+export interface AttachmentConsent {
+	receiptId: string; resultDigest: string; draftRevision: string; authorityGeneration: string;
+	acceptedDegradations: string[];
+}
+export interface PreparedAttachmentLink {
+	originalId: string; preparedId: string; originalSha256: string; preparedSha256: string;
+	representationKind: "text" | "image";
+}
+export interface PreparedSubmission {
+	message: string; images: ImageContent[]; companionMessages: FileMentionMessage[];
+	preparationDigest: string; attachments: PreparedAttachmentLink[];
+}
+interface Staged { receipt: AttachmentReceipt; message: string; bytes: number; reserved: string | undefined }
+const sha256 = (value: string | Uint8Array): string => Bun.SHA256.hash(value, "hex");
+
+/** Ephemeral immutable receipts. Restart and every draft/context/authority change require fresh preparation. */
+export class AttachmentPreparations {
+	readonly #binding: () => AttachmentBinding;
+	readonly #receipts = new Map<string, Staged>();
+	#pending: { preparationId: string; draftId: string; abort: AbortController } | undefined;
+	#bytes = 0;
+	constructor(binding: () => AttachmentBinding) { this.#binding = binding; }
+
+	/** Cancel both pending publication and ready receipts. Late worker output cannot recreate either. */
+	cancel(preparationId: string): { cancelled: boolean } {
+		let cancelled = false;
+		if (this.#pending?.preparationId === preparationId) { this.#pending.abort.abort(); cancelled = true; }
+		for (const [id, staged] of this.#receipts) {
+			if (staged.receipt.preparationId !== preparationId) continue;
+			if (staged.reserved) throw new Error("ATTACHMENT_ALREADY_RESERVED");
+			this.#receipts.delete(id); this.#bytes -= staged.bytes; cancelled = true;
+		}
+		return { cancelled };
+	}
+
+	async prepare(draft: AttachmentDraft): Promise<AttachmentReceipt> {
+		const binding = structuredClone(this.#binding());
+		this.#prune();
+		if (this.#pending) throw new Error("ATTACHMENT_PREPARATION_BUSY");
+		this.#validateDraft(draft);
+		if (this.#receipts.size >= ATTACHMENT_LIMITS.receipts) throw new Error("ATTACHMENT_RECEIPT_BUDGET");
+		const pending = { preparationId: draft.preparationId, draftId: draft.draftId, abort: new AbortController() };
+		this.#pending = pending;
+		const timer: Timer = setTimeout(() => pending.abort.abort(), ATTACHMENT_LIMITS.inputMs);
+		try {
+			const items: AttachmentPreparedItem[] = [];
+			for (const original of draft.objects) items.push(await this.#prepareItem(original, binding, pending.abort.signal));
+			if (pending.abort.signal.aborted) throw new Error("ATTACHMENT_CANCELLED");
+			if (JSON.stringify(binding) !== JSON.stringify(this.#binding())) throw new Error("ATTACHMENT_CONTEXT_CHANGED");
+			const expiresAt = Date.now() + ATTACHMENT_LIMITS.receiptMs;
+			const base = { version: "attachment-preparation-v1" as const, budgetVersion: ATTACHMENT_BUDGET_VERSION,
+				receiptId: crypto.randomUUID(), preparationId: draft.preparationId, draftId: draft.draftId,
+				draftRevision: draft.draftRevision, authorityGeneration: draft.authorityGeneration,
+				draftFingerprint: sha256(JSON.stringify(draft)), binding, expiresAt,
+				status: items.every(item => item.status === "ready") ? "ready" as const : "failed" as const, items };
+			const receipt: AttachmentReceipt = { ...base, resultDigest: sha256(JSON.stringify(base)) };
+			const bytes = Buffer.byteLength(JSON.stringify(receipt));
+			if (bytes > ATTACHMENT_LIMITS.preparedBytes || this.#bytes + bytes > ATTACHMENT_LIMITS.stagedBytes) {
+				throw new Error("ATTACHMENT_PREPARED_BUDGET");
+			}
+			this.#receipts.set(receipt.receiptId, { receipt, message: draft.message, bytes, reserved: undefined });
+			this.#bytes += bytes;
+			return structuredClone(receipt);
+		} finally {
+			clearTimeout(timer);
+			if (this.#pending === pending) this.#pending = undefined;
+		}
+	}
+
+	validateAndFreeze(consent: AttachmentConsent): PreparedSubmission {
+		this.#prune();
+		const staged = this.#receipts.get(consent.receiptId);
+		if (!staged) throw new Error("ATTACHMENT_RECEIPT_STALE");
+		if (staged.receipt.status !== "ready") throw new Error("ATTACHMENT_NOT_READY");
+		if (JSON.stringify(staged.receipt.binding) !== JSON.stringify(this.#binding())) throw new Error("ATTACHMENT_CONTEXT_CHANGED");
+		if (staged.receipt.resultDigest !== consent.resultDigest || staged.receipt.draftRevision !== consent.draftRevision ||
+			staged.receipt.authorityGeneration !== consent.authorityGeneration ||
+			staged.receipt.budgetVersion !== ATTACHMENT_BUDGET_VERSION) throw new Error("ATTACHMENT_CONSENT_STALE");
+		const required = new Set(staged.receipt.items.flatMap(item => item.status === "ready" ? item.degradations : []));
+		if ([...required].some(code => !consent.acceptedDegradations.includes(code)) ||
+			consent.acceptedDegradations.some(code => !required.has(code))) {
+			throw new Error("ATTACHMENT_DEGRADATION_CONSENT_REQUIRED");
+		}
+		const images: ImageContent[] = [];
+		const companionMessages: FileMentionMessage[] = [];
+		const attachments: PreparedAttachmentLink[] = [];
+		for (const item of staged.receipt.items) {
+			if (item.status !== "ready") throw new Error("ATTACHMENT_NOT_READY");
+			const representation = item.representation;
+			attachments.push({ originalId: item.originalId, originalSha256: item.originalSha256,
+				preparedId: item.preparedId, preparedSha256: item.preparedSha256, representationKind: representation.kind });
+			if (representation.kind === "image") images.push({ type: "image", data: representation.data, mimeType: representation.mimeType });
+			else companionMessages.push({ role: "fileMention", timestamp: Date.now(), files: [{
+				path: `attachment-prepared://${item.preparedId}`, content: representation.text,
+				byteSize: Buffer.byteLength(representation.text),
+			}] });
+		}
+		return { message: staged.message, images, companionMessages,
+			preparationDigest: staged.receipt.resultDigest, attachments };
+	}
+
+	#validateDraft(draft: AttachmentDraft): void {
+		if (draft.objects.length < 1 || draft.objects.length > ATTACHMENT_LIMITS.objects ||
+			Buffer.byteLength(draft.message) > ATTACHMENT_LIMITS.messageBytes) throw new Error("ATTACHMENT_INPUT_BUDGET");
+		if (Buffer.byteLength(JSON.stringify({ id: "x".repeat(96), type: "attachment_prepare", ...draft })) + 1 >
+			ATTACHMENT_LIMITS.rpcBytes) throw new Error("ATTACHMENT_RPC_BUDGET");
+		let bytes = 0;
+		const ids = new Set<string>();
+		for (const object of draft.objects) {
+			if (!/^[A-Za-z0-9_-]{1,96}$/.test(object.originalId) || ids.has(object.originalId) ||
+				!/^[a-f0-9]{64}$/.test(object.sha256)) throw new Error("ATTACHMENT_OBJECT_INVALID");
+			ids.add(object.originalId);
+			bytes += Math.floor(object.data.length / 4) * 3;
+		}
+		if (bytes > ATTACHMENT_LIMITS.originalBytes + draft.objects.length * 2) throw new Error("ATTACHMENT_INPUT_BUDGET");
+	}
+
+	async #prepareItem(original: ControlledOriginal, binding: AttachmentBinding, signal: AbortSignal): Promise<AttachmentPreparedItem> {
+		const failed = (code: string): AttachmentPreparedItem => ({ originalId: original.originalId,
+			originalSha256: original.sha256, preparedId: crypto.randomUUID(), preparedSha256: "", status: "failed", code });
+		const decoded = decodeBase64ImageData(original.data);
+		if (decoded.reason) return failed("attachment_invalid_base64");
+		if (sha256(decoded.bytes) !== original.sha256) return failed("attachment_original_changed");
+		const image = ["png", "jpeg", "webp", "gif"].includes(original.format);
+		if (image && !binding.imageCapable) return failed("attachment_target_has_no_image_input");
+		const result = await prepareAttachmentIsolated({ format: original.format, bytes: decoded.bytes }, signal);
+		return { ...result, originalId: original.originalId, originalSha256: original.sha256,
+			preparedId: crypto.randomUUID(), preparedSha256: result.status === "ready" ? sha256(JSON.stringify(result.representation)) : "" };
+	}
+
+	#prune(): void {
+		for (const [id, value] of this.#receipts) {
+			if (value.receipt.expiresAt > Date.now()) continue;
+			this.#receipts.delete(id); this.#bytes -= value.bytes;
+		}
+	}
+}
