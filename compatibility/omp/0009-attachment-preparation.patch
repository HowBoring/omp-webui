+/** Container facts used before image decode. Frame data is never treated as a trusted allocation size. */
+export interface ImageAnimation { frames: number; animated: boolean; decodedBytesPerPixel: number }
+
+function gifFrames(bytes: Uint8Array): number {
+	if (bytes.length < 14) throw new Error("Invalid GIF");
+	const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+	const canvasWidth = view.getUint16(6, true), canvasHeight = view.getUint16(8, true);
+	let offset = 13 + ((bytes[10] & 0x80) ? 3 * 2 ** ((bytes[10] & 7) + 1) : 0);
+	let frames = 0;
+	const blocks = (): void => {
+		for (;;) {
+			if (offset >= bytes.length) throw new Error("Truncated GIF blocks");
+			const count = bytes[offset++];
+			if (count === 0) return;
+			offset += count;
+			if (offset > bytes.length) throw new Error("Truncated GIF block");
+		}
+	};
+	while (offset < bytes.length) {
+		const marker = bytes[offset++];
+		if (marker === 0x3b && frames > 0) return frames;
+		if (marker === 0x21) { offset++; blocks(); continue; }
+		if (marker !== 0x2c || offset + 9 > bytes.length) throw new Error("Invalid GIF frame");
+		const left = view.getUint16(offset, true), top = view.getUint16(offset + 2, true);
+		const width = view.getUint16(offset + 4, true), height = view.getUint16(offset + 6, true);
+		if (!width || !height || left + width > canvasWidth || top + height > canvasHeight) {
+			throw new Error("Invalid GIF frame bounds");
+		}
+		const flags = bytes[offset + 8];
+		offset += 9 + ((flags & 0x80) ? 3 * 2 ** ((flags & 7) + 1) : 0);
+		offset++; // LZW minimum code size.
+		blocks();
+		frames++;
+	}
+	throw new Error("Missing GIF trailer");
+}
+
+/** Count declared/contained frames without decoding. Full image decoding remains a separate required check. */
+export function imageAnimation(bytes: Uint8Array, mimeType: string, bounds?: { width: number; height: number }): ImageAnimation {
+	let frames = 1;
+	let decodedBytesPerPixel = 4;
+	const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+	if (mimeType === "image/gif") frames = gifFrames(bytes);
+	if (mimeType === "image/png") {
+		if (bytes.length < 33) throw new Error("Truncated PNG header");
+		decodedBytesPerPixel = bytes[24] === 16 ? 8 : 4;
+		const width = view.getUint32(16), height = view.getUint32(20);
+		let declared: number | undefined, controls = 0, sequence = 0;
+		let imageData = false, defaultImage = false, ended = false;
+		for (let offset = 8; offset + 12 <= bytes.length;) {
+			const length = view.getUint32(offset);
+			if (offset + 12 + length > bytes.length) throw new Error("Truncated PNG chunk");
+			const type = String.fromCharCode(...bytes.subarray(offset + 4, offset + 8));
+			if (type === "acTL") {
+				if (length !== 8 || declared !== undefined || imageData) throw new Error("Invalid APNG control");
+				declared = view.getUint32(offset + 8);
+				if (declared < 1) throw new Error("Invalid APNG frame count");
+			}
+			if (type === "fcTL") {
+				if (length !== 26 || declared === undefined || view.getUint32(offset + 8) !== sequence++) throw new Error("Invalid APNG frame control");
+				const frameWidth = view.getUint32(offset + 12), frameHeight = view.getUint32(offset + 16);
+				if (!frameWidth || !frameHeight || view.getUint32(offset + 20) + frameWidth > width ||
+					view.getUint32(offset + 24) + frameHeight > height) throw new Error("Invalid APNG frame bounds");
+				controls++;
+			}
+			if (type === "fdAT" && (length < 4 || controls < 1 || view.getUint32(offset + 8) !== sequence++)) throw new Error("Invalid APNG frame data");
+			if (type === "IDAT") { if (!imageData && !controls) defaultImage = true; imageData = true; }
+			if (type === "IEND") {
+				if (length !== 0 || offset + 12 !== bytes.length) throw new Error("Invalid PNG trailer");
+				ended = true;
+			}
+			offset += 12 + length;
+		}
+		if (!ended || (declared !== undefined && controls !== declared)) throw new Error("Invalid APNG frame count");
+		frames = declared === undefined ? 1 : declared + (defaultImage ? 1 : 0);
+	}
+	if (mimeType === "image/webp") {
+		if (bytes.length < 12 || view.getUint32(4, true) + 8 !== bytes.length) throw new Error("Invalid WebP container size");
+		frames = 0;
+		const uint24 = (offset: number): number => bytes[offset] + 256 * bytes[offset + 1] + 65536 * bytes[offset + 2];
+		for (let offset = 12; offset + 8 <= bytes.length;) {
+			const length = view.getUint32(offset + 4, true);
+			if (offset + 8 + length + (length & 1) > bytes.length) throw new Error("Truncated WebP chunk");
+			if (String.fromCharCode(...bytes.subarray(offset, offset + 4)) === "ANMF") {
+				if (length < 16 || !bounds || uint24(offset + 8) * 2 + uint24(offset + 14) + 1 > bounds.width ||
+					uint24(offset + 11) * 2 + uint24(offset + 17) + 1 > bounds.height) throw new Error("Invalid WebP frame bounds");
+				frames++;
+			}
+			offset += 8 + length + (length & 1);
+		}
+		frames ||= 1;
+	}
+	if (frames < 1) throw new Error("Invalid animation frame count");
+	return { frames, animated: frames > 1, decodedBytesPerPixel };
+}
