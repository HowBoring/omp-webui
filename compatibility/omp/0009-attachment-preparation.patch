@@ -0,0 +1,15 @@
+import type { Model } from "@oh-my-pi/pi-ai";
+import { sendsImageInputOnWire } from "@oh-my-pi/pi-ai/providers/vision-guard";
+import { ATTACHMENT_BUDGET_VERSION } from "./limits";
+
+export interface AttachmentImagePolicy { blocked: boolean; urls: boolean }
+
+/** Bind effective wire modality and normalization settings; model IDs alone do not establish compatibility. */
+export function attachmentModelFingerprint(model: Model | undefined, policy: AttachmentImagePolicy): string {
+	return Bun.SHA256.hash(JSON.stringify({ model, policy, imageWire: model ? sendsImageInputOnWire(model) : false,
+		budgetVersion: ATTACHMENT_BUDGET_VERSION, normalization: "inline-png-jpeg-v1" }), "hex");
+}
+
+export function attachmentImageCapable(model: Model | undefined, policy: AttachmentImagePolicy): boolean {
+	return model !== undefined && sendsImageInputOnWire(model) && !policy.blocked && !policy.urls;
+}
diff --git a/packages/coding-agent/src/attachments/package.ts b/packages/coding-agent/src/attachments/package.ts
