new file mode 100644
index 0000000000..cfdd941f9e
--- /dev/null
+++ b/packages/coding-agent/src/attachments/validation.ts
@@ -0,0 +1,43 @@
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import { MAX_PREPARED_ENTRY_PART_INDEX } from "./entry-parts";
+import type { PreparedAttachmentLink } from "./receipts";
+
+const identity = (value: unknown): value is string => typeof value === "string" && /^[A-Za-z0-9_-]{1,96}$/.test(value);
+const digest = (value: unknown): value is string => typeof value === "string" && /^[a-f0-9]{64}$/.test(value);
+
+function validEntryPart(value: unknown): boolean {
+	return isRecord(value) && Object.keys(value).every(key => ["kind", "index"].includes(key))
+		&& (value.kind === "content" || value.kind === "files") && typeof value.index === "number"
+		&& Number.isSafeInteger(value.index) && value.index >= 0 && value.index <= MAX_PREPARED_ENTRY_PART_INDEX;
+}
+/** Pure native persisted-metadata validation; object/content hashes convey no read authority. */
+export function validPreparedLinks(value: unknown): value is PreparedAttachmentLink[] {
+	return Array.isArray(value) && value.length <= 8 && value.every(link => isRecord(link) &&
+		identity(link.originalId) && identity(link.preparedId) && digest(link.originalSha256) && digest(link.preparedSha256) &&
+		(link.representationKind === "text" || link.representationKind === "image") &&
+		(link.entryPart === undefined || (validEntryPart(link.entryPart) && link.entryPartUnavailable === undefined &&
+			isRecord(link.entryPart) && link.entryPart.kind === (link.representationKind === "text" ? "files" : "content"))) &&
+		(link.entryPartUnavailable === undefined || (typeof link.entryPartUnavailable === "string" &&
+			["missing", "changed", "ambiguous"].includes(link.entryPartUnavailable))) &&
+		Object.keys(link).every(key => ["originalId", "preparedId", "originalSha256", "preparedSha256", "representationKind", "entryPart", "entryPartUnavailable"].includes(key)));
+}
+
+export function validNativePreparation(value: unknown): boolean {
+	return isRecord(value) && identity(value.receiptId) && digest(value.resultDigest) && identity(value.draftRevision) &&
+		identity(value.authorityGeneration) && Array.isArray(value.acceptedDegradations) && value.acceptedDegradations.length <= 16 &&
+		value.acceptedDegradations.every(code => typeof code === "string" && /^[a-z_]{1,64}$/.test(code)) &&
+		validPreparedLinks(value.attachments) && value.attachments.every(link => link.entryPart === undefined && link.entryPartUnavailable === undefined);
+}
+
+/** Permanent native facts retain exact ordered attachment identities and any earned persisted locator. */
+export function samePreparedLinks(left: readonly PreparedAttachmentLink[] | undefined,
+	right: readonly PreparedAttachmentLink[] | undefined): boolean {
+	if (left === undefined || right === undefined) return left === right;
+	return left.length === right.length && left.every((link, index) => {
+		const next = right[index];
+		return link.originalId === next.originalId && link.preparedId === next.preparedId
+			&& link.originalSha256 === next.originalSha256 && link.preparedSha256 === next.preparedSha256
+			&& link.representationKind === next.representationKind && link.entryPart?.kind === next.entryPart?.kind
+			&& link.entryPart?.index === next.entryPart?.index && link.entryPartUnavailable === next.entryPartUnavailable;
+	});
+}
diff --git a/packages/coding-agent/src/attachments/worker.ts b/packages/coding-agent/src/attachments/worker.ts
new file mode 100644
index 0000000000..bf5c42685d
--- /dev/null
+++ b/packages/coding-agent/src/attachments/worker.ts
@@ -0,0 +1,27 @@
+import "./deny-network";
+import { readStreamBounded } from "@oh-my-pi/pi-utils/stream";
+import { prepareAttachment } from "./prepare";
+import type { AttachmentFormat } from "./prepare";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+/** Private process selector: inline bytes only, no filename/path read capability. */
+export async function runAttachmentWorker(format: AttachmentFormat): Promise<void> {
+	try {
+		const bytes = await readStreamBounded(Bun.stdin.stream(), ATTACHMENT_LIMITS.imageBytes);
+		const result = await prepareAttachment({ format, bytes });
+		await Bun.stdout.write(JSON.stringify(result));
+	} catch {
+		await Bun.stdout.write(JSON.stringify({ status: "failed", code: "attachment_converter_error" }));
+	}
+}
+
+export function isAttachmentFormat(value: unknown): value is AttachmentFormat {
+	return typeof value === "string" && ["utf8", "png", "jpeg", "webp", "gif", "pdf", "docx", "pptx", "xlsx", "epub"].includes(value);
+}
+
+if (import.meta.main) {
+	const format = process.argv[2];
+	if (!isAttachmentFormat(format)) {
+		process.exitCode = 2;
+	} else await runAttachmentWorker(format);
+}
