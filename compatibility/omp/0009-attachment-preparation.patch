index 0000000000..54f185280a
--- /dev/null
+++ b/packages/coding-agent/src/attachments/entry-parts.ts
@@ -0,0 +1,57 @@
+/** Native persisted-body locators earned from the actual staged part object, never content matching. */
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import type { SubmissionCausality } from "../session/submission-provenance";
+import type { PreparedAttachmentLink } from "./receipts";
+
+export interface PreparedEntryPart { kind: "content" | "files"; index: number }
+export const MAX_PREPARED_ENTRY_PART_INDEX = 65_535;
+interface PartOrigin { link: PreparedAttachmentLink; baseline: string }
+const parts = new WeakMap<object, PartOrigin>();
+function representation(part: unknown, kind: PreparedAttachmentLink["representationKind"]): string | undefined {
+	if (!isRecord(part)) return;
+	if (kind === "text") return typeof part.content === "string" ? JSON.stringify({ content: part.content }) : undefined;
+	return part.type === "image" && typeof part.data === "string" && typeof part.mimeType === "string"
+		? JSON.stringify({ type: "image", data: part.data, mimeType: part.mimeType }) : undefined;
+}
+/** Only the native receipt freezer may establish this association on its newly created exact wire part. */
+export function stagePreparedEntryPart(part: object, link: PreparedAttachmentLink): void {
+	const baseline = representation(part, link.representationKind);
+	if (baseline === undefined) throw new Error("ATTACHMENT_REPRESENTATION_CHANGED");
+	parts.set(part, { link: structuredClone(link), baseline });
+}
+/** Explicit native construction/clone carrier; extension replacements cannot establish this identity. */
+export function copyPreparedEntryPart(source: object, target: object): void {
+	const origin = parts.get(source); if (origin) parts.set(target, origin);
+}
+interface Candidate { part: object; locator: PreparedEntryPart; origin: PartOrigin }
+function candidates(body: unknown): Candidate[] {
+	if (!isRecord(body)) return [];
+	const result: Candidate[] = [];
+	for (const kind of ["content", "files"] as const) {
+		const values = body[kind]; if (!Array.isArray(values)) continue;
+		for (let index = 0; index < Math.min(values.length, MAX_PREPARED_ENTRY_PART_INDEX + 1); index++) {
+			const part: unknown = values[index]; if (!isRecord(part)) continue;
+			const origin = parts.get(part); if (!origin) continue;
+			result.push({ part, locator: { kind, index }, origin });
+		}
+	}
+	return result;
+}
+/** Called at final persisted-message construction, after all native filtering/normalization. Missing parts stay explicit. */
+export function locatePreparedEntryParts(cause: SubmissionCausality | undefined, body: unknown): SubmissionCausality | undefined {
+	if (!cause?.attachments?.length) return cause;
+	const actual = candidates(body);
+	const attachments = cause.attachments.map(link => {
+		const { entryPart: _oldPart, entryPartUnavailable: _oldUnavailable, ...manifest } = link;
+		const found = actual.filter(value => value.origin.link.preparedId === link.preparedId);
+		if (found.length !== 1) return { ...manifest, entryPartUnavailable: found.length ? "ambiguous" as const : "missing" as const };
+		const value = found[0];
+		if (JSON.stringify(value.origin.link) !== JSON.stringify(manifest)
+			|| representation(value.part, link.representationKind) !== value.origin.baseline
+			|| value.locator.kind !== (link.representationKind === "text" ? "files" : "content")) {
+			return { ...manifest, entryPartUnavailable: "changed" as const };
+		}
+		return { ...manifest, entryPart: value.locator };
+	});
+	return { ...cause, attachments };
+}
