+/** Prepared inputs use the proved idle main-prompt path. Other native input kinds keep their existing behavior. */
+export const attachmentInputPolicy = Object.freeze({
+	version: "attachment-input-policy-v1" as const, supportedInputKinds: ["prompt"] as const,
+	requiresIdle: true as const, supportsStreamingBehavior: false as const,
+});
+
+/** Called before receipt claim/reservation, and again before ordered ingress side effects. */
+export function assertPreparedInputPolicy(inputType: string, busy: boolean, streamingBehavior?: string): void {
+	if (inputType !== "prompt" || streamingBehavior !== undefined) throw new Error("ATTACHMENT_INPUT_KIND_UNSUPPORTED");
+	if (busy) throw new Error("ATTACHMENT_BUSY_UNSUPPORTED");
+}
diff --git a/packages/coding-agent/src/attachments/isolated.ts b/packages/coding-agent/src/attachments/isolated.ts
new file mode 100644
index 0000000000..d016c77260
--- /dev/null
+++ b/packages/coding-agent/src/attachments/isolated.ts
@@ -0,0 +1,64 @@
+import type { AttachmentInput, AttachmentPreparation } from "./prepare";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import * as os from "node:os";
+import { workerHostEntry } from "@oh-my-pi/pi-utils/worker-host";
+import { readStreamBounded } from "@oh-my-pi/pi-utils/stream";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+function isPreparation(value: unknown): value is AttachmentPreparation {
+	if (!value || typeof value !== "object") return false;
+	if ("status" in value && value.status === "failed") return "code" in value && typeof value.code === "string";
+	if (!("status" in value) || value.status !== "ready" || !("degradations" in value) ||
+		!Array.isArray(value.degradations) || !value.degradations.every(code => typeof code === "string") ||
+		!("representation" in value) || !value.representation || typeof value.representation !== "object") return false;
+	const representation = value.representation;
+	if (!("kind" in representation)) return false;
+	if (representation.kind === "text") return "text" in representation && typeof representation.text === "string";
+	return representation.kind === "image" && "data" in representation && typeof representation.data === "string" &&
+		"mimeType" in representation && typeof representation.mimeType === "string" &&
+		"width" in representation && typeof representation.width === "number" &&
+		"height" in representation && typeof representation.height === "number";
+}
+
+/** Runs conversion in an owned, cancellable process; cancelled inputs never produce a usable representation. */
+export async function prepareAttachmentIsolated(input: AttachmentInput, signal?: AbortSignal): Promise<AttachmentPreparation> {
+	if (signal?.aborted) return { status: "failed", code: "attachment_cancelled" };
+	if (process.platform !== "linux" || !await Bun.file("/usr/bin/prlimit").exists()) {
+		return { status: "failed", code: "attachment_converter_unavailable" };
+	}
+	const profile = await fs.mkdtemp(path.join(os.tmpdir(), "omp-preparation-"));
+	const host = workerHostEntry();
+	const argv = host ? [host, "__omp_worker_attachment", input.format]
+		: [new URL("./worker.ts", import.meta.url).pathname, input.format];
+	const child = Bun.spawn(["/usr/bin/prlimit", `--data=${ATTACHMENT_LIMITS.conversionDataBytes}`,
+		`--cpu=${ATTACHMENT_LIMITS.conversionCpuSeconds}`, "--core=0", "--fsize=0", "--", process.execPath,
+		"--no-env-file", ...argv], {
+		stdin: input.bytes, stdout: "pipe", stderr: "pipe", cwd: profile,
+		env: { PATH: "/usr/bin:/bin", HOME: profile, PI_CODING_AGENT_DIR: profile, TMPDIR: profile,
+			OMP_OFFLINE: "1", NO_COLOR: "1", TERM: "dumb" },
+	});
+	let timedOut = false;
+	const abort = (): void => { child.kill("SIGKILL"); };
+	const timer: Timer = setTimeout(() => { timedOut = true; abort(); }, ATTACHMENT_LIMITS.conversionMs);
+	signal?.addEventListener("abort", abort, { once: true });
+	try {
+		if (signal?.aborted) abort();
+		const [output] = await Promise.all([
+			readStreamBounded(child.stdout, ATTACHMENT_LIMITS.convertedBytes).catch(error => { abort(); throw error; }),
+			readStreamBounded(child.stderr, 16 * 1024).catch(error => { abort(); throw error; }),
+		]);
+		const code = await child.exited;
+		if (signal?.aborted) return { status: "failed", code: "attachment_cancelled" };
+		if (timedOut) return { status: "failed", code: "attachment_conversion_timeout" };
+		if (code !== 0) return { status: "failed", code: "attachment_converter_resource_failure" };
+		const result: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(output));
+		return isPreparation(result) ? result : { status: "failed", code: "attachment_converter_protocol" };
+	} catch {
+		return { status: "failed", code: signal?.aborted ? "attachment_cancelled" : "attachment_converter_resource_failure" };
+	} finally {
+		clearTimeout(timer); signal?.removeEventListener("abort", abort);
+		abort(); await child.exited;
+		await fs.rm(profile, { recursive: true, force: true });
+	}
+}
