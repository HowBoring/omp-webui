index 0000000000..811404f310
--- /dev/null
+++ b/packages/coding-agent/src/attachments/deny-network.ts
@@ -0,0 +1,24 @@
+/** Preparation helper only. Installed before native converter imports; it owns no Agent or provider credentials. */
+import http from "node:http";
+import https from "node:https";
+import http2 from "node:http2";
+import net from "node:net";
+import tls from "node:tls";
+import dgram from "node:dgram";
+import { syncBuiltinESMExports } from "node:module";
+
+const deny = (): never => { throw new Error("ATTACHMENT_NETWORK_FORBIDDEN"); };
+globalThis.fetch = Object.assign(deny, { preconnect: deny });
+globalThis.WebSocket = class { constructor() { deny(); } } as unknown as typeof WebSocket;
+http.request = deny;
+http.get = deny;
+https.request = deny;
+https.get = deny;
+http2.connect = deny;
+net.Socket.prototype.connect = deny;
+net.connect = deny;
+net.createConnection = deny;
+tls.connect = deny;
+dgram.createSocket = deny;
+Bun.connect = deny;
+syncBuiltinESMExports();
diff --git a/packages/coding-agent/src/attachments/document.ts b/packages/coding-agent/src/attachments/document.ts
new file mode 100644
index 0000000000..feaa94b3f9
--- /dev/null
+++ b/packages/coding-agent/src/attachments/document.ts
@@ -0,0 +1,53 @@
+import { openArchive } from "@oh-my-pi/pi-utils/ar";
+import { Markit } from "../markit/registry";
+import type { AttachmentInput, AttachmentPreparation } from "./prepare";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+/** Check package identity and all declared expansion before an engine can allocate member content. */
+async function validatePackage(input: AttachmentInput): Promise<void> {
+	const archive = await openArchive({ bytes: input.bytes, format: "zip" }, { limits: {
+		maxEntries: ATTACHMENT_LIMITS.archiveEntries, maxInMemorySize: ATTACHMENT_LIMITS.archiveBytes,
+		maxMemberSize: ATTACHMENT_LIMITS.archiveMemberBytes, maxIndexSize: ATTACHMENT_LIMITS.archiveIndexBytes,
+		maxPathBytes: ATTACHMENT_LIMITS.archivePathBytes, maxLinkDepth: 0,
+	} });
+	let total = 0;
+	for (const entry of archive.indexEntries()) {
+		if (entry.storage?.type === "link") throw new Error("attachment_archive_link");
+		total += entry.size;
+		if (total > ATTACHMENT_LIMITS.archiveBytes) throw new Error("attachment_archive_budget");
+	}
+	const required: Record<string, string> = { docx: "word/document.xml", pptx: "ppt/presentation.xml",
+		xlsx: "xl/workbook.xml", epub: "META-INF/container.xml" };
+	if (!archive.getNode(required[input.format])) throw new Error("attachment_format_mismatch");
+	if (input.format !== "epub" && !archive.getNode("[Content_Types].xml")) throw new Error("attachment_format_mismatch");
+	if (input.format === "epub") {
+		const type = await archive.readFile("mimetype");
+		if (new TextDecoder("utf-8", { fatal: true }).decode(type.bytes) !== "application/epub+zip") {
+			throw new Error("attachment_format_mismatch");
+		}
+	}
+}
+
+/** Uses native converter engines without shared caches, image extraction or executable/user paths. */
+export async function convertAttachmentDocument(input: AttachmentInput): Promise<AttachmentPreparation> {
+	try {
+		if (input.format === "pdf") {
+			if (new TextDecoder().decode(input.bytes.subarray(0, 5)) !== "%PDF-") {
+				return { status: "failed", code: "attachment_format_mismatch" };
+			}
+		} else await validatePackage(input);
+		const result = await new Markit().convert(Buffer.from(input.bytes), { extension: `.${input.format}` });
+		if (!result.markdown.trim()) return { status: "failed", code: "attachment_conversion_empty" };
+		if (Buffer.byteLength(result.markdown) > ATTACHMENT_LIMITS.convertedBytes) {
+			return { status: "failed", code: "attachment_conversion_output_budget" };
+		}
+		const degradations = ["document_structure_changed"];
+		if (result.facts?.pagesNeedingOcr?.length) degradations.push("pdf_ocr_required");
+		if (result.facts?.hasEncodingIssues) degradations.push("pdf_encoding_issues");
+		if (result.facts?.emptyText) degradations.push("document_no_extractable_text");
+		if (result.facts?.omittedImages) degradations.push("document_images_omitted");
+		return { status: "ready", representation: { kind: "text", text: result.markdown }, degradations };
+	} catch {
+		return { status: "failed", code: "attachment_conversion_failed" };
+	}
+}
diff --git a/packages/coding-agent/src/attachments/isolated.ts b/packages/coding-agent/src/attachments/isolated.ts
new file mode 100644
index 0000000000..d016c77260
--- /dev/null
+++ b/packages/coding-agent/src/attachments/isolated.ts
@@ -0,0 +1,64 @@
+import type { AttachmentInput, AttachmentPreparation } from "./prepare";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import * as os from "node:os";
+import { workerHostEntry } from "@oh-my-pi/pi-utils/worker-host";
+import { readStreamBounded } from "@oh-my-pi/pi-utils/stream";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+function isPreparation(value: unknown): value is AttachmentPreparation {
+	if (!value || typeof value !== "object") return false;
+	if ("status" in value && value.status === "failed") return "code" in value && typeof value.code === "string";
+	if (!("status" in value) || value.status !== "ready" || !("degradations" in value) ||
+		!Array.isArray(value.degradations) || !value.degradations.every(code => typeof code === "string") ||
+		!("representation" in value) || !value.representation || typeof value.representation !== "object") return false;
+	const representation = value.representation;
+	if (!("kind" in representation)) return false;
+	if (representation.kind === "text") return "text" in representation && typeof representation.text === "string";
+	return representation.kind === "image" && "data" in representation && typeof representation.data === "string" &&
+		"mimeType" in representation && typeof representation.mimeType === "string" &&
+		"width" in representation && typeof representation.width === "number" &&
+		"height" in representation && typeof representation.height === "number";
+}
+
+/** Runs conversion in an owned, cancellable process; cancelled inputs never produce a usable representation. */
+export async function prepareAttachmentIsolated(input: AttachmentInput, signal?: AbortSignal): Promise<AttachmentPreparation> {
+	if (signal?.aborted) return { status: "failed", code: "attachment_cancelled" };
+	if (process.platform !== "linux" || !await Bun.file("/usr/bin/prlimit").exists()) {
+		return { status: "failed", code: "attachment_converter_unavailable" };
+	}
+	const profile = await fs.mkdtemp(path.join(os.tmpdir(), "omp-preparation-"));
+	const host = workerHostEntry();
+	const argv = host ? [host, "__omp_worker_attachment", input.format]
+		: [new URL("./worker.ts", import.meta.url).pathname, input.format];
+	const child = Bun.spawn(["/usr/bin/prlimit", `--data=${ATTACHMENT_LIMITS.conversionDataBytes}`,
+		`--cpu=${ATTACHMENT_LIMITS.conversionCpuSeconds}`, "--core=0", "--fsize=0", "--", process.execPath,
+		"--no-env-file", ...argv], {
+		stdin: input.bytes, stdout: "pipe", stderr: "pipe", cwd: profile,
+		env: { PATH: "/usr/bin:/bin", HOME: profile, PI_CODING_AGENT_DIR: profile, TMPDIR: profile,
+			OMP_OFFLINE: "1", NO_COLOR: "1", TERM: "dumb" },
+	});
+	let timedOut = false;
+	const abort = (): void => { child.kill("SIGKILL"); };
+	const timer: Timer = setTimeout(() => { timedOut = true; abort(); }, ATTACHMENT_LIMITS.conversionMs);
+	signal?.addEventListener("abort", abort, { once: true });
+	try {
+		if (signal?.aborted) abort();
+		const [output] = await Promise.all([
+			readStreamBounded(child.stdout, ATTACHMENT_LIMITS.convertedBytes).catch(error => { abort(); throw error; }),
+			readStreamBounded(child.stderr, 16 * 1024).catch(error => { abort(); throw error; }),
+		]);
+		const code = await child.exited;
+		if (signal?.aborted) return { status: "failed", code: "attachment_cancelled" };
+		if (timedOut) return { status: "failed", code: "attachment_conversion_timeout" };
+		if (code !== 0) return { status: "failed", code: "attachment_converter_resource_failure" };
+		const result: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(output));
+		return isPreparation(result) ? result : { status: "failed", code: "attachment_converter_protocol" };
+	} catch {
+		return { status: "failed", code: signal?.aborted ? "attachment_cancelled" : "attachment_converter_resource_failure" };
+	} finally {
+		clearTimeout(timer); signal?.removeEventListener("abort", abort);
+		abort(); await child.exited;
+		await fs.rm(profile, { recursive: true, force: true });
+	}
+}
diff --git a/packages/coding-agent/src/attachments/limits.ts b/packages/coding-agent/src/attachments/limits.ts
new file mode 100644
