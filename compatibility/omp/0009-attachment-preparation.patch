+/** Preparation helper only. Installed before native converter imports; it owns no Agent or provider credentials. */
+import http from "node:http";
+import https from "node:https";
+import http2 from "node:http2";
+import net from "node:net";
+import tls from "node:tls";
+import dgram from "node:dgram";
+import { syncBuiltinESMExports } from "node:module";
+
+const deny = (): never => { throw new Error("ATTACHMENT_NETWORK_FORBIDDEN"); };
+globalThis.fetch = Object.assign(deny, { preconnect: deny });
+globalThis.WebSocket = class { constructor() { deny(); } } as unknown as typeof WebSocket;
+http.request = deny;
+http.get = deny;
+https.request = deny;
+https.get = deny;
+http2.connect = deny;
+net.Socket.prototype.connect = deny;
+net.connect = deny;
+net.createConnection = deny;
+tls.connect = deny;
+dgram.createSocket = deny;
+Bun.connect = deny;
+syncBuiltinESMExports();
diff --git a/packages/coding-agent/src/attachments/document.ts b/packages/coding-agent/src/attachments/document.ts
new file mode 100644
index 0000000000..55984966c4
--- /dev/null
+++ b/packages/coding-agent/src/attachments/document.ts
@@ -0,0 +1,31 @@
+import { validateAttachmentPackage } from "./package";
+import { Markit } from "../markit/registry";
+import type { AttachmentInput, AttachmentPreparation } from "./prepare";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+/** Uses native converter engines without shared caches, image extraction or executable/user paths. */
+export async function convertAttachmentDocument(input: AttachmentInput): Promise<AttachmentPreparation> {
+	try {
+		if (input.format === "pdf") {
+			if (new TextDecoder().decode(input.bytes.subarray(0, 5)) !== "%PDF-") {
+				return { status: "failed", code: "attachment_format_mismatch" };
+			}
+		} else await validateAttachmentPackage(input);
+		const result = await new Markit().convert(Buffer.from(input.bytes), { extension: `.${input.format}` });
+		if (!result.markdown.trim()) return { status: "failed", code: "attachment_conversion_empty" };
+		if (Buffer.byteLength(result.markdown) > ATTACHMENT_LIMITS.convertedBytes) {
+			return { status: "failed", code: "attachment_conversion_output_budget" };
+		}
+		const degradations = ["document_structure_changed"];
+		if (result.facts?.pagesNeedingOcr?.length) degradations.push("pdf_ocr_required");
+		if (result.facts?.hasEncodingIssues) degradations.push("pdf_encoding_issues");
+		if (result.facts?.emptyText) degradations.push("document_no_extractable_text");
+		if (result.facts?.omittedImages) degradations.push("document_images_omitted");
+		return { status: "ready", representation: { kind: "text", text: result.markdown }, degradations,
+			facts: { originalBytes: input.bytes.length, convertedBytes: Buffer.byteLength(result.markdown), ...result.facts } };
+	} catch (error) {
+		const code = error instanceof Error && /^attachment_[a-z_]+$/.test(error.message)
+			? error.message : "attachment_conversion_failed";
+		return { status: "failed", code };
+	}
+}
diff --git a/packages/coding-agent/src/attachments/entry-parts.ts b/packages/coding-agent/src/attachments/entry-parts.ts
