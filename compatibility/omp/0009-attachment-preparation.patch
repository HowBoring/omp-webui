index 0000000000..8b6a55f662
--- /dev/null
+++ b/packages/coding-agent/src/attachments/package.ts
@@ -0,0 +1,64 @@
+import { openArchive } from "@oh-my-pi/pi-utils/ar";
+import { XMLParser } from "@oh-my-pi/pi-utils/xml";
+import type { AttachmentInput } from "./prepare";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+interface ContentTypes { Types?: { "@_xmlns"?: string; Override?: { "@_PartName"?: string; "@_ContentType"?: string }[] | { "@_PartName"?: string; "@_ContentType"?: string } } }
+const packageTypes = {
+	docx: ["word/document.xml", "application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"],
+	pptx: ["ppt/presentation.xml", "application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml"],
+	xlsx: ["xl/workbook.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"],
+} as const;
+
+/** Reject unsupported encodings rather than consenting to silently replaced document text. */
+export function decodeAttachmentXml(bytes: Uint8Array): string {
+	let text: string;
+	try { text = new TextDecoder("utf-8", { fatal: true }).decode(bytes); }
+	catch { throw new Error("attachment_document_encoding_unsupported"); }
+	if (text.includes("\0") || /<\?xml\b[^>]*\bencoding\s*=\s*["'](?!utf-8["']|us-ascii["'])/i.test(text)) {
+		throw new Error("attachment_document_encoding_unsupported");
+	}
+	return text;
+}
+
+/** A ZIP signature or a conveniently named member alone cannot establish a selected Office format. */
+export function matchesAttachmentContentType(format: keyof typeof packageTypes, xml: string): boolean {
+	const parser = new XMLParser({ ignoreAttributes: false, processEntities: { maxTotalExpansions: 1000 } });
+	const root = (parser.parse(xml) as ContentTypes).Types;
+	if (root?.["@_xmlns"] !== "http://schemas.openxmlformats.org/package/2006/content-types") return false;
+	const overrides = root.Override ? Array.isArray(root.Override) ? root.Override : [root.Override] : [];
+	const [part, mimeType] = packageTypes[format];
+	return overrides.some(item => item["@_PartName"] === `/${part}` && item["@_ContentType"] === mimeType);
+}
+
+/** Check package identity, encoding and declared expansion before any engine can allocate its content. */
+export async function validateAttachmentPackage(input: AttachmentInput): Promise<void> {
+	const archive = await openArchive({ bytes: input.bytes, format: "zip" }, { limits: {
+		maxEntries: ATTACHMENT_LIMITS.archiveEntries, maxInMemorySize: ATTACHMENT_LIMITS.archiveBytes,
+		maxMemberSize: ATTACHMENT_LIMITS.archiveMemberBytes, maxIndexSize: ATTACHMENT_LIMITS.archiveIndexBytes,
+		maxPathBytes: ATTACHMENT_LIMITS.archivePathBytes, maxLinkDepth: 0,
+	} });
+	let total = 0;
+	for (const entry of archive.indexEntries()) {
+		if (entry.storage?.type === "link") throw new Error("attachment_archive_link");
+		total += entry.size;
+		if (total > ATTACHMENT_LIMITS.archiveBytes) throw new Error("attachment_archive_budget");
+	}
+	for (const entry of archive.indexEntries()) {
+		if (!entry.isDirectory && /\.(?:xml|rels|opf|xhtml|html)$/i.test(entry.path)) {
+			decodeAttachmentXml((await archive.readFile(entry.path)).bytes);
+		}
+	}
+	if (input.format === "epub") {
+		if (!archive.getNode("META-INF/container.xml") || !archive.getNode("mimetype") ||
+			decodeAttachmentXml((await archive.readFile("mimetype")).bytes) !== "application/epub+zip") {
+			throw new Error("attachment_format_mismatch");
+		}
+		return;
+	}
+	if (!(input.format === "docx" || input.format === "pptx" || input.format === "xlsx")) throw new Error("attachment_format_mismatch");
+	if (!archive.getNode(packageTypes[input.format][0]) || !archive.getNode("[Content_Types].xml") ||
+		!matchesAttachmentContentType(input.format, decodeAttachmentXml((await archive.readFile("[Content_Types].xml")).bytes))) {
+		throw new Error("attachment_format_mismatch");
+	}
+}
diff --git a/packages/coding-agent/src/attachments/prepare.ts b/packages/coding-agent/src/attachments/prepare.ts
new file mode 100644
index 0000000000..39b436297a
--- /dev/null
+++ b/packages/coding-agent/src/attachments/prepare.ts
@@ -0,0 +1,77 @@
+import { truncateHead, truncateHeadBytes } from "@oh-my-pi/pi-tui/tools/streaming-output";
+import { imageDecodeFailureReason } from "@oh-my-pi/pi-tui/chat/image-loading";
+import { parseImageMetadata } from "@oh-my-pi/pi-utils/mime";
+import { imageAnimation } from "@oh-my-pi/pi-utils/image-animation";
+import { resizeImage } from "../utils/image-resize";
+import { ATTACHMENT_LIMITS } from "./limits";
+import { convertAttachmentDocument } from "./document";
+
+/** Native conversion boundary. It never dispatches input or calls an Agent, extension, model or tool. */
+export type AttachmentFormat = "utf8" | "png" | "jpeg" | "webp" | "gif" | "pdf" | "docx" | "pptx" | "xlsx" | "epub";
+export interface AttachmentInput { format: AttachmentFormat; bytes: Uint8Array }
+export interface AttachmentFacts {
+	originalBytes?: number; convertedBytes?: number; preparedBytes?: number;
+	sourceWidth?: number; sourceHeight?: number; frames?: number; decodedBytes?: number;
+	pagesNeedingOcr?: number[]; hasEncodingIssues?: boolean; omittedImages?: number; emptyText?: boolean;
+}
+export type AttachmentPreparation =
+	| { status: "failed"; code: string }
+	| { status: "ready"; representation: PreparedRepresentation; degradations: string[]; facts?: AttachmentFacts };
+export type PreparedRepresentation = { kind: "text"; text: string }
+	| { kind: "image"; mimeType: string; data: string; width: number; height: number };
+
+function prepareText(text: string): AttachmentPreparation {
+	const truncated = truncateHead(text);
+	const content = truncated.firstLineExceedsLimit ? truncateHeadBytes(text, 50 * 1024).text : truncated.content;
+	return { status: "ready", representation: { kind: "text", text: content },
+		degradations: truncated.truncated ? ["text_truncated"] : [] };
+}
+
+async function prepareImage(input: AttachmentInput): Promise<AttachmentPreparation> {
+	const metadata = parseImageMetadata(input.bytes);
+	const mimeType = `image/${input.format}`;
+	if (!metadata || metadata.mimeType !== mimeType) return { status: "failed", code: "attachment_format_mismatch" };
+	const { width, height } = metadata;
+	if (!width || !height) return { status: "failed", code: "attachment_invalid_image" };
+	let animation;
+	try { animation = imageAnimation(input.bytes, mimeType, { width, height }); }
+	catch { return { status: "failed", code: "attachment_invalid_image" }; }
+	if (width > ATTACHMENT_LIMITS.imageDimension || height > ATTACHMENT_LIMITS.imageDimension ||
+		width * height * animation.frames > ATTACHMENT_LIMITS.imagePixels ||
+		width * height * animation.frames * animation.decodedBytesPerPixel > ATTACHMENT_LIMITS.decodedBytes) {
+		return { status: "failed", code: "attachment_decoded_budget" };
+	}
+	const image = { type: "image" as const, mimeType, data: input.bytes.toBase64() };
+	if (await imageDecodeFailureReason(image)) return { status: "failed", code: "attachment_invalid_image" };
+	const convertToPng = animation.animated || input.format === "gif";
+	const source = convertToPng ? await new Bun.Image(input.bytes).png().bytes() : input.bytes;
+	const result = await resizeImage({ bytes: source, mimeType: convertToPng ? "image/png" : mimeType }, { excludeWebP: true });
+	if (result.decodeFailed) return { status: "failed", code: "attachment_image_conversion_failed" };
+	if (result.buffer.length > ATTACHMENT_LIMITS.preparedImageBytes) return { status: "failed", code: "attachment_prepared_budget" };
+	const degradations = result.wasResized || convertToPng ? ["image_transformed"] : [];
+	if (animation.animated) degradations.push("animation_first_frame_only");
+	return { status: "ready", representation: { kind: "image", mimeType: result.mimeType, data: result.data,
+		width: result.width, height: result.height }, degradations, facts: { originalBytes: input.bytes.length,
+		preparedBytes: result.buffer.length, sourceWidth: width, sourceHeight: height, frames: animation.frames,
+		decodedBytes: width * height * animation.frames * animation.decodedBytesPerPixel } };
+}
+
+export async function prepareAttachment(input: AttachmentInput): Promise<AttachmentPreparation> {
+	const isImage = ["png", "jpeg", "webp", "gif"].includes(input.format);
+	const ceiling = isImage ? ATTACHMENT_LIMITS.imageBytes : ATTACHMENT_LIMITS.documentBytes;
+	if (input.bytes.byteLength > ceiling) return { status: "failed", code: "attachment_original_budget" };
+	if (isImage) return prepareImage(input);
+	if (input.format !== "utf8") {
+		const converted = await convertAttachmentDocument(input);
+		if (converted.status === "failed" || converted.representation.kind !== "text") return converted;
+		const result = prepareText(converted.representation.text);
+		return result.status === "ready" ? { ...result, facts: converted.facts,
+			degradations: [...converted.degradations, ...result.degradations] } : result;
+	}
+	try {
+		const text = new TextDecoder("utf-8", { fatal: true }).decode(input.bytes);
+		return prepareText(text);
+	} catch {
+		return { status: "failed", code: "attachment_invalid_utf8" };
+	}
+}
diff --git a/packages/coding-agent/src/attachments/provider-guard.ts b/packages/coding-agent/src/attachments/provider-guard.ts
new file mode 100644
index 0000000000..907abd0a88
--- /dev/null
+++ b/packages/coding-agent/src/attachments/provider-guard.ts
@@ -0,0 +1,140 @@
+import { stagePreparedEntryPart, copyPreparedEntryPart } from "./entry-parts";
+import type { Context, ImageContent, Message } from "@oh-my-pi/pi-ai";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { FileMentionMessage } from "../session/messages";
+import { stageAttachmentMessage, type SubmissionTarget } from "../session/submission-provenance";
+import type { PreparedAttachmentLink } from "./receipts";
+import { submissionScope, stagedAttachmentLinks } from "../session/submission-provenance";
+
+export interface PreparedDelivery { readonly target: SubmissionTarget; readonly modelFingerprint: string;
+	readonly attachments: readonly PreparedAttachmentLink[]; dispatched: boolean }
+interface ImageOrigin { link: PreparedAttachmentLink; data: string; mimeType: string; delivery?: PreparedDelivery }
+const images = new WeakMap<object, ImageOrigin>();
+const documentSources = new WeakMap<object, { files: string; role: string; delivery?: PreparedDelivery }>();
+const documents = new WeakMap<object, { links: readonly PreparedAttachmentLink[]; content: string; role: string; delivery?: PreparedDelivery }>();
+
+/** Native staging establishes causal identity on the actual immutable image object. */
+export function stagePreparedImage(image: ImageContent, link: PreparedAttachmentLink, delivery?: PreparedDelivery): void {
+	stagePreparedEntryPart(image, link);
+	images.set(image, { link: { ...link }, data: image.data, mimeType: image.mimeType, ...(delivery ? { delivery } : {}) });
+}
+
+/** Stage the original immutable document fields, independently of later extension/model views. */
+export function stagePreparedDocument(message: FileMentionMessage, delivery?: PreparedDelivery): void {
+	documentSources.set(message, { files: JSON.stringify(message.files), role: message.role, ...(delivery ? { delivery } : {}) });
+}
+
+/** This native clone operation establishes origin before extension handlers can mutate or replace any clone. */
+export function clonePreparedContextMessages(source: AgentMessage[]): AgentMessage[] {
+	const cloned = structuredClone(source);
+	for (let index = 0; index < source.length; index++) {
+		const original = source[index], copy = cloned[index];
+		const links = stagedAttachmentLinks(original);
+		if (links) stageAttachmentMessage(copy, [...links]);
+		const document = documentSources.get(original);
+		if (document) documentSources.set(copy, document);
+		const content: unknown = Reflect.get(original, "content"), copiedContent: unknown = Reflect.get(copy, "content");
+		if (!Array.isArray(content) || !Array.isArray(copiedContent)) continue;
+		for (let part = 0; part < content.length; part++) {
+			const origin = content[part] && typeof content[part] === "object" ? images.get(content[part]) : undefined;
+			if (origin && copiedContent[part] && typeof copiedContent[part] === "object") {
+				images.set(copiedContent[part], origin); copyPreparedEntryPart(content[part], copiedContent[part]);
+			}
+		}
+	}
+	return cloned;
+}
+
+/** The native converter carries provenance from a specific source object into each actual model message. */
+export function carryPreparedModelMessage(source: object, target: Message): void {
+	if (documents.has(target)) return;
+	const origin = documentSources.get(source);
+	if (origin && (Reflect.get(source, "role") !== origin.role || JSON.stringify(Reflect.get(source, "files")) !== origin.files)) {
+		throw new Error("ATTACHMENT_PROVIDER_REPRESENTATION_CHANGED");
+	}
+	const links = stagedAttachmentLinks(source)?.filter(link => link.representationKind === "text");
+	if (links?.length) documents.set(target, { links, content: JSON.stringify(target.content), role: target.role,
+		...(origin?.delivery ? { delivery: origin.delivery } : {}) });
+}
+
+function assertOrder(expected: string[], actual: string[]): void {
+	if (actual.length < expected.length) throw new Error("ATTACHMENT_PROVIDER_REPRESENTATION_MISSING");
+	if (actual.length !== expected.length || actual.some((id, index) => id !== expected[index])) {
+		throw new Error("ATTACHMENT_PROVIDER_REPRESENTATION_CHANGED");
+	}
+}
+
+/** Capture only actual native causal objects present in this call, after queued inputs fold into the live context. */
+export function capturePreparedDeliveries(messages: readonly object[]): PreparedDelivery[] {
+	const deliveries = new Set<PreparedDelivery>();
+	for (const message of messages) {
+		const document = documentSources.get(message)?.delivery ?? documents.get(message)?.delivery;
+		if (document && !document.dispatched) deliveries.add(document);
+		const content: unknown = Reflect.get(message, "content");
+		if (!Array.isArray(content)) continue;
+		for (const part of content) {
+			const delivery = part && typeof part === "object" ? images.get(part)?.delivery : undefined;
+			if (delivery && !delivery.dispatched) deliveries.add(delivery);
+		}
+	}
+	return [...deliveries];
+}
+
+/** Expectations come from the actual native call's source objects, independently of the task draining its queue. */
+export function assertPreparedDeliveries(context: Context, modelFingerprint: string, deliveries: readonly PreparedDelivery[],
+	target: SubmissionTarget): void {
+	for (const delivery of deliveries) {
+		if (delivery.modelFingerprint !== modelFingerprint) throw new Error("ATTACHMENT_TARGET_CHANGED");
+		if (delivery.target.sourceId !== target.sourceId || delivery.target.instanceId !== target.instanceId ||
+			delivery.target.nativeSessionId !== target.nativeSessionId) throw new Error("SUBMISSION_TARGET_CHANGED");
+	}
+	assertAttachments(context, deliveries.flatMap(delivery => [...delivery.attachments]));
+}
+
+/** Validate the final native payload-hook boundary; a thrown/rejected/cancelled hook never retires its groups. */
+export async function guardPreparedPayload(payload: unknown, deliveries: readonly PreparedDelivery[],
+	validate: () => void, transform: () => unknown | Promise<unknown>, signal?: AbortSignal): Promise<unknown> {
+	signal?.throwIfAborted(); validate();
+	const fingerprint = Bun.SHA256.hash(JSON.stringify(payload) ?? "undefined", "hex");
+	const transformed = await transform();
+	signal?.throwIfAborted(); validate();
+	if (Bun.SHA256.hash(JSON.stringify(transformed ?? payload) ?? "undefined", "hex") !== fingerprint) {
+		throw new Error("ATTACHMENT_PROVIDER_PAYLOAD_CHANGED");
+	}
+	for (const delivery of deliveries) delivery.dispatched = true;
+	return transformed;
+}
+
+/** Refuse lost/replaced prepared inputs before any provider dispatch; identical bytes do not establish origin. */
+export function assertPreparedProviderContext(context: Context, modelFingerprint: string): void {
+	const prepared = submissionScope()?.prepared;
+	if (!prepared) return;
+	if (modelFingerprint !== prepared.modelFingerprint) throw new Error("ATTACHMENT_TARGET_CHANGED");
+	assertAttachments(context, prepared.attachments);
+}
+
+function assertAttachments(context: Context, attachments: readonly PreparedAttachmentLink[]): void {
+	const expected = attachments.filter(link => link.representationKind === "image").map(link => link.preparedId);
+	const expectedText = attachments.filter(link => link.representationKind === "text").map(link => link.preparedId);
+	const actual: string[] = [];
+	const actualText: string[] = [];
+	for (const message of context.messages) {
+		const document = documents.get(message);
+		if (document?.links.some(link => expectedText.includes(link.preparedId))) {
+			if (message.role !== document.role || JSON.stringify(message.content) !== document.content) {
+				throw new Error("ATTACHMENT_PROVIDER_REPRESENTATION_CHANGED");
+			}
+			actualText.push(...document.links.map(link => link.preparedId));
+		}
+		if (message.role !== "user" || !Array.isArray(message.content)) continue;
+		for (const part of message.content) {
+			if (part.type !== "image") continue;
+			const origin = images.get(part);
+			if (!origin || !expected.includes(origin.link.preparedId)) continue;
+			if (part.data !== origin.data || part.mimeType !== origin.mimeType) throw new Error("ATTACHMENT_PROVIDER_REPRESENTATION_CHANGED");
+			actual.push(origin.link.preparedId);
+		}
+	}
+	assertOrder(expected, actual);
+	assertOrder(expectedText, actualText);
+}
diff --git a/packages/coding-agent/src/attachments/receipts.ts b/packages/coding-agent/src/attachments/receipts.ts
new file mode 100644
index 0000000000..ae4b1536e8
--- /dev/null
+++ b/packages/coding-agent/src/attachments/receipts.ts
@@ -0,0 +1,208 @@
+import type { ImageContent } from "@oh-my-pi/pi-ai";
+import type { FileMentionMessage } from "../session/messages";
+import { decodeBase64ImageData } from "@oh-my-pi/pi-utils/mime";
+import type { AttachmentFormat, AttachmentPreparation } from "./prepare";
+import { prepareAttachmentIsolated } from "./isolated";
+import { ATTACHMENT_BUDGET_VERSION, ATTACHMENT_LIMITS } from "./limits";
+import { stagePreparedEntryPart } from "./entry-parts";
+import type { PreparedEntryPart } from "./entry-parts";
+import { stageAttachmentMessage } from "../session/submission-provenance";
+import { measureAttachmentRpc, measureAttachmentOutput } from "./rpc-budget";
+import { stagePreparedImage, stagePreparedDocument, type PreparedDelivery } from "./provider-guard";
+
+export interface AttachmentBinding {
+	sourceId: string; instanceId: string; nativeSessionId: string; contextId: string;
+	modelFingerprint: string; imageCapable: boolean;
+}
+export interface ControlledOriginal { originalId: string; format: AttachmentFormat; sha256: string; data: string }
+export interface AttachmentDraft {
+	preparationId: string; draftId: string; draftRevision: string; authorityGeneration: string;
+	message: string; objects: ControlledOriginal[];
+}
+export type AttachmentPreparedItem = AttachmentPreparation & { originalId: string; originalSha256: string;
+	preparedId: string; preparedSha256: string };
+export interface AttachmentReceipt {
+	version: "attachment-preparation-v1"; budgetVersion: string; receiptId: string; preparationId: string;
+	draftId: string; draftRevision: string; authorityGeneration: string; draftFingerprint: string;
+	binding: AttachmentBinding; expiresAt: number; status: "ready" | "failed"; resultDigest: string;
+	items: AttachmentPreparedItem[];
+}
+export interface AttachmentConsent {
+	receiptId: string; resultDigest: string; draftRevision: string; authorityGeneration: string;
+	acceptedDegradations: string[];
+}
+export interface PreparedAttachmentLink {
+	originalId: string; preparedId: string; originalSha256: string; preparedSha256: string;
+	representationKind: "text" | "image";
+	entryPart?: PreparedEntryPart; entryPartUnavailable?: "missing" | "changed" | "ambiguous";
+}
+export interface PreparedSubmission {
+	message: string; images: ImageContent[]; companionMessages: FileMentionMessage[];
+	preparationDigest: string; attachments: PreparedAttachmentLink[]; modelFingerprint: string;
+}
+interface Staged { receipt: AttachmentReceipt; message: string; bytes: number; reserved: string | undefined; bundle?: PreparedSubmission }
+const sha256 = (value: string | Uint8Array): string => Bun.SHA256.hash(value, "hex");
+
+/** Ephemeral immutable receipts. Restart and every draft/context/authority change require fresh preparation. */
+export class AttachmentPreparations {
+	readonly #binding: () => AttachmentBinding;
+	readonly #receipts = new Map<string, Staged>();
+	#pending: { preparationId: string; draftId: string; abort: AbortController } | undefined;
+	#bytes = 0;
+	constructor(binding: () => AttachmentBinding) { this.#binding = binding; }
+
+	/** Cancel both pending publication and ready receipts. Late worker output cannot recreate either. */
+	cancel(preparationId: string): { cancelled: boolean } {
+		let cancelled = false;
+		if (this.#pending?.preparationId === preparationId) { this.#pending.abort.abort(); cancelled = true; }
+		for (const [id, staged] of this.#receipts) {
+			if (staged.receipt.preparationId !== preparationId) continue;
+			if (staged.reserved) throw new Error("ATTACHMENT_ALREADY_RESERVED");
+			this.#receipts.delete(id); this.#bytes -= staged.bytes; cancelled = true;
+		}
+		return { cancelled };
+	}
+
+	async prepare(draft: AttachmentDraft): Promise<AttachmentReceipt> {
+		const binding = structuredClone(this.#binding());
+		this.#prune();
+		if (this.#pending) throw new Error("ATTACHMENT_PREPARATION_BUSY");
+		this.#validateDraft(draft);
+		if (this.#receipts.size >= ATTACHMENT_LIMITS.receipts) throw new Error("ATTACHMENT_RECEIPT_BUDGET");
+		const pending = { preparationId: draft.preparationId, draftId: draft.draftId, abort: new AbortController() };
+		this.#pending = pending;
+		const timer: Timer = setTimeout(() => pending.abort.abort(), ATTACHMENT_LIMITS.inputMs);
+		try {
+			const items: AttachmentPreparedItem[] = [];
+			for (const original of draft.objects) items.push(await this.#prepareItem(original, binding, pending.abort.signal));
+			if (pending.abort.signal.aborted) throw new Error("ATTACHMENT_CANCELLED");
+			if (JSON.stringify(binding) !== JSON.stringify(this.#binding())) throw new Error("ATTACHMENT_CONTEXT_CHANGED");
+			const expiresAt = Date.now() + ATTACHMENT_LIMITS.receiptMs;
+			const base = { version: "attachment-preparation-v1" as const, budgetVersion: ATTACHMENT_BUDGET_VERSION,
+				receiptId: crypto.randomUUID(), preparationId: draft.preparationId, draftId: draft.draftId,
+				draftRevision: draft.draftRevision, authorityGeneration: draft.authorityGeneration,
+				draftFingerprint: sha256(JSON.stringify({ preparationId: draft.preparationId, draftId: draft.draftId,
+					draftRevision: draft.draftRevision, authorityGeneration: draft.authorityGeneration, message: draft.message,
+					objects: draft.objects.map(({ originalId, format, sha256 }) => ({ originalId, format, sha256 })) })), binding, expiresAt,
+				status: items.every(item => item.status === "ready") ? "ready" as const : "failed" as const, items };
+			const receipt: AttachmentReceipt = { ...base, resultDigest: sha256(JSON.stringify(base)) };
+			measureAttachmentOutput({ type: "response", id: "x".repeat(96), command: "attachment_prepare", success: true, data: receipt });
+			const bytes = Buffer.byteLength(JSON.stringify(receipt));
+			if (bytes > ATTACHMENT_LIMITS.preparedBytes || this.#bytes + bytes > ATTACHMENT_LIMITS.stagedBytes) {
+				throw new Error("ATTACHMENT_PREPARED_BUDGET");
+			}
+			this.#receipts.set(receipt.receiptId, { receipt, message: draft.message, bytes, reserved: undefined });
+			this.#bytes += bytes;
+			return structuredClone(receipt);
+		} finally {
+			clearTimeout(timer);
+			if (this.#pending === pending) this.#pending = undefined;
+		}
+	}
+
+	validateAndFreeze(consent: AttachmentConsent, clientSubmissionId?: string): PreparedSubmission {
+		this.#prune();
+		const staged = this.#receipts.get(consent.receiptId);
+		if (!staged) throw new Error("ATTACHMENT_RECEIPT_STALE");
+		if (staged.receipt.status !== "ready") throw new Error("ATTACHMENT_NOT_READY");
+		if (JSON.stringify(staged.receipt.binding) !== JSON.stringify(this.#binding())) throw new Error("ATTACHMENT_CONTEXT_CHANGED");
+		if (staged.receipt.resultDigest !== consent.resultDigest || staged.receipt.draftRevision !== consent.draftRevision ||
+			staged.receipt.authorityGeneration !== consent.authorityGeneration ||
+			staged.receipt.budgetVersion !== ATTACHMENT_BUDGET_VERSION) throw new Error("ATTACHMENT_CONSENT_STALE");
+		if (staged.reserved && staged.reserved !== clientSubmissionId) throw new Error("ATTACHMENT_ALREADY_RESERVED");
+		const required = new Set(staged.receipt.items.flatMap(item => item.status === "ready" ? item.degradations : []));
+		if ([...required].some(code => !consent.acceptedDegradations.includes(code)) ||
+			consent.acceptedDegradations.some(code => !required.has(code))) {
+			throw new Error("ATTACHMENT_DEGRADATION_CONSENT_REQUIRED");
+		}
+		if (clientSubmissionId) staged.reserved = clientSubmissionId;
+		return staged.bundle ??= this.#freezeBundle(staged);
+	}
+
+	/** Called only after the native reservation has been durably verified. */
+	markReserved(receiptId: string, clientSubmissionId: string): void {
+		const staged = this.#receipts.get(receiptId);
+		if (!staged || staged.reserved !== clientSubmissionId) throw new Error("ATTACHMENT_RESERVATION_MISMATCH");
+		this.#receipts.delete(receiptId); this.#bytes -= staged.bytes;
+	}
+
+	#freezeBundle(staged: Staged): PreparedSubmission {
+		const images: ImageContent[] = [];
+		const companionMessages: FileMentionMessage[] = [];
+		const attachments: PreparedAttachmentLink[] = [];
+		const delivery: PreparedDelivery = { target: { sourceId: staged.receipt.binding.sourceId,
+			instanceId: staged.receipt.binding.instanceId, nativeSessionId: staged.receipt.binding.nativeSessionId },
+			modelFingerprint: staged.receipt.binding.modelFingerprint, attachments, dispatched: false };
+		for (const item of staged.receipt.items) {
+			if (item.status !== "ready") throw new Error("ATTACHMENT_NOT_READY");
+			const representation = item.representation;
+			const link = { originalId: item.originalId, originalSha256: item.originalSha256,
+				preparedId: item.preparedId, preparedSha256: item.preparedSha256, representationKind: representation.kind };
+			attachments.push(Object.freeze(link));
+			if (representation.kind === "image") {
+				const image: ImageContent = { type: "image", data: representation.data, mimeType: representation.mimeType };
+				stagePreparedImage(image, link, delivery); images.push(image);
+			}
+			else {
+				const message: FileMentionMessage = { role: "fileMention", timestamp: staged.receipt.expiresAt - ATTACHMENT_LIMITS.receiptMs,
+					files: [{ path: `attachment-prepared://${item.preparedId}`, content: representation.text,
+						byteSize: Buffer.byteLength(representation.text) }] };
+				stagePreparedEntryPart(message.files[0], link);
+				stageAttachmentMessage(message, [link]); stagePreparedDocument(message, delivery);
+				Object.freeze(message.files[0]); Object.freeze(message.files);
+				for (const key of ["role", "timestamp", "files"] as const) {
+					Object.defineProperty(message, key, { writable: false, configurable: false });
+				}
+				companionMessages.push(message);
+			}
+		}
+		for (const image of images) {
+			for (const key of ["type", "mimeType", "data"] as const) {
+				Object.defineProperty(image, key, { writable: false, configurable: false });
+			}
+		}
+		Object.freeze(images); Object.freeze(companionMessages); Object.freeze(attachments);
+		return Object.freeze({ message: staged.message, images, companionMessages,
+			preparationDigest: staged.receipt.resultDigest, attachments, modelFingerprint: staged.receipt.binding.modelFingerprint });
+	}
+
+	#validateDraft(draft: AttachmentDraft): void {
+		if (draft.objects.length < 1 || draft.objects.length > ATTACHMENT_LIMITS.objects ||
+			Buffer.byteLength(draft.message) > ATTACHMENT_LIMITS.messageBytes) throw new Error("ATTACHMENT_INPUT_BUDGET");
+		measureAttachmentRpc({ id: "x".repeat(96), type: "attachment_prepare", preparationId: draft.preparationId,
+			draftId: draft.draftId, draftRevision: draft.draftRevision, authorityGeneration: draft.authorityGeneration,
+			message: draft.message, objects: draft.objects });
+		let bytes = 0;
+		const ids = new Map<string, string>();
+		for (const object of draft.objects) {
+			const identity = JSON.stringify({ format: object.format, sha256: object.sha256 });
+			if (!/^[A-Za-z0-9_-]{1,96}$/.test(object.originalId) ||
+				(ids.has(object.originalId) && ids.get(object.originalId) !== identity) ||
+				!/^[a-f0-9]{64}$/.test(object.sha256)) throw new Error("ATTACHMENT_OBJECT_INVALID");
+			ids.set(object.originalId, identity);
+			const padding = object.data.endsWith("==") ? 2 : object.data.endsWith("=") ? 1 : 0;
+			bytes += Math.floor(object.data.length * 3 / 4) - padding;
+		}
+		if (bytes > ATTACHMENT_LIMITS.originalBytes) throw new Error("ATTACHMENT_INPUT_BUDGET");
+	}
+
+	async #prepareItem(original: ControlledOriginal, binding: AttachmentBinding, signal: AbortSignal): Promise<AttachmentPreparedItem> {
+		const failed = (code: string): AttachmentPreparedItem => ({ originalId: original.originalId,
+			originalSha256: original.sha256, preparedId: crypto.randomUUID(), preparedSha256: "", status: "failed", code });
+		const decoded = decodeBase64ImageData(original.data);
+		if (decoded.reason) return failed("attachment_invalid_base64");
+		if (sha256(decoded.bytes) !== original.sha256) return failed("attachment_original_changed");
+		const image = ["png", "jpeg", "webp", "gif"].includes(original.format);
+		if (image && !binding.imageCapable) return failed("attachment_target_has_no_image_input");
+		const result = await prepareAttachmentIsolated({ format: original.format, bytes: decoded.bytes }, signal);
+		return { ...result, originalId: original.originalId, originalSha256: original.sha256,
+			preparedId: crypto.randomUUID(), preparedSha256: result.status === "ready" ? sha256(JSON.stringify(result.representation)) : "" };
+	}
+
+	#prune(): void {
+		for (const [id, value] of this.#receipts) {
+			if (value.receipt.expiresAt > Date.now()) continue;
+			this.#receipts.delete(id); this.#bytes -= value.bytes;
+		}
+	}
+}
diff --git a/packages/coding-agent/src/attachments/rpc-budget.ts b/packages/coding-agent/src/attachments/rpc-budget.ts
new file mode 100644
index 0000000000..a1774d215d
--- /dev/null
+++ b/packages/coding-agent/src/attachments/rpc-budget.ts
@@ -0,0 +1,23 @@
+import { RpcFrameEncoder } from "../modes/rpc/rpc-frame";
+import { ATTACHMENT_LIMITS } from "./limits";
+
+/** Stdin is one unchunked JSONL command. Base64 originals, escapes, metadata and newline are already in these bytes. */
+export function measureAttachmentRpc(frame: object): { logicalBytes: number; wireBytes: number; frames: number } {
+	const logicalBytes = Buffer.byteLength(JSON.stringify(frame)) + 1;
+	if (logicalBytes > ATTACHMENT_LIMITS.rpcBytes) throw new Error("ATTACHMENT_RPC_BUDGET");
+	return { logicalBytes, wireBytes: logicalBytes, frames: 1 };
+}
+
+/** Stdout separately uses the genuine public v2 encoder, including physical chunk envelopes and newlines. */
+export function measureAttachmentOutput(frame: object): { logicalBytes: number; wireBytes: number; frames: number } {
+	const logicalBytes = Buffer.byteLength(JSON.stringify(frame)) + 1;
+	if (logicalBytes > ATTACHMENT_LIMITS.rpcOutputBytes) throw new Error("ATTACHMENT_RPC_OUTPUT_BUDGET");
+	const encoder = new RpcFrameEncoder();
+	encoder.setProtocolVersion(2);
+	let wireBytes = 0, frames = 0;
+	for (const line of encoder.encodeFrames(frame)) {
+		wireBytes += Buffer.byteLength(line); frames++;
+		if (wireBytes > ATTACHMENT_LIMITS.rpcOutputWireBytes) throw new Error("ATTACHMENT_RPC_WIRE_BUDGET");
+	}
+	return { logicalBytes, wireBytes, frames };
+}
