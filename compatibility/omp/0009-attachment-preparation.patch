+import type { AgentSession } from "../../session/agent-session";
+import { AttachmentPreparations } from "../../attachments/receipts";
+import { validAttachmentCommand } from "./attachments.generated";
+import type { AttachmentCommand } from "./attachment-client";
+
+/** Uses protected native identity and current runtime context; Host generations supply additional fences, not authority. */
+export function createAttachmentPreparations(session: AgentSession): AttachmentPreparations {
+	return new AttachmentPreparations(() => {
+		const target = session.sessionManager.getSubmissionTarget();
+		const runtime = session.getHistoryRuntimeContext();
+		const context = session.sessionManager.getHistoryMessageContext(runtime);
+		return { ...target, contextId: context.contextId,
+			modelFingerprint: Bun.SHA256.hash(JSON.stringify(runtime), "hex"), imageCapable: session.model?.input.includes("image") ?? false };
+	});
+}
+
+/** Validate the complete same-source public command before conversion or object decoding. */
+export function validateAttachmentCommand(value: unknown): asserts value is AttachmentCommand {
+	if (!validAttachmentCommand(value)) throw new Error("ATTACHMENT_COMMAND_SCHEMA");
+	for (const key of ["preparationId", "draftId", "draftRevision", "authorityGeneration"] as const) {
+		if (!(key in value)) continue;
+		const field: unknown = Reflect.get(value, key);
+		if (typeof field !== "string" || !/^[A-Za-z0-9_-]{1,96}$/.test(field)) throw new Error("ATTACHMENT_COMMAND_SCHEMA");
+	}
+	if (value.id !== undefined && value.id.length > 96) throw new Error("ATTACHMENT_COMMAND_SCHEMA");
+}
