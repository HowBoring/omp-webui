 const CONCAT_SINK_RETAIN_BYTES = 1024 * 1024;
 
+/** Read a complete owned stream with an allocation ceiling. Callers must terminate its producer on overflow. */
+export async function readStreamBounded(stream: ReadableStream<Uint8Array>, maxBytes: number): Promise<Uint8Array> {
+	const sink = new ConcatSink();
