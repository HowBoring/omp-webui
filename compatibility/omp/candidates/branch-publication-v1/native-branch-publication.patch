     assertCurrent();
-  } finally { fs.closeSync(fd); }
+    const directory = `/proc/self/fd/${directoryFd}`;
+    const fd = openAnonymousFile(directory, mode);
+    try {
+      writePreparedFile(fd, bytes, mode);
+      if (durable) fs.fsyncSync(fd);
+      const prepared = durable ? fs.fstatSync(fd, { bigint: true }) : undefined;
+      if (prepared && prepared.size !== BigInt(bytes.length)) throw new Error("GENERATION_NEW_SHORT_WRITE");
+
+      assertCurrent();
+      const libc = dlopen("libc.so.6", {
+        linkat: { args: [FFIType.i32, FFIType.ptr, FFIType.i32, FFIType.ptr, FFIType.i32], returns: FFIType.i32 },
+        __errno_location: { args: [], returns: FFIType.ptr },
+      });
+      try {
+        const errno = durable ? libc.symbols.__errno_location() : null;
+        const source = Buffer.from(`/proc/self/fd/${fd}\0`);
+        const target = Buffer.from(`${name}\0`);
+        mayHaveLinked = true;
+        if (libc.symbols.linkat(-100, ptr(source), directoryFd, ptr(target), 0x400) !== 0) {
+          // EEXIST proves this attempt never replaced the incumbent namespace entry.
+          if (errno && read.i32(errno) === os.constants.errno.EEXIST) mayHaveLinked = false;
