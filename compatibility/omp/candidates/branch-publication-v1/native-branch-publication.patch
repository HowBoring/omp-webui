+import * as os from "node:os";
+import { dlopen, FFIType, ptr, read } from "bun:ffi";
+
+export class DurableNewFilePublicationError extends Error {
+  constructor(readonly outcome: "not_published" | "outcome_unknown", cause: unknown) {
+    super(outcome === "not_published" ? "DURABLE_NEW_PUBLICATION_NOT_PUBLISHED" : "DURABLE_NEW_PUBLICATION_UNKNOWN", { cause });
+  }
+}
+
+export function publishNewFile(
+  directoryFd: number, name: string, bytes: Buffer, mode: number, assertCurrent: () => void,
+): void {
+  publishNewFileImpl(directoryFd, name, bytes, mode, assertCurrent, false);
+}
+
+/**
+ * Publishes complete caller-serialized bytes at mode 0600. The caller keeps the already-durable trusted
+ * parent directory fd open and supplies a synchronous check of its current identity and publication authority.
+ * Success proves the named inode and completed file and parent syncs. An unknown outcome requires observation.
+ */
+export function publishDurableNewFile(
+  directoryFd: number, name: string, bytes: Buffer, assertCurrent: () => void,
+): void {
+  publishNewFileImpl(directoryFd, name, bytes, 0o600, assertCurrent, true);
+}
+
+function openAnonymousFile(directory: string, mode: number): number {
+  // Linux O_TMPFILE | O_RDWR; no named staging cleanup.
+  try { return fs.openSync(directory, 0x410002, mode); }
   catch { throw new Error("GENERATION_NEW_PUBLICATION_UNSUPPORTED"); }
+}
+
+function writePreparedFile(fd: number, bytes: Buffer, mode: number): void {
+  let offset = 0;
+  while (offset < bytes.length) {
+    const count = fs.writeSync(fd, bytes, offset, bytes.length - offset, offset);
+    if (!count) throw new Error("GENERATION_NEW_SHORT_WRITE");
+    offset += count;
+  }
+  fs.fchmodSync(fd, mode);
+}
+
+function verifyPublishedFile(target: string, held: fs.BigIntStats, durable: boolean): void {
+  const named = durable ? fs.lstatSync(target, { bigint: true }) : fs.statSync(target, { bigint: true });
+  if (held.dev !== named.dev || held.ino !== named.ino || held.birthtimeNs !== named.birthtimeNs) {
+    throw new Error("GENERATION_NEW_PUBLICATION_UNKNOWN");
+  }
+  if (durable && (!named.isFile() || named.size !== held.size || named.mtimeNs !== held.mtimeNs || named.mode !== held.mode)) {
+    throw new Error("GENERATION_NEW_PUBLICATION_UNKNOWN");
+  }
+}
+
+function publishNewFileImpl(
+  directoryFd: number, name: string, bytes: Buffer, mode: number, assertCurrent: () => void, durable: boolean,
+): void {
+  let mayHaveLinked = false;
