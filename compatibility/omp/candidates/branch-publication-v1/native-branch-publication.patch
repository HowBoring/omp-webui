+      const published = `${directory}/${name}`;
+      const held = prepared ?? fs.fstatSync(fd, { bigint: true });
+      verifyPublishedFile(published, held, durable);
+      if (durable) fs.fsyncSync(directoryFd);
+      assertCurrent();
+      if (durable) verifyPublishedFile(published, held, true);
+    } finally { fs.closeSync(fd); }
+  } catch (error) {
+    if (!durable) throw error;
+    throw new DurableNewFilePublicationError(mayHaveLinked ? "outcome_unknown" : "not_published", error);
