new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/branch-inspect-client.ts
@@ -0,0 +1,46 @@
+import {
+	type BranchInspectCommand,
+	type BranchInspectErrorCode,
+	type BranchInspectParams,
+	type BranchInspectPreview,
+	sameBranchSource,
+	validBranchInspectParams,
+	validBranchInspectResponse,
+} from "./branch-inspect-wire";
+
+type Request = (command: BranchInspectCommand & { id: string }) => Promise<unknown>;
+export type BranchInspectClientErrorCode = BranchInspectErrorCode | "BRANCH_INSPECT_RESPONSE_SCHEMA";
+
+export class BranchInspectClientError extends Error {
+	readonly code: BranchInspectClientErrorCode;
+	constructor(code: BranchInspectClientErrorCode) {
+		super(code);
+		this.name = "BranchInspectClientError";
+		this.code = code;
+	}
+}
+
+/** Unregistered public JSONL callback client for the read-only branch inspection candidate. */
+export class BranchInspectClient {
+	readonly #request: Request;
+
+	constructor(request: Request) {
+		this.#request = request;
+	}
+
+	async inspect(params: BranchInspectParams): Promise<BranchInspectPreview> {
+		if (!validBranchInspectParams(params)) throw new BranchInspectClientError("BRANCH_INSPECT_COMMAND_SCHEMA");
+		const id = crypto.randomUUID();
+		const command = { ...structuredClone(params), id, type: "branch_inspect" } as const;
+		const { source, entryId, expected } = command;
+		const reply = await this.#request(structuredClone(command));
+		if (!validBranchInspectResponse(reply) || reply.id !== id)
+			throw new BranchInspectClientError("BRANCH_INSPECT_RESPONSE_SCHEMA");
+		if (!reply.success) throw new BranchInspectClientError(reply.code);
+		const { data } = reply;
+		if (data.entryId !== entryId || !sameBranchSource(data.source, source) ||
+			(expected && (data.parentId !== expected.parentId || data.targetRevision !== expected.targetRevision ||
+				data.contextRevision !== expected.contextRevision))) throw new BranchInspectClientError("BRANCH_INSPECT_RESPONSE_SCHEMA");
+		return data;
+	}
+}
diff --git a/packages/coding-agent/src/modes/rpc/branch-inspect-wire.ts b/packages/coding-agent/src/modes/rpc/branch-inspect-wire.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/branch-inspect-wire.ts
@@ -0,0 +1,118 @@
+/** Protected current Native Session identity, using the public SubmissionTarget fields. */
+export interface BranchInspectSource {
+	sourceId: string;
+	instanceId: string;
+	nativeSessionId: string;
+}
+
+export interface BranchInspectCut {
+	parentId: string | null;
+	targetRevision: string;
+	contextRevision: string;
+}
+
+export interface BranchInspectParams {
+	source: BranchInspectSource;
+	entryId: string;
+	/** Revalidate the entire selected cut and current idle state. */
+	expected?: BranchInspectCut;
+}
+
+export interface BranchInspectCommand extends BranchInspectParams {
+	type: "branch_inspect";
+	id?: string;
+}
+
+export interface BranchInspectPreview extends BranchInspectCut {
+	version: "branch-inspect-v1";
+	source: BranchInspectSource;
+	entryId: string;
+}
+
+const errorCodes = [
+	"BRANCH_INSPECT_COMMAND_SCHEMA",
+	"BRANCH_SOURCE_CHANGED",
+	"BRANCH_SOURCE_UNAVAILABLE",
+	"BRANCH_TARGET_MISSING",
+	"BRANCH_TARGET_NOT_USER",
+	"BRANCH_TARGET_UNAVAILABLE",
+	"BRANCH_STALE_TARGET",
+	"BRANCH_STALE_CONTEXT",
+	"session_busy",
+	"NAVIGATION_BUSY",
+] as const;
+
+export type BranchInspectErrorCode = (typeof errorCodes)[number];
+export type BranchInspectResponse = { id?: string; type: "response"; command: "branch_inspect" } & (
+	| { success: true; data: BranchInspectPreview }
+	| { success: false; code: BranchInspectErrorCode; error: string }
+);
+
+function record(value: unknown): value is Record<string, unknown> {
+	if (typeof value !== "object" || value === null) return false;
+	const prototype = Object.getPrototypeOf(value);
+	return prototype === Object.prototype || prototype === null;
+}
+
+function only(value: Record<string, unknown>, fields: readonly string[]): boolean {
+	return Reflect.ownKeys(value).every(key => typeof key === "string" && fields.includes(key) &&
+		Object.prototype.propertyIsEnumerable.call(value, key));
+}
+
+function bounded(value: unknown, max: number): value is string {
+	return typeof value === "string" && value.length > 0 && value.length <= max;
+}
+
+function revision(value: unknown): value is string {
+	return typeof value === "string" && /^[a-f0-9]{64}$/.test(value);
+}
+
+export function branchInspectRequestId(value: unknown): string | undefined {
+	return record(value) && bounded(value.id, 96) ? value.id : undefined;
+}
+
+function validSource(value: unknown): value is BranchInspectSource {
+	return record(value) && only(value, ["sourceId", "instanceId", "nativeSessionId"]) &&
+		revision(value.sourceId) && revision(value.instanceId) && bounded(value.nativeSessionId, 128);
+}
+
+function hasCut(value: Record<string, unknown>): boolean {
+	return (value.parentId === null || bounded(value.parentId, 128)) &&
+		revision(value.targetRevision) && revision(value.contextRevision);
+}
+
+export function sameBranchSource(left: BranchInspectSource, right: BranchInspectSource): boolean {
+	return left.sourceId === right.sourceId && left.instanceId === right.instanceId &&
+		left.nativeSessionId === right.nativeSessionId;
+}
+
+function hasBranchInspectParams(value: Record<string, unknown>): boolean {
+	if (!validSource(value.source) || !bounded(value.entryId, 128)) return false;
+	return !Object.hasOwn(value, "expected") || (record(value.expected) &&
+		only(value.expected, ["parentId", "targetRevision", "contextRevision"]) && hasCut(value.expected));
+}
+
+export function validBranchInspectParams(value: unknown): value is BranchInspectParams {
+	return record(value) && only(value, ["source", "entryId", "expected"]) && hasBranchInspectParams(value);
+}
+
+export function validBranchInspectCommand(value: unknown): value is BranchInspectCommand {
+	if (!record(value) || value.type !== "branch_inspect" || !only(value, ["id", "type", "source", "entryId", "expected"]))
+		return false;
+	return (!Object.hasOwn(value, "id") || branchInspectRequestId(value) !== undefined) && hasBranchInspectParams(value);
+}
+
+export function validBranchInspectPreview(value: unknown): value is BranchInspectPreview {
+	return record(value) && value.version === "branch-inspect-v1" &&
+		only(value, ["version", "source", "entryId", "parentId", "targetRevision", "contextRevision"]) &&
+		validSource(value.source) && bounded(value.entryId, 128) && hasCut(value);
+}
+
+export function validBranchInspectResponse(value: unknown): value is BranchInspectResponse {
+	if (!record(value) || value.type !== "response" || value.command !== "branch_inspect" ||
+		(Object.hasOwn(value, "id") && branchInspectRequestId(value) === undefined)) return false;
+	const envelope = ["id", "type", "command", "success"];
+	if (value.success === true) return only(value, [...envelope, "data"]) && validBranchInspectPreview(value.data);
+	return value.success === false && only(value, [...envelope, "code", "error"]) && bounded(value.error, 128) &&
+		errorCodes.some(code => code === value.code);
+}
diff --git a/packages/coding-agent/src/modes/rpc/rpc-branch-inspect.ts b/packages/coding-agent/src/modes/rpc/rpc-branch-inspect.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-branch-inspect.ts
@@ -0,0 +1,110 @@
+import {
+	branchInspectRequestId,
+	type BranchInspectErrorCode,
+	type BranchInspectPreview,
+	type BranchInspectResponse,
+	type BranchInspectSource,
+	sameBranchSource,
+	validBranchInspectCommand,
+	validBranchInspectPreview,
+} from "./branch-inspect-wire";
+
+interface Entry {
+	type: string;
+	parentId: string | null;
+	message?: { role: string };
+}
+
+/** Read-only subset of the Native SessionManager. */
+interface BranchInspection {
+	assertNavigationSource(): void;
+	getSubmissionTarget(): BranchInspectSource;
+	getEntry(id: string): Entry | undefined;
+	navigationTarget(id: string): { entryId: string; parentId: string | null; targetRevision: string };
+	navigationContextRevision(): string;
+}
+
+class BranchInspectionError extends Error {
+	readonly code: BranchInspectErrorCode;
+	constructor(code: BranchInspectErrorCode) {
+		super(code);
+		this.code = code;
+	}
+}
+
+function refuse(code: BranchInspectErrorCode): never {
+	throw new BranchInspectionError(code);
+}
+
+function sourceIdentity(manager: BranchInspection): BranchInspectSource {
+	try {
+		manager.assertNavigationSource();
+		return manager.getSubmissionTarget();
+	} catch {
+		return refuse("BRANCH_SOURCE_UNAVAILABLE");
+	}
+}
+
+function readTarget(manager: BranchInspection, entryId: string) {
+	const entry = manager.getEntry(entryId);
+	if (!entry) return refuse("BRANCH_TARGET_MISSING");
+	if (entry.type !== "message" || entry.message?.role !== "user") return refuse("BRANCH_TARGET_NOT_USER");
+	if (entry.parentId !== null && (entry.parentId === entryId || !manager.getEntry(entry.parentId)))
+		return refuse("BRANCH_TARGET_UNAVAILABLE");
+	try {
+		const target = manager.navigationTarget(entryId);
+		if (target.entryId === entryId && target.parentId === entry.parentId) return target;
+	} catch (failure) {
+		// The Native target reader checks protected storage again before reading the entry.
+		const code = failure instanceof Error ? failure.message : undefined;
+		if (code === "NAVIGATION_ENTRY_NOT_FOUND") return refuse("BRANCH_TARGET_MISSING");
+		if (code !== "NAVIGATION_TARGET_TOO_LARGE") return refuse("BRANCH_SOURCE_UNAVAILABLE");
+	}
+	return refuse("BRANCH_TARGET_UNAVAILABLE");
+}
+
+/** Synchronous preview or revalidation using the current protected Native Session. */
+export function inspectBranch(
+	value: unknown,
+	manager: BranchInspection,
+	isBusy: () => boolean,
+	outstandingBuiltinCount: number,
+): BranchInspectPreview {
+	if (!validBranchInspectCommand(value)) return refuse("BRANCH_INSPECT_COMMAND_SCHEMA");
+	const source = sourceIdentity(manager);
+	if (!sameBranchSource(source, value.source)) return refuse("BRANCH_SOURCE_CHANGED");
+	const { entryId, expected } = value;
+	if (expected && (outstandingBuiltinCount > 0 || isBusy())) return refuse("session_busy");
+	const target = readTarget(manager, entryId);
+	const contextRevision = sourceContext(manager);
+	const preview = { version: "branch-inspect-v1", source, ...target, contextRevision };
+	if (!validBranchInspectPreview(preview)) return refuse("BRANCH_TARGET_UNAVAILABLE");
+	if (expected && (expected.parentId !== preview.parentId || expected.targetRevision !== preview.targetRevision))
+		return refuse("BRANCH_STALE_TARGET");
+	if (expected && expected.contextRevision !== contextRevision) return refuse("BRANCH_STALE_CONTEXT");
+	return preview;
+}
+
+function sourceContext(manager: BranchInspection): string {
+	try {
+		return manager.navigationContextRevision();
+	} catch {
+		return refuse("BRANCH_SOURCE_UNAVAILABLE");
+	}
+}
+
+export function respondBranchInspect(
+	value: unknown,
+	manager: BranchInspection,
+	isBusy: () => boolean,
+	outstandingBuiltinCount: number,
+): BranchInspectResponse {
+	const id = branchInspectRequestId(value);
+	const envelope = { ...(id === undefined ? {} : { id }), type: "response", command: "branch_inspect" } as const;
+	try {
+		return { ...envelope, success: true, data: inspectBranch(value, manager, isBusy, outstandingBuiltinCount) };
+	} catch (failure) {
+		const code = failure instanceof BranchInspectionError ? failure.code : "BRANCH_SOURCE_UNAVAILABLE";
+		return { ...envelope, success: false, code, error: code };
+	}
+}
