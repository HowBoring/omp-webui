+/** Deferred interactive startup. Continue never resolves another physical instance or creates a sibling. */
+export const strictStartDefs = {
+  StrictStartState: {
+    version: "'strict-start-v1'", phase: "'waiting' | 'opening' | 'open' | 'failed' | 'cancelled' | 'outcome_unknown'",
+    "intent?": "'continue' | 'new'", "operationId?": "string", "code?": "string",
+    "binding?": "CatalogDescriptor", "nativeSessionId?": "string", "cwd?": "string",
+  },
+};
+export const strictStartCommands = [
+  { name: "strict_start", doc: "Explicitly create or continue after exact-instance ownership and cwd validation. Never replay.",
+    params: { intent: "'continue' | 'new'", expectedCwd: "string", "reference?": "string" }, result: "StrictStartState" },
+  { name: "get_strict_state", doc: "Observe this worker's truthful startup outcome; never retries an operation.", result: "StrictStartState" },
+  { name: "cancel_strict_start", doc: "Cancel pending startup; already published side effects remain explicit.", result: "StrictStartState" },
+] as const;
diff --git a/packages/coding-agent/src/session/session-generation.ts b/packages/coding-agent/src/session/session-generation.ts
new file mode 100644
index 0000000000..5ae33e6cc5
--- /dev/null
+++ b/packages/coding-agent/src/session/session-generation.ts
@@ -0,0 +1,249 @@
+/** Native generation format v1. Publication only appends to a held carrier; no rename, unlink or truncation. */
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { readFileXattr, writeFileXattr } from "../utils/file-xattr";
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+
+export const generationBudgets = Object.freeze({ bodyBytes: 128 * 1024 * 1024, retainedBytes: 512 * 1024 * 1024,
+  generations: 64, directoryEntries: 128, metadataBytes: 1024, markerBytes: 1024 });
+const HEAD_XATTR = "user.omp-generation-v1";
+const CARRIER_TYPE = "ompgen1";
+const COMMIT_TYPE = "omp_generation_commit";
+const hash = (value: string | Uint8Array): string => Bun.SHA256.hash(value, "hex");
+const decoder = new TextDecoder("utf8", { fatal: true });
+interface GenerationMetadata {
+  format: "omp-native-generation"; version: 1; token: string; carrier: string; nativeSessionId: string;
+  offset: number; bytes: number; sha256: string;
+}
+interface CommitHead { version: 1; carrier: string; current: CommitRecord; previous?: CommitRecord; checksum: string }
+interface CommitRecord { type: typeof COMMIT_TYPE; version: 1; token: string; offset: number; metadataSha256: string; checksum: string }
+export interface ResolvedGeneration { text: string; physicalBytes: number; logicalBytes: number; committed: boolean }
+export function generationDirectory(file: string): string { return `.${path.basename(file)}.omp-generations`; }
+export function hasGenerationDirectory(file: string): boolean {
+  try { return fs.lstatSync(path.join(path.dirname(file), generationDirectory(file))).isDirectory(); }
+  catch (error) { if (isRecord(error) && error.code === "ENOENT") return false; throw error; }
+}
+export function carrierIdentity(fd: number): string {
+  const info = fs.fstatSync(fd, { bigint: true });
+  return hash(`${info.dev}:${info.ino}:${info.birthtimeNs}`);
+}
+export function readHeldBytes(fd: number, max = generationBudgets.bodyBytes): Buffer {
+  const size = fs.fstatSync(fd).size;
+  if (size > max) throw new Error("GENERATION_BODY_LIMIT");
+  const bytes = Buffer.alloc(size); let offset = 0;
+  while (offset < size) {
+    const count = fs.readSync(fd, bytes, offset, size - offset, offset);
+    if (!count) throw new Error("GENERATION_CHANGED_DURING_READ");
+    offset += count;
+  }
+  return bytes;
+}
+function nativeId(text: string): string {
+  for (const line of text.split("\n", 3).slice(0, 2)) {
+    let value: unknown; try { value = JSON.parse(line); } catch { continue; }
+    if (isRecord(value) && (value.type === "session" || value.type === CARRIER_TYPE) && typeof value.id === "string") return value.id;
+  }
+  throw new Error("GENERATION_NATIVE_HEADER_INVALID");
+}
+function metadata(value: unknown): value is GenerationMetadata {
+  return isRecord(value) && value.format === "omp-native-generation" && value.version === 1
+    && typeof value.token === "string" && /^[0-9a-f-]{36}$/.test(value.token)
+    && typeof value.carrier === "string" && /^[0-9a-f]{64}$/.test(value.carrier)
+    && typeof value.nativeSessionId === "string" && value.nativeSessionId.length <= 128
+    && typeof value.offset === "number" && Number.isSafeInteger(value.offset) && value.offset >= 0
+    && typeof value.bytes === "number" && Number.isSafeInteger(value.bytes) && value.bytes <= generationBudgets.bodyBytes && value.bytes > 0
+    && typeof value.sha256 === "string" && /^[0-9a-f]{64}$/.test(value.sha256);
+}
+function marker(value: unknown): value is CommitRecord {
+  if (!isRecord(value) || value.type !== COMMIT_TYPE) return false;
+  if (value.version !== 1) throw new Error("GENERATION_FORMAT_UNSUPPORTED");
+  if (typeof value.token !== "string" || !/^[0-9a-f-]{36}$/.test(value.token)
+    || typeof value.offset !== "number" || !Number.isSafeInteger(value.offset) || value.offset < 0
+    || typeof value.metadataSha256 !== "string" || !/^[0-9a-f]{64}$/.test(value.metadataSha256)
+    || typeof value.checksum !== "string") throw new Error("GENERATION_COMMIT_CORRUPT");
+  const payload = { type: COMMIT_TYPE, version: 1, token: value.token, offset: value.offset, metadataSha256: value.metadataSha256 };
+  if (hash(JSON.stringify(payload)) !== value.checksum) throw new Error("GENERATION_COMMIT_CORRUPT");
+  return true;
+}
+interface HeaderPosition { type: "session" | "ompgen1"; valueOffset: number }
+function headerPosition(bytes: Buffer): HeaderPosition {
+  let start = 0;
+  for (let index = 0; index < 2; index++) {
+    const end = bytes.indexOf(10, start);
+    if (end < 0 || end > 16_384) throw new Error("GENERATION_NATIVE_HEADER_INVALID");
+    const line = decoder.decode(bytes.subarray(start, end));
+    const value: unknown = JSON.parse(line);
+    if (isRecord(value) && (value.type === "session" || value.type === CARRIER_TYPE)) {
+      const match = /"type"\s*:\s*"(session|ompgen1)"/.exec(line);
+      if (!match) throw new Error("GENERATION_HEADER_ENCODING_UNSUPPORTED");
+      const textOffset = match.index + match[0].lastIndexOf(value.type);
+      return { type: value.type, valueOffset: start + Buffer.byteLength(line.slice(0, textOffset)) };
+    }
+    start = end + 1;
+  }
+  throw new Error("GENERATION_NATIVE_HEADER_INVALID");
+}
+function readCommitAt(fd: number, record: CommitRecord): CommitRecord | undefined {
+  const bytes = Buffer.alloc(generationBudgets.markerBytes + 1);
+  const count = fs.readSync(fd, bytes, 0, bytes.length, record.offset), end = bytes.subarray(0, count).indexOf(10);
+  if (end < 0) return undefined;
+  const line = decoder.decode(bytes.subarray(0, end));
+  if (!line.startsWith('{"type":"omp_generation')) return undefined;
+  let value: unknown; try { value = JSON.parse(line); } catch { throw new Error("GENERATION_COMMIT_CORRUPT"); }
+  if (!marker(value) || JSON.stringify(value) !== JSON.stringify(record)) throw new Error("GENERATION_HEAD_MISMATCH");
+  return value;
+}
+function readHead(fd: number): CommitHead | undefined {
+  const bytes = readFileXattr(fd, HEAD_XATTR, 1024);
+  if (!bytes) return undefined;
+  let value: unknown; try { value = JSON.parse(decoder.decode(bytes)); } catch { throw new Error("GENERATION_HEAD_CORRUPT"); }
+  if (!isRecord(value) || value.version !== 1 || value.carrier !== carrierIdentity(fd)
+    || !marker(value.current) || (value.previous !== undefined && !marker(value.previous)) || typeof value.checksum !== "string")
+    throw new Error("GENERATION_HEAD_CORRUPT");
+  const payload = { version: 1, carrier: value.carrier, current: value.current,
+    ...(value.previous === undefined ? {} : { previous: value.previous }) };
+  if (hash(JSON.stringify(payload)) !== value.checksum) throw new Error("GENERATION_HEAD_CORRUPT");
+  return { ...payload, version: 1, checksum: value.checksum };
+}
+function committedHead(fd: number, head: CommitHead): CommitRecord | undefined {
+  if (readCommitAt(fd, head.current)) return head.current;
+  if (!head.previous) return undefined;
+  if (!readCommitAt(fd, head.previous)) throw new Error("GENERATION_PREDECESSOR_MISSING");
+  return head.previous;
+}
+function openSidecar(parentFd: number, file: string): number {
+  return fs.openSync(`/proc/self/fd/${parentFd}/${generationDirectory(file)}`,
+    fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+}
+function readSidecar(directoryFd: number, name: string, max: number): Buffer {
+  const fd = fs.openSync(`/proc/self/fd/${directoryFd}/${name}`, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+  try { if (!fs.fstatSync(fd).isFile()) throw new Error("GENERATION_NOT_REGULAR"); return readHeldBytes(fd, max); }
+  finally { fs.closeSync(fd); }
+}
+function resolveCommit(fd: number, parentFd: number, file: string, record: CommitRecord, expectedId: string): string {
+  const directoryFd = openSidecar(parentFd, file);
+  try {
+    const bytes = readSidecar(directoryFd, `${record.offset}-${record.token}.meta`, generationBudgets.metadataBytes);
+    if (hash(bytes) !== record.metadataSha256) throw new Error("GENERATION_METADATA_CORRUPT");
+    const value: unknown = JSON.parse(decoder.decode(bytes));
+    if (!metadata(value) || value.token !== record.token || value.offset !== record.offset
+      || value.carrier !== carrierIdentity(fd) || value.nativeSessionId !== expectedId) throw new Error("GENERATION_BINDING_MISMATCH");
+    const body = readSidecar(directoryFd, `${record.token}.gen`, generationBudgets.bodyBytes);
+    if (body.length !== value.bytes || hash(body) !== value.sha256) throw new Error("GENERATION_CONTENT_CORRUPT");
+    const text = decoder.decode(body);
+    if (!text.endsWith("\n") || nativeId(text) !== expectedId) throw new Error("GENERATION_NATIVE_HEADER_INVALID");
+    return text;
+  } finally { fs.closeSync(directoryFd); }
+}
+/** Complete malformed/unsupported commits are errors. An incomplete last record is never a commit. */
+export function resolveHeldGeneration(fd: number, parentFd: number, file: string): ResolvedGeneration {
+  const bytes = readHeldBytes(fd), physicalBytes = bytes.length;
+  const complete = bytes.lastIndexOf(10) + 1;
+  const header = headerPosition(bytes);
+  const head = readHead(fd);
+  if (header.type === CARRIER_TYPE && !head) throw new Error("GENERATION_CONTROL_MISSING");
+  const committed = head ? committedHead(fd, head) : undefined;
+  const normalized = Buffer.from(bytes.subarray(0, complete));
+  if (header.type === CARRIER_TYPE) normalized.write("session", header.valueOffset, "ascii");
+  const physical = decoder.decode(normalized);
+  let latest: { record: CommitRecord; end: number } | undefined, offset = 0;
+  for (const line of physical.split("\n")) {
+    if (!line) continue;
+    let value: unknown;
+    if (line.startsWith('{"type":"omp_generation')) {
+      try { value = JSON.parse(line); } catch { throw new Error("GENERATION_COMMIT_CORRUPT"); }
+      if (isRecord(value) && value.type !== COMMIT_TYPE) throw new Error("GENERATION_FORMAT_UNSUPPORTED");
+      if (marker(value)) {
+        if (Buffer.byteLength(line) > generationBudgets.markerBytes || value.offset !== offset) throw new Error("GENERATION_COMMIT_CORRUPT");
+        latest = { record: value, end: offset + Buffer.byteLength(line) + 1 };
+      }
+    }
+    offset += Buffer.byteLength(line) + 1;
+  }
+  if ((latest?.record.token ?? undefined) !== committed?.token) throw new Error("GENERATION_HEAD_STALE_OR_MISSING");
+  if (!latest) return { text: physical, physicalBytes, logicalBytes: Buffer.byteLength(physical), committed: false };
+  const prefix = resolveCommit(fd, parentFd, file, latest.record, nativeId(physical));
+  const text = prefix + decoder.decode(bytes.subarray(latest.end, complete));
+  if (Buffer.byteLength(text) > generationBudgets.bodyBytes) throw new Error("GENERATION_BODY_LIMIT");
+  return { text, physicalBytes, logicalBytes: Buffer.byteLength(text), committed: true };
+}
+export function readNativeGeneration(file: string): ResolvedGeneration {
+  const parentFd = fs.openSync(path.dirname(file), fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+  const fd = fs.openSync(`/proc/self/fd/${parentFd}/${path.basename(file)}`, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+  try { return resolveHeldGeneration(fd, parentFd, file); }
+  finally { fs.closeSync(fd); fs.closeSync(parentFd); }
+}
+function writeComplete(fd: number, bytes: Buffer, start: number): void {
+  let offset = 0;
+  while (offset < bytes.length) {
+    const count = fs.writeSync(fd, bytes, offset, bytes.length - offset, start + offset);
+    if (!count) throw new Error("GENERATION_SHORT_WRITE"); offset += count;
+  }
+}
+function budget(directoryFd: number, needed: number): void {
+  const directory = fs.opendirSync(`/proc/self/fd/${directoryFd}`);
+  let entries = 0, generations = 0, retained = 0;
+  try {
+    for (let entry = directory.readSync(); entry; entry = directory.readSync()) {
+      if (++entries > generationBudgets.directoryEntries) throw new Error("GENERATION_COUNT_LIMIT");
+      if (!/^(?:[0-9a-f-]{36}\.gen|\d+-[0-9a-f-]{36}\.meta)$/.test(entry.name)) throw new Error("GENERATION_DIRECTORY_INVALID");
+      const stat = fs.lstatSync(`/proc/self/fd/${directoryFd}/${entry.name}`);
+      if (!stat.isFile()) throw new Error("GENERATION_DIRECTORY_INVALID");
+      retained += stat.size; if (entry.name.endsWith(".gen")) generations++;
+    }
+  } finally { directory.closeSync(); }
+  if (generations >= generationBudgets.generations || entries + 2 > generationBudgets.directoryEntries)
+    throw new Error("GENERATION_COUNT_LIMIT");
+  if (retained + needed + generationBudgets.metadataBytes > generationBudgets.retainedBytes)
+    throw new Error("GENERATION_RETAINED_BYTES_LIMIT");
+}
+/** Called inside the existing native mutation lock while the real lease remains held. Software-crash durability only. */
+export function publishHeldGeneration(fd: number, parentFd: number, file: string, body: string,
+  assertCurrent: () => void, options?: { expectedSize?: number | null; commitGuard?: () => boolean }): boolean {
+  assertCurrent();
+  const bytes = Buffer.from(body, "utf8");
+  if (bytes.length > generationBudgets.bodyBytes) throw new Error("GENERATION_BODY_LIMIT");
+  const before = resolveHeldGeneration(fd, parentFd, file);
+  if (before.physicalBytes && fs.readSync(fd, Buffer.alloc(1), 0, 1, before.physicalBytes - 1) !== 1)
+    throw new Error("GENERATION_CARRIER_UNREADABLE");
+  const last = Buffer.alloc(1); fs.readSync(fd, last, 0, 1, before.physicalBytes - 1);
+  if (last[0] !== 10) throw new Error("GENERATION_INCOMPLETE_TAIL");
+  if (options?.expectedSize !== undefined && options.expectedSize !== before.logicalBytes) throw new Error("STRICT_WRITE_CONFLICT");
+  const id = nativeId(before.text);
+  if (!body.endsWith("\n") || nativeId(body) !== id) throw new Error("GENERATION_NATIVE_HEADER_INVALID");
+  if (options?.commitGuard && !options.commitGuard()) return false;
+  try { fs.mkdirSync(`/proc/self/fd/${parentFd}/${generationDirectory(file)}`, { mode: 0o700 }); }
+  catch (error) { if (!isRecord(error) || error.code !== "EEXIST") throw error; }
+  const directoryFd = openSidecar(parentFd, file);
+  try {
+    budget(directoryFd, bytes.length); assertCurrent();
+    const token = crypto.randomUUID();
+    const value: GenerationMetadata = { format: "omp-native-generation", version: 1, token, carrier: carrierIdentity(fd),
+      nativeSessionId: id, offset: before.physicalBytes, bytes: bytes.length, sha256: hash(bytes) };
+    const metadataBytes = Buffer.from(JSON.stringify(value), "utf8");
+    for (const [name, contents] of [[`${token}.gen`, bytes], [`${value.offset}-${token}.meta`, metadataBytes]] as const) {
+      const target = fs.openSync(`/proc/self/fd/${directoryFd}/${name}`,
+        fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o400);
+      try { writeComplete(target, contents, 0); } finally { fs.closeSync(target); }
+    }
+    assertCurrent();
+    if (options?.commitGuard && !options.commitGuard()) return false;
+    if (fs.fstatSync(fd).size !== before.physicalBytes) throw new Error("STRICT_WRITE_CONFLICT");
+    const payload = { type: COMMIT_TYPE, version: 1, token, offset: value.offset, metadataSha256: hash(metadataBytes) };
+    const record: CommitRecord = { ...payload, type: COMMIT_TYPE, version: 1, checksum: hash(JSON.stringify(payload)) };
+    const previousHead = readHead(fd), previous = previousHead ? committedHead(fd, previousHead) : undefined;
+    const headPayload = { version: 1, carrier: carrierIdentity(fd), current: record, ...(previous ? { previous } : {}) };
+    writeFileXattr(fd, HEAD_XATTR, Buffer.from(JSON.stringify({ ...headPayload, checksum: hash(JSON.stringify(headPayload)) })));
+    assertCurrent();
+    const header = headerPosition(readHeldBytes(fd));
+    if (header.type === "session") {
+      writeComplete(fd, Buffer.from(CARRIER_TYPE, "ascii"), header.valueOffset);
+      assertCurrent();
+      if (headerPosition(readHeldBytes(fd)).type !== CARRIER_TYPE) throw new Error("GENERATION_MARKER_OUTCOME_UNKNOWN");
+    }
+    writeComplete(fd, Buffer.from(JSON.stringify(record) + "\n", "utf8"), value.offset); assertCurrent();
+    const confirmed = resolveHeldGeneration(fd, parentFd, file);
+    if (confirmed.text !== body) throw new Error("GENERATION_COMMIT_OUTCOME_UNKNOWN");
+    return true;
+  } finally { fs.closeSync(directoryFd); }
+}
