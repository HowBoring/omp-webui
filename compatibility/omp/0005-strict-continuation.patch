+/** Deferred interactive startup. Continue never resolves another physical instance or creates a sibling. */
+export const strictStartDefs = {
+  StrictStartupPolicy: {
+    version: "'strict-start-v1'", status: "'prototype'", platforms: "string[]", ownership: "'native-exclusive-lease'",
+    selectedInstance: "'anchored-carrier'", publication: "'native-generation-v1'", carrierFormat: "'ompgen1'",
+    xattrs: "'required-fd-user-xattr'", durability: "'process-crash-only'", rollback: "'flatten-export-required'",
+    maxLogicalBytes: "number.integer", maxCarrierBytes: "number.integer", maxRetainedBytes: "number.integer",
+    maxGenerations: "number.integer", catalogCarrierPrefixBytes: "number.integer", catalogControlBytes: "number.integer", catalogGenerationPrefixBytes: "number.integer",
+  },
+  StrictStartState: {
+    version: "'strict-start-v1'", phase: "'waiting' | 'opening' | 'open' | 'failed' | 'cancelling' | 'cancelled' | 'outcome_unknown'",
+    "intent?": "'continue' | 'new'", "operationId?": "string", "code?": "string",
+    "binding?": "CatalogDescriptor", "nativeSessionId?": "string", "cwd?": "string",
+  },
+};
+export const strictStartCommands = [
+  { name: "strict_start", doc: "Explicitly create or continue after exact-instance ownership and cwd validation. Never replay.",
