+      try { return this.#reservation.auxiliary(file, false, target => fs.existsSync(target)); }
+      catch (error) { if (error instanceof Error && "code" in error && error.code === "ENOENT") return false; throw error; }
+    }
+    this.#check(file); return true;
+  }
+  exists(file: string): Promise<boolean> { return Promise.resolve(this.existsSync(file)); }
+  statSync(file: string): SessionStorageStat {
+    this.#check(file);
+    const stat = fs.statSync(file), logicalSize = Buffer.byteLength(this.#reservation.read());
+    this.#check(file); return { size: logicalSize, mtimeMs: stat.mtimeMs, mtime: stat.mtime };
+  }
+  readText(file: string): Promise<string> { return Promise.resolve(this.readTextSync(file)); }
+  readTextSync(file: string): string {
+    if (this.#reservation.auxiliaryName(file)) return this.#reservation.auxiliary(file, false, target => {
+      const fd = fs.openSync(target, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+      try { if (fs.fstatSync(fd).size > 5 * 1024 * 1024) throw new Error("STRICT_DRAFT_BYTES_LIMIT"); return fs.readFileSync(fd, "utf8"); }
+      finally { fs.closeSync(fd); }
+    });
+    this.#check(file); return this.#reservation.read();
+  }
+  readTextSlices(file: string, head: number, tail: number): Promise<[string, string]> {
+    const bytes = Buffer.from(this.readTextSync(file));
+    return Promise.resolve([bytes.subarray(0, head).toString("utf8"), bytes.subarray(Math.max(0, bytes.length - tail)).toString("utf8")]);
+  }
+  listFilesSync(_dir: string, _pattern: string): string[] { throw new Error("STRICT_ALTERNATE_TARGET_FORBIDDEN"); }
+  writeTextSync(file: string, body: string, options?: WriteTextAtomicOptions): void {
+    this.#check(file); this.#files.withStrictMutationSync(file, () => this.#reservation.publish(body, options));
+  }
+  writeLinesSync(file: string, body: readonly string[], options?: SessionStorageWriteOptions): void { this.writeTextSync(file, body.join(""), options); }
+  async writeText(file: string, body: string): Promise<void> {
+    if (this.#reservation.auxiliaryName(file)) {
+      if (Buffer.byteLength(body) > 5 * 1024 * 1024) throw new Error("STRICT_DRAFT_BYTES_LIMIT");
+      this.#reservation.auxiliary(file, true, target => {
+        const fd = fs.openSync(target, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_NOFOLLOW, 0o600);
+        try { fs.writeFileSync(fd, body, "utf8"); fs.ftruncateSync(fd, Buffer.byteLength(body)); }
+        finally { fs.closeSync(fd); }
+      }); return;
+    }
+    this.writeTextSync(file, body);
+  }
+  async writeTextAtomic(file: string, body: string, options?: WriteTextAtomicOptions): Promise<void> { this.writeTextSync(file, body, options); }
+  async writeLinesAtomic(file: string, body: readonly string[], options?: WriteTextAtomicOptions): Promise<void> { this.writeTextSync(file, body.join(""), options); }
+  async appendSessionTitleAtomically(file: string, line: string, update: SessionTitleUpdate, expectedSize: number | null): Promise<void> {
+    this.#check(file);
+    this.#files.withStrictMutationSync(file, () => {
+      const current = this.#reservation.read();
+      this.#reservation.publish(overlayTitleSlotContent(current + line, update), { expectedSize });
+    });
+  }
+  async updateSessionTitle(file: string, update: SessionTitleUpdate): Promise<void> {
+    this.#check(file); const current = this.#reservation.read();
+    this.writeTextSync(file, overlayTitleSlotContent(current, update), { expectedSize: Buffer.byteLength(current) });
+  }
+  rename(file: string, _next: string): Promise<void> { this.#check(file); throw new Error("STRICT_RELOCATION_FORBIDDEN"); }
+  async unlink(file: string): Promise<void> {
+    if (this.#reservation.auxiliaryName(file)) { this.#reservation.auxiliary(file, false, target => fs.unlinkSync(target)); return; }
+    this.#check(file); throw new Error("STRICT_DELETE_FORBIDDEN");
+  }
+  deleteSessionWithArtifacts(file: string): Promise<void> { return this.unlink(file); }
+  withSessionFileLockSync<T>(file: string, operation: () => T): T {
+    this.#check(file);
+    return this.#files.withSessionFileLockSync(file, () => { this.#check(file); const result = operation(); this.#check(file); return result; });
+  }
+  claimSession(id: string, file: string): () => void {
+    this.#check(file);
+    if (id !== this.#reservation.descriptor.nativeSessionId) throw new Error("STRICT_NATIVE_ID_CHANGED");
+    // The reservation already owns a real OS lease. Manager releases cannot relinquish it before full worker disposal.
+    return () => {};
+  }
+  openWriter(file: string, options?: { flags?: "a" | "w"; onError?: (error: Error) => void }): SessionStorageWriter {
+    this.#check(file);
+    if (options?.flags === "w") this.#reject(file);
+    let closed = false, failure: Error | undefined;
+    const append = (line: string): void => {
+      if (closed) throw new Error("STRICT_WRITER_CLOSED");
+      if (failure) throw failure;
+      try { this.#check(file); this.#files.withStrictMutationSync(file, () => this.#reservation.append(line)); }
+      catch (error) { failure = error instanceof Error ? error : new Error("STRICT_WRITE_FAILED"); options?.onError?.(failure); throw failure; }
+    };
+    const flush = (): void => { if (failure) throw failure; this.#check(file); };
+    return { appendSync: append, append: async line => append(line), flush: async () => flush(), flushSync: flush,
+      close: async () => { closed = true; if (failure) throw failure; }, isOpen: () => !closed, getError: () => failure };
+  }
+  drain(): Promise<void> { this.#reservation.assertCurrent(); return Promise.resolve(); }
+}
diff --git a/packages/coding-agent/src/utils/file-new-publication.ts b/packages/coding-agent/src/utils/file-new-publication.ts
new file mode 100644
index 0000000000..574de0bde5
--- /dev/null
+++ b/packages/coding-agent/src/utils/file-new-publication.ts
@@ -0,0 +1,26 @@
+/** Linux publication of a complete NEW file. Anonymous preparation and fd-bound linkat never clobber a destination. */
+import * as fs from "node:fs";
+import { dlopen, FFIType, ptr } from "bun:ffi";
+export function publishNewFile(directoryFd: number, name: string, bytes: Buffer, mode: number, assertCurrent: () => void): void {
+  if (process.platform !== "linux" || !name || name.includes("/") || name.includes("\0")) throw new Error("GENERATION_NEW_PUBLICATION_UNSUPPORTED");
+  assertCurrent();
+  let fd: number;
+  try { fd = fs.openSync(`/proc/self/fd/${directoryFd}`, 0x410002, mode); } // Linux O_TMPFILE | O_RDWR; no named staging cleanup.
+  catch { throw new Error("GENERATION_NEW_PUBLICATION_UNSUPPORTED"); }
+  try {
+    let offset = 0;
+    while (offset < bytes.length) {
+      const count = fs.writeSync(fd, bytes, offset, bytes.length - offset, offset);
+      if (!count) throw new Error("GENERATION_NEW_SHORT_WRITE"); offset += count;
+    }
+    fs.fchmodSync(fd, mode); assertCurrent();
+    const libc = dlopen("libc.so.6", { linkat: { args: [FFIType.i32, FFIType.ptr, FFIType.i32, FFIType.ptr, FFIType.i32], returns: FFIType.i32 } });
+    try {
+      const source = Buffer.from(`/proc/self/fd/${fd}\0`), target = Buffer.from(`${name}\0`);
+      if (libc.symbols.linkat(-100, ptr(source), directoryFd, ptr(target), 0x400) !== 0) throw new Error("GENERATION_NEW_PUBLICATION_REFUSED");
+    } finally { libc.close(); }
+    const held = fs.fstatSync(fd, { bigint: true }), named = fs.statSync(`/proc/self/fd/${directoryFd}/${name}`, { bigint: true });
+    if (held.dev !== named.dev || held.ino !== named.ino || held.birthtimeNs !== named.birthtimeNs) throw new Error("GENERATION_NEW_PUBLICATION_UNKNOWN");
+    assertCurrent();
+  } finally { fs.closeSync(fd); }
+}
