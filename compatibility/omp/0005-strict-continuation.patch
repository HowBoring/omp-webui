index 0000000000..a96b149784
--- /dev/null
+++ b/packages/coding-agent/src/session/session-artifact-copy.ts
@@ -0,0 +1,140 @@
+/** Bounded native logical copy for artifact trees containing generation Sessions; source leases survive every publication. */
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { isRecord } from "@oh-my-pi/pi-utils/type-guards";
+import { publishNewFile } from "../utils/file-new-publication";
+import { tryAcquireSessionLease } from "./session-storage";
+import type { FileLockHandle } from "@oh-my-pi/pi-utils/file-lock";
+import { parseSessionContent } from "./session-loader";
+import { readHeldBytes, readHeldGenerationMetadata, resolveHeldGeneration } from "./session-generation";
+import { sessionHeaderIdFromPrefix } from "./session-header-id";
+
+const identity = (info: fs.BigIntStats): string => `${info.dev}:${info.ino}:${info.birthtimeNs}`;
+interface Directory { fd: number; file: string; identity: string }
+interface Entry { parent: Directory; name: string; relative: string; identity: string; mode: number; fd?: number; nativeId?: string; bytes?: Buffer; link?: string }
+const budgets = Object.freeze({ entries: 8192, directories: 256, depth: 32, nativeSessions: 64, bodyBytes: 128 * 1024 * 1024 });
+
+export interface PreparedGenerationArtifactCopy { publish(destination: string): void; close(): void }
+export function prepareGenerationArtifactTree(source: string): PreparedGenerationArtifactCopy {
+  const sources: Directory[] = [], targets: Directory[] = [], entries: Entry[] = [], leases: FileLockHandle[] = [];
+  let examined = 0, bytes = 0, attempted = false, closed = false;
+  const directory = (file: string, fd: number): Directory => ({ file, fd, identity: identity(fs.fstatSync(fd, { bigint: true })) });
+  const assertDirectories = (items: Directory[]): void => {
+    for (const item of items) if (identity(fs.statSync(item.file, { bigint: true })) !== item.identity)
+      throw new Error("GENERATION_ARTIFACT_DIRECTORY_CHANGED");
+  };
+  const assertSources = (): void => {
+    assertDirectories(sources);
+    if (closed) throw new Error("GENERATION_ARTIFACT_COPY_CLOSED");
+    for (const entry of entries) if (identity(fs.lstatSync(`/proc/self/fd/${entry.parent.fd}/${entry.name}`, { bigint: true })) !== entry.identity)
+      throw new Error("GENERATION_ARTIFACT_CHANGED");
+  };
+  const inventory = (parent: Directory, relative: string, depth: number): void => {
+    if (depth > budgets.depth) throw new Error("GENERATION_ARTIFACT_SCAN_LIMIT");
+    const listing = fs.opendirSync(`/proc/self/fd/${parent.fd}`), controls: string[] = [], names = new Set<string>();
+    try {
+      for (let item = listing.readSync(); item; item = listing.readSync()) {
+        if (++examined > budgets.entries) throw new Error("GENERATION_ARTIFACT_SCAN_LIMIT");
+        const control = /^\.(.+)\.omp-generations$/.exec(item.name);
+        if (control) { if (!control[1]) throw new Error("GENERATION_ARTIFACT_CONTROL_INVALID"); controls.push(control[1]); continue; }
+        names.add(item.name);
+        const file = `/proc/self/fd/${parent.fd}/${item.name}`, childRelative = path.join(relative, item.name);
+        if (item.isDirectory()) {
+          if (sources.length >= budgets.directories) throw new Error("GENERATION_ARTIFACT_SCAN_LIMIT");
+          const child = directory(path.join(source, childRelative), fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW));
+          sources.push(child); inventory(child, childRelative, depth + 1); continue;
+        }
+        const info = fs.lstatSync(file, { bigint: true });
+        const entry: Entry = { parent, name: item.name, relative: childRelative, identity: identity(info), mode: Number(info.mode & 0o777n) };
+        if (info.isSymbolicLink()) entry.link = fs.readlinkSync(file);
+        else if (info.isFile()) {
+          const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+          try {
+            if (identity(fs.fstatSync(fd, { bigint: true })) !== entry.identity) throw new Error("GENERATION_ARTIFACT_CHANGED");
+            if (item.name.endsWith(".jsonl")) {
+              const prefix = Buffer.alloc(16_384), count = fs.readSync(fd, prefix, 0, prefix.length, 0);
+              const leading = prefix.subarray(0, count);
+              const nativePrefix = /"type"\s*:\s*"ompgen1"/.test(leading.toString("utf8"))
+                ? readHeldGenerationMetadata(fd, parent.fd, path.join(source, childRelative), 16_384, leading) : leading;
+              const nativeId = sessionHeaderIdFromPrefix(nativePrefix); if (nativeId) { entry.nativeId = nativeId; entry.fd = fd; }
+            }
+            if (!entry.nativeId) {
+              entry.bytes = readHeldBytes(fd, budgets.bodyBytes - bytes); bytes += entry.bytes.length;
+              if (fs.fstatSync(fd, { bigint: true }).size !== BigInt(entry.bytes.length)) throw new Error("GENERATION_ARTIFACT_CHANGED");
+            }
+          } finally { if (entry.fd !== fd) fs.closeSync(fd); }
+        } else throw new Error("GENERATION_ARTIFACT_TYPE_UNSUPPORTED");
+        entries.push(entry);
+      }
+      if (controls.some(name => !names.has(name))) throw new Error("GENERATION_ARTIFACT_CONTROL_ORPHANED");
+    } finally { listing.closeSync(); }
+  };
+  try {
+    if (fs.realpathSync(source) !== source) throw new Error("GENERATION_ARTIFACT_SOURCE_ALIAS_UNSUPPORTED");
+    sources.push(directory(source, fs.openSync(source, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW)));
+    inventory(sources[0]!, "", 0); assertSources();
+    // Real leases and complete shared-reader cuts precede ALL destination mutation.
+    for (const entry of entries) if (entry.nativeId) {
+      if (leases.length >= budgets.nativeSessions) throw new Error("GENERATION_ARTIFACT_SESSION_LIMIT");
+      let lease: FileLockHandle | null;
+      try { lease = tryAcquireSessionLease(entry.nativeId); } catch { throw new Error("STRICT_OWNERSHIP_UNKNOWN"); }
+      if (!lease) throw new Error("STRICT_OCCUPIED"); leases.push(lease); assertSources();
+      if (entry.fd === undefined) throw new Error("GENERATION_ARTIFACT_BODY_UNAVAILABLE");
+      const length = fs.fstatSync(entry.fd).size, last = Buffer.alloc(1);
+      if (!length || fs.readSync(entry.fd, last, 0, 1, length - 1) !== 1 || last[0] !== 10) throw new Error("GENERATION_ARTIFACT_INCOMPLETE_TAIL");
+      const text = resolveHeldGeneration(entry.fd, entry.parent.fd, path.join(source, entry.relative)).text;
+      const parsed = parseSessionContent(text);
+      if (parsed.invalidHeader || parsed.malformedRecords) throw new Error("GENERATION_ARTIFACT_NATIVE_INVALID");
+      entry.bytes = Buffer.from(text);
+      if (sessionHeaderIdFromPrefix(entry.bytes.subarray(0, 16_384)) !== entry.nativeId) throw new Error("GENERATION_ARTIFACT_NATIVE_ID_CHANGED");
+      bytes += entry.bytes.length;
+      if (bytes > budgets.bodyBytes) throw new Error("GENERATION_ARTIFACT_BODY_LIMIT");
+    }
+    assertSources();
+  } catch (error) { close(); throw error; }
+  function close(): void {
+    if (closed) return; closed = true;
+    let failure: unknown;
+    for (const release of [
+      ...leases.map(lease => () => lease.release()),
+      ...entries.filter(entry => entry.fd !== undefined).map(entry => () => fs.closeSync(entry.fd!)),
+      ...[...targets, ...sources].reverse().map(item => () => fs.closeSync(item.fd)),
+    ]) { try { release(); } catch (error) { failure ??= error; } }
+    if (failure) throw failure;
+  }
+  return { close, publish(destination: string): void {
+    if (attempted) throw new Error("GENERATION_ARTIFACT_COPY_ALREADY_ATTEMPTED"); attempted = true; assertSources();
+    fs.mkdirSync(destination, { recursive: true, mode: 0o700 });
+    const root = directory(destination, fs.openSync(destination, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW)); targets.push(root);
+    const byRelative = new Map<string, Directory>([["", root]]);
+    const targetParent = (relative: string): Directory => {
+      const existing = byRelative.get(relative); if (existing) return existing;
+      const parent = targetParent(path.dirname(relative) === "." ? "" : path.dirname(relative)), name = path.basename(relative);
+      const target = `/proc/self/fd/${parent.fd}/${name}`;
+      try { fs.mkdirSync(target, { mode: 0o700 }); } catch (error) { if (!isRecord(error) || error.code !== "EEXIST") throw error; }
+      const child = directory(path.join(destination, relative), fs.openSync(target, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW));
+      targets.push(child); byRelative.set(relative, child); return child;
+    };
+    const publications = entries.map(entry => ({ entry, parent: targetParent(path.dirname(entry.relative) === "." ? "" : path.dirname(entry.relative)) }));
+    for (const { entry, parent } of publications) {
+      try { fs.lstatSync(`/proc/self/fd/${parent.fd}/${entry.name}`); throw new Error("GENERATION_ARTIFACT_DESTINATION_OCCUPIED"); }
+      catch (error) { if (!isRecord(error) || error.code !== "ENOENT") throw error; }
+    }
+    const assertCurrent = (): void => { assertSources(); assertDirectories(targets); };
+    for (const { entry, parent } of publications) {
+      assertCurrent();
+      if (entry.link !== undefined) {
+        const target = `/proc/self/fd/${parent.fd}/${entry.name}`; fs.symlinkSync(entry.link, target);
+        if (fs.readlinkSync(target) !== entry.link) throw new Error("GENERATION_ARTIFACT_PUBLICATION_UNKNOWN");
+      }
+      else if (entry.bytes) publishNewFile(parent.fd, entry.name, entry.bytes, entry.mode, assertCurrent);
+      else throw new Error("GENERATION_ARTIFACT_BODY_UNAVAILABLE");
+      assertCurrent();
+    }
+  } };
+}
+
+export function copyGenerationArtifactTree(source: string, destination: string): void {
+  const prepared = prepareGenerationArtifactTree(source);
+  try { prepared.publish(destination); } finally { prepared.close(); }
+}
