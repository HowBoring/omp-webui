+import { SESSION_DRAFT_FILE, DRAFT_ONLY_SESSION_MARKER } from "../../session/session-drafts";
+/** Exact-instance ownership acquired before ordinary Session or extension initialization. */
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { FileHandle } from "node:fs/promises";
+import { getSessionOwnersDir } from "@oh-my-pi/pi-utils/dirs";
+import { tryAcquireFileLock, type FileLockHandle } from "@oh-my-pi/pi-utils/file-lock";
+import { resolveHeldGeneration, publishHeldGeneration, generationBudgets } from "../../session/session-generation";
+import { openWithin } from "./catalog-path";
+import { hash, readDescriptor, type NativeSource } from "./catalog-metadata";
+import type { CatalogDescriptor } from "./wire/rpc-wire.generated";
+
+export class StrictReservation {
+  readonly descriptor: CatalogDescriptor;
+  readonly filePath: string;
+  readonly #source: NativeSource;
+  readonly #anchor: FileHandle | undefined;
+  readonly #lease: FileLockHandle;
+  readonly #fd: number;
+  readonly #parentFd: number;
+  readonly #parentIdentity: string;
+  readonly #cwdFd: number;
+  readonly #cwdPath: string;
+  readonly #cwdIdentity: string;
+  #writeAttempted = false;
+  #released = false;
+  #cancelled = false;
+  #failure: Error | undefined;
+
+  constructor(source: NativeSource, filePath: string, descriptor: CatalogDescriptor,
+    anchor: FileHandle | undefined, lease: FileLockHandle, fd: number, cwdFd: number, cwdPath: string) {
+    this.#source = source; this.filePath = filePath; this.descriptor = descriptor;
+    this.#anchor = anchor; this.#lease = lease; this.#fd = fd;
+    this.#parentFd = fs.openSync(path.dirname(filePath), fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+    const parent = fs.fstatSync(this.#parentFd, { bigint: true });
+    this.#parentIdentity = hash(`${parent.dev}:${parent.ino}:${parent.birthtimeNs}`);
+    this.#cwdFd = cwdFd; this.#cwdPath = cwdPath;
+    const info = fs.fstatSync(cwdFd, { bigint: true });
+    this.#cwdIdentity = hash(`${info.dev}:${info.ino}:${info.birthtimeNs}`);
+  }
+
+  static async acquire(source: NativeSource, filePath: string, expected: CatalogDescriptor,
+    expectedCwd: string, signal: AbortSignal): Promise<StrictReservation> {
+    if (process.platform !== "linux") throw new Error("STRICT_PLATFORM_UNVALIDATED");
+    signal.throwIfAborted();
+    if (expected.cwd.status !== "known" || expected.cwd.canonical !== expectedCwd
+      || await fs.promises.realpath(expectedCwd) !== expectedCwd) throw new Error("STRICT_CWD_MISMATCH");
+    const name = /^[A-Za-z0-9_-]{1,128}$/.test(expected.nativeSessionId) ? expected.nativeSessionId
+      : `h-${Bun.hash.wyhash(expected.nativeSessionId).toString(16).padStart(16, "0")}`;
+    let lease: FileLockHandle | null;
+    try { lease = tryAcquireFileLock(path.join(getSessionOwnersDir(), name)); }
+    catch { throw new Error("STRICT_OWNERSHIP_UNKNOWN"); }
+    if (!lease) throw new Error("STRICT_OCCUPIED");
+    let anchor: FileHandle | undefined, fd: number | undefined, cwdFd: number | undefined;
+    try {
+      signal.throwIfAborted();
+      const descriptor = await readDescriptor(source, filePath);
+      if (descriptor.instanceId !== expected.instanceId || descriptor.nativeSessionId !== expected.nativeSessionId)
+        throw new Error("STRICT_REPLACED");
+      if (descriptor.cwd.status !== "known" || descriptor.cwd.canonical !== expectedCwd)
+        throw new Error("STRICT_CWD_MISMATCH");
+      anchor = await openWithin(source.root, source.rootIdentity, filePath);
+      fd = fs.openSync(`/proc/self/fd/${anchor.fd}`, fs.constants.O_RDWR);
+      cwdFd = fs.openSync(expectedCwd, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+      const reservation = new StrictReservation(source, filePath, descriptor, anchor, lease, fd, cwdFd, expectedCwd);
+      reservation.assertCurrent(); reservation.assertWritableTail(); signal.throwIfAborted();
+      return reservation;
+    } catch (error) {
+      if (fd !== undefined) fs.closeSync(fd);
+      if (cwdFd !== undefined) fs.closeSync(cwdFd);
+      await anchor?.close(); lease.release(); throw error;
+    }
+  }
+
+  /** Explicit New alone may exclusively create a native carrier. Failure never retries or deletes an uncertain creation. */
+  static async create(source: NativeSource, filePath: string, nativeSessionId: string, body: string,
+    expectedCwd: string, signal: AbortSignal): Promise<StrictReservation> {
+    if (process.platform !== "linux") throw new Error("STRICT_PLATFORM_UNVALIDATED");
+    if (await fs.promises.realpath(expectedCwd) !== expectedCwd) throw new Error("STRICT_CWD_MISMATCH");
+    signal.throwIfAborted();
+    let lease: FileLockHandle | null;
+    try { lease = tryAcquireFileLock(path.join(getSessionOwnersDir(), nativeSessionId)); }
+    catch { throw new Error("STRICT_OWNERSHIP_UNKNOWN"); }
+    if (!lease) throw new Error("STRICT_OCCUPIED");
+    let anchor: FileHandle | undefined, fd: number | undefined, cwdFd: number | undefined;
+    let parent: FileHandle | undefined;
+    try {
+      parent = await openWithin(source.root, source.rootIdentity, path.dirname(filePath), true);
+      signal.throwIfAborted();
+      cwdFd = fs.openSync(expectedCwd, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+      fd = fs.openSync(`/proc/self/fd/${parent.fd}/${path.basename(filePath)}`,
+        fs.constants.O_RDWR | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);
+      const bytes = Buffer.from(body, "utf8"); let offset = 0;
+      while (offset < bytes.length) {
+        const count = fs.writeSync(fd, bytes, offset, bytes.length - offset, offset);
+        if (!count) throw new Error("STRICT_NEW_OUTCOME_UNKNOWN"); offset += count;
+      }
+      anchor = await openWithin(source.root, source.rootIdentity, filePath);
+      const descriptor = await readDescriptor(source, filePath);
+      if (descriptor.nativeSessionId !== nativeSessionId) throw new Error("STRICT_NEW_OUTCOME_UNKNOWN");
+      const result = new StrictReservation(source, filePath, descriptor, anchor, lease, fd, cwdFd, expectedCwd);
+      result.#writeAttempted = true; result.assertCurrent(); signal.throwIfAborted();
+      return result;
+    } catch (error) {
+      if (fd !== undefined) fs.closeSync(fd);
+      if (cwdFd !== undefined) fs.closeSync(cwdFd);
+      await anchor?.close(); lease.release();
+      if (fd !== undefined) throw new Error("STRICT_NEW_OUTCOME_UNKNOWN");
+      throw error;
+    } finally { await parent?.close(); }
+  }
+
+  /** Native explicit-transition factory. Source-owned logical serialization is exclusively materialized under a real lease. */
+  static createNativeFileSync(filePath: string, body: string, expectedCwd: string): StrictReservation {
+    const root = fs.realpathSync(path.dirname(filePath)), cwd = fs.realpathSync(expectedCwd);
+    if (cwd !== expectedCwd || path.resolve(filePath) !== path.join(root, path.basename(filePath))) throw new Error("STRICT_NEW_PATH_MISMATCH");
+    const rootInfo = fs.statSync(root, { bigint: true }), rootIdentity = hash(`${rootInfo.dev}:${rootInfo.ino}:${rootInfo.birthtimeNs}`);
+    const source: NativeSource = { root, rootIdentity, sourceId: hash(`native-explicit:${root}:${rootIdentity}`) };
+    let header: unknown;
+    for (const line of body.split("\n", 3).slice(0, 2)) {
+      const candidate: unknown = JSON.parse(line);
+      if (typeof candidate === "object" && candidate !== null && "type" in candidate && candidate.type === "session") header = candidate;
+    }
+    if (typeof header !== "object" || header === null || !("id" in header) || typeof header.id !== "string"
+      || !("timestamp" in header) || typeof header.timestamp !== "string") throw new Error("STRICT_NATIVE_HEADER_INVALID");
+    const nativeSessionId = header.id;
+    let lease: FileLockHandle | null;
+    try { lease = tryAcquireFileLock(path.join(getSessionOwnersDir(), nativeSessionId)); }
+    catch { throw new Error("STRICT_OWNERSHIP_UNKNOWN"); }
+    if (!lease) throw new Error("STRICT_OCCUPIED");
+    const parentFd = fs.openSync(root, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+    let fd: number | undefined, cwdFd: number | undefined;
+    try {
+      cwdFd = fs.openSync(cwd, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+      fd = fs.openSync(`/proc/self/fd/${parentFd}/${path.basename(filePath)}`,
+        fs.constants.O_RDWR | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);
+      const info = fs.fstatSync(fd, { bigint: true }), instanceId = hash(`${info.dev}:${info.ino}:${info.birthtimeNs}:${nativeSessionId}`);
+      const reference = Buffer.from(JSON.stringify({ sourceId: source.sourceId, locator: path.basename(filePath), instanceId, nativeSessionId })).toString("base64url");
+      const observedAt = new Date().toISOString();
+      const descriptor: CatalogDescriptor = { sourceId: source.sourceId, instanceId, nativeSessionId, reference,
+        aliases: [path.basename(filePath)], cwd: { status: "known", recorded: cwd, canonical: cwd },
+        createdAt: header.timestamp, modifiedAt: observedAt, observedAt, ownership: { state: "held", observedAt } };
+      const reservation = new StrictReservation(source, filePath, descriptor, undefined, lease, fd, cwdFd, cwd);
+      reservation.#writeAt(body, 0); reservation.read(); return reservation;
+    } catch (error) {
+      if (fd !== undefined) fs.closeSync(fd);
+      if (cwdFd !== undefined) fs.closeSync(cwdFd);
+      lease.release();
+      if (fd !== undefined) throw new Error("STRICT_NEW_OUTCOME_UNKNOWN");
+      throw error;
+    } finally { fs.closeSync(parentFd); }
+  }
+
+  /** Every data access is bound to the pinned inode; a new pathname is never adopted. */
+  assertCurrent(filePath = this.filePath): void {
+    if (this.#cancelled) throw new Error("STRICT_CANCELLED");
+    if (path.resolve(filePath) !== this.filePath) throw new Error("STRICT_TARGET_CHANGED");
+    if (this.#failure) throw this.#failure;
+    try {
+      if (this.#released) throw new Error("STRICT_RESERVATION_RELEASED");
+      const root = fs.statSync(this.#source.root, { bigint: true });
+      if (hash(`${root.dev}:${root.ino}:${root.birthtimeNs}`) !== this.#source.rootIdentity)
+        throw new Error("STRICT_SOURCE_REPLACED");
+      const parent = fs.statSync(path.dirname(this.filePath), { bigint: true });
+      if (hash(`${parent.dev}:${parent.ino}:${parent.birthtimeNs}`) !== this.#parentIdentity) throw new Error("STRICT_DIRECTORY_REPLACED");
+      const cwd = fs.statSync(this.#cwdPath, { bigint: true });
+      if (!cwd.isDirectory() || hash(`${cwd.dev}:${cwd.ino}:${cwd.birthtimeNs}`) !== this.#cwdIdentity)
+        throw new Error("STRICT_CWD_REPLACED");
+      const named = fs.statSync(this.filePath, { bigint: true }), held = fs.fstatSync(this.#fd, { bigint: true });
+      const instance = (stat: fs.BigIntStats) => hash(`${stat.dev}:${stat.ino}:${stat.birthtimeNs}:${this.descriptor.nativeSessionId}`);
+      if (!named.isFile() || instance(named) !== this.descriptor.instanceId || instance(held) !== this.descriptor.instanceId)
+        throw new Error("STRICT_REPLACED");
+    } catch (error) {
+      this.#failure = error instanceof Error && error.message.startsWith("STRICT_") ? error : new Error("STRICT_MISSING_OR_INACCESSIBLE");
+      throw this.#failure;
+    }
+  }
+
+  /** Catalog-equivalent existence metadata remains usable for a terminal resume hint after releasing ownership. */
+  hasCurrentMetadata(file: string): boolean {
+    if (path.resolve(file) !== this.filePath) return false;
+    try {
+      const root = fs.statSync(this.#source.root, { bigint: true }), parent = fs.statSync(path.dirname(file), { bigint: true });
+      const named = fs.statSync(file, { bigint: true });
+      return hash(`${root.dev}:${root.ino}:${root.birthtimeNs}`) === this.#source.rootIdentity
+        && hash(`${parent.dev}:${parent.ino}:${parent.birthtimeNs}`) === this.#parentIdentity
+        && hash(`${named.dev}:${named.ino}:${named.birthtimeNs}:${this.descriptor.nativeSessionId}`) === this.descriptor.instanceId;
+    } catch { return false; }
+  }
+
+  auxiliaryName(file: string): string | undefined {
+    const root = this.filePath.slice(0, -".jsonl".length);
+    return [SESSION_DRAFT_FILE, DRAFT_ONLY_SESSION_MARKER].find(name => file === path.join(root, name));
+  }
+
+  auxiliary<T>(file: string, create: boolean, operation: (anchoredPath: string) => T): T {
+    this.assertCurrent();
+    const name = this.auxiliaryName(file);
+    if (!name) throw new Error("STRICT_AUXILIARY_TARGET_FORBIDDEN");
+    const directory = `/proc/self/fd/${this.#parentFd}/${path.basename(this.filePath, ".jsonl")}`;
+    if (create) {
+      try { fs.mkdirSync(directory, { mode: 0o700 }); }
+      catch (error) { if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST") throw error; }
+    }
+    const fd = fs.openSync(directory, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+    try { const result = operation(`/proc/self/fd/${fd}/${name}`); this.assertCurrent(); return result; }
+    finally { fs.closeSync(fd); }
+  }
+
+  cancel(): void { this.#cancelled = true; }
+
+  async currentDescriptor(): Promise<CatalogDescriptor> {
+    this.assertCurrent();
+    this.read();
+    const current = await readDescriptor(this.#source, this.filePath);
+    this.assertCurrent();
+    if (current.instanceId !== this.descriptor.instanceId || current.nativeSessionId !== this.descriptor.nativeSessionId
+      || current.cwd.status !== "known" || current.cwd.canonical !== this.#cwdPath) throw new Error("STRICT_BINDING_CHANGED");
+    return current;
+  }
+
+  verifiedSourceBinding(): { sourceId: string; instanceId: string; nativeSessionId: string; reference: string } {
+    this.read(); this.assertCurrent();
+    const { sourceId, instanceId, nativeSessionId, reference } = this.descriptor;
+    return { sourceId, instanceId, nativeSessionId, reference };
+  }
+
+  assertWritableTail(): void {
+    this.assertCurrent(); const size = fs.fstatSync(this.#fd).size, last = Buffer.alloc(1);
+    if (size === 0 || fs.readSync(this.#fd, last, 0, 1, size - 1) !== 1 || last[0] !== 10)
+      throw new Error("STRICT_INCOMPLETE_NATIVE_TAIL");
+  }
+
+  read(): string {
+    this.assertCurrent();
+    const result = resolveHeldGeneration(this.#fd, this.#parentFd, this.filePath);
+    this.assertCurrent(); return result.text;
+  }
+
+  publish(body: string, options?: { expectedSize?: number | null; commitGuard?: () => boolean }): boolean {
+    this.assertCurrent();
+    this.#writeAttempted = true;
+    try { return publishHeldGeneration(this.#fd, this.#parentFd, this.filePath, body, () => this.assertCurrent(), options); }
+    catch (error) {
+      const clean = error instanceof Error && ["GENERATION_HARDLINK_PUBLICATION_UNSUPPORTED", "GENERATION_BODY_LIMIT", "GENERATION_COUNT_LIMIT", "GENERATION_RETAINED_BYTES_LIMIT", "STRICT_WRITE_CONFLICT"].includes(error.message);
+      if (clean && !this.#failure) throw error;
+      this.#failure = new Error("STRICT_WRITE_OUTCOME_UNKNOWN"); throw this.#failure;
+    }
+  }
+
+  get writeAttempted(): boolean { return this.#writeAttempted; }
+
+  append(line: string): void {
+    this.assertCurrent();
+    if (Buffer.byteLength(this.read()) + Buffer.byteLength(line) > generationBudgets.bodyBytes)
+      throw new Error("GENERATION_BODY_LIMIT");
+    const start = fs.fstatSync(this.#fd).size;
+    if (start + Buffer.byteLength(line) > generationBudgets.carrierBytes) throw new Error("GENERATION_CARRIER_LIMIT");
+    const last = Buffer.alloc(1);
+    if (start > 0 && (fs.readSync(this.#fd, last, 0, 1, start - 1) !== 1 || last[0] !== 10)) throw new Error("GENERATION_INCOMPLETE_TAIL");
+    this.#writeAt(line, start);
+  }
+
+  /** Append or initialize an exclusively created carrier; existing body bytes are never overwritten here. */
+  #writeAt(line: string, start: number): void {
+    this.assertCurrent();
+    if (start !== fs.fstatSync(this.#fd).size) throw new Error("STRICT_NON_APPEND_WRITE_FORBIDDEN");
+    const bytes = Buffer.from(line, "utf8");
+    this.#writeAttempted = true;
+    try {
+      let offset = 0;
+      while (offset < bytes.length) {
+        const count = fs.writeSync(this.#fd, bytes, offset, bytes.length - offset, start + offset);
+        if (count === 0) throw new Error("STRICT_WRITE_FAILED");
+        offset += count;
+      }
+      this.assertCurrent();
+    } catch {
+      this.#failure = new Error("STRICT_WRITE_OUTCOME_UNKNOWN"); throw this.#failure;
+    }
+  }
+
+  async release(): Promise<void> {
+    if (this.#released) return;
+    this.#released = true;
+    try { fs.closeSync(this.#fd); }
+    finally { try { fs.closeSync(this.#parentFd); }
+      finally { try { fs.closeSync(this.#cwdFd); }
+        finally { try { await this.#anchor?.close(); } finally { this.#lease.release(); } } } }
+  }
+}
