@@ -0,0 +1,30 @@
+/** Process-local handoff from deferred startup to the normal public rpc-ui worker. */
+import type { SessionManager } from "../../session/session-manager";
+import type { StrictReservation } from "./strict-reservation";
+import type { StrictStartState } from "./wire/rpc-wire.generated";
+export interface StrictStartupContext {
+  manager: SessionManager;
+  reservation: StrictReservation;
+  input: ReadableStream<Uint8Array>;
+  state: StrictStartState;
+  effectsStarted: boolean;
+  beginExtensions(): void;
+  complete(output: (frame: object) => void): Promise<void>;
+}
+let context: StrictStartupContext | undefined;
+export function setStrictStartup(value: StrictStartupContext): void {
+  if (context) throw new Error("STRICT_START_ALREADY_ATTEMPTED");
+  context = value;
+}
+export function getStrictStartup(): StrictStartupContext | undefined { return context; }
+export async function observeStrictStartup(): Promise<StrictStartState> {
+  if (!context) return { version: "strict-start-v1", phase: "waiting" };
+  if (context.state.phase === "cancelled") return { ...context.state };
+  try {
+    context.reservation.assertCurrent();
+    const binding = await context.reservation.currentDescriptor();
+    if (context.state.phase === "open") context.state = { ...context.state, binding };
+  }
+  catch { context.state = { ...context.state, phase: "outcome_unknown", code: "STRICT_BINDING_LOST" }; }
+  return { ...context.state };
+}
