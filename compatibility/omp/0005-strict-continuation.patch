@@ -0,0 +1,33 @@
+/** Linux fd-bound extended attributes. Unsupported filesystems/platforms fail closed; never fall back to paths. */
+import { dlopen, FFIType, ptr, read } from "bun:ffi";
+function library() {
+  if (process.platform !== "linux") throw new Error("GENERATION_XATTR_PLATFORM_UNSUPPORTED");
+  for (const soname of ["libc.so.6", "libc.so"]) {
+    try { return dlopen(soname, {
+      fgetxattr: { args: [FFIType.i32, FFIType.ptr, FFIType.ptr, FFIType.u64], returns: FFIType.i64 },
+      fsetxattr: { args: [FFIType.i32, FFIType.ptr, FFIType.ptr, FFIType.u64, FFIType.i32], returns: FFIType.i32 },
+      __errno_location: { args: [], returns: FFIType.ptr },
+    }); } catch {}
+  }
+  throw new Error("GENERATION_XATTR_UNAVAILABLE");
+}
+/** Absence is distinct from ENOTSUP, permission errors and over-limit values. */
+export function readFileXattr(fd: number, name: string, maximum: number): Buffer | undefined {
+  const libc = library(), key = Buffer.from(`${name}\0`, "utf8"), bytes = Buffer.alloc(maximum);
+  try {
+    const count = Number(libc.symbols.fgetxattr(fd, ptr(key), ptr(bytes), BigInt(bytes.length)));
+    if (count >= 0) return bytes.subarray(0, count);
+    const errno = libc.symbols.__errno_location();
+    if (errno && read.i32(errno) === 61) return undefined; // Linux ENODATA only.
+    throw new Error("GENERATION_XATTR_READ_FAILED");
+  } finally { libc.close(); }
+}
+/** The kernel publishes the complete bounded attribute on this exact inode atomically. No fsync/power-loss claim. */
+export function writeFileXattr(fd: number, name: string, value: Uint8Array): void {
+  if (value.length > 1024) throw new Error("GENERATION_XATTR_LIMIT");
+  const libc = library(), key = Buffer.from(`${name}\0`, "utf8");
+  try {
+    if (libc.symbols.fsetxattr(fd, ptr(key), ptr(value), BigInt(value.length), 0) !== 0)
+      throw new Error("GENERATION_XATTR_WRITE_FAILED");
+  } finally { libc.close(); }
+}
