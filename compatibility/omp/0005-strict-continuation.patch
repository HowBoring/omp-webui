@@ -0,0 +1,21 @@
+/** Matched native TUI/CLI continuations of generation carriers use the same real-lease, pinned storage. */
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { getActiveProfile } from "@oh-my-pi/pi-utils/dirs";
+import { hash, physicalId, readDescriptor, type NativeSource } from "../modes/rpc/catalog-metadata";
+import { StrictReservation } from "../modes/rpc/strict-reservation";
+import { StrictSessionStorage } from "./strict-session-storage";
+export async function openNativeGenerationStorage(file: string): Promise<StrictSessionStorage> {
+  const target = await fs.realpath(file), root = path.dirname(target), rootIdentity = await physicalId(root);
+  const source: NativeSource = { root, rootIdentity, sourceId: hash(`${getActiveProfile() ?? "default"}:${root}:${rootIdentity}`) };
+  const descriptor = await readDescriptor(source, target);
+  if (descriptor.cwd.status !== "known" || !descriptor.cwd.canonical) throw new Error("STRICT_CWD_UNAVAILABLE");
+  const reservation = await StrictReservation.acquire(source, target, descriptor, descriptor.cwd.canonical, new AbortController().signal);
+  try { return new StrictSessionStorage(reservation, true, false); }
+  catch (error) { await reservation.release(); throw error; }
+}
+
+/** Only explicit native New/fork/branch callers may create a fresh backend from their logical native serialization. */
+export function createExplicitNativeStorage(filePath: string, body: string, cwd: string): StrictSessionStorage {
+  return new StrictSessionStorage(StrictReservation.createNativeFileSync(filePath, body, cwd), true, false);
+}
diff --git a/packages/coding-agent/src/session/session-artifact-copy.ts b/packages/coding-agent/src/session/session-artifact-copy.ts
