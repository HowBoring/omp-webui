index 0000000000..bd1e1dfb17
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/strict-context.ts
@@ -0,0 +1,23 @@
+/** Process-local handoff from deferred startup to the normal public rpc-ui worker. */
+import type { SessionManager } from "../../session/session-manager";
+import type { StrictReservation } from "./strict-reservation";
+import type { StrictStartState } from "./wire/rpc-wire.generated";
+export interface StrictStartupContext {
+  manager: SessionManager;
+  reservation: StrictReservation;
+  input: ReadableStream<Uint8Array>;
+  state: StrictStartState;
+  complete(output: (frame: object) => void): Promise<void>;
+}
+let context: StrictStartupContext | undefined;
+export function setStrictStartup(value: StrictStartupContext): void {
+  if (context) throw new Error("STRICT_START_ALREADY_ATTEMPTED");
+  context = value;
+}
+export function getStrictStartup(): StrictStartupContext | undefined { return context; }
+export function observeStrictStartup(): StrictStartState {
+  if (!context) return { version: "strict-start-v1", phase: "waiting" };
+  try { context.reservation.assertCurrent(); }
+  catch { context.state = { ...context.state, phase: "outcome_unknown", code: "STRICT_BINDING_LOST" }; }
+  return { ...context.state };
+}
diff --git a/packages/coding-agent/src/modes/rpc/strict-input.ts b/packages/coding-agent/src/modes/rpc/strict-input.ts
new file mode 100644
index 0000000000..3b0f72c44c
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/strict-input.ts
@@ -0,0 +1,30 @@
+/** Bounded handoff retaining every already-read byte without creating a second stdin reader. */
+export class StrictInput {
+  readonly stream: ReadableStream<Uint8Array>;
+  readonly #queue: Uint8Array[] = [];
+  #bytes = 0;
+  #waiting: ReadableStreamDefaultController<Uint8Array> | undefined;
+  #closed = false;
+  constructor() {
+    this.stream = new ReadableStream<Uint8Array>({
+      pull: controller => {
+        const next = this.#queue.shift();
+        if (next) { this.#bytes -= next.length; controller.enqueue(next); }
+        else if (this.#closed) controller.close();
+        else this.#waiting = controller;
+      },
+      cancel: () => { this.#queue.length = 0; this.#bytes = 0; this.#closed = true; this.#waiting = undefined; },
+    }, { highWaterMark: 0 });
+  }
+  push(bytes: Uint8Array): void {
+    if (this.#closed) throw new Error("STRICT_INPUT_CLOSED");
+    if (this.#waiting) { const waiting = this.#waiting; this.#waiting = undefined; waiting.enqueue(bytes); return; }
+    if (this.#bytes + bytes.length > 1_048_576) throw new Error("STRICT_FORWARD_BUFFER_LIMIT");
+    this.#queue.push(bytes); this.#bytes += bytes.length;
+  }
+  close(): void {
+    if (this.#closed) return;
+    this.#closed = true;
+    if (this.#waiting) { this.#waiting.close(); this.#waiting = undefined; }
+  }
+}
diff --git a/packages/coding-agent/src/modes/rpc/strict-mode.ts b/packages/coding-agent/src/modes/rpc/strict-mode.ts
new file mode 100644
index 0000000000..74ce4adf6c
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/strict-mode.ts
@@ -0,0 +1,118 @@
+/** Deferred rpc-ui startup. Intentional lazy-import exception: no ordinary Session/UI may precede ownership. */
+import { RpcFrameEncoder, MAX_RPC_FRAME_BYTES, MAX_RPC_REASSEMBLED_BYTES } from "./rpc-frame";
+import { validateStrictCommand, type StrictCommand } from "./strict.generated";
+import { NativeCatalog } from "./catalog-native";
+import { rpcInteractionPolicy } from "./rpc-interaction-policy";
+import { StrictInput } from "./strict-input";
+import { StrictReservation } from "./strict-reservation";
+import { setStrictStartup, type StrictStartupContext } from "./strict-context";
+import type { StrictStartState } from "./wire/rpc-wire.generated";
+
+export async function runStrictMode(runtimeArgs: string[] = []): Promise<void> {
+  const encoder = new RpcFrameEncoder();
+  const output = (value: object): void => {
+    for (const frame of encoder.encodeFrames(value)) process.stdout.write(frame);
+  };
+  let state: StrictStartState = { version: "strict-start-v1", phase: "waiting" };
+  output({ type: "ready", protocolVersion: 1, supportedProtocolVersions: [1, 2],
+    maxFrameBytes: MAX_RPC_FRAME_BYTES, maxReassembledFrameBytes: MAX_RPC_REASSEMBLED_BYTES,
+    strictStartup: "strict-start-v1", interactionPolicy: rpcInteractionPolicy });
+  let negotiated = false, attempted = false;
+  let startup: Promise<void> | undefined, reservation: StrictReservation | undefined;
+  let handedOff = false, inputEnded = false;
+  const abort = new AbortController();
+  const handoff = new StrictInput();
+  const input = handoff.stream;
+  const fail = (command: StrictCommand, error: unknown): void => {
+    const code = abort.signal.aborted ? reservation?.writeAttempted ? "STRICT_START_OUTCOME_UNKNOWN" : "STRICT_CANCELLED" : error instanceof Error && /^STRICT_[A-Z_]+$/.test(error.message)
+      ? error.message : "STRICT_STARTUP_FAILED";
+    state = { ...state, phase: code.includes("OUTCOME_UNKNOWN") ? "outcome_unknown"
+      : code === "STRICT_CANCELLED" ? "cancelled" : "failed", code };
+    output({ type: "response", id: command.id, command: command.type, success: false, code, error: code });
+  };
+  const start = async (command: StrictCommand & { type: "strict_start" }): Promise<void> => {
+    state = { version: "strict-start-v1", phase: "opening", intent: command.intent, operationId: command.id };
+    try {
+      if (command.intent !== "continue") throw new Error("STRICT_NEW_NOT_IMPLEMENTED");
+      if (!command.reference) throw new Error("STRICT_INVALID_REFERENCE");
+      const catalog = await NativeCatalog.create();
+      try {
+        const resolved = await catalog.resolveStrictReference(command.reference);
+        reservation = await StrictReservation.acquire(resolved.source, resolved.path, resolved.descriptor, command.expectedCwd, abort.signal);
+      } finally { await catalog.close(); }
+      abort.signal.throwIfAborted();
+      // The imports below are permitted only after the physical instance, real lease and cwd are verified.
+      const { SessionManager } = await import("../../session/session-manager");
+      const { StrictSessionStorage } = await import("../../session/strict-session-storage");
+      const manager = await SessionManager.open(reservation.filePath, undefined, new StrictSessionStorage(reservation),
+        { throwIfMissing: true, suppressBreadcrumb: true });
+      reservation.assertCurrent(); abort.signal.throwIfAborted();
+      manager.enableStrictContinuation(() => reservation!.assertCurrent());
+      manager.bindHistorySource({ sourceId: reservation.descriptor.sourceId, instanceId: reservation.descriptor.instanceId,
+        nativeSessionId: reservation.descriptor.nativeSessionId, reference: reservation.descriptor.reference });
+      if (manager.getSessionId() !== reservation.descriptor.nativeSessionId || manager.getCwd() !== command.expectedCwd)
+        throw new Error("STRICT_NATIVE_ID_OR_CWD_CHANGED");
+      const owned = reservation;
+      const context: StrictStartupContext = { manager, reservation: owned, input, state,
+        async complete(write) {
+          owned.assertCurrent(); abort.signal.throwIfAborted();
+          await manager.flush(); owned.assertCurrent();
+          state = { ...state, phase: "open", binding: owned.descriptor, nativeSessionId: manager.getSessionId(), cwd: manager.getCwd() };
+          context.state = state;
+          write({ type: "response", id: command.id, command: "strict_start", success: true, data: state });
+        },
+      };
+      setStrictStartup(context);
+      handedOff = true;
+      if (inputEnded) throw new Error("STRICT_CANCELLED");
+      const runtime = await import("../../cli-runtime");
+      await runtime.runCli(["--mode", "rpc-ui", "--cwd", command.expectedCwd, ...runtimeArgs]);
+    } catch (error) { fail(command, error); }
+    finally { await reservation?.release(); }
+  };
+  const buffer = new Uint8Array(16_384);
+  let used = 0;
+  try {
+    for await (const bytes of Bun.stdin.stream()) for (const byte of bytes) {
+      if (used === buffer.length) throw new Error("STRICT_INPUT_LIMIT");
+      buffer[used++] = byte;
+      if (byte !== 10) continue;
+      const line = buffer.slice(0, used); used = 0;
+      const value: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(line.subarray(0, line.length - 1)));
+      if (handedOff) {
+        if (state.phase === "opening" && validateStrictCommand(value) && value.type === "get_strict_state") {
+          output({ type: "response", id: value.id, command: value.type, success: true, data: state }); continue;
+        }
+        if (state.phase === "opening" && validateStrictCommand(value) && value.type === "cancel_strict_start") {
+          abort.abort(); handoff.close();
+          state = { ...state, phase: reservation?.writeAttempted ? "outcome_unknown" : "cancelled",
+            code: reservation?.writeAttempted ? "STRICT_START_OUTCOME_UNKNOWN" : "STRICT_CANCELLED" };
+          output({ type: "response", id: value.id, command: value.type, success: true, data: state }); continue;
+        }
+        handoff.push(line); continue;
+      }
+      if (!validateStrictCommand(value) || value.id.length > 128) throw new Error("STRICT_COMMAND_SCHEMA");
+      if (value.type === "negotiate_protocol") {
+        if (negotiated || value.protocolVersion !== 2) throw new Error("STRICT_NEGOTIATION");
+        output({ type: "response", id: value.id, command: value.type, success: true, data: { protocolVersion: 2 } });
+        encoder.setProtocolVersion(2); negotiated = true; continue;
+      }
+      if (!negotiated) throw new Error("STRICT_NEGOTIATION_REQUIRED");
+      if (value.type === "strict_start") {
+        if (attempted) { output({ type: "response", id: value.id, command: value.type, success: false,
+          code: "STRICT_START_ALREADY_ATTEMPTED", error: "STRICT_START_ALREADY_ATTEMPTED" }); continue; }
+        attempted = true; startup = start(value); continue;
+      }
+      if (value.type === "cancel_strict_start") {
+        abort.abort();
+        state = { ...state, phase: "cancelled", code: "STRICT_CANCELLED" };
+      }
+      output({ type: "response", id: value.id, command: value.type, success: true, data: state });
+    }
+    if (used) throw new Error("STRICT_PARTIAL_EOF");
+    inputEnded = true;
+    if (!handedOff) abort.abort();
+    handoff.close();
+    await startup;
+  } finally { abort.abort(); await reservation?.release(); }
+}
diff --git a/packages/coding-agent/src/modes/rpc/strict-reservation.ts b/packages/coding-agent/src/modes/rpc/strict-reservation.ts
