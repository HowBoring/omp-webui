new file mode 100644
index 0000000000..03b8b4aba6
--- /dev/null
+++ b/packages/coding-agent/src/session/strict-session-storage.ts
@@ -0,0 +1,65 @@
+/** Native exact-instance storage. No pathname reopening, unknown lease success, sibling recovery or backup guessing. */
+import * as fs from "node:fs";
+import { FileSessionStorage, type SessionStorage, type SessionStorageStat, type SessionStorageWriter,
+  type SessionStorageWriteOptions, type WriteTextAtomicOptions } from "./session-storage";
+import { serializeTitleSlot, type SessionTitleUpdate } from "./session-title-slot";
+import type { StrictReservation } from "../modes/rpc/strict-reservation";
+
+export class StrictSessionStorage implements SessionStorage {
+  readonly #reservation: StrictReservation;
+  readonly #files = new FileSessionStorage();
+  constructor(reservation: StrictReservation) { this.#reservation = reservation; }
+  #check(file: string): void { this.#reservation.assertCurrent(file); }
+  #reject(file: string): never { this.#check(file); throw new Error("STRICT_ATOMIC_REWRITE_UNAVAILABLE"); }
+  ensureDirSync(_dir: string): void { this.#reservation.assertCurrent(); }
+  existsSync(file: string): boolean { this.#check(file); return true; }
+  exists(file: string): Promise<boolean> { this.#check(file); return Promise.resolve(true); }
+  statSync(file: string): SessionStorageStat {
+    this.#check(file);
+    const stat = fs.statSync(file);
+    this.#check(file); return { size: stat.size, mtimeMs: stat.mtimeMs, mtime: stat.mtime };
+  }
+  readText(file: string): Promise<string> { return Promise.resolve(this.readTextSync(file)); }
+  readTextSync(file: string): string { this.#check(file); return this.#reservation.read(); }
+  readTextSlices(file: string, head: number, tail: number): Promise<[string, string]> {
+    const bytes = Buffer.from(this.readTextSync(file));
+    return Promise.resolve([bytes.subarray(0, head).toString("utf8"), bytes.subarray(Math.max(0, bytes.length - tail)).toString("utf8")]);
+  }
+  listFilesSync(_dir: string, _pattern: string): string[] { throw new Error("STRICT_ALTERNATE_TARGET_FORBIDDEN"); }
+  writeTextSync(file: string, _body: string, _options?: SessionStorageWriteOptions): void { this.#reject(file); }
+  writeLinesSync(file: string, _body: readonly string[], _options?: SessionStorageWriteOptions): void { this.#reject(file); }
+  writeText(file: string, _body: string): Promise<void> { return Promise.reject(this.#reject(file)); }
+  writeTextAtomic(file: string, _body: string, _options?: WriteTextAtomicOptions): Promise<void> { return Promise.reject(this.#reject(file)); }
+  writeLinesAtomic(file: string, _body: readonly string[], _options?: WriteTextAtomicOptions): Promise<void> { return Promise.reject(this.#reject(file)); }
+  async updateSessionTitle(file: string, update: SessionTitleUpdate): Promise<void> {
+    this.#check(file); this.#files.withStrictMutationSync(file, () => this.#reservation.writeAt(serializeTitleSlot(update), 0));
+  }
+  rename(file: string, _next: string): Promise<void> { this.#check(file); throw new Error("STRICT_RELOCATION_FORBIDDEN"); }
+  unlink(file: string): Promise<void> { this.#check(file); throw new Error("STRICT_DELETE_FORBIDDEN"); }
+  deleteSessionWithArtifacts(file: string): Promise<void> { return this.unlink(file); }
+  withSessionFileLockSync<T>(file: string, operation: () => T): T {
+    this.#check(file);
+    return this.#files.withSessionFileLockSync(file, () => { this.#check(file); const result = operation(); this.#check(file); return result; });
+  }
+  claimSession(id: string, file: string): () => void {
+    this.#check(file);
+    if (id !== this.#reservation.descriptor.nativeSessionId) throw new Error("STRICT_NATIVE_ID_CHANGED");
+    // The reservation already owns a real OS lease. Manager releases cannot relinquish it before full worker disposal.
+    return () => {};
+  }
+  openWriter(file: string, options?: { flags?: "a" | "w"; onError?: (error: Error) => void }): SessionStorageWriter {
+    this.#check(file);
+    if (options?.flags === "w") this.#reject(file);
+    let closed = false, failure: Error | undefined;
+    const append = (line: string): void => {
+      if (closed) throw new Error("STRICT_WRITER_CLOSED");
+      if (failure) throw failure;
+      try { this.#check(file); this.#files.withStrictMutationSync(file, () => this.#reservation.append(line)); }
+      catch (error) { failure = error instanceof Error ? error : new Error("STRICT_WRITE_FAILED"); options?.onError?.(failure); throw failure; }
+    };
+    const flush = (): void => { if (failure) throw failure; this.#check(file); };
+    return { appendSync: append, append: async line => append(line), flush: async () => flush(), flushSync: flush,
+      close: async () => { closed = true; if (failure) throw failure; }, isOpen: () => !closed, getError: () => failure };
+  }
+  drain(): Promise<void> { this.#reservation.assertCurrent(); return Promise.resolve(); }
+}
