+"""Agreed pure OS/fd3 callbacks and selected AST; no adapter import or actor."""
+import unittest
+from pathlib import Path
+from types import SimpleNamespace as N
+from external_backpressure_policy_test import policy, source_function, io_class
+
+
+class Startup74Tests(unittest.TestCase):
+    def scenario(self, observed=None, wait_failure=None, **changes):
+        session = policy.Session()
+        session.protector, session.pidfd, session.identity = N(pid=77), 16, (5, 99)
+        session.source74_verified = True
+        session.startup_bytes = session.hello = session.start_intent = False
+        for name, value in changes.items():
+            setattr(session, name, value)
+        effects = []
+        class FakePath:
+            def __truediv__(self, other): return self
+            def exists(self): return False
+            def iterdir(self): return iter([])
+        def waitid(*args): return observed if observed is not None else N(si_code=1, si_status=74, si_pid=77)
+        def original_wait(*args):
+            effects.append(("original-wait", args[3]))
+            if wait_failure is not None: raise wait_failure
+        journal = N(save=lambda event, **kw: effects.append(event))
+        reader = N(raw=b'', finish=lambda *args: effects.append('reader-joined'))
+        writer = N(close=lambda: effects.append('close-duplicate'))
+        dispatcher = N(startup_no_peer=lambda until: effects.append('dispatcher-joined-no-peer'))
+        function = source_function('failed_startup74', {
+            'require': policy.require, 'identity': lambda fd: (5, 99), 'os': N(waitid=waitid,
+                P_PIDFD=3, WEXITED=4, WNOHANG=8, WNOWAIT=16, CLD_EXITED=1), 'WALL': 32,
+            'time': N(monotonic=lambda: 0), 'BUDGET': 5, 'STAGE': FakePath(),
+            'original_wait': original_wait,
+            'receive': lambda *args: b'', 'domain_empty': lambda *args: effects.append('kernel-ECHILD')})
+        return session, effects, lambda: function(session, journal, (object(), writer, 12, [reader], dispatcher))
+
+    def test_known_prehello74_is_failed_drain_after_original_reap(self):
+        _session, effects, run = self.scenario()
+        self.assertEqual(run(), 3)
+        self.assertLess(effects.index(('original-wait', 74)), effects.index('close-duplicate'))
+        self.assertIn('reader-joined', effects)
+        self.assertIn('kernel-ECHILD', effects)
+        self.assertIn('dispatcher-joined-no-peer', effects)
+        self.assertEqual(effects[-1], 'FAILED_DRAINED_STARTUP74')
+
+    def test_any_prefix_start_or_missing_source_proof_preserves_duplicate(self):
+        for field in ('startup_bytes', 'hello', 'start_intent', 'started', 'root_zero'):
+            _session, effects, run = self.scenario(**{field: True})
+            with self.assertRaises(policy.Refusal): run()
+            self.assertNotIn('close-duplicate', effects)
+        _session, effects, run = self.scenario(source74_verified=False)
+        with self.assertRaises(policy.Refusal): run()
+        self.assertNotIn('close-duplicate', effects)
+
+    def test_other_original_status_or_unreaped_owner_retains_duplicate(self):
+        for observed in (N(si_code=1, si_status=0, si_pid=77), N(si_code=2, si_status=9, si_pid=77),
+                         N(si_code=1, si_status=74, si_pid=78)):
+            _session, effects, run = self.scenario(observed=observed)
+            with self.assertRaisesRegex(policy.Refusal, 'STARTUP74_ORIGINAL_STATUS'): run()
+            self.assertNotIn('close-duplicate', effects)
+        _session, effects, run = self.scenario(wait_failure=policy.Refusal('ORIGINAL_WAIT_STATUS'))
+        with self.assertRaisesRegex(policy.Refusal, 'ORIGINAL_WAIT_STATUS'): run()
+        self.assertNotIn('close-duplicate', effects)
+
+    def test_partial_hello_then_terminal_never_loses_prefix(self):
+        session = policy.Session()
+        session.pidfd = 16
+        observations = iter([(['peer'], [], []), ([16], [], [])])
+        function = source_function('startup_line', {
+            'select': N(select=lambda *args: next(observations)), 'remaining': policy.remaining,
+            'time': N(monotonic=lambda: 0), 'require': policy.require,
+            'receive': lambda *args: b'H', 'BUDGET': 5})
+        with self.assertRaisesRegex(policy.Refusal, 'PREHELLO_ORIGINAL_TERMINAL'):
+            function(session, 'peer', N(save=lambda *args, **kw: None))
+        self.assertTrue(session.startup_bytes)
+
+
+class CompletionObservationTests(unittest.TestCase):
+    def test_eof_without_joined_reader_does_not_finish(self):
+        journal = []
+        for live in (False, True):
+            reader_type = io_class('Reader', {'require': policy.require, 'remaining': policy.remaining,
+                'time': N(monotonic=lambda: 0)})
+            reader = reader_type.__new__(reader_type)
+            reader.eof = N(wait=lambda until: True)
+            reader.thread = N(join=lambda until: None, is_alive=lambda: live)
+            reader.failure, reader.raw = None, bytearray()
+            if live:
+                with self.assertRaisesRegex(policy.Refusal, 'READER_JOIN_TIMEOUT'):
+                    reader.finish(5, N(save=lambda *args, **kw: journal.append(args[0])), 'test')
+            else:
+                reader.finish(5, N(save=lambda *args, **kw: journal.append(args[0])), 'test')
+        self.assertEqual(journal, ['ORIGINAL_READER_EOF'])
+
+    def test_only_no_peer_accept_timeout_can_finish_dispatcher_startup_refusal(self):
+        dispatcher_type = io_class('Dispatcher', {'require': policy.require, 'remaining': policy.remaining,
+            'time': N(monotonic=lambda: 0)})
+        for accepted, failure, live in ((False, 'DISPATCHER_ACCEPT_TIMEOUT', False),
+                (True, 'DISPATCHER_ACCEPT_TIMEOUT', False), (False, 'DISPATCHER_AMBIGUITY', False),
+                (False, 'DISPATCHER_ACCEPT_TIMEOUT', True)):
+            dispatcher = dispatcher_type.__new__(dispatcher_type)
+            dispatcher.done = N(wait=lambda bound: True)
+            dispatcher.thread = N(join=lambda bound: None, is_alive=lambda: live)
+            dispatcher.accepted, dispatcher.failure = accepted, failure
+            events = []
+            dispatcher.journal = N(save=lambda *args: events.append(args[0]))
+            if accepted or failure != 'DISPATCHER_ACCEPT_TIMEOUT' or live:
+                with self.assertRaises(policy.Refusal): dispatcher.startup_no_peer(5)
+                self.assertEqual(events, [])
+            else:
+                dispatcher.startup_no_peer(5)
+                self.assertEqual(events, ['STARTUP74_DISPATCHER_ACCEPT_TIMEOUT_JOINED_NO_PEER'])
+
+    def test_refusal_code_is_bounded_and_scrubbed(self):
+        function = source_function('refusal_code', {'Refusal': policy.Refusal})
+        self.assertEqual(function(policy.Refusal('PREHELLO_ORIGINAL_TERMINAL')), 'PREHELLO_ORIGINAL_TERMINAL')
+        for value in ('/private/path', 'TOKEN secret', 'A' * 97, ''):
+            self.assertEqual(function(policy.Refusal(value)), 'SCRUBBED_REFUSAL')
+        self.assertEqual(function(RuntimeError('do not log')), 'NON_REFUSAL')
+
+
+if __name__ == '__main__': unittest.main()
