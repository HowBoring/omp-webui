@@ -0,0 +1,361 @@
+"""Exercise the fault and disposition at the existing fixture's fake OS seam."""
+import ast
+from dataclasses import dataclass
+import errno
+from pathlib import Path
+from types import SimpleNamespace as N
+import unittest
+
+from external_backpressure_policy import Refusal, Session, fill_queue, recover, remaining, require
+
+
+def fixture_function(name, **namespace):
+    source = Path(__file__).with_name("external_backpressure.py")
+    selected = [node for node in ast.parse(source.read_text()).body
+                if isinstance(node, (ast.FunctionDef, ast.ClassDef)) and node.name == name]
+    assert len(selected) == 1, name
+    namespace.update(Refusal=Refusal, require=require, remaining=remaining, dataclass=dataclass)
+    exec(compile(ast.Module(body=selected, type_ignores=[]), str(source), "exec"), namespace)
+    return namespace[name]
+
+
+class ControlReadHalfTests(unittest.TestCase):
+    def observe(self, *, started=True, ack=True, altered_fence=False, altered_pidfd=False,
+                expired=False, shutdown_failure=False):
+        session = Session()
+        fault = fixture_function("FaultObservation")()
+        session.started, session.root_zero = started, True
+        session.pidfd, session.identity = 17, (5, 321)
+        clock = 0.0
+        events = []
+        fence = b"original incomplete fence"
+
+        def pause(_read, _write, _error, delay):
+            nonlocal clock
+            self.assertLessEqual(delay, 0.01)
+            clock += 6 if expired else delay
+
+        def protected(pidfd, path, control, _generation, _journal):
+            self.assertEqual((pidfd, path, control), (17, Path("/fake/fences/g.fence"), 91))
+            events.append(("protection", clock))
+            return b"changed" if altered_fence and session.failed else fence
+
+        def shutdown(how):
+            self.assertTrue(session.failed)
+            events.append(("shutdown", how))
+            if shutdown_failure:
+                raise OSError("uncertain shutdown")
+
+        writes = iter([812, BlockingIOError(errno.EAGAIN, "full")])
+
+        def send(_data):
+            result = next(writes)
+            if isinstance(result, OSError):
+                raise result
+            return result
+
+        peer = N(fileno=lambda: 12, shutdown=shutdown)
+        writer = N(setblocking=lambda value: self.assertFalse(value), send=send)
+        dispatcher = N(release=N(set=lambda: events.append(("release", clock))),
+                       ack=N(wait=lambda bound: events.append(("ack", bound)) or ack),
+                       failure=None, done=N(is_set=lambda: False))
+        journal = N(save=lambda name, **fields: events.append((name, fields)))
+
+        def identity(fd):
+            if fd == session.pidfd and altered_pidfd and session.failed:
+                return (5, 322)
+            return {12: (1, 234), 17: (5, 321)}[fd]
+
+        func = fixture_function("control_read_half_fault",
+                                STAGE=Path("/fake"), GENERATION="g", BUDGET=5, fill_queue=fill_queue,
+                                time=N(monotonic=lambda: clock), select=N(select=pause), socket=N(SHUT_RD=0),
+                                identity=identity,
+                                os=N(open=lambda *args: 91, O_RDONLY=1, O_CLOEXEC=2, O_NOFOLLOW=4),
+                                protected=protected)
+        return session, fault, events, lambda: func(session, journal, (peer, writer, object(), [], dispatcher), fault)
+
+    def test_shutdown_follows_real_backpressure_and_ack_with_bounded_protection_receipt(self):
+        session, fault, events, run = self.observe()
+        run()
+        self.assertEqual(fault.original_fence, b"original incomplete fence")
+        self.assertTrue(fault.completed)
+        self.assertEqual(fault.shutdown_state, "RETURNED")
+        names = [event[0] for event in events]
+        expected_order = ["ACTUAL_FD3_EAGAIN", "release", "ack", "CONTROL_PEER_SHUT_RD_INTENT", "shutdown",
+                          "CONTROL_PEER_SHUT_RD_RETURNED", "CONTROL_READ_HALF_FAULT_PROTECTION_HELD"]
+        self.assertEqual(list(filter(expected_order.__contains__, names)), expected_order)
+        self.assertIn(("shutdown", 0), events)
+        self.assertTrue(session.failed)
+        self.assertFalse(session.signal_attempted)
+        self.assertGreaterEqual(events[-1][1]["interval"], 0.25)
+        self.assertLess(events[-1][1]["interval"], 5)
+        self.assertGreater(events[-1][1]["observations"], 1)
+
+    def test_missing_start_or_ack_cannot_inject(self):
+        for changes, code in (({"started": False}, "READ_HALF_FAULT_INELIGIBLE"),
+                              ({"ack": False}, "ACK_WRITE_FAILED")):
+            with self.subTest(code=code):
+                _session, fault, events, run = self.observe(**changes)
+                with self.assertRaisesRegex(Refusal, code):
+                    run()
+                self.assertNotIn("shutdown", [event[0] for event in events])
+                self.assertEqual(fault.shutdown_state, "NOT_ATTEMPTED")
+                self.assertFalse(fault.completed)
+
+    def test_lost_protection_or_deadline_after_shutdown_stays_failed_without_receipt(self):
+        for changes, code in (({"altered_fence": True}, "FAULT_FENCE_CHANGED"),
+                              ({"altered_pidfd": True}, "ORIGINAL_PIDFD_CHANGED"),
+                              ({"expired": True}, "READ_HALF_FAULT_TIMEOUT")):
+            with self.subTest(code=code):
+                session, fault, events, run = self.observe(**changes)
+                with self.assertRaisesRegex(Refusal, code):
+                    run()
+                self.assertTrue(session.failed)
+                self.assertEqual(fault.original_fence, b"original incomplete fence")
+                self.assertFalse(fault.completed)
+                self.assertEqual(fault.shutdown_state, "RETURNED")
+                self.assertIn(("shutdown", 0), events)
+                self.assertNotIn("CONTROL_READ_HALF_FAULT_PROTECTION_HELD", [event[0] for event in events])
+
+    def test_shutdown_failure_keeps_sticky_failure_without_successful_return_receipt(self):
+        session, fault, events, run = self.observe(shutdown_failure=True)
+        with self.assertRaises(OSError):
+            run()
+        names = [event[0] for event in events]
+        self.assertIn("CONTROL_PEER_SHUT_RD_INTENT", names)
+        self.assertNotIn("CONTROL_PEER_SHUT_RD_RETURNED", names)
+        self.assertTrue(session.failed)
+        self.assertFalse(session.signal_attempted)
+        self.assertFalse(fault.completed)
+        self.assertEqual(fault.shutdown_state, "ATTEMPTED_OUTCOME_UNCERTAIN")
+
+    def test_observed_fault_flows_to_manual_hold_with_original_fence(self):
+        session = Session()
+        events = []
+        owned = tuple(range(5))
+        journal = N(save=lambda name, **fields: events.append((name, fields)))
+
+        def recover(actual_session, actual_journal, actual_owned, fault):
+            self.assertIs(actual_session, session)
+            self.assertTrue(session.failed)
+            self.assertIs(actual_journal, journal)
+            self.assertIs(actual_owned, owned)
+            self.assertEqual(fault.original_fence, b"original incomplete fence")
+            self.assertTrue(fault.completed)
+            self.assertEqual(events[-1][0], "HOLD")
+            return 2
+
+        def observe(_session, _journal, _owned, fault):
+            fault.original_fence = b"original incomplete fence"
+            fault.completed = True
+            fault.shutdown_state = "RETURNED"
+
+        function = fixture_function("controller", FaultObservation=fixture_function("FaultObservation"),
+                                    start_protector=lambda *args: owned, protocol_start=lambda *args: None,
+                                    control_read_half_fault=observe,
+                                    refusal_code=str, manual_recovery=recover)
+        self.assertEqual(function(session, journal), 2)
+        self.assertEqual(events[-1][1]["refusalCode"], "CONTROL_READ_HALF_FAULT_HELD")
+        self.assertFalse(session.signal_attempted)
+
+    def disposition(self, *, approve, fault=None, fence=b"original incomplete fence", control_data=()):
+        session = Session()
+        session.failed = session.started = session.root_zero = True
+        session.protector, session.pidfd, session.identity = N(pid=77), 17, (5, 321)
+        if fault is None:
+            fault = fixture_function("FaultObservation")(fence, "RETURNED", True)
+        events, challenge = [], []
+        control_data = iter(control_data)
+        journal = N(save=lambda name, **fields: events.append((name, fields)))
+        dispatcher = N(finish=N(set=lambda: events.append(("dispatcher-finish", {}))),
+                       done=N(wait=lambda bound: True))
+        writer = N(close=lambda: events.append(("close-duplicate", {})))
+        reader = N(finish=lambda _bound, _journal, role: events.append(("reader-joined", {"role": role})))
+
+        def report(receipt):
+            challenge.append(receipt["freshManualCommand"].encode() + b"\n")
+            return True
+
+        def wait(process, pidfd, _until, status, _journal, role):
+            self.assertIs(process, session.protector)
+            events.append(("original-wait", {"fd": pidfd, "status": status, "role": role}))
+
+        def receive(_peer, _size, _until):
+            events.append(("control-receive", {}))
+            return next(control_data)
+
+        function = fixture_function(
+            "manual_recovery", STAGE=Path("/fake"), GENERATION="g", BUDGET=5, WALL=32,
+            os=N(open=lambda *args: 91, O_RDONLY=1, O_CLOEXEC=2, O_NOFOLLOW=4, urandom=lambda n: b"A" * n,
+                 waitid=lambda *args: None, P_PIDFD=3, WEXITED=4, WNOHANG=8, WNOWAIT=16),
+            protected=lambda *args: fence, report=report, input_line=lambda _fd: challenge[0] if approve else b"",
+            recover=recover, identity=lambda _fd: (5, 321), time=N(monotonic=lambda: 0),
+            signal=N(SIGKILL=9, pidfd_send_signal=lambda fd, number, *_args:
+                     events.append(("signal", {"fd": fd, "number": number}))),
+            original_wait=wait, domain_empty=lambda *_args: events.append(("direct-ECHILD", {})),
+            fence_bytes=lambda *args: fence, receive=receive)
+        return session, events, challenge, lambda: function(
+            session, journal, (object(), writer, object(), [reader, reader], dispatcher), fault)
+
+    def test_fresh_literal_disposition_reaps_original_then_joins_readers_and_preserves_fence(self):
+        session, events, challenge, run = self.disposition(approve=True)
+        self.assertEqual(run(), 2)
+        self.assertEqual(challenge, [f"ROOT_KILL_ONLY_ORIGINAL 77 17 5 321 {'41' * 24}\n".encode()])
+        self.assertIn(("signal", {"fd": 17, "number": 9}), events)
+        names = [event[0] for event in events]
+        self.assertLess(names.index("MANUAL_ORIGINAL_PROTECTOR_SIGKILL_INTENT"), names.index("signal"))
+        self.assertLess(names.index("original-wait"), names.index("close-duplicate"))
+        self.assertIn(("original-wait", {"fd": 17, "status": -9, "role": "manual-protector"}), events)
+        self.assertIn(("MANUAL_CONTROL_NOT_USED_AS_EOF_EVIDENCE", {"shutdownState": "RETURNED"}), events)
+        self.assertNotIn("control-receive", names)
+        self.assertEqual(names.count("reader-joined"), 2)
+        self.assertIn("direct-ECHILD", names)
+        self.assertEqual(events[-1], ("MANUAL_RECOVERED_NOT_NORMAL_PASS", {
+            "faultObserved": True, "failedFenceCleared": False, "failedFenceHex": b"original incomplete fence".hex()}))
+        self.assertTrue(session.signal_attempted)
+
+    def test_missing_literal_cannot_attempt_signal(self):
+        session, events, _challenge, run = self.disposition(approve=False)
+        with self.assertRaisesRegex(Refusal, "FRESH_ROOT_MANUAL_COMMAND_REQUIRED"):
+            run()
+        self.assertFalse(session.signal_attempted)
+        self.assertNotIn("signal", [event[0] for event in events])
+
+    def test_changed_fence_in_unfinished_observation_cannot_become_challenge_baseline(self):
