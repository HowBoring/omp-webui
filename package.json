{
  "name": "omp-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --watch apps/host/src/main.ts",
    "start": "bun apps/host/src/main.ts",
    "test": "bun test",
    "test:access:browser": "python3 tests/access/browser.py",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun test && bun run build",
    "build": "bun build apps/host/src/main.ts --target=bun --outdir=dist",
    "compat:build": "bun scripts/build-compatibility.ts",
    "diagnostics": "bun --no-env-file vendor/host-diagnostics/diagnostics-main.js",
    "compat:prepare": "bun --no-env-file scripts/prepare-compatibility.ts",
    "dsh:prepare": "bash scripts/prepare-dsh.sh",
    "dsh:link": "bun scripts/link-dsh.ts",
    "diagnostics:build": "bun apps/diagnostics/build.ts && bun scripts/build-diagnostics-host.ts",
    "diagnostics:enroll": "bun scripts/enroll-candidate.ts",
    "catalog:fixture": "bun --no-env-file vendor/host-catalog/catalog-fixture-main.js",
    "catalog:fixture-data": "bun scripts/create-catalog-fixture.ts",
    "catalog:build": "bun apps/catalog/build.ts && bun scripts/build-catalog-host.ts",
    "workspaces:fixture-data": "bun scripts/create-workspace-fixture.ts",
    "workspaces:build": "bun apps/workspaces/build.ts && bun scripts/build-workspace-host.ts",
    "workspaces:component": "bun --no-env-file vendor/host-workspaces/workspace-component-main.js",
    "test:workspaces:browser": "python3 tests/workspaces/browser.py",
    "interactions:build": "bun apps/interactions/build.ts && bun scripts/build-interactions-host.ts",
    "interactions:fixture": "bun --no-env-file vendor/host-interactions/interactions-fixture-main.js"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.20.2",
    "ajv": "8.17.1",
    "zod": "4.6.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
